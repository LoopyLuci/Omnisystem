{
  "_comment": "DO NOT run npm audit fix --force. It upgrades Svelte 4->5 and Vite 5->6 which break compatibility. Use npm audit fix (non-breaking) only.",
  "name": "workspace",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "node ./scripts/dev-all.cjs",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:bundle": "node ./scripts/check-bundle-size.mjs",
    "build:ci": "npm run check && npm run build && npm run check:bundle",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:agent-api": "node ./agent-api-smoke.mjs",
    "test:agent-api:remote-only": "set WORKSPACE_SKIP_UI=1&& node ./agent-api-smoke.mjs",
    "test:agent-ui-hitl": "set WORKSPACE_SKIP_API=1&& node ./agent-api-smoke.mjs",
    "test:agent-ui-live": "set WORKSPACE_SKIP_API=1&& set WORKSPACE_UI_LIVE=1&& node ./agent-api-smoke.mjs",
    "test:agent-ui-live-orchestrated": "node ./agent-ui-live-orchestrated.mjs",
    "launch:all": "node ./orchestrate-workspace-ecosystem.mjs",
    "launch:desktop": "node ./orchestrate-workspace-ecosystem.mjs --mode desktop",
    "launch:desktop+usb": "node ./orchestrate-workspace-ecosystem.mjs --mode desktop+usb",
    "launch:desktop+usb:remote-smoke": "node ./orchestrate-workspace-ecosystem.mjs --mode desktop+usb --remote-surface-smoke",
    "launch:desktop+usb:remote-smoke:preflight": "node ./orchestrate-workspace-ecosystem.mjs --mode desktop+usb --remote-surface-smoke --preflight-only",
    "launch:preflight": "node ./orchestrate-workspace-ecosystem.mjs --preflight-only",
    "launch:preflight:report": "node ./orchestrate-workspace-ecosystem.mjs --preflight-only --report-path ../../tool_test/launcher/preflight.json",
    "test:android-usb-regression": "node ./android-usb-regression.mjs",
    "test:android-orientation-ux": "node ./android-orientation-ux-regression.mjs",
    "evidence:append-usb-ledger": "pwsh -File ./append-usb-evidence-ledger.ps1",
    "test:workspace-live-testing-feature": "set WORKSPACE_LIVE_MODE=1&& set WORKSPACE_LIVE_HEADLESS=0&& node ./workspace-live-testing-feature.mjs",
    "test:workspace-live-testing-feature:watch": "set WORKSPACE_LIVE_MODE=1&& set WORKSPACE_LIVE_HEADLESS=0&& set WORKSPACE_LIVE_SLOW_MO_MS=180&& set WORKSPACE_LIVE_SCENARIO_PAUSE_MS=1800&& set WORKSPACE_UI_KEEP_OPEN_MS=30000&& node ./workspace-live-testing-feature.mjs",
    "test:workspace-live-testing-feature:headless": "set WORKSPACE_LIVE_MODE=0&& set WORKSPACE_LIVE_HEADLESS=1&& node ./workspace-live-testing-feature.mjs",
    "test:workspace-live-audit:smoke": "set WORKSPACE_LIVE_MODE=0&& set WORKSPACE_LIVE_HEADLESS=1&& set WORKSPACE_LIVE_SCENARIO_TIMEOUT_MS=60000&& set WORKSPACE_AUDIT_PROFILE=smoke&& set WORKSPACE_AUDIT_RUN_AUX=0&& node ./workspace-live-testing-feature.mjs",
    "test:workspace-live-audit:full": "set WORKSPACE_LIVE_MODE=0&& set WORKSPACE_LIVE_HEADLESS=1&& set WORKSPACE_LIVE_SCENARIO_TIMEOUT_MS=120000&& set WORKSPACE_AUDIT_PROFILE=full&& set WORKSPACE_AUDIT_RUN_AUX=1&& node ./workspace-live-testing-feature.mjs",
    "test:workspace-live-feature-audit": "npm run test:workspace-live-audit:full",
    "demo:app-window-live": "node ./agent-app-window-live.mjs",
    "test:agent-all": "node ./agent-api-smoke.mjs",
    "test:agent-orchestrated": "node ./agent-orchestrate-all.mjs",
    "test:agent-routing-ci": "node ./agent-routing-ci.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-barcode-scanner": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "@techstark/opencv-js": "^5.0.0-release.1",
    "dompurify": "^3.0.6",
    "marked": "^18.0.6",
    "monaco-editor": "^0.56.0",
    "playwright": "^1.59.1",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@tsconfig/svelte": "^5.0.0",
    "@types/node": "^26.1.1",
    "jsdom": "^29.1.1",
    "svelte": "^4.2.0",
    "svelte-check": "^4.7.2",
    "typescript": "^6.0.3",
    "vite": "^5.0.0",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vitest": "^4.1.4"
  }
}
