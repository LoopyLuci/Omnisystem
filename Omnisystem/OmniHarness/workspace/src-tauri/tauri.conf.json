{
  "productName": "Omnisystem Workspace",
  "version": "0.2.0",
  "identifier": "com.omnisystem.workspace",
  "build": {
    "beforeDevCommand": "npm --prefix ../src run dev:all",
    "beforeBuildCommand": "npm --prefix ../src run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Omnisystem Workspace",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "assistant",
        "title": "Omnisystem Workspace",
        "width": 420,
        "height": 680,
        "minWidth": 340,
        "minHeight": 480,
        "resizable": true,
        "visible": false,
        "decorations": true,
        "alwaysOnTop": false,
        "url": "assistant.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob: 'unsafe-inline'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; child-src 'self' blob:; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' http://127.0.0.1:* https://127.0.0.1:* http://localhost:* https://localhost:* http://ipc.localhost:* ws://127.0.0.1:* wss://127.0.0.1:* ws://localhost:* wss://localhost:* ws://ipc.localhost:* wss://ipc.localhost:* https://*.open-meteo.com https://geocoding-api.open-meteo.com",
      "assetProtocol": { "enable": true, "scope": ["**"] },
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/LoopyLuci/Omnisystem/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENEMEYxMEVGQzVFQzZGODcKUldTSGIrekY3eEFQelRFeUdBcEU3UjFTVW9VemJJZEcyV2V0dCs1ZzR4NkFUL3NHRFhHaVhPTTMK"
    }
  }
}
