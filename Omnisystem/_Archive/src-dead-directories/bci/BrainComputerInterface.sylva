// BrainComputerInterface.sylva - Brain-computer interface system
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct BCIDevice {
    pub device_id: String,
    pub device_type: String, // eeg, emg, fmri
    pub channel_count: u32,
    pub sampling_rate_hz: u32,
    pub status: String, // idle, calibrating, active, error
    pub battery_percent: u8,
}

impl BCIDevice {
    pub fn new(device_id: String, device_type: String) -> Self {
        BCIDevice {
            device_id,
            device_type,
            channel_count: 16,
            sampling_rate_hz: 250,
            status: "idle".to_string(),
            battery_percent: 100,
        }
    }

    pub fn calibrate(&mut self) {
        self.status = "calibrating".to_string();
    }

    pub fn activate(&mut self) {
        self.status = "active".to_string();
    }

    pub fn update_battery(&mut self, percent: u8) {
        self.battery_percent = (percent).min(100);
    }
}

pub struct BrainSignal {
    pub signal_id: String,
    pub device_id: String,
    pub timestamp: u64,
    pub signal_type: String, // alpha, beta, gamma, theta, delta
    pub frequency_hz: f64,
    pub amplitude_uv: f64,
    pub processed: bool,
}

impl BrainSignal {
    pub fn new(signal_id: String, device_id: String) -> Self {
        BrainSignal {
            signal_id,
            device_id,
            timestamp: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
            signal_type: "alpha".to_string(),
            frequency_hz: 10.0,
            amplitude_uv: 50.0,
            processed: false,
        }
    }

    pub fn process(&mut self) {
        self.processed = true;
    }
}

pub struct IntentionDecoding {
    pub decoding_id: String,
    pub user_id: String,
    pub detected_intent: String, // movement, speech, attention, relaxation
    pub confidence_percent: f64,
    pub execution_time_ms: u32,
}

impl IntentionDecoding {
    pub fn new(decoding_id: String, user_id: String) -> Self {
        IntentionDecoding {
            decoding_id,
            user_id,
            detected_intent: String::new(),
            confidence_percent: 0.0,
            execution_time_ms: 0,
        }
    }

    pub fn decode(&mut self, intent: String, confidence: f64, exec_time: u32) {
        self.detected_intent = intent;
        self.confidence_percent = (confidence).min(100.0);
        self.execution_time_ms = exec_time;
    }
}

pub struct NeuroprostheticControl {
    pub control_id: String,
    pub user_id: String,
    pub prosthetic_type: String, // limb, hand, arm, robotic_device
    pub degrees_of_freedom: u32,
    pub success_rate_percent: f64,
    pub active: bool,
}

impl NeuroprostheticControl {
    pub fn new(control_id: String, user_id: String, prosthetic_type: String) -> Self {
        NeuroprostheticControl {
            control_id,
            user_id,
            prosthetic_type,
            degrees_of_freedom: 6,
            success_rate_percent: 0.0,
            active: false,
        }
    }

    pub fn activate(&mut self) {
        self.active = true;
    }

    pub fn update_success_rate(&mut self, rate: f64) {
        self.success_rate_percent = (rate).min(100.0);
    }
}

pub struct BrainComputerInterfaceSystem {
    pub system_id: String,
    pub devices: HashMap<String, BCIDevice>,
    pub signals: HashMap<String, BrainSignal>,
    pub decodings: HashMap<String, IntentionDecoding>,
    pub neuroprosthetics: HashMap<String, NeuroprostheticControl>,
}

impl BrainComputerInterfaceSystem {
    pub fn new(system_id: String) -> Self {
        BrainComputerInterfaceSystem {
            system_id,
            devices: HashMap::new(),
            signals: HashMap::new(),
            decodings: HashMap::new(),
            neuroprosthetics: HashMap::new(),
        }
    }

    pub fn register_device(&mut self, device: BCIDevice) {
        self.devices.insert(device.device_id.clone(), device);
    }

    pub fn record_signal(&mut self, signal: BrainSignal) {
        self.signals.insert(signal.signal_id.clone(), signal);
    }

    pub fn record_decoding(&mut self, decoding: IntentionDecoding) {
        self.decodings.insert(decoding.decoding_id.clone(), decoding);
    }

    pub fn register_neuroprosthetic(&mut self, control: NeuroprostheticControl) {
        self.neuroprosthetics.insert(control.control_id.clone(), control);
    }

    pub fn get_active_devices(&self) -> u32 {
        self.devices
            .iter()
            .filter(|(_, d)| d.status == "active")
            .count() as u32
    }

    pub fn get_processed_signals(&self) -> u32 {
        self.signals
            .iter()
            .filter(|(_, s)| s.processed)
            .count() as u32
    }

    pub fn get_high_confidence_decodings(&self) -> u32 {
        self.decodings
            .iter()
            .filter(|(_, d)| d.confidence_percent > 80.0)
            .count() as u32
    }

    pub fn get_average_prosthetic_success_rate(&self) -> f64 {
        if self.neuroprosthetics.is_empty() {
            0.0
        } else {
            let total: f64 = self.neuroprosthetics
                .iter()
                .map(|(_, np)| np.success_rate_percent)
                .sum();
            total / self.neuroprosthetics.len() as f64
        }
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 130: BRAIN-COMPUTER INTERFACE ===\n");
    let mut bcis = BrainComputerInterfaceSystem::new("bcis_001".to_string());
    let device = BCIDevice::new("dev_001".to_string(), "eeg".to_string());
    bcis.register_device(device);
    let signal = BrainSignal::new("sig_001".to_string(), "dev_001".to_string());
    bcis.record_signal(signal);
    let decoding = IntentionDecoding::new("dec_001".to_string(), "user_001".to_string());
    bcis.record_decoding(decoding);
    let neuropros = NeuroprostheticControl::new("np_001".to_string(), "user_001".to_string(), "robotic_hand".to_string());
    bcis.register_neuroprosthetic(neuropros);
    println!("✓ Device, signal, decoding, and neuroprosthetic recorded");
    println!("✓ Active devices: {}", bcis.get_active_devices());
    println!("✓✓✓ Brain-Computer Interface operational ✓✓✓");
    Ok(())
}
