// ThreatIntelligencePlatform.sylva - Threat intelligence and analysis
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct ThreatActor {
    pub actor_id: String,
    pub name: String,
    pub actor_type: String, // nation_state, criminal_group, hacktivist, insider
    pub sophistication_level: u32, // 1-5 scale
    pub known_capabilities: Vec<String>,
}

impl ThreatActor {
    pub fn new(actor_id: String, name: String, actor_type: String) -> Self {
        ThreatActor {
            actor_id,
            name,
            actor_type,
            sophistication_level: 1,
            known_capabilities: Vec::new(),
        }
    }

    pub fn add_capability(&mut self, capability: String) {
        if !self.known_capabilities.contains(&capability) {
            self.known_capabilities.push(capability);
        }
    }
}

pub struct Malware {
    pub malware_id: String,
    pub name: String,
    pub malware_family: String,
    pub malware_type: String, // trojan, worm, ransomware, spyware, rootkit
    pub detection_count: u32,
    pub variants: u32,
    pub first_seen: u64,
    pub last_seen: u64,
}

impl Malware {
    pub fn new(malware_id: String, name: String, malware_type: String) -> Self {
        let now = std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .unwrap()
            .as_secs();

        Malware {
            malware_id,
            name,
            malware_family: String::new(),
            malware_type,
            detection_count: 0,
            variants: 0,
            first_seen: now,
            last_seen: now,
        }
    }

    pub fn record_detection(&mut self) {
        self.detection_count += 1;
    }
}

pub struct Campaign {
    pub campaign_id: String,
    pub campaign_name: String,
    pub attributed_actor: String,
    pub start_date: u64,
    pub end_date: Option<u64>,
    pub targeted_sectors: Vec<String>,
    pub affected_regions: Vec<String>,
}

impl Campaign {
    pub fn new(campaign_id: String, campaign_name: String, actor: String) -> Self {
        Campaign {
            campaign_id,
            campaign_name,
            attributed_actor: actor,
            start_date: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
            end_date: None,
            targeted_sectors: Vec::new(),
            affected_regions: Vec::new(),
        }
    }

    pub fn add_sector(&mut self, sector: String) {
        if !self.targeted_sectors.contains(&sector) {
            self.targeted_sectors.push(sector);
        }
    }

    pub fn add_region(&mut self, region: String) {
        if !self.affected_regions.contains(&region) {
            self.affected_regions.push(region);
        }
    }
}

pub struct Indicator {
    pub indicator_id: String,
    pub indicator_type: String, // hash, ip, domain, url, email
    pub value: String,
    pub threat_level: String, // malicious, suspicious, benign
    pub confidence: f64, // 0.0 to 1.0
    pub last_updated: u64,
}

impl Indicator {
    pub fn new(indicator_id: String, indicator_type: String, value: String) -> Self {
        Indicator {
            indicator_id,
            indicator_type,
            value,
            threat_level: "unknown".to_string(),
            confidence: 0.0,
            last_updated: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
        }
    }

    pub fn assess_threat(&mut self, level: String, confidence: f64) {
        self.threat_level = level;
        self.confidence = (confidence).min(1.0);
    }
}

pub struct ThreatIntelligencePlatformSystem {
    pub system_id: String,
    pub actors: HashMap<String, ThreatActor>,
    pub malware: HashMap<String, Malware>,
    pub campaigns: HashMap<String, Campaign>,
    pub indicators: HashMap<String, Indicator>,
}

impl ThreatIntelligencePlatformSystem {
    pub fn new(system_id: String) -> Self {
        ThreatIntelligencePlatformSystem {
            system_id,
            actors: HashMap::new(),
            malware: HashMap::new(),
            campaigns: HashMap::new(),
            indicators: HashMap::new(),
        }
    }

    pub fn track_actor(&mut self, actor: ThreatActor) {
        self.actors.insert(actor.actor_id.clone(), actor);
    }

    pub fn track_malware(&mut self, malware: Malware) {
        self.malware.insert(malware.malware_id.clone(), malware);
    }

    pub fn track_campaign(&mut self, campaign: Campaign) {
        self.campaigns.insert(campaign.campaign_id.clone(), campaign);
    }

    pub fn track_indicator(&mut self, indicator: Indicator) {
        self.indicators.insert(indicator.indicator_id.clone(), indicator);
    }

    pub fn get_nation_state_actors(&self) -> u32 {
        self.actors
            .iter()
            .filter(|(_, a)| a.actor_type == "nation_state")
            .count() as u32
    }

    pub fn get_ransomware_samples(&self) -> u32 {
        self.malware
            .iter()
            .filter(|(_, m)| m.malware_type == "ransomware")
            .count() as u32
    }

    pub fn get_active_campaigns(&self) -> u32 {
        self.campaigns
            .iter()
            .filter(|(_, c)| c.end_date.is_none())
            .count() as u32
    }

    pub fn get_malicious_indicators(&self) -> u32 {
        self.indicators
            .iter()
            .filter(|(_, i)| i.threat_level == "malicious")
            .count() as u32
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 142: THREAT INTELLIGENCE PLATFORM ===\n");
    let mut tips = ThreatIntelligencePlatformSystem::new("tips_001".to_string());
    let actor = ThreatActor::new("actor_001".to_string(), "APT-28".to_string(), "nation_state".to_string());
    tips.track_actor(actor);
    let malware = Malware::new("mal_001".to_string(), "NotPetya".to_string(), "ransomware".to_string());
    tips.track_malware(malware);
    let campaign = Campaign::new("camp_001".to_string(), "Operation Stealth".to_string(), "actor_001".to_string());
    tips.track_campaign(campaign);
    let indicator = Indicator::new("ind_001".to_string(), "hash".to_string(), "d41d8cd98f00b204e9800998ecf8427e".to_string());
    tips.track_indicator(indicator);
    println!("✓ Actor, malware, campaign, and indicator recorded");
    println!("✓ Nation state actors: {}", tips.get_nation_state_actors());
    println!("✓✓✓ Threat Intelligence Platform operational ✓✓✓");
    Ok(())
}
