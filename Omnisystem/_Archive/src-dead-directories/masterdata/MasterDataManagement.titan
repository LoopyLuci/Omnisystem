// MasterDataManagement.titan - Master data management and data governance
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct MasterDataEntity {
    pub entity_id: String,
    pub entity_type: String, // customer, product, supplier, etc.
    pub attributes: HashMap<String, String>,
    pub version: u32,
    pub created_at: u64,
    pub last_modified: u64,
}

impl MasterDataEntity {
    pub fn new(entity_id: String, entity_type: String) -> Self {
        let now = std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .unwrap()
            .as_secs();

        MasterDataEntity {
            entity_id,
            entity_type,
            attributes: HashMap::new(),
            version: 1,
            created_at: now,
            last_modified: now,
        }
    }

    pub fn set_attribute(&mut self, key: String, value: String) {
        self.attributes.insert(key, value);
        self.version += 1;
        self.last_modified = std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .unwrap()
            .as_secs();
    }
}

pub struct DataQualityRule {
    pub rule_id: String,
    pub entity_type: String,
    pub rule_name: String,
    pub condition: String,
    pub severity: String, // error, warning
}

impl DataQualityRule {
    pub fn new(rule_id: String, entity_type: String, rule_name: String) -> Self {
        DataQualityRule {
            rule_id,
            entity_type,
            rule_name,
            condition: String::new(),
            severity: "warning".to_string(),
        }
    }
}

pub struct DataGovernancePolicy {
    pub policy_id: String,
    pub name: String,
    pub owner: String,
    pub retention_years: u32,
    pub classification: String, // public, internal, confidential
    pub enabled: bool,
}

impl DataGovernancePolicy {
    pub fn new(policy_id: String, name: String, owner: String) -> Self {
        DataGovernancePolicy {
            policy_id,
            name,
            owner,
            retention_years: 7,
            classification: "internal".to_string(),
            enabled: true,
        }
    }
}

pub struct MasterDataManagementSystem {
    pub system_id: String,
    pub entities: HashMap<String, MasterDataEntity>,
    pub quality_rules: HashMap<String, DataQualityRule>,
    pub policies: HashMap<String, DataGovernancePolicy>,
    pub total_entities: u32,
}

impl MasterDataManagementSystem {
    pub fn new(system_id: String) -> Self {
        MasterDataManagementSystem {
            system_id,
            entities: HashMap::new(),
            quality_rules: HashMap::new(),
            policies: HashMap::new(),
            total_entities: 0,
        }
    }

    pub fn register_entity(&mut self, entity: MasterDataEntity) -> Result<String, String> {
        let entity_id = entity.entity_id.clone();
        self.entities.insert(entity_id.clone(), entity);
        self.total_entities += 1;
        Ok(entity_id)
    }

    pub fn create_quality_rule(&mut self, rule: DataQualityRule) {
        self.quality_rules.insert(rule.rule_id.clone(), rule);
    }

    pub fn create_governance_policy(&mut self, policy: DataGovernancePolicy) {
        self.policies.insert(policy.policy_id.clone(), policy);
    }

    pub fn validate_entity(&self, entity_id: &str) -> Result<bool, String> {
        if let Some(entity) = self.entities.get(entity_id) {
            // Check quality rules for this entity type
            let applicable_rules: Vec<_> = self.quality_rules
                .iter()
                .filter(|(_, r)| r.entity_type == entity.entity_type)
                .collect();

            Ok(applicable_rules.len() > 0)
        } else {
            Err(format!("Entity {} not found", entity_id))
        }
    }

    pub fn get_entity_version_history(&self, entity_id: &str) -> Result<u32, String> {
        if let Some(entity) = self.entities.get(entity_id) {
            Ok(entity.version)
        } else {
            Err(format!("Entity {} not found", entity_id))
        }
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 101: MASTER DATA MANAGEMENT ===\n");
    let mut mdms = MasterDataManagementSystem::new("mdms_001".to_string());
    let mut entity = MasterDataEntity::new("cust_001".to_string(), "customer".to_string());
    entity.set_attribute("name".to_string(), "John Doe".to_string());
    entity.set_attribute("email".to_string(), "john@example.com".to_string());
    mdms.register_entity(entity)?;
    let rule = DataQualityRule::new("rule_1".to_string(), "customer".to_string(), "Email Required".to_string());
    mdms.create_quality_rule(rule);
    println!("✓ Master data entity registered");
    println!("✓ Total entities: {}", mdms.total_entities);
    println!("✓✓✓ Master Data Management operational ✓✓✓");
    Ok(())
}
