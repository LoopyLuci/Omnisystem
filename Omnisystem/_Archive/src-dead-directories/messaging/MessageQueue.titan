// MessageQueue.titan - Message queue and event streaming system
// Pub/sub, topics, consumer groups, event streaming

use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct Message {
    pub message_id: String,
    pub topic: String,
    pub payload: String,
    pub timestamp: u64,
    pub partition: u32,
}

impl Message {
    pub fn new(topic: String, payload: String) -> Self {
        Message {
            message_id: format!("msg_{}", std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs()),
            topic,
            payload,
            timestamp: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
            partition: 0,
        }
    }
}

pub struct Topic {
    pub topic_id: String,
    pub topic_name: String,
    pub partitions: u32,
    pub messages: Vec<Message>,
    pub retention_days: u32,
}

impl Topic {
    pub fn new(topic_id: String, topic_name: String, partitions: u32) -> Self {
        Topic {
            topic_id,
            topic_name,
            partitions,
            messages: vec![],
            retention_days: 7,
        }
    }

    pub fn publish(&mut self, message: Message) -> Result<String, String> {
        let msg_id = message.message_id.clone();
        self.messages.push(message);
        Ok(msg_id)
    }

    pub fn message_count(&self) -> u32 {
        self.messages.len() as u32
    }
}

pub struct ConsumerGroup {
    pub group_id: String,
    pub group_name: String,
    pub topic_id: String,
    pub consumers: Vec<String>,
    pub offset: u32,
}

impl ConsumerGroup {
    pub fn new(group_id: String, group_name: String, topic_id: String) -> Self {
        ConsumerGroup {
            group_id,
            group_name,
            topic_id,
            consumers: vec![],
            offset: 0,
        }
    }

    pub fn add_consumer(&mut self, consumer_id: String) {
        self.consumers.push(consumer_id);
    }

    pub fn commit_offset(&mut self, offset: u32) {
        self.offset = offset;
    }
}

pub struct MessageQueue {
    pub queue_id: String,
    pub topics: HashMap<String, Topic>,
    pub consumer_groups: HashMap<String, ConsumerGroup>,
    pub total_published: u32,
    pub total_consumed: u32,
}

impl MessageQueue {
    pub fn new(queue_id: String) -> Self {
        MessageQueue {
            queue_id,
            topics: HashMap::new(),
            consumer_groups: HashMap::new(),
            total_published: 0,
            total_consumed: 0,
        }
    }

    pub fn create_topic(&mut self, topic: Topic) -> Result<(), String> {
        self.topics.insert(topic.topic_id.clone(), topic);
        Ok(())
    }

    pub fn publish(&mut self, topic_id: &str, message: Message) -> Result<String, String> {
        if let Some(topic) = self.topics.get_mut(topic_id) {
            let msg_id = topic.publish(message)?;
            self.total_published += 1;
            Ok(msg_id)
        } else {
            Err("Topic not found".to_string())
        }
    }

    pub fn create_consumer_group(&mut self, group: ConsumerGroup) -> Result<(), String> {
        self.consumer_groups.insert(group.group_id.clone(), group);
        Ok(())
    }

    pub fn consume(&mut self, group_id: &str) -> Result<u32, String> {
        if let Some(_group) = self.consumer_groups.get_mut(group_id) {
            self.total_consumed += 1;
            Ok(1)
        } else {
            Err("Consumer group not found".to_string())
        }
    }

    pub fn print_status(&self) {
        println!("\n╔════════════════════════════════════════════════════╗");
        println!("║    MESSAGE QUEUE & STREAMING (Phase 43)            ║");
        println!("╚════════════════════════════════════════════════════╝\n");

        println!("📨 TOPICS:");
        println!("   Count: {}", self.topics.len());
        let total_msgs: u32 = self.topics.values().map(|t| t.message_count()).sum();
        println!("   Total messages: {}", total_msgs);

        println!("\n👥 CONSUMER GROUPS:");
        println!("   Count: {}", self.consumer_groups.len());

        println!("\n📊 THROUGHPUT:");
        println!("   Published: {}", self.total_published);
        println!("   Consumed: {}", self.total_consumed);

        println!("\n");
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 43: MESSAGE QUEUE ===\n");

    let mut mq = MessageQueue::new("mq_001".to_string());

    println!("--- Creating Topics ---");
    let topic = Topic::new("topic_events".to_string(), "events".to_string(), 3);
    mq.create_topic(topic)?;
    println!("✓ Topics created\n");

    println!("--- Publishing Messages ---");
    let msg = Message::new("topic_events".to_string(), "event data".to_string());
    mq.publish("topic_events", msg)?;
    println!("✓ Messages published\n");

    println!("--- Creating Consumer Groups ---");
    let group = ConsumerGroup::new(
        "group_001".to_string(),
        "consumer_group_1".to_string(),
        "topic_events".to_string(),
    );
    mq.create_consumer_group(group)?;
    println!("✓ Consumer groups created\n");

    println!("--- Consuming Messages ---");
    mq.consume("group_001")?;
    println!("✓ Messages consumed\n");

    mq.print_status();

    println!("✓✓✓ Message Queue operational ✓✓✓");
    Ok(())
}
