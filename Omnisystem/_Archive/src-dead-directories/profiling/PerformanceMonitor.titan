// PerformanceMonitor.titan - Performance monitoring and profiling
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct PerformanceMetric {
    pub metric_id: String,
    pub metric_name: String,
    pub value: f64,
    pub unit: String,
    pub timestamp: u64,
}

impl PerformanceMetric {
    pub fn new(metric_id: String, metric_name: String, value: f64, unit: String) -> Self {
        PerformanceMetric {
            metric_id,
            metric_name,
            value,
            unit,
            timestamp: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
        }
    }
}

pub struct CPUProfile {
    pub profile_id: String,
    pub cpu_usage_percent: f64,
    pub memory_usage_mb: u32,
    pub thread_count: u32,
}

impl CPUProfile {
    pub fn new(profile_id: String) -> Self {
        CPUProfile {
            profile_id,
            cpu_usage_percent: 0.0,
            memory_usage_mb: 0,
            thread_count: 0,
        }
    }
}

pub struct PerformanceMonitor {
    pub monitor_id: String,
    pub metrics: HashMap<String, PerformanceMetric>,
    pub cpu_profile: CPUProfile,
    pub total_samples: u32,
}

impl PerformanceMonitor {
    pub fn new(monitor_id: String) -> Self {
        PerformanceMonitor {
            monitor_id,
            metrics: HashMap::new(),
            cpu_profile: CPUProfile::new("profile_001".to_string()),
            total_samples: 0,
        }
    }

    pub fn record_metric(&mut self, metric: PerformanceMetric) -> Result<(), String> {
        self.metrics.insert(metric.metric_id.clone(), metric);
        self.total_samples += 1;
        Ok(())
    }

    pub fn get_average(&self, metric_name: &str) -> f64 {
        let matching: Vec<f64> = self.metrics
            .values()
            .filter(|m| m.metric_name == metric_name)
            .map(|m| m.value)
            .collect();

        if matching.is_empty() {
            0.0
        } else {
            matching.iter().sum::<f64>() / matching.len() as f64
        }
    }

    pub fn print_status(&self) {
        println!("\n╔════════════════════════════════════════════════════╗");
        println!("║    PERFORMANCE MONITOR (Phase 52)                  ║");
        println!("╚════════════════════════════════════════════════════╝\n");

        println!("📊 METRICS:");
        println!("   Total samples: {}", self.total_samples);

        println!("\n💻 CPU:");
        println!("   Usage: {:.1}%", self.cpu_profile.cpu_usage_percent);
        println!("   Memory: {} MB", self.cpu_profile.memory_usage_mb);

        println!("\n");
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 52: PERFORMANCE MONITOR ===\n");

    let mut monitor = PerformanceMonitor::new("perf_001".to_string());

    println!("--- Recording Metrics ---");
    let metric = PerformanceMetric::new(
        "m_latency".to_string(),
        "latency_ms".to_string(),
        45.5,
        "ms".to_string(),
    );
    monitor.record_metric(metric)?;
    println!("✓ Metrics recorded\n");

    println!("--- Analyzing ---");
    let avg = monitor.get_average("latency_ms");
    println!("✓ Average latency: {:.1}ms\n", avg);

    monitor.print_status();

    println!("✓✓✓ Performance Monitor operational ✓✓✓");
    Ok(())
}
