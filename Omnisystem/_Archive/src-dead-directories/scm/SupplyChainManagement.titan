// SupplyChainManagement.titan - Supply chain management and logistics
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct Supplier {
    pub supplier_id: String,
    pub name: String,
    pub location: String,
    pub rating: f64,
    pub lead_time_days: u32,
}

impl Supplier {
    pub fn new(supplier_id: String, name: String, location: String) -> Self {
        Supplier {
            supplier_id,
            name,
            location,
            rating: 5.0,
            lead_time_days: 7,
        }
    }
}

pub struct Inventory {
    pub inventory_id: String,
    pub sku: String,
    pub quantity_on_hand: u32,
    pub reorder_point: u32,
    pub unit_cost: f64,
}

impl Inventory {
    pub fn new(inventory_id: String, sku: String, reorder_point: u32) -> Self {
        Inventory {
            inventory_id,
            sku,
            quantity_on_hand: reorder_point * 2,
            reorder_point,
            unit_cost: 0.0,
        }
    }

    pub fn is_low_stock(&self) -> bool {
        self.quantity_on_hand <= self.reorder_point
    }

    pub fn adjust_stock(&mut self, delta: i32) {
        self.quantity_on_hand = ((self.quantity_on_hand as i32) + delta).max(0) as u32;
    }
}

pub struct Order {
    pub order_id: String,
    pub supplier_id: String,
    pub quantity: u32,
    pub unit_price: f64,
    pub status: String, // pending, shipped, delivered
    pub ordered_at: u64,
}

impl Order {
    pub fn new(order_id: String, supplier_id: String, quantity: u32) -> Self {
        Order {
            order_id,
            supplier_id,
            quantity,
            unit_price: 0.0,
            status: "pending".to_string(),
            ordered_at: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
        }
    }

    pub fn ship(&mut self) {
        self.status = "shipped".to_string();
    }

    pub fn deliver(&mut self) {
        self.status = "delivered".to_string();
    }

    pub fn get_total_cost(&self) -> f64 {
        self.quantity as f64 * self.unit_price
    }
}

pub struct SupplyChainManagementSystem {
    pub system_id: String,
    pub suppliers: HashMap<String, Supplier>,
    pub inventory: HashMap<String, Inventory>,
    pub orders: HashMap<String, Order>,
    pub total_inventory_value: f64,
}

impl SupplyChainManagementSystem {
    pub fn new(system_id: String) -> Self {
        SupplyChainManagementSystem {
            system_id,
            suppliers: HashMap::new(),
            inventory: HashMap::new(),
            orders: HashMap::new(),
            total_inventory_value: 0.0,
        }
    }

    pub fn register_supplier(&mut self, supplier: Supplier) {
        self.suppliers.insert(supplier.supplier_id.clone(), supplier);
    }

    pub fn add_inventory(&mut self, item: Inventory) {
        self.total_inventory_value += (item.quantity_on_hand as f64) * item.unit_cost;
        self.inventory.insert(item.inventory_id.clone(), item);
    }

    pub fn place_order(&mut self, order: Order) -> Result<String, String> {
        let order_id = order.order_id.clone();
        self.orders.insert(order_id.clone(), order);
        Ok(order_id)
    }

    pub fn get_low_stock_items(&self) -> Vec<String> {
        self.inventory
            .iter()
            .filter(|(_, item)| item.is_low_stock())
            .map(|(id, _)| id.clone())
            .collect()
    }

    pub fn update_order_status(&mut self, order_id: &str, status: String) -> Result<(), String> {
        if let Some(order) = self.orders.get_mut(order_id) {
            order.status = status;
            Ok(())
        } else {
            Err(format!("Order {} not found", order_id))
        }
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 107: SUPPLY CHAIN MANAGEMENT ===\n");
    let mut scm = SupplyChainManagementSystem::new("scm_001".to_string());
    let supplier = Supplier::new("sup_001".to_string(), "Widget Corp".to_string(), "China".to_string());
    scm.register_supplier(supplier);
    let inventory = Inventory::new("inv_001".to_string(), "WIDGET-001".to_string(), 100);
    scm.add_inventory(inventory);
    let order = Order::new("order_001".to_string(), "sup_001".to_string(), 500);
    scm.place_order(order)?;
    println!("✓ Supplier, inventory, and order managed");
    println!("✓ Total inventory value: ${:.2}", scm.total_inventory_value);
    println!("✓✓✓ Supply Chain Management operational ✓✓✓");
    Ok(())
}
