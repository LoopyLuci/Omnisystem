// OceanographyResearchPlatform.vera - Oceanography research and marine monitoring
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct OceanBuoy {
    pub buoy_id: String,
    pub buoy_name: String,
    pub latitude: f64,
    pub longitude: f64,
    pub depth_meters: u32,
    pub status: String, // operational, drifting, offline
}

impl OceanBuoy {
    pub fn new(buoy_id: String, buoy_name: String) -> Self {
        OceanBuoy {
            buoy_id,
            buoy_name,
            latitude: 0.0,
            longitude: 0.0,
            depth_meters: 0,
            status: "operational".to_string(),
        }
    }

    pub fn set_status(&mut self, new_status: String) {
        self.status = new_status;
    }
}

pub struct OceanData {
    pub data_id: String,
    pub buoy_id: String,
    pub timestamp: u64,
    pub temperature_celsius: f64,
    pub salinity_psu: f64,
    pub ph_level: f64,
    pub dissolved_oxygen_ml_l: f64,
    pub wave_height_meters: f64,
}

impl OceanData {
    pub fn new(data_id: String, buoy_id: String) -> Self {
        OceanData {
            data_id,
            buoy_id,
            timestamp: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
            temperature_celsius: 15.0,
            salinity_psu: 35.0,
            ph_level: 8.1,
            dissolved_oxygen_ml_l: 6.0,
            wave_height_meters: 1.5,
        }
    }
}

pub struct MarineSpecies {
    pub species_id: String,
    pub common_name: String,
    pub scientific_name: String,
    pub habitat: String,
    pub population_estimate: u32,
    pub conservation_status: String, // least_concern, vulnerable, endangered, critically_endangered
}

impl MarineSpecies {
    pub fn new(species_id: String, common_name: String, scientific_name: String) -> Self {
        MarineSpecies {
            species_id,
            common_name,
            scientific_name,
            habitat: String::new(),
            population_estimate: 0,
            conservation_status: "least_concern".to_string(),
        }
    }

    pub fn set_conservation_status(&mut self, status: String) {
        self.conservation_status = status;
    }
}

pub struct CoralReefMonitoring {
    pub monitoring_id: String,
    pub reef_name: String,
    pub location: String,
    pub last_survey: u64,
    pub bleaching_percent: f64,
    pub coral_coverage_percent: f64,
    pub fish_diversity_index: f64,
}

impl CoralReefMonitoring {
    pub fn new(monitoring_id: String, reef_name: String) -> Self {
        CoralReefMonitoring {
            monitoring_id,
            reef_name,
            location: String::new(),
            last_survey: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
            bleaching_percent: 0.0,
            coral_coverage_percent: 80.0,
            fish_diversity_index: 0.0,
        }
    }

    pub fn update_survey(&mut self, bleaching: f64, coverage: f64) {
        self.bleaching_percent = bleaching;
        self.coral_coverage_percent = coverage;
        self.last_survey = std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .unwrap()
            .as_secs();
    }
}

pub struct OceanographyResearchPlatformSystem {
    pub system_id: String,
    pub buoys: HashMap<String, OceanBuoy>,
    pub ocean_data: HashMap<String, OceanData>,
    pub species: HashMap<String, MarineSpecies>,
    pub coral_monitoring: HashMap<String, CoralReefMonitoring>,
}

impl OceanographyResearchPlatformSystem {
    pub fn new(system_id: String) -> Self {
        OceanographyResearchPlatformSystem {
            system_id,
            buoys: HashMap::new(),
            ocean_data: HashMap::new(),
            species: HashMap::new(),
            coral_monitoring: HashMap::new(),
        }
    }

    pub fn deploy_buoy(&mut self, buoy: OceanBuoy) {
        self.buoys.insert(buoy.buoy_id.clone(), buoy);
    }

    pub fn record_data(&mut self, data: OceanData) {
        self.ocean_data.insert(data.data_id.clone(), data);
    }

    pub fn track_species(&mut self, species: MarineSpecies) {
        self.species.insert(species.species_id.clone(), species);
    }

    pub fn monitor_reef(&mut self, monitoring: CoralReefMonitoring) {
        self.coral_monitoring.insert(monitoring.monitoring_id.clone(), monitoring);
    }

    pub fn get_operational_buoys(&self) -> u32 {
        self.buoys
            .iter()
            .filter(|(_, b)| b.status == "operational")
            .count() as u32
    }

    pub fn get_endangered_species(&self) -> u32 {
        self.species
            .iter()
            .filter(|(_, s)| s.conservation_status == "endangered" || s.conservation_status == "critically_endangered")
            .count() as u32
    }

    pub fn get_bleached_reefs(&self) -> u32 {
        self.coral_monitoring
            .iter()
            .filter(|(_, c)| c.bleaching_percent > 30.0)
            .count() as u32
    }

    pub fn get_average_ocean_temperature(&self) -> f64 {
        if self.ocean_data.is_empty() {
            0.0
        } else {
            let total: f64 = self.ocean_data
                .iter()
                .map(|(_, d)| d.temperature_celsius)
                .sum();
            total / self.ocean_data.len() as f64
        }
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 134: OCEANOGRAPHY RESEARCH PLATFORM ===\n");
    let mut orps = OceanographyResearchPlatformSystem::new("orps_001".to_string());
    let buoy = OceanBuoy::new("buoy_001".to_string(), "Pacific Monitor".to_string());
    orps.deploy_buoy(buoy);
    let data = OceanData::new("data_001".to_string(), "buoy_001".to_string());
    orps.record_data(data);
    let species = MarineSpecies::new("sp_001".to_string(), "Sea Turtle".to_string(), "Chelonia mydas".to_string());
    orps.track_species(species);
    let reef = CoralReefMonitoring::new("reef_001".to_string(), "Great Barrier Reef".to_string());
    orps.monitor_reef(reef);
    println!("✓ Buoy, data, species, and reef monitoring recorded");
    println!("✓ Operational buoys: {}", orps.get_operational_buoys());
    println!("✓✓✓ Oceanography Research Platform operational ✓✓✓");
    Ok(())
}
