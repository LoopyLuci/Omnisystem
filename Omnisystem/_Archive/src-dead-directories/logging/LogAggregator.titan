// LogAggregator.titan - Log aggregation and centralized logging
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct LogEntry {
    pub entry_id: String,
    pub source: String,
    pub level: String,
    pub message: String,
    pub timestamp: u64,
    pub context: HashMap<String, String>,
}

impl LogEntry {
    pub fn new(entry_id: String, source: String, level: String, message: String) -> Self {
        LogEntry {
            entry_id,
            source,
            level,
            message,
            timestamp: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
            context: HashMap::new(),
        }
    }
}

pub struct LogBuffer {
    pub buffer_id: String,
    pub entries: Vec<LogEntry>,
    pub max_entries: usize,
}

impl LogBuffer {
    pub fn new(buffer_id: String, max_entries: usize) -> Self {
        LogBuffer {
            buffer_id,
            entries: Vec::new(),
            max_entries,
        }
    }

    pub fn add_entry(&mut self, entry: LogEntry) {
        if self.entries.len() >= self.max_entries {
            self.entries.remove(0);
        }
        self.entries.push(entry);
    }
}

pub struct LogAggregator {
    pub aggregator_id: String,
    pub buffers: HashMap<String, LogBuffer>,
    pub total_logs: u32,
}

impl LogAggregator {
    pub fn new(aggregator_id: String) -> Self {
        LogAggregator {
            aggregator_id,
            buffers: HashMap::new(),
            total_logs: 0,
        }
    }

    pub fn register_source(&mut self, source: String) {
        let buffer = LogBuffer::new(format!("buf_{}", source), 10000);
        self.buffers.insert(source, buffer);
    }

    pub fn log(&mut self, source: String, level: String, message: String) -> Result<(), String> {
        if let Some(buffer) = self.buffers.get_mut(&source) {
            let entry = LogEntry::new(
                format!("log_{}", self.total_logs),
                source,
                level,
                message,
            );
            buffer.add_entry(entry);
            self.total_logs += 1;
            Ok(())
        } else {
            Err(format!("Source {} not registered", source))
        }
    }

    pub fn get_logs_by_level(&self, source: &str, level: &str) -> Vec<String> {
        let mut results = Vec::new();
        if let Some(buffer) = self.buffers.get(source) {
            for entry in &buffer.entries {
                if entry.level == level {
                    results.push(entry.message.clone());
                }
            }
        }
        results
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 65: LOG AGGREGATOR ===\n");
    let mut agg = LogAggregator::new("agg_001".to_string());
    agg.register_source("app".to_string());
    agg.log("app".to_string(), "INFO".to_string(), "Application started".to_string())?;
    agg.log("app".to_string(), "ERROR".to_string(), "Error occurred".to_string())?;
    let errors = agg.get_logs_by_level("app", "ERROR");
    println!("✓ Logged {} messages, {} errors", agg.total_logs, errors.len());
    println!("✓✓✓ Log Aggregator operational ✓✓✓");
    Ok(())
}
