// DataLossPrevention.vera - Data loss prevention and protection
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct DataClassification {
    pub classification_id: String,
    pub data_identifier: String,
    pub classification_level: String, // public, internal, confidential, restricted
    pub description: String,
    pub auto_detect: bool,
    pub created_at: u64,
}

impl DataClassification {
    pub fn new(classification_id: String, identifier: String, level: String) -> Self {
        DataClassification {
            classification_id,
            data_identifier: identifier,
            classification_level: level,
            description: String::new(),
            auto_detect: true,
            created_at: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
        }
    }
}

pub struct SensitiveDataPattern {
    pub pattern_id: String,
    pub pattern_name: String,
    pub pattern_type: String, // regex, keyword, fingerprint, hash
    pub pattern_string: String,
    pub detection_count: u32,
    pub match_threshold: f64, // 0.0 to 1.0
}

impl SensitiveDataPattern {
    pub fn new(pattern_id: String, pattern_name: String) -> Self {
        SensitiveDataPattern {
            pattern_id,
            pattern_name,
            pattern_type: "regex".to_string(),
            pattern_string: String::new(),
            detection_count: 0,
            match_threshold: 0.95,
        }
    }

    pub fn record_detection(&mut self) {
        self.detection_count += 1;
    }
}

pub struct DataTransferEvent {
    pub event_id: String,
    pub timestamp: u64,
    pub user_id: String,
    pub source: String,
    pub destination: String,
    pub transfer_type: String, // email, upload, download, print, clipboard
    pub data_classification: String,
    pub file_count: u32,
    pub size_mb: f64,
    pub flagged: bool,
}

impl DataTransferEvent {
    pub fn new(event_id: String, user_id: String, source: String, dest: String) -> Self {
        DataTransferEvent {
            event_id,
            timestamp: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
            user_id,
            source,
            destination: dest,
            transfer_type: "upload".to_string(),
            data_classification: "internal".to_string(),
            file_count: 0,
            size_mb: 0.0,
            flagged: false,
        }
    }

    pub fn flag_suspicious(&mut self) {
        self.flagged = true;
    }
}

pub struct DLPPolicy {
    pub policy_id: String,
    pub policy_name: String,
    pub protected_data_types: Vec<String>, // pii, credentials, intellectual_property, financial
    pub enforcement_level: String, // audit, alert, block
    pub destinations_blocked: Vec<String>, // email, cloud, removable_media
    pub enabled: bool,
    pub violations_count: u32,
}

impl DLPPolicy {
    pub fn new(policy_id: String, policy_name: String) -> Self {
        DLPPolicy {
            policy_id,
            policy_name,
            protected_data_types: Vec::new(),
            enforcement_level: "alert".to_string(),
            destinations_blocked: Vec::new(),
            enabled: true,
            violations_count: 0,
        }
    }

    pub fn add_protected_type(&mut self, data_type: String) {
        if !self.protected_data_types.contains(&data_type) {
            self.protected_data_types.push(data_type);
        }
    }

    pub fn block_destination(&mut self, destination: String) {
        if !self.destinations_blocked.contains(&destination) {
            self.destinations_blocked.push(destination);
        }
    }

    pub fn record_violation(&mut self) {
        self.violations_count += 1;
    }
}

pub struct IncidentResponse {
    pub response_id: String,
    pub event_id: String,
    pub action_taken: String, // quarantined, deleted, notified_user, escalated
    pub response_time_seconds: u32,
    pub escalated: bool,
}

impl IncidentResponse {
    pub fn new(response_id: String, event_id: String) -> Self {
        IncidentResponse {
            response_id,
            event_id,
            action_taken: String::new(),
            response_time_seconds: 0,
            escalated: false,
        }
    }

    pub fn escalate(&mut self) {
        self.escalated = true;
    }
}

pub struct DataLossPreventionSystem {
    pub system_id: String,
    pub classifications: HashMap<String, DataClassification>,
    pub patterns: HashMap<String, SensitiveDataPattern>,
    pub transfer_events: HashMap<String, DataTransferEvent>,
    pub policies: HashMap<String, DLPPolicy>,
    pub responses: HashMap<String, IncidentResponse>,
}

impl DataLossPreventionSystem {
    pub fn new(system_id: String) -> Self {
        DataLossPreventionSystem {
            system_id,
            classifications: HashMap::new(),
            patterns: HashMap::new(),
            transfer_events: HashMap::new(),
            policies: HashMap::new(),
            responses: HashMap::new(),
        }
    }

    pub fn create_classification(&mut self, classification: DataClassification) {
        self.classifications.insert(classification.classification_id.clone(), classification);
    }

    pub fn define_pattern(&mut self, pattern: SensitiveDataPattern) {
        self.patterns.insert(pattern.pattern_id.clone(), pattern);
    }

    pub fn log_transfer(&mut self, event: DataTransferEvent) {
        self.transfer_events.insert(event.event_id.clone(), event);
    }

    pub fn create_policy(&mut self, policy: DLPPolicy) {
        self.policies.insert(policy.policy_id.clone(), policy);
    }

    pub fn respond_to_incident(&mut self, response: IncidentResponse) {
        self.responses.insert(response.response_id.clone(), response);
    }

    pub fn get_flagged_transfers(&self) -> u32 {
        self.transfer_events
            .iter()
            .filter(|(_, e)| e.flagged)
            .count() as u32
    }

    pub fn get_enabled_policies(&self) -> u32 {
        self.policies
            .iter()
            .filter(|(_, p)| p.enabled)
            .count() as u32
    }

    pub fn get_total_violations(&self) -> u32 {
        self.policies
            .iter()
            .map(|(_, p)| p.violations_count)
            .sum()
    }

    pub fn get_escalated_responses(&self) -> u32 {
        self.responses
            .iter()
            .filter(|(_, r)| r.escalated)
            .count() as u32
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 151: DATA LOSS PREVENTION ===\n");
    let mut dlps = DataLossPreventionSystem::new("dlps_001".to_string());
    let classification = DataClassification::new("class_001".to_string(), "credit_card".to_string(), "restricted".to_string());
    dlps.create_classification(classification);
    let pattern = SensitiveDataPattern::new("pat_001".to_string(), "PII Detector".to_string());
    dlps.define_pattern(pattern);
    let transfer = DataTransferEvent::new("event_001".to_string(), "user_001".to_string(), "workstation".to_string(), "personal_email".to_string());
    dlps.log_transfer(transfer);
    let policy = DLPPolicy::new("pol_001".to_string(), "Protect Confidential Data".to_string());
    dlps.create_policy(policy);
    let response = IncidentResponse::new("resp_001".to_string(), "event_001".to_string());
    dlps.respond_to_incident(response);
    println!("✓ Classification, pattern, transfer, policy, and response recorded");
    println!("✓ Enabled policies: {}", dlps.get_enabled_policies());
    println!("✓✓✓ Data Loss Prevention operational ✓✓✓");
    Ok(())
}
