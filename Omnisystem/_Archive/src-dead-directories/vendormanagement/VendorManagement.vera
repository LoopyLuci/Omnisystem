// VendorManagement.vera - Vendor and third-party management
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct Vendor {
    pub vendor_id: String,
    pub name: String,
    pub category: String,
    pub location: String,
    pub rating: f64,
    pub active: bool,
}

impl Vendor {
    pub fn new(vendor_id: String, name: String, category: String) -> Self {
        Vendor {
            vendor_id,
            name,
            category,
            location: String::new(),
            rating: 5.0,
            active: true,
        }
    }

    pub fn deactivate(&mut self) {
        self.active = false;
    }

    pub fn update_rating(&mut self, new_rating: f64) {
        self.rating = new_rating.clamp(0.0, 5.0);
    }
}

pub struct VendorPerformanceMetric {
    pub metric_id: String,
    pub vendor_id: String,
    pub on_time_delivery: f64, // percentage
    pub quality_score: f64,
    pub responsiveness: f64,
    pub evaluation_date: u64,
}

impl VendorPerformanceMetric {
    pub fn new(metric_id: String, vendor_id: String) -> Self {
        VendorPerformanceMetric {
            metric_id,
            vendor_id,
            on_time_delivery: 0.0,
            quality_score: 0.0,
            responsiveness: 0.0,
            evaluation_date: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
        }
    }

    pub fn get_overall_score(&self) -> f64 {
        (self.on_time_delivery + self.quality_score + self.responsiveness) / 3.0
    }
}

pub struct VendorRiskAssessment {
    pub assessment_id: String,
    pub vendor_id: String,
    pub financial_health: f64, // 1-5
    pub operational_risk: f64, // 1-5
    pub compliance_status: String,
    pub assessment_date: u64,
}

impl VendorRiskAssessment {
    pub fn new(assessment_id: String, vendor_id: String) -> Self {
        VendorRiskAssessment {
            assessment_id,
            vendor_id,
            financial_health: 3.0,
            operational_risk: 3.0,
            compliance_status: "compliant".to_string(),
            assessment_date: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
        }
    }

    pub fn get_risk_level(&self) -> String {
        let avg_risk = (self.financial_health + self.operational_risk) / 2.0;
        if avg_risk < 2.0 {
            "Low".to_string()
        } else if avg_risk < 3.5 {
            "Medium".to_string()
        } else {
            "High".to_string()
        }
    }
}

pub struct VendorManagementSystem {
    pub system_id: String,
    pub vendors: HashMap<String, Vendor>,
    pub performance_metrics: HashMap<String, VendorPerformanceMetric>,
    pub risk_assessments: HashMap<String, VendorRiskAssessment>,
    pub total_vendors: u32,
}

impl VendorManagementSystem {
    pub fn new(system_id: String) -> Self {
        VendorManagementSystem {
            system_id,
            vendors: HashMap::new(),
            performance_metrics: HashMap::new(),
            risk_assessments: HashMap::new(),
            total_vendors: 0,
        }
    }

    pub fn onboard_vendor(&mut self, vendor: Vendor) -> Result<String, String> {
        let vendor_id = vendor.vendor_id.clone();
        self.vendors.insert(vendor_id.clone(), vendor);
        self.total_vendors += 1;
        Ok(vendor_id)
    }

    pub fn record_performance(&mut self, metric: VendorPerformanceMetric) {
        self.performance_metrics.insert(metric.metric_id.clone(), metric);
    }

    pub fn assess_risk(&mut self, assessment: VendorRiskAssessment) {
        self.risk_assessments.insert(assessment.assessment_id.clone(), assessment);
    }

    pub fn get_active_vendors(&self) -> u32 {
        self.vendors
            .iter()
            .filter(|(_, v)| v.active)
            .count() as u32
    }

    pub fn get_average_vendor_rating(&self) -> f64 {
        if self.vendors.is_empty() {
            0.0
        } else {
            let total: f64 = self.vendors.iter().map(|(_, v)| v.rating).sum();
            total / self.vendors.len() as f64
        }
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 112: VENDOR MANAGEMENT ===\n");
    let mut vms = VendorManagementSystem::new("vms_001".to_string());
    let vendor = Vendor::new("vendor_001".to_string(), "Tech Solutions Inc".to_string(), "Software".to_string());
    vms.onboard_vendor(vendor)?;
    let mut metric = VendorPerformanceMetric::new("metric_001".to_string(), "vendor_001".to_string());
    metric.on_time_delivery = 95.0;
    metric.quality_score = 4.5;
    vms.record_performance(metric);
    println!("✓ Vendor onboarded and evaluated");
    println!("✓ Active vendors: {}", vms.get_active_vendors());
    println!("✓ Average rating: {:.1}", vms.get_average_vendor_rating());
    println!("✓✓✓ Vendor Management operational ✓✓✓");
    Ok(())
}
