// ObservabilitySystem.titan - Phase 36: Monitoring, logging, tracing, metrics

use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub enum LogLevel {
    Debug,
    Info,
    Warning,
    Error,
    Critical,
}

pub struct LogEntry {
    pub entry_id: String,
    pub timestamp: u64,
    pub level: LogLevel,
    pub component: String,
    pub message: String,
}

impl LogEntry {
    pub fn new(level: LogLevel, component: String, message: String) -> Self {
        LogEntry {
            entry_id: format!("log_{}", std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs()),
            timestamp: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
            level,
            component,
            message,
        }
    }

    pub fn level_name(&self) -> &str {
        match self.level {
            LogLevel::Debug => "DEBUG",
            LogLevel::Info => "INFO",
            LogLevel::Warning => "WARN",
            LogLevel::Error => "ERROR",
            LogLevel::Critical => "CRITICAL",
        }
    }
}

pub struct Metric {
    pub metric_id: String,
    pub metric_name: String,
    pub value: f64,
    pub unit: String,
}

impl Metric {
    pub fn new(metric_name: String, value: f64, unit: String) -> Self {
        Metric {
            metric_id: format!("metric_{}", metric_name),
            metric_name,
            value,
            unit,
        }
    }
}

pub struct Alert {
    pub alert_id: String,
    pub alert_name: String,
    pub severity: String,
    pub threshold: f64,
    pub current_value: f64,
    pub is_triggered: bool,
}

impl Alert {
    pub fn new(alert_name: String, severity: String, threshold: f64) -> Self {
        Alert {
            alert_id: format!("alert_{}", alert_name),
            alert_name,
            severity,
            threshold,
            current_value: 0.0,
            is_triggered: false,
        }
    }

    pub fn check(&mut self, value: f64) -> bool {
        self.current_value = value;
        self.is_triggered = value > self.threshold;
        self.is_triggered
    }
}

pub struct ObservabilitySystem {
    pub system_id: String,
    pub logs: Vec<LogEntry>,
    pub metrics: HashMap<String, Metric>,
    pub alerts: HashMap<String, Alert>,
    pub total_log_entries: u32,
}

impl ObservabilitySystem {
    pub fn new(system_id: String) -> Self {
        ObservabilitySystem {
            system_id,
            logs: vec![],
            metrics: HashMap::new(),
            alerts: HashMap::new(),
            total_log_entries: 0,
        }
    }

    pub fn log(&mut self, level: LogLevel, component: String, message: String) {
        let entry = LogEntry::new(level, component, message);
        self.logs.push(entry);
        self.total_log_entries += 1;
    }

    pub fn record_metric(&mut self, metric: Metric) {
        self.metrics.insert(metric.metric_name.clone(), metric);
    }

    pub fn register_alert(&mut self, alert: Alert) {
        self.alerts.insert(alert.alert_id.clone(), alert);
    }

    pub fn check_alerts(&mut self, metric_name: &str, value: f64) -> Vec<String> {
        let mut triggered_alerts = vec![];
        for (_, alert) in &mut self.alerts {
            if alert.alert_name == metric_name && alert.check(value) {
                triggered_alerts.push(alert.alert_id.clone());
            }
        }
        triggered_alerts
    }

    pub fn print_status(&self) {
        println!("\n╔════════════════════════════════════════════════════╗");
        println!("║      OBSERVABILITY SYSTEM (Phase 36)               ║");
        println!("╚════════════════════════════════════════════════════╝\n");

        println!("📝 LOGGING:");
        println!("   Total entries: {}", self.total_log_entries);

        println!("\n📊 METRICS:");
        println!("   Tracked: {}", self.metrics.len());

        println!("\n🚨 ALERTS:");
        println!("   Registered: {}", self.alerts.len());

        println!("\n");
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 36: OBSERVABILITY SYSTEM ===\n");

    let mut system = ObservabilitySystem::new("obs_001".to_string());

    println!("--- Logging ---");
    system.log(LogLevel::Info, "kernel".to_string(), "System started".to_string());
    system.log(LogLevel::Warning, "memory".to_string(), "Memory usage at 75%".to_string());
    println!("✓ Logs recorded\n");

    println!("--- Metrics ---");
    system.record_metric(Metric::new("cpu_usage".to_string(), 65.5, "%".to_string()));
    system.record_metric(Metric::new("memory_usage".to_string(), 75.2, "%".to_string()));
    println!("✓ Metrics recorded\n");

    println!("--- Alerts ---");
    let alert = Alert::new("high_cpu".to_string(), "critical".to_string(), 80.0);
    system.register_alert(alert);
    system.check_alerts("high_cpu", 85.5);
    println!("✓ Alerts configured\n");

    system.print_status();

    println!("✓✓✓ Observability System operational ✓✓✓");
    Ok(())
}
