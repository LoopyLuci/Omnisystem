        transport.enable_tls();
        assert!(transport.open_connection().is_ok());
    }

    #[test]
    fn test_p2p_network() {
        let mut network = P2PNetwork::new("node_1".to_string());
        let peer = PeerInfo {
            peer_id: "peer_1".to_string(),
            address: "127.0.0.1".to_string(),
            port: 9001,
            reputation: 0.95,
            last_seen: 0,
            latency_ms: 5.0,
            bandwidth_mbps: 100.0,
            is_online: true,
        };

        assert!(network.add_peer(peer).is_ok());
    }

    #[test]
    fn test_message_queue() {
        let mut queue = MessageQueue::new("queue_1".to_string());
        let message = Message::new("node_a".to_string(), "node_b".to_string(), "Hello".to_string());
        assert!(queue.enqueue(message).is_ok());
    }

