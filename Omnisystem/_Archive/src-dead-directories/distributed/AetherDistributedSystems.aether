            }
        }

        pub fn create_session(&mut self, user_id: string, desktop_id: string) -> Result<string, string> {
            let session = RemoteDesktopSession {
                session_id: format!("rds_{}", std::time::now()),
                user_id,
                desktop_id,
                resolution_width: 1920,
                resolution_height: 1080,
                color_depth_bits: 32,
                compression_level: 6,
                is_active: true,
                connected_since: std::time::now(),
            };

            let session_id = session.session_id.clone();
            self.sessions.insert(session_id.clone(), session);
            println!("✅ Remote desktop session created: {}", session_id);
            Ok(session_id)
        }

        pub fn queue_input(&mut self, event: InputEvent) -> Result<(), string> {
            self.input_handler.input_queue.push(event);
            println!("🖱️  Input event queued (queue size: {})", self.input_handler.input_queue.len());
            Ok(())
        }

        pub fn process_input(&mut self) -> Option<InputEvent> {
            if !self.input_handler.input_queue.is_empty() {
                let event = self.input_handler.input_queue.remove(0);
                println!("⌨️  Processing input event: {}", event.event_type);
                Some(event)
            } else {
                None
            }
        }

        pub fn get_session_stats(&self) -> (i32, i32, f64) {
            let active_sessions = self.sessions.values().filter(|s| s.is_active).count() as i32;
            let total_sessions = self.sessions.len() as i32;
            let avg_bandwidth = if !self.stream_manager.streams.is_empty() {
                self.stream_manager.streams.values().map(|s| s.bitrate_mbps).sum::<f64>() / self.stream_manager.streams.len() as f64
            } else {
                0.0
            };

            (active_sessions, total_sessions, avg_bandwidth)
        }
    }

