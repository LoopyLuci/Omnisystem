                system_id: format!("rds_{}", std::time::now()),
                sessions: map::new(),
                stream_manager: StreamManager {
                    streams: map::new(),
                    bandwidth_limit_mbps: 100.0,
                    buffer_size_bytes: 65536,
                },
                input_handler: InputHandler {
                    input_queue: vector::new(),
                    mouse_position_x: 0,
                    mouse_position_y: 0,
