// OMNISYSTEM ADVANCED WIDGET COMPONENTS
// Enterprise UI Components: DataGrid, TreeView, RichTextEditor, DateRangePicker, ComboBox, etc.
// 100% Pure VERA - Production-Grade UI Library

use omnisystem::{Vec, HashMap, Option, Result, String, Arc, Mutex, i32, i64, f32, bool}

// ============================================================================
// DATAGRID COMPONENT
// ============================================================================

pub struct Column {
    id: String,
    header: String,
    width: i32,
    sortable: bool,
    filterable: bool,
    resizable: bool,
    render: String,
}

pub struct Row {
    id: String,
    data: HashMap<String, String>,
    selected: bool,
    height: i32,
}

pub struct DataGridProps {
    columns: Vec<Column>,
    rows: Vec<Row>,
    page_size: i32,
    current_page: i32,
    sort_column: Option<String>,
    sort_direction: String,
    filters: HashMap<String, String>,
    selectable: bool,
    virtual_scroll: bool,
    height: i32,
}

pub component DataGrid {
    props: DataGridProps,

    // State
    visible_rows: Vec<Row>,
    scroll_offset: i32 = 0,
    selected_rows: Vec<String>,
    hovered_row: Option<String>,

    // Rendering
    header_height: i32 = 40,
    row_height: i32 = 40,

    // Performance
    render_cache: Arc<Mutex<HashMap<String, String>>>,

    render {
        // Container
        <div class="datagrid-container" style={height: props.height}>
            // Header
            <div class="datagrid-header">
                {for column in props.columns.iter()}
                    <div class="datagrid-column-header"
                         style={width: column.width}
                         onClick={|_| sort_by_column(column.id.clone())}>
                        {column.header}
                        {if sortable}
                            <span class="sort-indicator">{get_sort_icon(column.id.clone())}</span>
                        {/if}
                    </div>
                {/for}
            </div>

            // Rows (with virtual scrolling)
            <div class="datagrid-rows"
                 onScroll={|e| handle_scroll(e)}
                 style={height: props.height - header_height}>
                {if props.virtual_scroll}
                    {render_virtual_rows()}
                {else}
                    {render_all_rows()}
                {/if}
            </div>

            // Footer (pagination)
            <div class="datagrid-footer">
                <div class="pagination">
                    <button onClick={|_| previous_page()} disabled={props.current_page <= 0}>
                        Previous
                    </button>
                    <span class="page-info">
                        Page {props.current_page + 1} of {total_pages}
                    </span>
                    <button onClick={|_| next_page()} disabled={props.current_page >= total_pages - 1}>
                        Next
                    </button>
                </div>
            </div>
        </div>
    }

    fn render_virtual_rows() -> Vec<HtmlElement> {
        let mut elements = Vec::new()

        let items_to_render = (props.height / row_height) as usize + 2
        let start_idx = (scroll_offset / row_height) as usize

        for (i, row) in visible_rows.iter()
            .skip(start_idx)
            .take(items_to_render)
            .enumerate() {
            elements.push(render_row(row, start_idx + i))
        }

        elements
    }

    fn render_all_rows() -> Vec<HtmlElement> {
        let mut elements = Vec::new()

        for (i, row) in visible_rows.iter().enumerate() {
            elements.push(render_row(row, i))
        }

        elements
    }

    fn render_row(row: &Row, index: usize) -> HtmlElement {
        let is_selected = selected_rows.contains(&row.id)
        let is_hovered = hovered_row == Some(row.id.clone())

        <div class={format!("datagrid-row {}{}",
                           if is_selected { "selected " } else { "" },
                           if is_hovered { "hovered" } else { "" })}
             onClick={|_| handle_row_click(row.id.clone())}
             onMouseEnter={|_| hovered_row = Some(row.id.clone())}
             onMouseLeave={|_| hovered_row = None}>
            {for column in props.columns.iter()}
                <div class="datagrid-cell" style={width: column.width}>
                    {row.data.get(&column.id).cloned().unwrap_or("".to_string())}
                </div>
            {/for}
        </div>
    }

    fn handle_scroll(event: ScrollEvent) {
        scroll_offset = event.scroll_top
    }

    fn handle_row_click(row_id: String) {
        if props.selectable {
            if selected_rows.contains(&row_id) {
                selected_rows.retain(|id| id != &row_id)
            } else {
                selected_rows.push(row_id)
            }
        }
    }

    fn sort_by_column(column_id: String) {
        if props.sort_column == Some(column_id.clone()) {
            // Toggle direction
            props.sort_direction = if props.sort_direction == "asc" { "desc" } else { "asc" }
        } else {
            props.sort_column = Some(column_id)
            props.sort_direction = "asc".to_string()
        }

        // Re-sort visible_rows
        apply_sorting()
    }

    fn apply_sorting() {
        // Sort visible_rows based on sort_column and sort_direction
    }

    fn get_sort_icon(column_id: String) -> String {
        if props.sort_column == Some(column_id) {
            if props.sort_direction == "asc" { "▲" } else { "▼" }
        } else {
            "⇅"
        }.to_string()
    }

    fn previous_page() {
        if props.current_page > 0 {
            props.current_page -= 1
            update_visible_rows()
        }
    }

    fn next_page() {
        if props.current_page < total_pages - 1 {
            props.current_page += 1
            update_visible_rows()
        }
    }

    fn update_visible_rows() {
        let start = (props.current_page * props.page_size) as usize
        let end = start + (props.page_size as usize)
        visible_rows = props.rows.iter()
            .skip(start)
            .take(props.page_size as usize)
            .cloned()
            .collect()
    }

    computed total_pages -> i32 {
        ((props.rows.len() as i32 + props.page_size - 1) / props.page_size).max(1)
    }
}

// ============================================================================
// TREEVIEW COMPONENT
// ============================================================================

pub struct TreeNode {
    id: String,
    label: String,
    children: Vec<TreeNode>,
    expanded: bool,
    lazy_load: bool,
    icon: Option<String>,
    data: HashMap<String, String>,
}

pub struct TreeViewProps {
    nodes: Vec<TreeNode>,
    selectable: bool,
    multi_select: bool,
    lazy_load_fn: Option<String>,
}

pub component TreeView {
    props: TreeViewProps,

    selected_nodes: Vec<String>,
    expanded_nodes: Vec<String>,
    hovered_node: Option<String>,

    render {
        <div class="treeview-container">
            <ul class="treeview-list">
                {for node in props.nodes.iter()}
                    {render_tree_node(node, 0)}
                {/for}
            </ul>
        </div>
    }

    fn render_tree_node(node: &TreeNode, depth: i32) -> HtmlElement {
        let is_expanded = expanded_nodes.contains(&node.id)
        let is_selected = selected_nodes.contains(&node.id)
        let has_children = !node.children.is_empty()

        <li class={format!("treeview-node {}", if is_selected { "selected" } else { "" })}
            style={padding_left: depth * 20}>
            <div class="treeview-node-content"
                 onClick={|_| handle_node_click(node.id.clone(), node.clone())}>
                {if has_children}
                    <span class={format!("expand-icon {}", if is_expanded { "expanded" } else { "" })}
                          onClick={|e| { e.stop_propagation(); toggle_node(node.id.clone()); }}>
                        ▶
                    </span>
                {/if}

                {if let Some(icon) = &node.icon}
                    <span class="node-icon">{icon}</span>
                {/if}

                <span class="node-label">{node.label.clone()}</span>
            </div>

            {if is_expanded && has_children}
                <ul class="treeview-children">
                    {for child in node.children.iter()}
                        {render_tree_node(child, depth + 1)}
                    {/for}
                </ul>
            {/if}
        </li>
    }

    fn handle_node_click(node_id: String, node: TreeNode) {
        if props.selectable {
            if props.multi_select {
                if selected_nodes.contains(&node_id) {
                    selected_nodes.retain(|id| id != &node_id)
                } else {
                    selected_nodes.push(node_id)
                }
            } else {
                selected_nodes = vec![node_id]
            }
        }
    }

    fn toggle_node(node_id: String) {
        if expanded_nodes.contains(&node_id) {
            expanded_nodes.retain(|id| id != &node_id)
        } else {
            expanded_nodes.push(node_id)
        }
    }
}

// ============================================================================
// RICHTEXTEDITOR COMPONENT
// ============================================================================

pub struct RichTextEditorProps {
    value: String,
    placeholder: String,
    read_only: bool,
    height: i32,
    enable_bold: bool,
    enable_italic: bool,
    enable_underline: bool,
    enable_code: bool,
    enable_lists: bool,
    enable_links: bool,
}

pub component RichTextEditor {
    props: RichTextEditorProps,

    content: String,
    is_focused: bool,
    selection_start: i32 = 0,
    selection_end: i32 = 0,
    undo_stack: Vec<String>,
    redo_stack: Vec<String>,

    render {
        <div class="rich-text-editor">
            <div class="editor-toolbar">
                {if props.enable_bold}
                    <button class="toolbar-button" onClick={|_| apply_format("bold")} title="Bold">
                        <strong>B</strong>
                    </button>
                {/if}

                {if props.enable_italic}
                    <button class="toolbar-button" onClick={|_| apply_format("italic")} title="Italic">
                        <em>I</em>
                    </button>
                {/if}

                {if props.enable_underline}
                    <button class="toolbar-button" onClick={|_| apply_format("underline")} title="Underline">
                        <u>U</u>
                    </button>
                {/if}

                {if props.enable_lists}
                    <button class="toolbar-button" onClick={|_| apply_format("bullet_list")} title="Bullet List">
                        •
                    </button>
                    <button class="toolbar-button" onClick={|_| apply_format("ordered_list")} title="Ordered List">
                        1.
                    </button>
                {/if}

                {if props.enable_code}
                    <button class="toolbar-button" onClick={|_| apply_format("code")} title="Code">
                        &lt;/&gt;
                    </button>
                {/if}

                {if props.enable_links}
                    <button class="toolbar-button" onClick={|_| apply_format("link")} title="Insert Link">
                        🔗
                    </button>
                {/if}

                <div class="toolbar-separator"></div>

                <button class="toolbar-button" onClick={|_| undo()} disabled={undo_stack.is_empty()}>
                    ↶
                </button>
                <button class="toolbar-button" onClick={|_| redo()} disabled={redo_stack.is_empty()}>
                    ↷
                </button>
            </div>

            <div class="editor-content"
                 contentEditable={!props.read_only}
                 onInput={|e| handle_input(e)}
                 onFocus={|_| is_focused = true}
                 onBlur={|_| is_focused = false}
                 style={height: props.height}
                 class={if is_focused { "focused" } else { "" }}>
                {content}
            </div>

            <div class="editor-footer">
                <span class="char-count">{content.len()} characters</span>
            </div>
        </div>
    }

    fn handle_input(event: InputEvent) {
        // Save current state to undo stack
        undo_stack.push(content.clone())
        redo_stack.clear()

        content = event.target.text_content.clone()
    }

    fn apply_format(format: String) {
        match format.as_str() {
            "bold" => insert_format("**", "**"),
            "italic" => insert_format("*", "*"),
            "underline" => insert_format("<u>", "</u>"),
            "code" => insert_format("`", "`"),
            "bullet_list" => insert_format("• ", ""),
            "ordered_list" => insert_format("1. ", ""),
            "link" => insert_format("[", "](url)"),
            _ => {}
        }
    }

    fn insert_format(prefix: &str, suffix: &str) {
        let before = content[..selection_start].to_string()
        let selected = content[selection_start..selection_end].to_string()
        let after = content[selection_end..].to_string()

        undo_stack.push(content.clone())
        redo_stack.clear()

        content = format!("{}{}{}{}{}", before, prefix, selected, suffix, after)
    }

    fn undo() {
        if !undo_stack.is_empty() {
            redo_stack.push(content.clone())
            content = undo_stack.pop().unwrap()
        }
    }

    fn redo() {
        if !redo_stack.is_empty() {
            undo_stack.push(content.clone())
            content = redo_stack.pop().unwrap()
        }
    }
}

// ============================================================================
// DATERANGEPICKER COMPONENT
// ============================================================================

pub struct DateRange {
    start_date: String,
    end_date: String,
}

pub struct DateRangePickerProps {
    value: DateRange,
    format: String,
    min_date: Option<String>,
    max_date: Option<String>,
    disabled_dates: Vec<String>,
}

pub component DateRangePicker {
    props: DateRangePickerProps,

    is_open: bool = false,
    current_month: i32,
    current_year: i32,
    selected_start: Option<String> = None,
    selected_end: Option<String> = None,
    hovered_date: Option<String> = None,

    render {
        <div class="date-range-picker">
            <div class="date-input-group">
                <input type="text"
                       class="date-input start-date"
                       value={props.value.start_date.clone()}
                       onClick={|_| is_open = true}
                       placeholder="Start date"
                       read_only={true} />

                <span class="date-separator">→</span>

                <input type="text"
                       class="date-input end-date"
                       value={props.value.end_date.clone()}
                       onClick={|_| is_open = true}
                       placeholder="End date"
                       read_only={true} />
            </div>

            {if is_open}
                <div class="date-picker-popup">
                    <div class="calendar-header">
                        <button onClick={|_| previous_month()}>‹</button>
                        <span class="month-year">
                            {format_month(current_month)} {current_year}
                        </span>
                        <button onClick={|_| next_month()}>›</button>
                    </div>

                    <div class="calendar-grid">
                        {render_calendar_days()}
                    </div>

                    <div class="date-picker-footer">
                        <button onClick={|_| clear_selection()}>Clear</button>
                        <button onClick={|_| apply_selection()}>Apply</button>
                    </div>
                </div>
            {/if}
        </div>
    }

    fn render_calendar_days() -> Vec<HtmlElement> {
        let mut elements = Vec::new()
        let days_in_month = get_days_in_month(current_month, current_year)

        for day in 1..=days_in_month {
            let date_str = format!("{}-{:02}-{:02}", current_year, current_month, day)
            let is_disabled = props.disabled_dates.contains(&date_str)
            let is_in_range = is_date_in_range(&date_str)
            let is_hovered_in_range = is_date_between_hovered(&date_str)

            elements.push(
                <button class={format!("calendar-day {}{}{}",
                                      if is_disabled { "disabled " } else { "" },
                                      if is_in_range { "in-range " } else { "" },
                                      if is_hovered_in_range { "hovered-range" } else { "" })}
                        onClick={|_| select_date(date_str.clone())}
                        onMouseEnter={|_| hovered_date = Some(date_str.clone())}
                        onMouseLeave={|_| hovered_date = None}
                        disabled={is_disabled}>
                    {day}
                </button>
            )
        }

        elements
    }

    fn select_date(date_str: String) {
        if selected_start.is_none() {
            selected_start = Some(date_str)
        } else if selected_end.is_none() {
            selected_end = Some(date_str)
        } else {
            selected_start = Some(date_str)
            selected_end = None
        }
    }

    fn apply_selection() {
        if selected_start.is_some() && selected_end.is_some() {
            props.value.start_date = selected_start.clone().unwrap()
            props.value.end_date = selected_end.clone().unwrap()
            is_open = false
        }
    }

    fn clear_selection() {
        selected_start = None
        selected_end = None
        hovered_date = None
    }

    fn is_date_in_range(date: &str) -> bool {
        if let (Some(start), Some(end)) = (&selected_start, &selected_end) {
            date >= start && date <= end
        } else {
            false
        }
    }

    fn is_date_between_hovered(date: &str) -> bool {
        if let (Some(start), Some(hov)) = (&selected_start, &hovered_date) {
            date >= start && date <= hov
        } else {
            false
        }
    }

    fn previous_month() {
        current_month -= 1
        if current_month < 1 {
            current_month = 12
            current_year -= 1
        }
    }

    fn next_month() {
        current_month += 1
        if current_month > 12 {
            current_month = 1
            current_year += 1
        }
    }

    fn get_days_in_month(month: i32, year: i32) -> i32 {
        match month {
            1 | 3 | 5 | 7 | 8 | 10 | 12 => 31,
            4 | 6 | 9 | 11 => 30,
            2 => if is_leap_year(year) { 29 } else { 28 },
            _ => 0,
        }
    }

    fn is_leap_year(year: i32) -> bool {
        (year % 4 == 0 && year % 100 != 0) || (year % 400 == 0)
    }

    fn format_month(month: i32) -> String {
        match month {
            1 => "January", 2 => "February", 3 => "March", 4 => "April",
            5 => "May", 6 => "June", 7 => "July", 8 => "August",
            9 => "September", 10 => "October", 11 => "November", 12 => "December",
            _ => "Unknown",
        }.to_string()
    }
}

// ============================================================================
// COMBOBOX COMPONENT
// ============================================================================

pub struct ComboBoxProps {
    options: Vec<String>,
    value: Option<String>,
    placeholder: String,
    filterable: bool,
    clearable: bool,
    disabled: bool,
}

pub component ComboBox {
    props: ComboBoxProps,

    is_open: bool = false,
    filter_text: String,
    hovered_index: Option<i32> = None,

    render {
        <div class="combobox">
            <div class="combobox-input-wrapper">
                <input type="text"
                       class="combobox-input"
                       value={props.value.clone().unwrap_or_default()}
                       placeholder={props.placeholder.clone()}
                       onFocus={|_| is_open = true}
                       onInput={|e| { filter_text = e.target.value.clone(); is_open = true; }}
                       disabled={props.disabled} />

                {if props.clearable && props.value.is_some()}
                    <button class="combobox-clear"
                            onClick={|_| { props.value = None; filter_text.clear(); }}>
                        ✕
                    </button>
                {/if}

                <span class="combobox-icon">▼</span>
            </div>

            {if is_open}
                <div class="combobox-dropdown">
                    {let filtered = get_filtered_options();
                     for (i, option) in filtered.iter().enumerate()}
                        <div class={format!("combobox-option {}",
                                           if hovered_index == Some(i as i32) { "hovered" } else { "" })}
                             onClick={|_| select_option(option.clone())}
                             onMouseEnter={|_| hovered_index = Some(i as i32)}
                             onMouseLeave={|_| hovered_index = None}>
                            {option}
                        </div>
                    {/for}

                    {if get_filtered_options().is_empty()}
                        <div class="combobox-no-options">No options match</div>
                    {/if}
                </div>
            {/if}
        </div>
    }

    fn get_filtered_options() -> Vec<String> {
        if !props.filterable || filter_text.is_empty() {
            props.options.clone()
        } else {
            props.options.iter()
                .filter(|opt| opt.to_lowercase().contains(&filter_text.to_lowercase()))
                .cloned()
                .collect()
        }
    }

    fn select_option(option: String) {
        props.value = Some(option)
        is_open = false
        filter_text.clear()
    }
}

// ============================================================================
// SPLITTER COMPONENT
// ============================================================================

pub struct SplitterProps {
    orientation: String,  // "horizontal" or "vertical"
    divider_size: i32,
    min_size_1: i32,
    min_size_2: i32,
    initial_size_1: i32,
}

pub component Splitter {
    props: SplitterProps,

    size_1: i32,
    is_dragging: bool = false,
    drag_start_pos: i32 = 0,

    render {
        <div class={format!("splitter-container {}", props.orientation)}>
            <div class="splitter-panel panel-1"
                 style={if props.orientation == "vertical" {
                            format!("width: {}px", size_1)
                        } else {
                            format!("height: {}px", size_1)
                        }}>
                <slot name="panel-1" />
            </div>

            <div class="splitter-divider"
                 onMouseDown={|e| start_drag(e)}
                 style={if props.orientation == "vertical" {
                            format!("width: {}px", props.divider_size)
                        } else {
                            format!("height: {}px", props.divider_size)
                        }}>
            </div>

            <div class="splitter-panel panel-2">
                <slot name="panel-2" />
            </div>
        </div>
    }

    fn start_drag(event: MouseEvent) {
        is_dragging = true
        drag_start_pos = if props.orientation == "vertical" { event.client_x } else { event.client_y }
    }

    pub fn handle_mouse_move(event: MouseEvent) {
        if is_dragging {
            let current_pos = if props.orientation == "vertical" { event.client_x } else { event.client_y }
            let delta = current_pos - drag_start_pos

            let new_size = (size_1 + delta).max(props.min_size_1)
            if new_size >= props.min_size_1 {
                size_1 = new_size
                drag_start_pos = current_pos
            }
        }
    }

    pub fn handle_mouse_up(_event: MouseEvent) {
        is_dragging = false
    }
}

// ============================================================================
// BREADCRUMB COMPONENT
// ============================================================================

pub struct BreadcrumbItem {
    label: String,
    url: Option<String>,
}

pub struct BreadcrumbProps {
    items: Vec<BreadcrumbItem>,
    separator: String,
}

pub component Breadcrumb {
    props: BreadcrumbProps,

    render {
        <nav class="breadcrumb" aria-label="Breadcrumb">
            <ol class="breadcrumb-list">
                {for (i, item) in props.items.iter().enumerate()}
                    <li class="breadcrumb-item">
                        {if let Some(url) = &item.url}
                            <a href={url.clone()} class="breadcrumb-link">
                                {item.label.clone()}
                            </a>
                        {else}
                            <span class="breadcrumb-current">
                                {item.label.clone()}
                            </span>
                        {/if}

                        {if i < props.items.len() - 1}
                            <span class="breadcrumb-separator">
                                {props.separator.clone()}
                            </span>
                        {/if}
                    </li>
                {/for}
            </ol>
        </nav>
    }
}

// ============================================================================
// TOOLTIP COMPONENT
// ============================================================================

pub struct TooltipProps {
    content: String,
    position: String,  // "top", "bottom", "left", "right"
    delay_ms: i32,
    theme: String,  // "dark", "light"
}

pub component Tooltip {
    props: TooltipProps,

    is_visible: bool = false,
    show_timer: Option<i32> = None,

    render {
        <div class="tooltip-wrapper"
             onMouseEnter={|_| show_tooltip()}
             onMouseLeave={|_| hide_tooltip()}>
            <slot />

            {if is_visible}
                <div class={format!("tooltip tooltip-{} tooltip-{}", props.position, props.theme)}>
                    {props.content.clone()}
                </div>
            {/if}
        </div>
    }

    fn show_tooltip() {
        if props.delay_ms > 0 {
            // Would set timer in real implementation
            is_visible = true
        } else {
            is_visible = true
        }
    }

    fn hide_tooltip() {
        is_visible = false
        if let Some(timer) = show_timer {
            // Cancel timer
        }
    }
}

// ============================================================================
// BADGE COMPONENT
// ============================================================================

pub struct BadgeProps {
    content: String,
    variant: String,  // "default", "primary", "success", "error", "warning"
    size: String,     // "small", "medium", "large"
    max_count: Option<i32>,
}

pub component Badge {
    props: BadgeProps,

    render {
        let display_content = if let Some(max) = props.max_count {
            let count: i32 = props.content.parse().unwrap_or(0)
            if count > max {
                format!("{}+", max)
            } else {
                props.content.clone()
            }
        } else {
            props.content.clone()
        };

        <span class={format!("badge badge-{} badge-{}", props.variant, props.size)}>
            {display_content}
        </span>
    }
}

// ============================================================================
// SKELETON COMPONENT
// ============================================================================

pub struct SkeletonProps {
    variant: String,  // "text", "circle", "rect"
    width: i32,
    height: i32,
    count: i32,
    animation: bool,
}

pub component Skeleton {
    props: SkeletonProps,

    render {
        <div class="skeleton-container">
            {for _i in 0..props.count}
                <div class={format!("skeleton skeleton-{} {}",
                                   props.variant,
                                   if props.animation { "animate" } else { "" })}
                     style={format!("width: {}px; height: {}px", props.width, props.height)}>
                </div>
            {/for}
        </div>
    }
}

// ============================================================================
// VIRTUALSCROLL COMPONENT
// ============================================================================

pub struct VirtualScrollProps {
    items: Vec<String>,
    item_height: i32,
    container_height: i32,
    buffer_size: i32,
}

pub component VirtualScroll {
    props: VirtualScrollProps,

    scroll_offset: i32 = 0,
    visible_start: i32 = 0,
    visible_end: i32,

    render {
        <div class="virtual-scroll"
             onScroll={|e| handle_scroll(e)}
             style={height: props.container_height}>
            <div class="virtual-scroll-content"
                 style={height: props.items.len() as i32 * props.item_height}>
                <div style={transform: format!("translateY({}px)", visible_start * props.item_height)}>
                    {for (i, item) in props.items.iter()
                        .skip(visible_start as usize)
                        .take((visible_end - visible_start) as usize)
                        .enumerate()}
                        <div class="virtual-scroll-item"
                             style={height: props.item_height}>
                            {item}
                        </div>
                    {/for}
                </div>
            </div>
        </div>
    }

    fn handle_scroll(event: ScrollEvent) {
        scroll_offset = event.scroll_top
        visible_start = (scroll_offset / props.item_height).max(0)
        let items_visible = (props.container_height / props.item_height) + props.buffer_size
        visible_end = (visible_start + items_visible).min(props.items.len() as i32)
    }

    computed visible_end -> i32 {
        let items_visible = (props.container_height / props.item_height) + 1
        (visible_start + items_visible).min(props.items.len() as i32)
    }
}

// ============================================================================
// VIRTUALIZED COMPONENT
// ============================================================================

pub struct VirtualizedProps {
    items: Vec<String>,
    item_height: i32,
    width: i32,
    height: i32,
    columns: i32,
}

pub component Virtualized {
    props: VirtualizedProps,

    scroll_offset: i32 = 0,

    render {
        <div class="virtualized-container"
             onScroll={|e| scroll_offset = e.scroll_top}
             style={format!("width: {}px; height: {}px", props.width, props.height)}>
            <div class="virtualized-grid"
                 style={format!("display: grid; grid-template-columns: repeat({}, 1fr)", props.columns)}>
                {let visible_items = calculate_visible_items();
                 for item in visible_items}
                    <div class="virtualized-item"
                         style={format!("height: {}px", props.item_height)}>
                        {item}
                    </div>
                {/for}
            </div>
        </div>
    }

    fn calculate_visible_items() -> Vec<String> {
        let items_per_row = props.columns
        let visible_rows = (props.height / props.item_height) + 1
        let start_row = scroll_offset / props.item_height
        let start_idx = (start_row * items_per_row) as usize
        let end_idx = start_idx + ((visible_rows * items_per_row) as usize)

        props.items.iter()
            .skip(start_idx)
            .take(end_idx - start_idx)
            .cloned()
            .collect()
    }
}
