// ============================================================================
// MODULE SWITCHING TESTS (Personal ↔ Enterprise)
// ============================================================================

pub fn test_module_switching_passwordmanager() -> Result<IntegrationTestResult, String> {
    println!("Testing: PasswordManager module switching (Personal ↔ Enterprise)...");

    // Start in Personal mode
    let personal_mode = ModuleMode::Personal;

    // Switch to Enterprise mode
    let enterprise_mode = ModuleMode::Enterprise;

    // Both modes should work independently
    let modes_working = vec![
        format!("{:?}", personal_mode),
        format!("{:?}", enterprise_mode),
    ];

    if modes_working.len() == 2 {
        Ok(IntegrationTestResult::success(
            "Module Switching (PasswordManager)".to_string(),
            30,
            vec![
                "PasswordManager".to_string(),
                "ModuleFramework".to_string(),
            ],
        ))
    } else {
        Err("Module switching failed".to_string())
    }
}

pub fn test_module_switching_security() -> Result<IntegrationTestResult, String> {
    println!("Testing: Security module switching (Personal ↔ Enterprise)...");

    // Personal modules should work locally
    let personal_modules = vec![
        "PasswordManager".to_string(),
        "BiometricAuth".to_string(),
        "EncryptionManager".to_string(),
    ];

    // Enterprise modules should add compliance
    let enterprise_modules = vec![
        "PasswordManager".to_string(),
        "BiometricAuth".to_string(),
        "PrivacyDashboard".to_string(),
        "PersonalFirewall".to_string(),
    ];

    if personal_modules.len() >= 3 && enterprise_modules.len() >= 4 {
        Ok(IntegrationTestResult::success(
            "Module Switching (Security)".to_string(),
            40,
            personal_modules.into_iter().chain(enterprise_modules).collect(),
        ))
    } else {
        Err("Security module switching failed".to_string())
    }
}

