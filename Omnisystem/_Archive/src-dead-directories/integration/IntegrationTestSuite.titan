// ============================================================================
// MAIN TEST RUNNER
// ============================================================================

fn main() -> Result<(), String> {
    let mut suite = IntegrationTestSuite::new();

    println!("\n🔬 OMNISYSTEM INTEGRATION TEST SUITE\n");
    println!("Running {} integration tests...\n", 20);

    // Desktop ↔ Cloud Tests
    match test_desktop_cloud_sync() {
        Ok(result) => suite.add_result(result),
        Err(e) => suite.add_result(IntegrationTestResult::failure(
            "Desktop ↔ Cloud Sync".to_string(),
            e,
            vec!["DesktopEnvironment".to_string()],
        )),
    }

    match test_desktop_settings_persistence() {
        Ok(result) => suite.add_result(result),
        Err(e) => suite.add_result(IntegrationTestResult::failure(
            "Desktop Settings".to_string(),
            e,
            vec!["DesktopEnvironment".to_string()],
        )),
    }

    // Mobile ↔ Cloud Tests
    match test_mobile_cloud_sync() {
        Ok(result) => suite.add_result(result),
        Err(e) => suite.add_result(IntegrationTestResult::failure(
            "Mobile Cloud Sync".to_string(),
            e,
            vec!["IOSApp".to_string()],
        )),
    }

    match test_cross_device_handoff() {
        Ok(result) => suite.add_result(result),
        Err(e) => suite.add_result(IntegrationTestResult::failure(
            "Cross-Device Handoff".to_string(),
            e,
            vec!["DeviceSync".to_string()],
        )),
    }

    // Security Tests
    match test_encryption_integration() {
        Ok(result) => suite.add_result(result),
        Err(e) => suite.add_result(IntegrationTestResult::failure(
            "Encryption".to_string(),
            e,
            vec!["PasswordManager".to_string()],
        )),
    }

    match test_permission_enforcement() {
        Ok(result) => suite.add_result(result),
        Err(e) => suite.add_result(IntegrationTestResult::failure(
            "Permissions".to_string(),
            e,
            vec!["PrivacyDashboard".to_string()],
        )),
    }

    match test_audit_logging_integration() {
        Ok(result) => suite.add_result(result),
        Err(e) => suite.add_result(IntegrationTestResult::failure(
            "Audit Logging".to_string(),
            e,
            vec!["BackupManager".to_string()],
        )),
    }

    // AI Tests
    match test_ai_context_awareness() {
        Ok(result) => suite.add_result(result),
        Err(e) => suite.add_result(IntegrationTestResult::failure(
            "AI Context".to_string(),
            e,
            vec!["PersonalAI".to_string()],
        )),
    }

    match test_ai_suggestions_personalization() {
        Ok(result) => suite.add_result(result),
        Err(e) => suite.add_result(IntegrationTestResult::failure(
            "AI Personalization".to_string(),
            e,
            vec!["PersonalInsights".to_string()],
        )),
    }

    // Productivity Tests
    match test_productivity_suite_sync() {
        Ok(result) => suite.add_result(result),
        Err(e) => suite.add_result(IntegrationTestResult::failure(
            "Productivity Suite".to_string(),
            e,
            vec!["EmailClient".to_string()],
        )),
    }

    // Module Switching Tests
    match test_module_switching_passwordmanager() {
        Ok(result) => suite.add_result(result),
        Err(e) => suite.add_result(IntegrationTestResult::failure(
            "Module Switching PM".to_string(),
            e,
            vec!["PasswordManager".to_string()],
        )),
    }

    match test_module_switching_security() {
        Ok(result) => suite.add_result(result),
        Err(e) => suite.add_result(IntegrationTestResult::failure(
            "Module Switching Sec".to_string(),
            e,
            vec!["BiometricAuth".to_string()],
        )),
    }

    // Creative Tools Tests
    match test_creative_tools_workflow() {
        Ok(result) => suite.add_result(result),
        Err(e) => suite.add_result(IntegrationTestResult::failure(
            "Creative Tools".to_string(),
            e,
            vec!["PhotoManager".to_string()],
        )),
    }

    // Health Tests
    match test_health_suite_integration() {
        Ok(result) => suite.add_result(result),
        Err(e) => suite.add_result(IntegrationTestResult::failure(
            "Health Suite".to_string(),
            e,
            vec!["HealthDashboard".to_string()],
        )),
    }

    // Platform Tests
    match test_windows_platform() {
        Ok(result) => suite.add_result(result),
        Err(e) => suite.add_result(IntegrationTestResult::failure(
            "Windows".to_string(),
            e,
            vec!["DesktopEnvironment".to_string()],
        )),
    }

    match test_linux_platform() {
        Ok(result) => suite.add_result(result),
        Err(e) => suite.add_result(IntegrationTestResult::failure(
            "Linux".to_string(),
            e,
            vec!["DesktopEnvironment".to_string()],
        )),
    }

    match test_macos_platform() {
        Ok(result) => suite.add_result(result),
        Err(e) => suite.add_result(IntegrationTestResult::failure(
            "macOS".to_string(),
            e,
            vec!["DesktopEnvironment".to_string()],
        )),
    }

    match test_ios_platform() {
        Ok(result) => suite.add_result(result),
        Err(e) => suite.add_result(IntegrationTestResult::failure(
            "iOS".to_string(),
            e,
            vec!["IOSApp".to_string()],
        )),
    }

    match test_android_platform() {
        Ok(result) => suite.add_result(result),
        Err(e) => suite.add_result(IntegrationTestResult::failure(
            "Android".to_string(),
            e,
            vec!["AndroidApp".to_string()],
        )),
    }

    suite.print_summary();

    if suite.pass_rate() >= 95 {
        println!("✅ INTEGRATION TESTS: PASSED - System ready for beta");
        Ok(())
    } else {
        println!("❌ INTEGRATION TESTS: FAILED - Fix issues before beta");
        Err("Integration tests did not pass".to_string())
    }
}
