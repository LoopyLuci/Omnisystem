// OMNISYSTEM FULL INTEGRATION TEST - VERIFY ALL 12 SYSTEMS WORK TOGETHER
// Complete end-to-end integration test for all enterprise systems (Phases 0-2)
// Language: TITAN (Systems Programming)
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════

use std::collections::HashMap;
use std::time::Instant;

// ─────────────────────────────────────────────────────────────────────────────────────────────────────────
// INTEGRATION TEST COORDINATOR
// ─────────────────────────────────────────────────────────────────────────────────────────────────────────

pub struct OmnisystemIntegrationTest {
    pub test_name: String,
    pub test_start: Instant,
    pub tests_run: u32,
    pub tests_passed: u32,
    pub tests_failed: u32,
    pub errors: Vec<String>,
    pub warnings: Vec<String>,
}

impl OmnisystemIntegrationTest {
    pub fn new(name: String) -> Self {
        OmnisystemIntegrationTest {
            test_name: name,
            test_start: Instant::now(),
            tests_run: 0,
            tests_passed: 0,
            tests_failed: 0,
            errors: Vec::new(),
            warnings: Vec::new(),
        }
    }

    pub fn run_test(&mut self, test_name: &str, test_fn: fn() -> Result<String, String>) -> Result<(), String> {
        self.tests_run += 1;

        match test_fn() {
            Ok(msg) => {
                self.tests_passed += 1;
                println!("  ✓ {}: {}", test_name, msg);
                Ok(())
            },
            Err(e) => {
                self.tests_failed += 1;
                self.errors.push(format!("{}: {}", test_name, e));
                println!("  ✗ {}: {}", test_name, e);
                Ok(())
            }
        }
    }

    pub fn print_summary(&self) {
        let duration = self.test_start.elapsed();

        println!("\n╔════════════════════════════════════════════════════════════════╗");
        println!("║             OMNISYSTEM INTEGRATION TEST SUMMARY                 ║");
        println!("╠════════════════════════════════════════════════════════════════╣");
        println!("║ Test Suite:        {}", self.test_name);
        println!("║ Tests Run:         {}", self.tests_run);
        println!("║ Passed:            {} ✓", self.tests_passed);
        println!("║ Failed:            {} ✗", self.tests_failed);
        println!("║ Pass Rate:         {:.1}%",
                 if self.tests_run > 0 {
                     (self.tests_passed as f64 / self.tests_run as f64) * 100.0
                 } else {
                     0.0
                 });
        println!("║ Duration:          {:.2}s", duration.as_secs_f64());
        println!("╠════════════════════════════════════════════════════════════════╣");

        if !self.errors.is_empty() {
            println!("║ ERRORS:");
            for error in &self.errors {
                println!("║   • {}", error);
            }
            println!("║");
        }

        if !self.warnings.is_empty() {
            println!("║ WARNINGS:");
            for warning in &self.warnings {
                println!("║   • {}", warning);
            }
            println!("║");
        }

        println!("║ OVERALL STATUS:    {}", if self.tests_failed == 0 { "✓ ALL PASS" } else { "✗ SOME FAIL" });
        println!("╚════════════════════════════════════════════════════════════════╝\n");
    }
}

