// SyntheticBiologyPlatform.helix - Synthetic biology and genetic engineering
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct GeneSequence {
    pub sequence_id: String,
    pub gene_name: String,
    pub organism: String,
    pub length_bp: u32,
    pub gc_content_percent: f64,
    pub function: String,
}

impl GeneSequence {
    pub fn new(sequence_id: String, gene_name: String, organism: String) -> Self {
        GeneSequence {
            sequence_id,
            gene_name,
            organism,
            length_bp: 0,
            gc_content_percent: 0.0,
            function: String::new(),
        }
    }

    pub fn calculate_gc_content(&mut self, gc_count: u32) {
        if self.length_bp > 0 {
            self.gc_content_percent = (gc_count as f64 / self.length_bp as f64) * 100.0;
        }
    }
}

pub struct DesignedOrganism {
    pub organism_id: String,
    pub name: String,
    pub parent_species: String,
    pub gene_modifications: u32,
    pub phenotype: String,
    pub viability: bool,
}

impl DesignedOrganism {
    pub fn new(organism_id: String, name: String, parent: String) -> Self {
        DesignedOrganism {
            organism_id,
            name,
            parent_species: parent,
            gene_modifications: 0,
            phenotype: String::new(),
            viability: false,
        }
    }

    pub fn add_modification(&mut self) {
        self.gene_modifications += 1;
    }

    pub fn set_viable(&mut self) {
        self.viability = true;
    }
}

pub struct SyntheticPathway {
    pub pathway_id: String,
    pub pathway_name: String,
    pub organism_id: String,
    pub num_enzymes: u32,
    pub product: String,
    pub yield_percent: f64,
    pub status: String, // designed, optimized, validated, deployed
}

impl SyntheticPathway {
    pub fn new(pathway_id: String, pathway_name: String, organism_id: String) -> Self {
        SyntheticPathway {
            pathway_id,
            pathway_name,
            organism_id,
            num_enzymes: 0,
            product: String::new(),
            yield_percent: 0.0,
            status: "designed".to_string(),
        }
    }

    pub fn optimize(&mut self) {
        self.status = "optimized".to_string();
    }

    pub fn validate(&mut self) {
        self.status = "validated".to_string();
    }

    pub fn deploy(&mut self) {
        self.status = "deployed".to_string();
    }
}

pub struct BioFermentation {
    pub fermentation_id: String,
    pub pathway_id: String,
    pub batch_id: String,
    pub volume_liters: f64,
    pub duration_hours: u32,
    pub product_yield_grams: f64,
    pub status: String, // preparing, active, completed, failed
}

impl BioFermentation {
    pub fn new(fermentation_id: String, pathway_id: String) -> Self {
        BioFermentation {
            fermentation_id,
            pathway_id,
            batch_id: String::new(),
            volume_liters: 1.0,
            duration_hours: 48,
            product_yield_grams: 0.0,
            status: "preparing".to_string(),
        }
    }

    pub fn start(&mut self) {
        self.status = "active".to_string();
    }

    pub fn complete(&mut self, yield_grams: f64) {
        self.status = "completed".to_string();
        self.product_yield_grams = yield_grams;
    }
}

pub struct SyntheticBiologyPlatformSystem {
    pub system_id: String,
    pub gene_sequences: HashMap<String, GeneSequence>,
    pub organisms: HashMap<String, DesignedOrganism>,
    pub pathways: HashMap<String, SyntheticPathway>,
    pub fermentations: HashMap<String, BioFermentation>,
}

impl SyntheticBiologyPlatformSystem {
    pub fn new(system_id: String) -> Self {
        SyntheticBiologyPlatformSystem {
            system_id,
            gene_sequences: HashMap::new(),
            organisms: HashMap::new(),
            pathways: HashMap::new(),
            fermentations: HashMap::new(),
        }
    }

    pub fn register_sequence(&mut self, sequence: GeneSequence) {
        self.gene_sequences.insert(sequence.sequence_id.clone(), sequence);
    }

    pub fn design_organism(&mut self, organism: DesignedOrganism) {
        self.organisms.insert(organism.organism_id.clone(), organism);
    }

    pub fn create_pathway(&mut self, pathway: SyntheticPathway) {
        self.pathways.insert(pathway.pathway_id.clone(), pathway);
    }

    pub fn start_fermentation(&mut self, fermentation: BioFermentation) {
        self.fermentations.insert(fermentation.fermentation_id.clone(), fermentation);
    }

    pub fn get_viable_organisms(&self) -> u32 {
        self.organisms
            .iter()
            .filter(|(_, o)| o.viability)
            .count() as u32
    }

    pub fn get_deployed_pathways(&self) -> u32 {
        self.pathways
            .iter()
            .filter(|(_, p)| p.status == "deployed")
            .count() as u32
    }

    pub fn get_completed_fermentations(&self) -> u32 {
        self.fermentations
            .iter()
            .filter(|(_, f)| f.status == "completed")
            .count() as u32
    }

    pub fn get_total_product_yield(&self) -> f64 {
        self.fermentations
            .iter()
            .map(|(_, f)| f.product_yield_grams)
            .sum()
    }

    pub fn get_average_gc_content(&self) -> f64 {
        if self.gene_sequences.is_empty() {
            0.0
        } else {
            let total: f64 = self.gene_sequences
                .iter()
                .map(|(_, gs)| gs.gc_content_percent)
                .sum();
            total / self.gene_sequences.len() as f64
        }
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 132: SYNTHETIC BIOLOGY PLATFORM ===\n");
    let mut sbps = SyntheticBiologyPlatformSystem::new("sbps_001".to_string());
    let sequence = GeneSequence::new("seq_001".to_string(), "GFP".to_string(), "E. coli".to_string());
    sbps.register_sequence(sequence);
    let organism = DesignedOrganism::new("org_001".to_string(), "SyntheticE.Coli".to_string(), "E. coli".to_string());
    sbps.design_organism(organism);
    let pathway = SyntheticPathway::new("path_001".to_string(), "Insulin Production".to_string(), "org_001".to_string());
    sbps.create_pathway(pathway);
    let fermentation = BioFermentation::new("ferm_001".to_string(), "path_001".to_string());
    sbps.start_fermentation(fermentation);
    println!("✓ Sequence, organism, pathway, and fermentation recorded");
    println!("✓ Viable organisms: {}", sbps.get_viable_organisms());
    println!("✓✓✓ Synthetic Biology Platform operational ✓✓✓");
    Ok(())
}
