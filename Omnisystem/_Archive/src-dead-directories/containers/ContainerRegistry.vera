// ContainerRegistry.vera - Container image registry and management
// Image storage, versioning, scanning, distribution

use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct ContainerImage {
    pub image_id: String,
    pub image_name: String,
    pub version: String,
    pub size_mb: u32,
    pub scan_status: String,
}

impl ContainerImage {
    pub fn new(image_id: String, image_name: String, version: String, size_mb: u32) -> Self {
        ContainerImage {
            image_id,
            image_name,
            version,
            size_mb,
            scan_status: "pending".to_string(),
        }
    }
}

pub struct ContainerRegistry {
    pub registry_id: String,
    pub images: HashMap<String, ContainerImage>,
    pub total_images: u32,
    pub total_size_gb: u32,
}

impl ContainerRegistry {
    pub fn new(registry_id: String) -> Self {
        ContainerRegistry {
            registry_id,
            images: HashMap::new(),
            total_images: 0,
            total_size_gb: 0,
        }
    }

    pub fn push_image(&mut self, image: ContainerImage) -> Result<String, String> {
        let img_id = image.image_id.clone();
        self.total_size_gb += (image.size_mb + 999) / 1000;
        self.images.insert(img_id.clone(), image);
        self.total_images += 1;
        Ok(img_id)
    }

    pub fn pull_image(&self, image_id: &str) -> Result<(), String> {
        if self.images.contains_key(image_id) {
            Ok(())
        } else {
            Err("Image not found".to_string())
        }
    }

    pub fn scan_image(&mut self, image_id: &str) -> Result<(), String> {
        if let Some(img) = self.images.get_mut(image_id) {
            img.scan_status = "scanned".to_string();
            Ok(())
        } else {
            Err("Image not found".to_string())
        }
    }

    pub fn print_status(&self) {
        println!("\n╔════════════════════════════════════════════════════╗");
        println!("║      CONTAINER REGISTRY (Phase 46)                 ║");
        println!("╚════════════════════════════════════════════════════╝\n");

        println!("🐳 IMAGES:");
        println!("   Total: {}", self.total_images);
        println!("   Storage: {} GB", self.total_size_gb);

        println!("\n");
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 46: CONTAINER REGISTRY ===\n");

    let mut registry = ContainerRegistry::new("registry_001".to_string());

    println!("--- Pushing Images ---");
    let img = ContainerImage::new(
        "img_app".to_string(),
        "omnisystem/app".to_string(),
        "1.0.0".to_string(),
        256,
    );
    registry.push_image(img)?;
    println!("✓ Image pushed\n");

    println!("--- Scanning Images ---");
    registry.scan_image("img_app")?;
    println!("✓ Image scanned\n");

    registry.print_status();

    println!("✓✓✓ Container Registry operational ✓✓✓");
    Ok(())
}
