// FeedbackSystem.aether - Customer feedback and survey management
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct Feedback {
    pub feedback_id: String,
    pub user_id: String,
    pub rating: u8, // 1-5
    pub comment: String,
    pub category: String,
    pub submitted_at: u64,
}

impl Feedback {
    pub fn new(feedback_id: String, user_id: String, rating: u8) -> Self {
        Feedback {
            feedback_id,
            user_id,
            rating: rating.min(5),
            comment: String::new(),
            category: String::new(),
            submitted_at: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
        }
    }

    pub fn add_comment(&mut self, comment: String) {
        self.comment = comment;
    }
}

pub struct Survey {
    pub survey_id: String,
    pub title: String,
    pub questions: Vec<String>,
    pub responses: u32,
    pub status: String, // active, closed
}

impl Survey {
    pub fn new(survey_id: String, title: String) -> Self {
        Survey {
            survey_id,
            title,
            questions: Vec::new(),
            responses: 0,
            status: "active".to_string(),
        }
    }

    pub fn add_question(&mut self, question: String) {
        self.questions.push(question);
    }

    pub fn record_response(&mut self) {
        self.responses += 1;
    }

    pub fn close(&mut self) {
        self.status = "closed".to_string();
    }
}

pub struct FeedbackAnalytics {
    pub analytics_id: String,
    pub total_feedback: u32,
    pub average_rating: f64,
    pub satisfaction_score: f64,
    pub category_breakdown: HashMap<String, u32>,
}

impl FeedbackAnalytics {
    pub fn new(analytics_id: String) -> Self {
        FeedbackAnalytics {
            analytics_id,
            total_feedback: 0,
            average_rating: 0.0,
            satisfaction_score: 0.0,
            category_breakdown: HashMap::new(),
        }
    }

    pub fn calculate_average(&mut self, feedback_list: &[Feedback]) {
        if feedback_list.is_empty() {
            return;
        }

        let total: u32 = feedback_list.iter().map(|f| f.rating as u32).sum();
        self.average_rating = total as f64 / feedback_list.len() as f64;
        self.total_feedback = feedback_list.len() as u32;
        self.satisfaction_score = (self.average_rating / 5.0) * 100.0;
    }
}

pub struct FeedbackSystem {
    pub system_id: String,
    pub feedback_items: HashMap<String, Feedback>,
    pub surveys: HashMap<String, Survey>,
    pub analytics: FeedbackAnalytics,
}

impl FeedbackSystem {
    pub fn new(system_id: String) -> Self {
        FeedbackSystem {
            system_id,
            feedback_items: HashMap::new(),
            surveys: HashMap::new(),
            analytics: FeedbackAnalytics::new("ana_001".to_string()),
        }
    }

    pub fn submit_feedback(&mut self, feedback: Feedback) -> Result<String, String> {
        let feedback_id = feedback.feedback_id.clone();
        self.feedback_items.insert(feedback_id.clone(), feedback);
        Ok(feedback_id)
    }

    pub fn create_survey(&mut self, survey: Survey) -> Result<String, String> {
        let survey_id = survey.survey_id.clone();
        self.surveys.insert(survey_id.clone(), survey);
        Ok(survey_id)
    }

    pub fn respond_to_survey(&mut self, survey_id: &str) -> Result<(), String> {
        if let Some(survey) = self.surveys.get_mut(survey_id) {
            survey.record_response();
            Ok(())
        } else {
            Err(format!("Survey {} not found", survey_id))
        }
    }

    pub fn get_satisfaction_score(&self) -> f64 {
        self.analytics.satisfaction_score
    }

    pub fn generate_insights(&self) -> String {
        format!(
            "Total feedback: {}, Average rating: {:.1}/5, Satisfaction: {:.1}%",
            self.analytics.total_feedback, self.analytics.average_rating, self.analytics.satisfaction_score
        )
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 87: FEEDBACK SYSTEM ===\n");
    let mut fs = FeedbackSystem::new("fs_001".to_string());
    let mut feedback = Feedback::new("fb_001".to_string(), "user_123".to_string(), 5);
    feedback.add_comment("Excellent service!".to_string());
    fs.submit_feedback(feedback)?;
    println!("✓ Feedback submitted");
    println!("✓ {}", fs.generate_insights());
    println!("✓✓✓ Feedback System operational ✓✓✓");
    Ok(())
}
