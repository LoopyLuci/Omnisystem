// FinanceManagement.vera - Financial management and ERP
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct GeneralLedgerAccount {
    pub account_id: String,
    pub account_number: String,
    pub account_type: String, // asset, liability, equity, revenue, expense
    pub balance: f64,
    pub description: String,
}

impl GeneralLedgerAccount {
    pub fn new(account_id: String, account_number: String, account_type: String) -> Self {
        GeneralLedgerAccount {
            account_id,
            account_number,
            account_type,
            balance: 0.0,
            description: String::new(),
        }
    }

    pub fn post_transaction(&mut self, amount: f64) {
        self.balance += amount;
    }

    pub fn get_balance(&self) -> f64 {
        self.balance
    }
}

pub struct JournalEntry {
    pub entry_id: String,
    pub debit_account: String,
    pub credit_account: String,
    pub amount: f64,
    pub description: String,
    pub posted_at: u64,
    pub posted: bool,
}

impl JournalEntry {
    pub fn new(entry_id: String, debit: String, credit: String, amount: f64) -> Self {
        JournalEntry {
            entry_id,
            debit_account: debit,
            credit_account: credit,
            amount,
            description: String::new(),
            posted_at: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
            posted: false,
        }
    }

    pub fn post(&mut self) {
        self.posted = true;
    }
}

pub struct FinancialStatement {
    pub statement_id: String,
    pub statement_type: String, // balance_sheet, income_statement, cash_flow
    pub period_start: u64,
    pub period_end: u64,
    pub totals: HashMap<String, f64>,
}

impl FinancialStatement {
    pub fn new(statement_id: String, statement_type: String) -> Self {
        FinancialStatement {
            statement_id,
            statement_type,
            period_start: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
            period_end: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
            totals: HashMap::new(),
        }
    }

    pub fn set_total(&mut self, line_item: String, amount: f64) {
        self.totals.insert(line_item, amount);
    }
}

pub struct FinanceManagementSystem {
    pub system_id: String,
    pub accounts: HashMap<String, GeneralLedgerAccount>,
    pub journal_entries: HashMap<String, JournalEntry>,
    pub financial_statements: HashMap<String, FinancialStatement>,
    pub total_assets: f64,
}

impl FinanceManagementSystem {
    pub fn new(system_id: String) -> Self {
        FinanceManagementSystem {
            system_id,
            accounts: HashMap::new(),
            journal_entries: HashMap::new(),
            financial_statements: HashMap::new(),
            total_assets: 0.0,
        }
    }

    pub fn create_account(&mut self, account: GeneralLedgerAccount) {
        self.accounts.insert(account.account_id.clone(), account);
    }

    pub fn record_journal_entry(&mut self, entry: JournalEntry) -> Result<String, String> {
        let entry_id = entry.entry_id.clone();
        self.journal_entries.insert(entry_id.clone(), entry);
        Ok(entry_id)
    }

    pub fn post_journal_entry(&mut self, entry_id: &str) -> Result<(), String> {
        if let Some(entry) = self.journal_entries.get_mut(entry_id) {
            if let Some(debit) = self.accounts.get_mut(&entry.debit_account) {
                debit.post_transaction(entry.amount);
            }
            if let Some(credit) = self.accounts.get_mut(&entry.credit_account) {
                credit.post_transaction(-entry.amount);
            }
            entry.post();
            self.total_assets = self.accounts
                .iter()
                .filter(|(_, a)| a.account_type == "asset")
                .map(|(_, a)| a.balance)
                .sum();
            Ok(())
        } else {
            Err(format!("Entry {} not found", entry_id))
        }
    }

    pub fn generate_statement(&mut self, statement: FinancialStatement) {
        self.financial_statements.insert(statement.statement_id.clone(), statement);
    }

    pub fn get_trial_balance(&self) -> Result<f64, String> {
        let balance: f64 = self.accounts.iter().map(|(_, a)| a.balance).sum();
        Ok(balance)
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 108: FINANCE MANAGEMENT ===\n");
    let mut fm = FinanceManagementSystem::new("fm_001".to_string());
    let asset_account = GeneralLedgerAccount::new("acc_001".to_string(), "1000".to_string(), "asset".to_string());
    let revenue_account = GeneralLedgerAccount::new("acc_002".to_string(), "4000".to_string(), "revenue".to_string());
    fm.create_account(asset_account);
    fm.create_account(revenue_account);
    let entry = JournalEntry::new("je_001".to_string(), "acc_001".to_string(), "acc_002".to_string(), 10000.0);
    fm.record_journal_entry(entry)?;
    fm.post_journal_entry("je_001")?;
    println!("✓ Journal entry posted");
    println!("✓ Total assets: ${:.2}", fm.total_assets);
    println!("✓✓✓ Finance Management operational ✓✓✓");
    Ok(())
}
