// Event Sourcing
// Event store, event replay, and temporal consistency
// Replaces: phase 25 event sourcing systems (100% rewrite in TITAN)

use omnisystem::{HashMap, Vec, String, Option, Result}
use omnisystem::time::SystemTime

struct Event {
    id: String,
    aggregate_id: String,
    event_type: String,
    data: Vec<u8>,
    version: i32,
    timestamp: i64,
    user_id: String
}

struct EventStore {
    events: Vec<Event>,
    snapshots: HashMap<String, (i32, Vec<u8>)>,  // aggregate_id -> (version, state)
    event_count: i64
}

impl EventStore {
    fn new() -> Self {
        return EventStore {
            events: Vec::new(),
            snapshots: HashMap::new(),
            event_count: 0
        }
    }

    fn append(&mut self, aggregate_id: String, event_type: String, data: Vec<u8>, user_id: String) -> Result<String, String> {
        let event_id = "event_".to_string() + &SystemTime::now().secs().to_string()

        let version = self.get_version(&aggregate_id) + 1

        let event = Event {
            id: event_id.clone(),
            aggregate_id: aggregate_id.clone(),
            event_type: event_type,
            data: data,
            version: version,
            timestamp: SystemTime::now().secs(),
            user_id: user_id
        }

        self.events.push(event)
        self.event_count = self.event_count + 1

        println("EventStore: Appended event {}", event_id)
        Ok(event_id)
    }

    fn get_events(&self, aggregate_id: String) -> Vec<Event> {
        let mut results = Vec::new()

        for event in &self.events {
            if event.aggregate_id == aggregate_id {
                results.push(event.clone())
            }
        }

        return results
    }

    fn get_version(&self, aggregate_id: &str) -> i32 {
        let mut max_version = 0

        for event in &self.events {
            if event.aggregate_id == aggregate_id && event.version > max_version {
                max_version = event.version
            }
        }

        return max_version
    }

    fn replay(&self, aggregate_id: String) -> Result<Vec<u8>, String> {
        // Check for snapshot
        if let Some((snap_version, snap_state)) = self.snapshots.get(&aggregate_id) {
            let mut state = snap_state.clone()

            // Replay events after snapshot
            for event in &self.events {
                if event.aggregate_id == aggregate_id && event.version > *snap_version {
                    // Apply event to state
                    println("EventStore: Replaying event version {}", event.version)
                }
            }

            return Ok(state)
        }

        // Full replay from start
        let mut state = Vec::new()
        for event in &self.events {
            if event.aggregate_id == aggregate_id {
                state = event.data.clone()
            }
        }

        Ok(state)
    }

    fn create_snapshot(&mut self, aggregate_id: String, version: i32, state: Vec<u8>) -> Result<(), String> {
        self.snapshots.insert(aggregate_id.clone(), (version, state))
        println("EventStore: Created snapshot for {} at version {}", aggregate_id, version)
        Ok(())
    }

    fn get_event_count(&self) -> i64 {
        return self.event_count
    }
}

fn test_event_sourcing() -> Result<(), String> {
    let mut store = EventStore::new()

    // Append events for aggregate
    store.append("user:123".to_string(), "UserCreated".to_string(), vec![1, 2, 3], "system".to_string())?
    store.append("user:123".to_string(), "EmailUpdated".to_string(), vec![4, 5], "user123".to_string())?
    store.append("user:123".to_string(), "ProfileUpdated".to_string(), vec![6], "user123".to_string())?

    let events = store.get_events("user:123".to_string())
    println("Retrieved {} events", events.len())

    let state = store.replay("user:123".to_string())?
    println("Replayed state: {} bytes", state.len())

    store.create_snapshot("user:123".to_string(), 2, state)?

    println("Total events: {}", store.get_event_count())

    Ok(())
}
