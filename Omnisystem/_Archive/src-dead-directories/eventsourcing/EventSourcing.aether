// EventSourcing.aether - Event sourcing and event store
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct DomainEvent {
    pub event_id: String,
    pub event_type: String,
    pub aggregate_id: String,
    pub aggregate_type: String,
    pub version: u32,
    pub timestamp: u64,
    pub data: HashMap<String, String>,
}

impl DomainEvent {
    pub fn new(event_id: String, event_type: String, aggregate_id: String) -> Self {
        DomainEvent {
            event_id,
            event_type,
            aggregate_id,
            aggregate_type: "Order".to_string(),
            version: 1,
            timestamp: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
            data: HashMap::new(),
        }
    }

    pub fn add_data(&mut self, key: String, value: String) {
        self.data.insert(key, value);
    }
}

pub struct EventStore {
    pub store_id: String,
    pub events: Vec<DomainEvent>,
    pub snapshots: HashMap<String, u32>,
}

impl EventStore {
    pub fn new(store_id: String) -> Self {
        EventStore {
            store_id,
            events: Vec::new(),
            snapshots: HashMap::new(),
        }
    }

    pub fn append_event(&mut self, event: DomainEvent) -> Result<(), String> {
        self.events.push(event);
        Ok(())
    }

    pub fn get_events(&self, aggregate_id: &str) -> Vec<DomainEvent> {
        self.events
            .iter()
            .filter(|e| e.aggregate_id == aggregate_id)
            .cloned()
            .collect()
    }

    pub fn create_snapshot(&mut self, aggregate_id: String, version: u32) -> Result<(), String> {
        self.snapshots.insert(aggregate_id, version);
        Ok(())
    }

    pub fn get_events_since(&self, aggregate_id: &str, version: u32) -> Vec<DomainEvent> {
        self.events
            .iter()
            .filter(|e| e.aggregate_id == aggregate_id && e.version > version)
            .cloned()
            .collect()
    }
}

pub struct EventSourcingManager {
    pub manager_id: String,
    pub event_store: EventStore,
    pub projections: HashMap<String, String>,
}

impl EventSourcingManager {
    pub fn new(manager_id: String) -> Self {
        EventSourcingManager {
            manager_id,
            event_store: EventStore::new("store_001".to_string()),
            projections: HashMap::new(),
        }
    }

    pub fn record_event(&mut self, event: DomainEvent) -> Result<(), String> {
        self.event_store.append_event(event)?;
        Ok(())
    }

    pub fn rebuild_aggregate(&self, aggregate_id: &str) -> Result<Vec<DomainEvent>, String> {
        let events = self.event_store.get_events(aggregate_id);
        if events.is_empty() {
            return Err(format!("No events for aggregate {}", aggregate_id));
        }
        Ok(events)
    }

    pub fn update_projection(&mut self, projection_id: String, state: String) {
        self.projections.insert(projection_id, state);
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 67: EVENT SOURCING ===\n");
    let mut es = EventSourcingManager::new("esm_001".to_string());
    let mut event = DomainEvent::new("evt_001".to_string(), "OrderCreated".to_string(), "order_123".to_string());
    event.add_data("customer_id".to_string(), "cust_001".to_string());
    es.record_event(event)?;
    es.update_projection("order_123_view".to_string(), "created".to_string());
    println!("✓ Event stored");
    println!("✓ Events in store: {}", es.event_store.events.len());
    println!("✓✓✓ Event Sourcing operational ✓✓✓");
    Ok(())
}
