// Sound Design System
// System sound effects, haptic feedback, audio cues, customizable sounds, 3D spatial audio
// Phase 165

use omnisystem::{Vec, HashMap, Option, Result, String, f64, bool}
use omnisystem::sync::{Arc, Mutex}

struct AudioClip {
    name: String,
    file_path: String,
    duration: f64,
    category: String,
    volume: f64,
    loop_enabled: bool
}

struct SoundEffect {
    name: String,
    trigger_event: String,
    audio_clip: String,
    volume: f64,
    pitch_variance: f64
}

struct HapticFeedback {
    intensity: f64,
    duration: f64,
    pattern: String
}

struct SpatialAudioSettings {
    position_x: f64,
    position_y: f64,
    position_z: f64,
    distance_attenuation: f64,
    doppler_level: f64
}

struct AudioMixer {
    master_volume: f64,
    sfx_volume: f64,
    music_volume: f64,
    voice_volume: f64,
    ambient_volume: f64
}

enum AudioCategory {
    UI,
    Notification,
    Success,
    Error,
    Warning,
    Music,
    Ambient,
    Voice
}

actor SoundDesignEngine {
    audio_clips: HashMap<String, AudioClip> = HashMap::new(),
    sound_effects: HashMap<String, SoundEffect> = HashMap::new(),
    mixer: AudioMixer = AudioMixer {
        master_volume: 1.0,
        sfx_volume: 0.8,
        music_volume: 0.6,
        voice_volume: 0.9,
        ambient_volume: 0.5
    },
    haptic_enabled: bool = true,
    spatial_audio_enabled: bool = true,
    active_sounds: Vec<String> = Vec::new(),
    sound_queue: Vec<String> = Vec::new(),
    max_concurrent_sounds: i32 = 32

    message RegisterAudioClip(name: String, file_path: String, category: String) -> Result<(), String> {
        if name.len() == 0 || file_path.len() == 0 {
            return Err("Invalid audio clip parameters".to_string())
        }

        let clip = AudioClip {
            name: name.clone(),
            file_path: file_path,
            duration: 0.0,
            category: category,
            volume: 1.0,
            loop_enabled: false
        }

        audio_clips.insert(name, clip)
        Ok(())
    }

    message RegisterSoundEffect(name: String, trigger_event: String, audio_clip_name: String) -> Result<(), String> {
        if !audio_clips.contains_key(&audio_clip_name) {
            return Err("Audio clip not found".to_string())
        }

        let effect = SoundEffect {
            name: name.clone(),
            trigger_event: trigger_event,
            audio_clip: audio_clip_name,
            volume: 1.0,
            pitch_variance: 0.1
        }

        sound_effects.insert(name, effect)
        Ok(())
    }

    message PlaySound(sound_name: String) -> Result<(), String> {
        if active_sounds.len() >= max_concurrent_sounds as usize {
            sound_queue.push(sound_name)
            return Ok(())
        }

        if sound_effects.contains_key(&sound_name) {
            active_sounds.push(sound_name)
            Ok(())
        } else if audio_clips.contains_key(&sound_name) {
            active_sounds.push(sound_name)
            Ok(())
        } else {
            Err("Sound not found".to_string())
        }
    }

    message StopSound(sound_name: String) -> Result<(), String> {
        if let Some(pos) = active_sounds.iter().position(|x| x == &sound_name) {
            active_sounds.remove(pos)
            Ok(())
        } else {
            Err("Sound not playing".to_string())
        }
    }

    message StopAllSounds() -> Result<(), String> {
        active_sounds.clear()
        Ok(())
    }

    message SetSoundVolume(sound_name: String, volume: f64) -> Result<(), String> {
        if volume < 0.0 || volume > 1.0 {
            return Err("Volume must be 0.0 to 1.0".to_string())
        }

        if let Some(effect) = sound_effects.get_mut(&sound_name) {
            effect.volume = volume
            return Ok(())
        }

        if let Some(clip) = audio_clips.get_mut(&sound_name) {
            clip.volume = volume
            return Ok(())
        }

        Err("Sound not found".to_string())
    }

    message PlayNotificationSound(notification_type: String) -> Result<(), String> {
        let sound_name = match notification_type.as_str() {
            "success" => "notification_success".to_string(),
            "error" => "notification_error".to_string(),
            "warning" => "notification_warning".to_string(),
            "info" => "notification_info".to_string(),
            _ => return Err("Unknown notification type".to_string())
        }

        self.PlaySound(sound_name)
    }

    message PlayUIFeedback(feedback_type: String) -> Result<(), String> {
        let sound_name = match feedback_type.as_str() {
            "tap" => "ui_tap".to_string(),
            "hover" => "ui_hover".to_string(),
            "focus" => "ui_focus".to_string(),
            "activate" => "ui_activate".to_string(),
            "error" => "ui_error".to_string(),
            _ => return Err("Unknown feedback type".to_string())
        }

        self.PlaySound(sound_name)
    }

    message SetHapticFeedback(enabled: bool) -> Result<(), String> {
        haptic_enabled = enabled
        Ok(())
    }

    message TriggerHaptic(intensity: f64, duration: f64) -> Result<(), String> {
        if !haptic_enabled {
            return Ok(())
        }

        if intensity < 0.0 || intensity > 1.0 {
            return Err("Intensity must be 0.0 to 1.0".to_string())
        }

        if duration <= 0.0 {
            return Err("Duration must be positive".to_string())
        }

        println("Haptic feedback triggered: intensity={}, duration={}", intensity, duration)
        Ok(())
    }

    message SetMasterVolume(volume: f64) -> Result<(), String> {
        if volume < 0.0 || volume > 1.0 {
            return Err("Volume must be 0.0 to 1.0".to_string())
        }
        mixer.master_volume = volume
        Ok(())
    }

    message SetCategoryVolume(category: String, volume: f64) -> Result<(), String> {
        if volume < 0.0 || volume > 1.0 {
            return Err("Volume must be 0.0 to 1.0".to_string())
        }

        match category.as_str() {
            "sfx" => mixer.sfx_volume = volume,
            "music" => mixer.music_volume = volume,
            "voice" => mixer.voice_volume = volume,
            "ambient" => mixer.ambient_volume = volume,
            _ => return Err("Unknown category".to_string())
        }

        Ok(())
    }

    message GetMasterVolume() -> f64 {
        mixer.master_volume
    }

    message SetSpatialAudioEnabled(enabled: bool) -> Result<(), String> {
        spatial_audio_enabled = enabled
        Ok(())
    }

    message PlaySpatialSound(sound_name: String, position_x: f64, position_y: f64, position_z: f64) -> Result<(), String> {
        if !spatial_audio_enabled {
            return self.PlaySound(sound_name)
        }

        println("Playing spatial sound '{}' at position ({}, {}, {})", sound_name, position_x, position_y, position_z)
        self.PlaySound(sound_name)
    }

    message GetActiveSoundCount() -> i32 {
        active_sounds.len() as i32
    }

    message GetQueuedSoundCount() -> i32 {
        sound_queue.len() as i32
    }

    message ProcessSoundQueue() -> Result<(), String> {
        while sound_queue.len() > 0 && active_sounds.len() < max_concurrent_sounds as usize {
            if let Some(sound_name) = sound_queue.first() {
                let name = sound_name.clone()
                sound_queue.remove(0)
                self.PlaySound(name)?
            }
        }

        Ok(())
    }

    message MuteAll() -> Result<(), String> {
        mixer.master_volume = 0.0
        Ok(())
    }

    message UnmuteAll(previous_volume: f64) -> Result<(), String> {
        if previous_volume < 0.0 || previous_volume > 1.0 {
            return Err("Invalid volume value".to_string())
        }
        mixer.master_volume = previous_volume
        Ok(())
    }
}

async fn test_sound_design() -> Result<(), String> {
    let audio: ActorRef<SoundDesignEngine> = spawn(SoundDesignEngine {
        audio_clips: HashMap::new(),
        sound_effects: HashMap::new(),
        mixer: AudioMixer {
            master_volume: 1.0,
            sfx_volume: 0.8,
            music_volume: 0.6,
            voice_volume: 0.9,
            ambient_volume: 0.5
        },
        haptic_enabled: true,
        spatial_audio_enabled: true,
        active_sounds: Vec::new(),
        sound_queue: Vec::new(),
        max_concurrent_sounds: 32
    })

    await audio.call(SoundDesignEngine::RegisterAudioClip("success_sound".to_string(), "/sounds/success.wav".to_string(), "success".to_string()))?
    await audio.call(SoundDesignEngine::RegisterAudioClip("error_sound".to_string(), "/sounds/error.wav".to_string(), "error".to_string()))?

    await audio.call(SoundDesignEngine::RegisterSoundEffect("ui_tap".to_string(), "button_click".to_string(), "success_sound".to_string()))?

    await audio.call(SoundDesignEngine::PlayNotificationSound("success".to_string()))?
    await audio.call(SoundDesignEngine::PlayUIFeedback("tap".to_string()))?

    let count = await audio.call(SoundDesignEngine::GetActiveSoundCount())?
    println("Active sounds: {}", count)

    await audio.call(SoundDesignEngine::SetMasterVolume(0.8))?
    let vol = await audio.call(SoundDesignEngine::GetMasterVolume())?
    println("Master volume: {}", vol)

    await audio.call(SoundDesignEngine::TriggerHaptic(0.7, 0.2))?

    Ok(())
}
