// SecurityAudit.vera - Security audit logging and forensics
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub enum AuditEventType {
    Login,
    Logout,
    DataAccess,
    DataModification,
    PermissionChange,
    ConfigChange,
    SecurityEvent,
}

pub struct AuditEvent {
    pub event_id: String,
    pub event_type: AuditEventType,
    pub user_id: String,
    pub resource: String,
    pub action: String,
    pub timestamp: u64,
    pub ip_address: String,
    pub status: String, // success, failure, unknown
}

impl AuditEvent {
    pub fn new(event_id: String, event_type: AuditEventType, user_id: String) -> Self {
        AuditEvent {
            event_id,
            event_type,
            user_id,
            resource: String::new(),
            action: String::new(),
            timestamp: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
            ip_address: String::new(),
            status: "unknown".to_string(),
        }
    }
}

pub struct AuditPolicy {
    pub policy_id: String,
    pub name: String,
    pub retention_days: u32,
    pub enabled_events: Vec<String>,
    pub excluded_users: Vec<String>,
}

impl AuditPolicy {
    pub fn new(policy_id: String, name: String, retention_days: u32) -> Self {
        AuditPolicy {
            policy_id,
            name,
            retention_days,
            enabled_events: Vec::new(),
            excluded_users: Vec::new(),
        }
    }

    pub fn add_enabled_event(&mut self, event: String) {
        if !self.enabled_events.contains(&event) {
            self.enabled_events.push(event);
        }
    }

    pub fn add_excluded_user(&mut self, user: String) {
        if !self.excluded_users.contains(&user) {
            self.excluded_users.push(user);
        }
    }
}

pub struct SecurityAuditSystem {
    pub system_id: String,
    pub events: HashMap<String, AuditEvent>,
    pub policy: AuditPolicy,
    pub total_events: u32,
    pub security_events: u32,
}

impl SecurityAuditSystem {
    pub fn new(system_id: String) -> Self {
        SecurityAuditSystem {
            system_id,
            events: HashMap::new(),
            policy: AuditPolicy::new("policy_001".to_string(), "Default".to_string(), 90),
            total_events: 0,
            security_events: 0,
        }
    }

    pub fn log_event(&mut self, event: AuditEvent) -> Result<String, String> {
        let event_id = event.event_id.clone();

        // Check policy exclusions
        if self.policy.excluded_users.contains(&event.user_id) {
            return Err("User excluded from audit".to_string());
        }

        self.events.insert(event_id.clone(), event);
        self.total_events += 1;

        Ok(event_id)
    }

    pub fn record_security_event(&mut self, event: AuditEvent) -> Result<String, String> {
        let event_id = event.event_id.clone();
        self.log_event(event)?;
        self.security_events += 1;
        Ok(event_id)
    }

    pub fn query_events(&self, user_id: &str) -> Vec<String> {
        self.events
            .iter()
            .filter(|(_, e)| e.user_id == user_id)
            .map(|(id, _)| id.clone())
            .collect()
    }

    pub fn get_audit_report(&self) -> String {
        format!(
            "Audit Report: {} total events, {} security events, {} retention days",
            self.total_events, self.security_events, self.policy.retention_days
        )
    }

    pub fn purge_old_events(&mut self, days_old: u32) -> Result<u32, String> {
        let now = std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .unwrap()
            .as_secs();

        let cutoff = now - (days_old as u64 * 86400);
        let count = self.events
            .iter()
            .filter(|(_, e)| e.timestamp < cutoff)
            .count();

        self.events.retain(|_, e| e.timestamp >= cutoff);

        Ok(count as u32)
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 96: SECURITY AUDIT ===\n");
    let mut sas = SecurityAuditSystem::new("sas_001".to_string());
    sas.policy.add_enabled_event("Login".to_string());
    sas.policy.add_enabled_event("DataAccess".to_string());
    let event = AuditEvent::new("evt_001".to_string(), AuditEventType::Login, "user_001".to_string());
    sas.log_event(event)?;
    println!("✓ Audit event logged");
    println!("✓ {}", sas.get_audit_report());
    println!("✓✓✓ Security Audit operational ✓✓✓");
    Ok(())
}
