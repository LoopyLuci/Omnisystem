// BudgetManager.vera - Budget tracking and cost management
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct CostEntry {
    pub entry_id: String,
    pub resource_type: String,
    pub cost_per_unit: f64,
    pub units_used: f64,
    pub total_cost: f64,
    pub timestamp: u64,
}

impl CostEntry {
    pub fn new(entry_id: String, resource_type: String, cost_per_unit: f64, units_used: f64) -> Self {
        let total_cost = cost_per_unit * units_used;
        CostEntry {
            entry_id,
            resource_type,
            cost_per_unit,
            units_used,
            total_cost,
            timestamp: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
        }
    }
}

pub struct Budget {
    pub budget_id: String,
    pub resource_type: String,
    pub monthly_limit: f64,
    pub current_spend: f64,
    pub entries: Vec<CostEntry>,
}

impl Budget {
    pub fn new(budget_id: String, resource_type: String, monthly_limit: f64) -> Self {
        Budget {
            budget_id,
            resource_type,
            monthly_limit,
            current_spend: 0.0,
            entries: Vec::new(),
        }
    }

    pub fn add_cost(&mut self, entry: CostEntry) -> Result<(), String> {
        self.current_spend += entry.total_cost;
        if self.current_spend > self.monthly_limit {
            return Err(format!("Budget exceeded: {} > {}", self.current_spend, self.monthly_limit));
        }
        self.entries.push(entry);
        Ok(())
    }

    pub fn get_remaining(&self) -> f64 {
        if self.current_spend > self.monthly_limit {
            0.0
        } else {
            self.monthly_limit - self.current_spend
        }
    }

    pub fn get_utilization_percentage(&self) -> f64 {
        (self.current_spend / self.monthly_limit) * 100.0
    }
}

pub struct BudgetManager {
    pub manager_id: String,
    pub budgets: HashMap<String, Budget>,
    pub total_spend: f64,
}

impl BudgetManager {
    pub fn new(manager_id: String) -> Self {
        BudgetManager {
            manager_id,
            budgets: HashMap::new(),
            total_spend: 0.0,
        }
    }

    pub fn create_budget(&mut self, budget: Budget) {
        self.budgets.insert(budget.budget_id.clone(), budget);
    }

    pub fn record_cost(&mut self, budget_id: &str, resource_type: String, cost_per_unit: f64, units: f64) -> Result<(), String> {
        if let Some(budget) = self.budgets.get_mut(budget_id) {
            let entry = CostEntry::new(
                format!("cost_{}", budget.entries.len()),
                resource_type,
                cost_per_unit,
                units,
            );
            budget.add_cost(entry)?;
            self.total_spend += cost_per_unit * units;
            Ok(())
        } else {
            Err(format!("Budget {} not found", budget_id))
        }
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 66: BUDGET MANAGER ===\n");
    let mut bm = BudgetManager::new("bm_001".to_string());
    let budget = Budget::new("compute".to_string(), "compute".to_string(), 10000.0);
    bm.create_budget(budget);
    bm.record_cost("compute", "cpu_hours".to_string(), 10.0, 50.0)?;
    println!("✓ Cost recorded: $500");
    println!("✓ Remaining: ${}", bm.budgets["compute"].get_remaining());
    println!("✓✓✓ Budget Manager operational ✓✓✓");
    Ok(())
}
