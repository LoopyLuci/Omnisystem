// DisasterRecoveryPlanner.vera - Disaster recovery planning and execution
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub enum RecoveryPriority {
    Critical,
    High,
    Medium,
    Low,
}

pub struct RecoveryPlan {
    pub plan_id: String,
    pub system_name: String,
    pub rto_minutes: u32, // Recovery Time Objective
    pub rpo_minutes: u32, // Recovery Point Objective
    pub priority: RecoveryPriority,
    pub steps: Vec<String>,
}

impl RecoveryPlan {
    pub fn new(plan_id: String, system_name: String, rto: u32, rpo: u32, priority: RecoveryPriority) -> Self {
        RecoveryPlan {
            plan_id,
            system_name,
            rto_minutes: rto,
            rpo_minutes: rpo,
            priority,
            steps: Vec::new(),
        }
    }

    pub fn add_step(&mut self, step: String) {
        self.steps.push(step);
    }

    pub fn estimate_recovery_time(&self) -> u32 {
        (self.steps.len() as u32) * 2 // 2 minutes per step estimate
    }
}

pub struct DisasterEvent {
    pub event_id: String,
    pub system_affected: String,
    pub severity: String, // low, medium, high, critical
    pub detected_at: u64,
    pub recovery_started: Option<u64>,
    pub recovery_completed: Option<u64>,
}

impl DisasterEvent {
    pub fn new(event_id: String, system_affected: String, severity: String) -> Self {
        DisasterEvent {
            event_id,
            system_affected,
            severity,
            detected_at: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
            recovery_started: None,
            recovery_completed: None,
        }
    }

    pub fn start_recovery(&mut self) {
        self.recovery_started = Some(
            std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs()
        );
    }

    pub fn complete_recovery(&mut self) {
        self.recovery_completed = Some(
            std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs()
        );
    }

    pub fn get_recovery_time_minutes(&self) -> Option<u32> {
        match (self.recovery_started, self.recovery_completed) {
            (Some(start), Some(end)) => Some(((end - start) / 60) as u32),
            _ => None,
        }
    }
}

pub struct DisasterRecoveryPlanner {
    pub planner_id: String,
    pub plans: HashMap<String, RecoveryPlan>,
    pub events: HashMap<String, DisasterEvent>,
    pub total_recoveries: u32,
    pub successful_recoveries: u32,
}

impl DisasterRecoveryPlanner {
    pub fn new(planner_id: String) -> Self {
        DisasterRecoveryPlanner {
            planner_id,
            plans: HashMap::new(),
            events: HashMap::new(),
            total_recoveries: 0,
            successful_recoveries: 0,
        }
    }

    pub fn register_plan(&mut self, plan: RecoveryPlan) {
        self.plans.insert(plan.plan_id.clone(), plan);
    }

    pub fn report_disaster(&mut self, event: DisasterEvent) -> Result<String, String> {
        let event_id = event.event_id.clone();
        self.events.insert(event_id.clone(), event);
        self.total_recoveries += 1;
        Ok(event_id)
    }

    pub fn execute_recovery(&mut self, event_id: &str, plan_id: &str) -> Result<(), String> {
        if let Some(event) = self.events.get_mut(event_id) {
            if let Some(plan) = self.plans.get(plan_id) {
                event.start_recovery();
                event.complete_recovery();
                let recovery_time = event.get_recovery_time_minutes();

                if let Some(time) = recovery_time {
                    if time <= plan.rto_minutes {
                        self.successful_recoveries += 1;
                    }
                }
                Ok(())
            } else {
                Err(format!("Plan {} not found", plan_id))
            }
        } else {
            Err(format!("Event {} not found", event_id))
        }
    }

    pub fn get_recovery_success_rate(&self) -> f64 {
        if self.total_recoveries == 0 {
            0.0
        } else {
            (self.successful_recoveries as f64 / self.total_recoveries as f64) * 100.0
        }
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 90: DISASTER RECOVERY PLANNER ===\n");
    let mut drp = DisasterRecoveryPlanner::new("drp_001".to_string());
    let plan = RecoveryPlan::new("plan_db".to_string(), "database".to_string(), 30, 5, RecoveryPriority::Critical);
    drp.register_plan(plan);
    let event = DisasterEvent::new("evt_001".to_string(), "database".to_string(), "critical".to_string());
    drp.report_disaster(event)?;
    drp.execute_recovery("evt_001", "plan_db")?;
    println!("✓ Disaster recovery executed");
    println!("✓ Recovery success rate: {:.1}%", drp.get_recovery_success_rate());
    println!("✓✓✓ Disaster Recovery Planner operational ✓✓✓");
    Ok(())
}
