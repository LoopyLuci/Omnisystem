// EnvironmentalHealthSafety.vera - EHS management and compliance
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct SafetyIncident {
    pub incident_id: String,
    pub location: String,
    pub description: String,
    pub severity: String, // minor, serious, fatal
    pub reported_at: u64,
    pub investigated: bool,
}

impl SafetyIncident {
    pub fn new(incident_id: String, location: String, severity: String) -> Self {
        SafetyIncident {
            incident_id,
            location,
            description: String::new(),
            severity,
            reported_at: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
            investigated: false,
        }
    }

    pub fn mark_investigated(&mut self) {
        self.investigated = true;
    }
}

pub struct EnvironmentalMonitor {
    pub monitor_id: String,
    pub location: String,
    pub air_quality_index: f64,
    pub waste_volume_kg: f64,
    pub water_usage_liters: f64,
}

impl EnvironmentalMonitor {
    pub fn new(monitor_id: String, location: String) -> Self {
        EnvironmentalMonitor {
            monitor_id,
            location,
            air_quality_index: 50.0,
            waste_volume_kg: 0.0,
            water_usage_liters: 0.0,
        }
    }

    pub fn update_reading(&mut self, aqi: f64, waste: f64, water: f64) {
        self.air_quality_index = aqi;
        self.waste_volume_kg = waste;
        self.water_usage_liters = water;
    }
}

pub struct SafetyTraining {
    pub training_id: String,
    pub title: String,
    pub required: bool,
    pub participants: Vec<String>,
    pub completion_date: u64,
}

impl SafetyTraining {
    pub fn new(training_id: String, title: String, required: bool) -> Self {
        SafetyTraining {
            training_id,
            title,
            required,
            participants: Vec::new(),
            completion_date: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
        }
    }

    pub fn enroll(&mut self, employee_id: String) {
        if !self.participants.contains(&employee_id) {
            self.participants.push(employee_id);
        }
    }
}

pub struct EnvironmentalHealthSafetySystem {
    pub system_id: String,
    pub incidents: HashMap<String, SafetyIncident>,
    pub monitors: HashMap<String, EnvironmentalMonitor>,
    pub training_programs: HashMap<String, SafetyTraining>,
    pub total_incidents: u32,
}

impl EnvironmentalHealthSafetySystem {
    pub fn new(system_id: String) -> Self {
        EnvironmentalHealthSafetySystem {
            system_id,
            incidents: HashMap::new(),
            monitors: HashMap::new(),
            training_programs: HashMap::new(),
            total_incidents: 0,
        }
    }

    pub fn report_incident(&mut self, incident: SafetyIncident) {
        self.incidents.insert(incident.incident_id.clone(), incident);
        self.total_incidents += 1;
    }

    pub fn register_monitor(&mut self, monitor: EnvironmentalMonitor) {
        self.monitors.insert(monitor.monitor_id.clone(), monitor);
    }

    pub fn create_training(&mut self, training: SafetyTraining) {
        self.training_programs.insert(training.training_id.clone(), training);
    }

    pub fn get_uninvestigated_incidents(&self) -> u32 {
        self.incidents
            .iter()
            .filter(|(_, i)| !i.investigated)
            .count() as u32
    }

    pub fn get_average_aqi(&self) -> f64 {
        if self.monitors.is_empty() {
            0.0
        } else {
            let sum: f64 = self.monitors.iter().map(|(_, m)| m.air_quality_index).sum();
            sum / self.monitors.len() as f64
        }
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 114: ENVIRONMENTAL HEALTH & SAFETY ===\n");
    let mut ehs = EnvironmentalHealthSafetySystem::new("ehs_001".to_string());
    let incident = SafetyIncident::new("inc_001".to_string(), "Building A".to_string(), "minor".to_string());
    ehs.report_incident(incident);
    let monitor = EnvironmentalMonitor::new("mon_001".to_string(), "Floor 1".to_string());
    ehs.register_monitor(monitor);
    let training = SafetyTraining::new("train_001".to_string(), "Fire Safety".to_string(), true);
    ehs.create_training(training);
    println!("✓ Incident, monitor, and training recorded");
    println!("✓ Average AQI: {:.1}", ehs.get_average_aqi());
    println!("✓✓✓ Environmental Health & Safety operational ✓✓✓");
    Ok(())
}
