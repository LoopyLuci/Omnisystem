// HumanResourcesManagement.titan - Human resources and talent management
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct Employee {
    pub employee_id: String,
    pub name: String,
    pub email: String,
    pub department: String,
    pub position: String,
    pub salary: f64,
    pub hire_date: u64,
    pub status: String, // active, inactive, terminated
}

impl Employee {
    pub fn new(employee_id: String, name: String, department: String) -> Self {
        Employee {
            employee_id,
            name,
            email: String::new(),
            department,
            position: String::new(),
            salary: 0.0,
            hire_date: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
            status: "active".to_string(),
        }
    }

    pub fn terminate(&mut self) {
        self.status = "terminated".to_string();
    }
}

pub struct PerformanceReview {
    pub review_id: String,
    pub employee_id: String,
    pub reviewer_id: String,
    pub rating: f64, // 1-5
    pub comments: String,
    pub review_date: u64,
}

impl PerformanceReview {
    pub fn new(review_id: String, employee_id: String, reviewer_id: String, rating: f64) -> Self {
        PerformanceReview {
            review_id,
            employee_id,
            reviewer_id,
            rating: rating.clamp(1.0, 5.0),
            comments: String::new(),
            review_date: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
        }
    }
}

pub struct TrainingProgram {
    pub program_id: String,
    pub name: String,
    pub description: String,
    pub duration_hours: u32,
    pub participants: Vec<String>,
}

impl TrainingProgram {
    pub fn new(program_id: String, name: String, duration: u32) -> Self {
        TrainingProgram {
            program_id,
            name,
            description: String::new(),
            duration_hours: duration,
            participants: Vec::new(),
        }
    }

    pub fn enroll(&mut self, employee_id: String) {
        if !self.participants.contains(&employee_id) {
            self.participants.push(employee_id);
        }
    }
}

pub struct HumanResourcesManagementSystem {
    pub system_id: String,
    pub employees: HashMap<String, Employee>,
    pub reviews: HashMap<String, PerformanceReview>,
    pub training_programs: HashMap<String, TrainingProgram>,
    pub total_payroll: f64,
}

impl HumanResourcesManagementSystem {
    pub fn new(system_id: String) -> Self {
        HumanResourcesManagementSystem {
            system_id,
            employees: HashMap::new(),
            reviews: HashMap::new(),
            training_programs: HashMap::new(),
            total_payroll: 0.0,
        }
    }

    pub fn hire_employee(&mut self, employee: Employee) -> Result<String, String> {
        let employee_id = employee.employee_id.clone();
        self.total_payroll += employee.salary;
        self.employees.insert(employee_id.clone(), employee);
        Ok(employee_id)
    }

    pub fn conduct_review(&mut self, review: PerformanceReview) {
        self.reviews.insert(review.review_id.clone(), review);
    }

    pub fn create_training(&mut self, program: TrainingProgram) {
        self.training_programs.insert(program.program_id.clone(), program);
    }

    pub fn get_active_employees(&self) -> u32 {
        self.employees
            .iter()
            .filter(|(_, e)| e.status == "active")
            .count() as u32
    }

    pub fn get_average_review_rating(&self) -> f64 {
        if self.reviews.is_empty() {
            0.0
        } else {
            let total: f64 = self.reviews.iter().map(|(_, r)| r.rating).sum();
            total / self.reviews.len() as f64
        }
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 109: HUMAN RESOURCES MANAGEMENT ===\n");
    let mut hrms = HumanResourcesManagementSystem::new("hrms_001".to_string());
    let mut emp = Employee::new("emp_001".to_string(), "Bob Smith".to_string(), "Engineering".to_string());
    emp.salary = 120000.0;
    emp.position = "Senior Engineer".to_string();
    hrms.hire_employee(emp)?;
    let review = PerformanceReview::new("rev_001".to_string(), "emp_001".to_string(), "mgr_001".to_string(), 4.5);
    hrms.conduct_review(review);
    println!("✓ Employee hired and reviewed");
    println!("✓ Active employees: {}", hrms.get_active_employees());
    println!("✓✓✓ Human Resources Management operational ✓✓✓");
    Ok(())
}
