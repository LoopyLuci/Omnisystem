// IncidentManagementSystem.vera - Incident management and response
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct SecurityIncident {
    pub incident_id: String,
    pub title: String,
    pub description: String,
    pub severity: String, // critical, high, medium, low
    pub status: String, // detected, acknowledged, investigating, contained, resolved, closed
    pub created_at: u64,
    pub resolved_at: Option<u64>,
}

impl SecurityIncident {
    pub fn new(incident_id: String, title: String) -> Self {
        SecurityIncident {
            incident_id,
            title,
            description: String::new(),
            severity: "medium".to_string(),
            status: "detected".to_string(),
            created_at: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
            resolved_at: None,
        }
    }

    pub fn acknowledge(&mut self) {
        self.status = "acknowledged".to_string();
    }

    pub fn resolve(&mut self) {
        self.status = "resolved".to_string();
        self.resolved_at = Some(std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .unwrap()
            .as_secs());
    }

    pub fn get_duration_seconds(&self) -> u64 {
        match self.resolved_at {
            Some(resolved) => resolved - self.created_at,
            None => std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs() - self.created_at,
        }
    }
}

pub struct IncidentResponse {
    pub response_id: String,
    pub incident_id: String,
    pub responder: String,
    pub action_taken: String,
    pub timestamp: u64,
    pub impact: String, // contained, escalated, no_change
}

impl IncidentResponse {
    pub fn new(response_id: String, incident_id: String, responder: String) -> Self {
        IncidentResponse {
            response_id,
            incident_id,
            responder,
            action_taken: String::new(),
            timestamp: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
            impact: "no_change".to_string(),
        }
    }
}

pub struct RootCauseAnalysis {
    pub rca_id: String,
    pub incident_id: String,
    pub root_cause: String,
    pub contributing_factors: Vec<String>,
    pub analysis_date: u64,
    pub completed: bool,
}

impl RootCauseAnalysis {
    pub fn new(rca_id: String, incident_id: String) -> Self {
        RootCauseAnalysis {
            rca_id,
            incident_id,
            root_cause: String::new(),
            contributing_factors: Vec::new(),
            analysis_date: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
            completed: false,
        }
    }

    pub fn add_factor(&mut self, factor: String) {
        if !self.contributing_factors.contains(&factor) {
            self.contributing_factors.push(factor);
        }
    }

    pub fn mark_complete(&mut self) {
        self.completed = true;
    }
}

pub struct RemediationAction {
    pub action_id: String,
    pub incident_id: String,
    pub action_description: String,
    pub owner: String,
    pub due_date: u64,
    pub status: String, // planned, in_progress, completed
    pub priority: u32, // 1-5 scale
}

impl RemediationAction {
    pub fn new(action_id: String, incident_id: String, description: String) -> Self {
        RemediationAction {
            action_id,
            incident_id,
            action_description: description,
            owner: String::new(),
            due_date: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs() + (30 * 86400),
            status: "planned".to_string(),
            priority: 3,
        }
    }

    pub fn start(&mut self) {
        self.status = "in_progress".to_string();
    }

    pub fn complete(&mut self) {
        self.status = "completed".to_string();
    }
}

pub struct IncidentManagementSystemStruct {
    pub system_id: String,
    pub incidents: HashMap<String, SecurityIncident>,
    pub responses: HashMap<String, IncidentResponse>,
    pub analyses: HashMap<String, RootCauseAnalysis>,
    pub remediations: HashMap<String, RemediationAction>,
}

impl IncidentManagementSystemStruct {
    pub fn new(system_id: String) -> Self {
        IncidentManagementSystemStruct {
            system_id,
            incidents: HashMap::new(),
            responses: HashMap::new(),
            analyses: HashMap::new(),
            remediations: HashMap::new(),
        }
    }

    pub fn create_incident(&mut self, incident: SecurityIncident) {
        self.incidents.insert(incident.incident_id.clone(), incident);
    }

    pub fn record_response(&mut self, response: IncidentResponse) {
        self.responses.insert(response.response_id.clone(), response);
    }

    pub fn perform_rca(&mut self, analysis: RootCauseAnalysis) {
        self.analyses.insert(analysis.rca_id.clone(), analysis);
    }

    pub fn create_remediation(&mut self, action: RemediationAction) {
        self.remediations.insert(action.action_id.clone(), action);
    }

    pub fn get_open_incidents(&self) -> u32 {
        self.incidents
            .iter()
            .filter(|(_, i)| i.status != "closed")
            .count() as u32
    }

    pub fn get_critical_incidents(&self) -> u32 {
        self.incidents
            .iter()
            .filter(|(_, i)| i.severity == "critical")
            .count() as u32
    }

    pub fn get_pending_remediations(&self) -> u32 {
        self.remediations
            .iter()
            .filter(|(_, r)| r.status != "completed")
            .count() as u32
    }

    pub fn get_completed_rcas(&self) -> u32 {
        self.analyses
            .iter()
            .filter(|(_, a)| a.completed)
            .count() as u32
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 143: INCIDENT MANAGEMENT SYSTEM ===\n");
    let mut ims = IncidentManagementSystemStruct::new("ims_001".to_string());
    let incident = SecurityIncident::new("inc_001".to_string(), "Data Breach Detected".to_string());
    ims.create_incident(incident);
    let response = IncidentResponse::new("resp_001".to_string(), "inc_001".to_string(), "analyst_001".to_string());
    ims.record_response(response);
    let rca = RootCauseAnalysis::new("rca_001".to_string(), "inc_001".to_string());
    ims.perform_rca(rca);
    let remediation = RemediationAction::new("rem_001".to_string(), "inc_001".to_string(), "Patch vulnerability".to_string());
    ims.create_remediation(remediation);
    println!("✓ Incident, response, RCA, and remediation recorded");
    println!("✓ Open incidents: {}", ims.get_open_incidents());
    println!("✓✓✓ Incident Management System operational ✓✓✓");
    Ok(())
}
