// ProjectPortfolioManagement.aether - Project portfolio management
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct Project {
    pub project_id: String,
    pub name: String,
    pub description: String,
    pub status: String, // planning, active, on_hold, completed
    pub budget: f64,
    pub spent: f64,
    pub start_date: u64,
    pub target_end_date: u64,
}

impl Project {
    pub fn new(project_id: String, name: String, budget: f64) -> Self {
        let now = std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .unwrap()
            .as_secs();

        Project {
            project_id,
            name,
            description: String::new(),
            status: "planning".to_string(),
            budget,
            spent: 0.0,
            start_date: now,
            target_end_date: now + (180 * 86400), // 6 months
        }
    }

    pub fn activate(&mut self) {
        self.status = "active".to_string();
    }

    pub fn record_expense(&mut self, amount: f64) {
        self.spent += amount;
    }

    pub fn budget_remaining(&self) -> f64 {
        (self.budget - self.spent).max(0.0)
    }

    pub fn budget_percentage_used(&self) -> f64 {
        if self.budget == 0.0 {
            0.0
        } else {
            (self.spent / self.budget) * 100.0
        }
    }
}

pub struct ProjectTask {
    pub task_id: String,
    pub project_id: String,
    pub title: String,
    pub assigned_to: String,
    pub status: String, // todo, in_progress, completed
    pub due_date: u64,
}

impl ProjectTask {
    pub fn new(task_id: String, project_id: String, title: String) -> Self {
        ProjectTask {
            task_id,
            project_id,
            title,
            assigned_to: String::new(),
            status: "todo".to_string(),
            due_date: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs() + (30 * 86400),
        }
    }

    pub fn start(&mut self) {
        self.status = "in_progress".to_string();
    }

    pub fn complete(&mut self) {
        self.status = "completed".to_string();
    }
}

pub struct Portfolio {
    pub portfolio_id: String,
    pub name: String,
    pub projects: Vec<String>,
    pub total_budget: f64,
    pub total_spent: f64,
}

impl Portfolio {
    pub fn new(portfolio_id: String, name: String) -> Self {
        Portfolio {
            portfolio_id,
            name,
            projects: Vec::new(),
            total_budget: 0.0,
            total_spent: 0.0,
        }
    }

    pub fn add_project(&mut self, project_id: String, budget: f64) {
        self.projects.push(project_id);
        self.total_budget += budget;
    }
}

pub struct ProjectPortfolioManagementSystem {
    pub system_id: String,
    pub projects: HashMap<String, Project>,
    pub tasks: HashMap<String, ProjectTask>,
    pub portfolios: HashMap<String, Portfolio>,
}

impl ProjectPortfolioManagementSystem {
    pub fn new(system_id: String) -> Self {
        ProjectPortfolioManagementSystem {
            system_id,
            projects: HashMap::new(),
            tasks: HashMap::new(),
            portfolios: HashMap::new(),
        }
    }

    pub fn create_project(&mut self, project: Project) -> Result<String, String> {
        let project_id = project.project_id.clone();
        self.projects.insert(project_id.clone(), project);
        Ok(project_id)
    }

    pub fn create_task(&mut self, task: ProjectTask) {
        self.tasks.insert(task.task_id.clone(), task);
    }

    pub fn create_portfolio(&mut self, portfolio: Portfolio) {
        self.portfolios.insert(portfolio.portfolio_id.clone(), portfolio);
    }

    pub fn get_portfolio_health(&self) -> f64 {
        let total_budget: f64 = self.projects.iter().map(|(_, p)| p.budget).sum();
        let total_spent: f64 = self.projects.iter().map(|(_, p)| p.spent).sum();
        if total_budget == 0.0 {
            0.0
        } else {
            (total_spent / total_budget) * 100.0
        }
    }

    pub fn get_completed_tasks(&self) -> u32 {
        self.tasks
            .iter()
            .filter(|(_, t)| t.status == "completed")
            .count() as u32
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 111: PROJECT PORTFOLIO MANAGEMENT ===\n");
    let mut ppms = ProjectPortfolioManagementSystem::new("ppms_001".to_string());
    let project = Project::new("proj_001".to_string(), "System Upgrade".to_string(), 500000.0);
    ppms.create_project(project)?;
    let task = ProjectTask::new("task_001".to_string(), "proj_001".to_string(), "Design Architecture".to_string());
    ppms.create_task(task);
    let portfolio = Portfolio::new("port_001".to_string(), "IT Initiatives".to_string());
    ppms.create_portfolio(portfolio);
    println!("✓ Project and task created");
    println!("✓ Portfolio health: {:.1}%", ppms.get_portfolio_health());
    println!("✓✓✓ Project Portfolio Management operational ✓✓✓");
    Ok(())
}
