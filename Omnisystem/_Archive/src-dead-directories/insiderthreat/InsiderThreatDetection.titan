// InsiderThreatDetection.titan - Insider threat detection and monitoring
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct UserBehaviorProfile {
    pub profile_id: String,
    pub user_id: String,
    pub department: String,
    pub role: String,
    pub baseline_login_time: u32,
    pub baseline_data_access_count: u32,
    pub baseline_file_copy_count: u32,
    pub created_at: u64,
}

impl UserBehaviorProfile {
    pub fn new(profile_id: String, user_id: String, role: String) -> Self {
        UserBehaviorProfile {
            profile_id,
            user_id,
            department: String::new(),
            role,
            baseline_login_time: 480, // 8 hours
            baseline_data_access_count: 100,
            baseline_file_copy_count: 5,
            created_at: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
        }
    }
}

pub struct BehaviorAnomaly {
    pub anomaly_id: String,
    pub user_id: String,
    pub anomaly_type: String, // unusual_access, data_exfiltration, login_anomaly, privilege_misuse
    pub severity: String, // critical, high, medium, low
    pub detected_at: u64,
    pub description: String,
    pub risk_score: f64, // 0.0 to 100.0
}

impl BehaviorAnomaly {
    pub fn new(anomaly_id: String, user_id: String, anomaly_type: String) -> Self {
        BehaviorAnomaly {
            anomaly_id,
            user_id,
            anomaly_type,
            severity: "medium".to_string(),
            detected_at: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
            description: String::new(),
            risk_score: 0.0,
        }
    }

    pub fn assess_risk(&mut self, score: f64) {
        self.risk_score = (score).min(100.0);
    }
}

pub struct DataAccessEvent {
    pub event_id: String,
    pub user_id: String,
    pub data_classification: String, // public, internal, confidential, restricted
    pub resource_accessed: String,
    pub access_time: u64,
    pub bytes_accessed: u64,
    pub copy_operation: bool,
    pub anomalous: bool,
}

impl DataAccessEvent {
    pub fn new(event_id: String, user_id: String, data_class: String) -> Self {
        DataAccessEvent {
            event_id,
            user_id,
            data_classification: data_class,
            resource_accessed: String::new(),
            access_time: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
            bytes_accessed: 0,
            copy_operation: false,
            anomalous: false,
        }
    }

    pub fn flag_as_anomalous(&mut self) {
        self.anomalous = true;
    }
}

pub struct RiskAlert {
    pub alert_id: String,
    pub user_id: String,
    pub risk_level: String, // critical, high, medium, low
    pub triggered_by: Vec<String>, // anomaly IDs that triggered this
    pub alert_time: u64,
    pub status: String, // active, acknowledged, investigating, resolved
    pub assigned_investigator: String,
}

impl RiskAlert {
    pub fn new(alert_id: String, user_id: String) -> Self {
        RiskAlert {
            alert_id,
            user_id,
            risk_level: "medium".to_string(),
            triggered_by: Vec::new(),
            alert_time: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
            status: "active".to_string(),
            assigned_investigator: String::new(),
        }
    }

    pub fn acknowledge(&mut self) {
        self.status = "acknowledged".to_string();
    }

    pub fn resolve(&mut self) {
        self.status = "resolved".to_string();
    }
}

pub struct InsiderThreatDetectionSystem {
    pub system_id: String,
    pub profiles: HashMap<String, UserBehaviorProfile>,
    pub anomalies: HashMap<String, BehaviorAnomaly>,
    pub access_events: HashMap<String, DataAccessEvent>,
    pub alerts: HashMap<String, RiskAlert>,
}

impl InsiderThreatDetectionSystem {
    pub fn new(system_id: String) -> Self {
        InsiderThreatDetectionSystem {
            system_id,
            profiles: HashMap::new(),
            anomalies: HashMap::new(),
            access_events: HashMap::new(),
            alerts: HashMap::new(),
        }
    }

    pub fn create_profile(&mut self, profile: UserBehaviorProfile) {
        self.profiles.insert(profile.profile_id.clone(), profile);
    }

    pub fn detect_anomaly(&mut self, anomaly: BehaviorAnomaly) {
        self.anomalies.insert(anomaly.anomaly_id.clone(), anomaly);
    }

    pub fn log_access_event(&mut self, event: DataAccessEvent) {
        self.access_events.insert(event.event_id.clone(), event);
    }

    pub fn generate_alert(&mut self, alert: RiskAlert) -> Result<String, String> {
        let alert_id = alert.alert_id.clone();
        self.alerts.insert(alert_id.clone(), alert);
        Ok(alert_id)
    }

    pub fn get_high_risk_users(&self) -> u32 {
        self.alerts
            .iter()
            .filter(|(_, a)| a.risk_level == "high" || a.risk_level == "critical")
            .map(|(_, a)| a.user_id.clone())
            .collect::<std::collections::HashSet<_>>()
            .len() as u32
    }

    pub fn get_anomalous_access_events(&self) -> u32 {
        self.access_events
            .iter()
            .filter(|(_, e)| e.anomalous)
            .count() as u32
    }

    pub fn get_active_alerts(&self) -> u32 {
        self.alerts
            .iter()
            .filter(|(_, a)| a.status == "active")
            .count() as u32
    }

    pub fn get_critical_risk_alerts(&self) -> u32 {
        self.alerts
            .iter()
            .filter(|(_, a)| a.risk_level == "critical")
            .count() as u32
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 147: INSIDER THREAT DETECTION ===\n");
    let mut itds = InsiderThreatDetectionSystem::new("itds_001".to_string());
    let profile = UserBehaviorProfile::new("prof_001".to_string(), "user_001".to_string(), "analyst".to_string());
    itds.create_profile(profile);
    let anomaly = BehaviorAnomaly::new("anom_001".to_string(), "user_001".to_string(), "data_exfiltration".to_string());
    itds.detect_anomaly(anomaly);
    let event = DataAccessEvent::new("event_001".to_string(), "user_001".to_string(), "confidential".to_string());
    itds.log_access_event(event);
    let alert = RiskAlert::new("alert_001".to_string(), "user_001".to_string());
    itds.generate_alert(alert)?;
    println!("✓ Profile, anomaly, event, and alert recorded");
    println!("✓ Active alerts: {}", itds.get_active_alerts());
    println!("✓✓✓ Insider Threat Detection operational ✓✓✓");
    Ok(())
}
