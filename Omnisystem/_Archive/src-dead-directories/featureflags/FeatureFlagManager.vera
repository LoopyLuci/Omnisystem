// FeatureFlagManager.vera - Feature flags and canary deployments
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct FeatureFlag {
    pub flag_id: String,
    pub is_enabled: bool,
    pub rollout_percentage: u8,
    pub target_users: Vec<String>,
    pub created_at: u64,
}

impl FeatureFlag {
    pub fn new(flag_id: String, enabled: bool) -> Self {
        FeatureFlag {
            flag_id,
            is_enabled: enabled,
            rollout_percentage: 0,
            target_users: Vec::new(),
            created_at: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
        }
    }

    pub fn set_rollout(&mut self, percentage: u8) {
        self.rollout_percentage = percentage.min(100);
    }

    pub fn is_enabled_for_user(&self, user_id: &str) -> bool {
        if !self.is_enabled {
            return false;
        }

        if self.target_users.contains(&user_id.to_string()) {
            return true;
        }

        let user_hash = user_id.len() % 100;
        user_hash < self.rollout_percentage as usize
    }
}

pub struct FeatureFlagManager {
    pub manager_id: String,
    pub flags: HashMap<String, FeatureFlag>,
}

impl FeatureFlagManager {
    pub fn new(manager_id: String) -> Self {
        FeatureFlagManager {
            manager_id,
            flags: HashMap::new(),
        }
    }

    pub fn create_flag(&mut self, flag: FeatureFlag) {
        self.flags.insert(flag.flag_id.clone(), flag);
    }

    pub fn is_enabled(&self, flag_id: &str, user_id: &str) -> bool {
        if let Some(flag) = self.flags.get(flag_id) {
            flag.is_enabled_for_user(user_id)
        } else {
            false
        }
    }

    pub fn enable_canary(&mut self, flag_id: &str, percentage: u8) -> Result<(), String> {
        if let Some(flag) = self.flags.get_mut(flag_id) {
            flag.set_rollout(percentage);
            flag.is_enabled = true;
            Ok(())
        } else {
            Err(format!("Flag {} not found", flag_id))
        }
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 63: FEATURE FLAG MANAGER ===\n");
    let mut ffm = FeatureFlagManager::new("ffm_001".to_string());
    let mut flag = FeatureFlag::new("feature_newui".to_string(), false);
    flag.set_rollout(25);
    ffm.create_flag(flag);
    ffm.enable_canary("feature_newui", 50)?;
    println!("✓ Feature flag created with 50% rollout");
    println!("✓✓✓ Feature Flag Manager operational ✓✓✓");
    Ok(())
}
