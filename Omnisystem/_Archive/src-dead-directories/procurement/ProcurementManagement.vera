// ProcurementManagement.vera - Procurement and purchasing management
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct PurchaseRequisition {
    pub requisition_id: String,
    pub requester: String,
    pub items: Vec<String>,
    pub total_amount: f64,
    pub status: String, // draft, submitted, approved, rejected
    pub created_at: u64,
}

impl PurchaseRequisition {
    pub fn new(requisition_id: String, requester: String) -> Self {
        PurchaseRequisition {
            requisition_id,
            requester,
            items: Vec::new(),
            total_amount: 0.0,
            status: "draft".to_string(),
            created_at: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
        }
    }

    pub fn add_item(&mut self, item: String, price: f64) {
        self.items.push(item);
        self.total_amount += price;
    }

    pub fn submit(&mut self) {
        self.status = "submitted".to_string();
    }

    pub fn approve(&mut self) {
        self.status = "approved".to_string();
    }
}

pub struct PurchaseOrder {
    pub order_id: String,
    pub requisition_id: String,
    pub vendor_id: String,
    pub total_value: f64,
    pub status: String, // created, sent, acknowledged, received
    pub created_at: u64,
}

impl PurchaseOrder {
    pub fn new(order_id: String, requisition_id: String, vendor_id: String, value: f64) -> Self {
        PurchaseOrder {
            order_id,
            requisition_id,
            vendor_id,
            total_value: value,
            status: "created".to_string(),
            created_at: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
        }
    }

    pub fn send(&mut self) {
        self.status = "sent".to_string();
    }

    pub fn acknowledge(&mut self) {
        self.status = "acknowledged".to_string();
    }

    pub fn receive(&mut self) {
        self.status = "received".to_string();
    }
}

pub struct Invoice {
    pub invoice_id: String,
    pub order_id: String,
    pub vendor_id: String,
    pub amount: f64,
    pub invoice_date: u64,
    pub payment_status: String, // pending, processed, paid
}

impl Invoice {
    pub fn new(invoice_id: String, order_id: String, vendor_id: String, amount: f64) -> Self {
        Invoice {
            invoice_id,
            order_id,
            vendor_id,
            amount,
            invoice_date: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
            payment_status: "pending".to_string(),
        }
    }

    pub fn process(&mut self) {
        self.payment_status = "processed".to_string();
    }

    pub fn pay(&mut self) {
        self.payment_status = "paid".to_string();
    }
}

pub struct ProcurementManagementSystem {
    pub system_id: String,
    pub requisitions: HashMap<String, PurchaseRequisition>,
    pub purchase_orders: HashMap<String, PurchaseOrder>,
    pub invoices: HashMap<String, Invoice>,
    pub total_spend: f64,
}

impl ProcurementManagementSystem {
    pub fn new(system_id: String) -> Self {
        ProcurementManagementSystem {
            system_id,
            requisitions: HashMap::new(),
            purchase_orders: HashMap::new(),
            invoices: HashMap::new(),
            total_spend: 0.0,
        }
    }

    pub fn create_requisition(&mut self, req: PurchaseRequisition) -> Result<String, String> {
        let req_id = req.requisition_id.clone();
        self.requisitions.insert(req_id.clone(), req);
        Ok(req_id)
    }

    pub fn create_purchase_order(&mut self, po: PurchaseOrder) {
        self.total_spend += po.total_value;
        self.purchase_orders.insert(po.order_id.clone(), po);
    }

    pub fn record_invoice(&mut self, invoice: Invoice) {
        self.invoices.insert(invoice.invoice_id.clone(), invoice);
    }

    pub fn get_pending_requisitions(&self) -> u32 {
        self.requisitions
            .iter()
            .filter(|(_, r)| r.status == "submitted")
            .count() as u32
    }

    pub fn get_pending_invoices(&self) -> u32 {
        self.invoices
            .iter()
            .filter(|(_, i)| i.payment_status == "pending")
            .count() as u32
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 116: PROCUREMENT MANAGEMENT ===\n");
    let mut pms = ProcurementManagementSystem::new("pms_001".to_string());
    let mut req = PurchaseRequisition::new("req_001".to_string(), "dept_001".to_string());
    req.add_item("Laptop".to_string(), 1500.0);
    pms.create_requisition(req)?;
    let po = PurchaseOrder::new("po_001".to_string(), "req_001".to_string(), "vendor_001".to_string(), 1500.0);
    pms.create_purchase_order(po);
    let invoice = Invoice::new("inv_001".to_string(), "po_001".to_string(), "vendor_001".to_string(), 1500.0);
    pms.record_invoice(invoice);
    println!("✓ Requisition, PO, and invoice recorded");
    println!("✓ Total spend: ${:.2}", pms.total_spend);
    println!("✓✓✓ Procurement Management operational ✓✓✓");
    Ok(())
}
