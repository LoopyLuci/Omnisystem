// QualityManagement.titan - Quality management and process improvement
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct QualityMetric {
    pub metric_id: String,
    pub name: String,
    pub target: f64,
    pub actual: f64,
    pub unit: String,
}

impl QualityMetric {
    pub fn new(metric_id: String, name: String, target: f64, unit: String) -> Self {
        QualityMetric {
            metric_id,
            name,
            target,
            actual: 0.0,
            unit,
        }
    }

    pub fn is_within_target(&self) -> bool {
        (self.actual - self.target).abs() / self.target < 0.1 // 10% tolerance
    }
}

pub struct DefectReport {
    pub report_id: String,
    pub product_id: String,
    pub severity: String, // critical, major, minor
    pub description: String,
    pub status: String, // open, investigating, resolved
    pub reported_at: u64,
}

impl DefectReport {
    pub fn new(report_id: String, product_id: String, severity: String) -> Self {
        DefectReport {
            report_id,
            product_id,
            severity,
            description: String::new(),
            status: "open".to_string(),
            reported_at: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
        }
    }

    pub fn resolve(&mut self) {
        self.status = "resolved".to_string();
    }
}

pub struct AuditChecklist {
    pub audit_id: String,
    pub process_name: String,
    pub items: Vec<String>,
    pub completed_items: u32,
    pub audit_date: u64,
}

impl AuditChecklist {
    pub fn new(audit_id: String, process_name: String) -> Self {
        AuditChecklist {
            audit_id,
            process_name,
            items: Vec::new(),
            completed_items: 0,
            audit_date: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
        }
    }

    pub fn add_item(&mut self, item: String) {
        if !self.items.contains(&item) {
            self.items.push(item);
        }
    }

    pub fn mark_complete(&mut self) {
        self.completed_items += 1;
    }

    pub fn completion_percentage(&self) -> f64 {
        if self.items.is_empty() {
            0.0
        } else {
            (self.completed_items as f64 / self.items.len() as f64) * 100.0
        }
    }
}

pub struct QualityManagementSystem {
    pub system_id: String,
    pub metrics: HashMap<String, QualityMetric>,
    pub defects: HashMap<String, DefectReport>,
    pub audits: HashMap<String, AuditChecklist>,
}

impl QualityManagementSystem {
    pub fn new(system_id: String) -> Self {
        QualityManagementSystem {
            system_id,
            metrics: HashMap::new(),
            defects: HashMap::new(),
            audits: HashMap::new(),
        }
    }

    pub fn register_metric(&mut self, metric: QualityMetric) {
        self.metrics.insert(metric.metric_id.clone(), metric);
    }

    pub fn report_defect(&mut self, report: DefectReport) {
        self.defects.insert(report.report_id.clone(), report);
    }

    pub fn create_audit(&mut self, audit: AuditChecklist) {
        self.audits.insert(audit.audit_id.clone(), audit);
    }

    pub fn get_metrics_on_target(&self) -> u32 {
        self.metrics
            .iter()
            .filter(|(_, m)| m.is_within_target())
            .count() as u32
    }

    pub fn get_open_defects(&self) -> u32 {
        self.defects
            .iter()
            .filter(|(_, d)| d.status == "open")
            .count() as u32
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 113: QUALITY MANAGEMENT ===\n");
    let mut qms = QualityManagementSystem::new("qms_001".to_string());
    let metric = QualityMetric::new("metric_001".to_string(), "Defect Rate".to_string(), 1.0, "per_million".to_string());
    qms.register_metric(metric);
    let defect = DefectReport::new("def_001".to_string(), "product_001".to_string(), "major".to_string());
    qms.report_defect(defect);
    println!("✓ Metric and defect recorded");
    println!("✓ Open defects: {}", qms.get_open_defects());
    println!("✓✓✓ Quality Management operational ✓✓✓");
    Ok(())
}
