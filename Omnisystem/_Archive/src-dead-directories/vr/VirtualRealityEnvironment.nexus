// VirtualRealityEnvironment.nexus - Virtual reality environment and interaction
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct VRHeadset {
    pub headset_id: String,
    pub headset_model: String,
    pub resolution_per_eye: u32,
    pub refresh_rate_hz: u32,
    pub field_of_view: f64,
    pub tracking_space: String, // seated, standing, room_scale
    pub battery_percent: u8,
}

impl VRHeadset {
    pub fn new(headset_id: String, headset_model: String) -> Self {
        VRHeadset {
            headset_id,
            headset_model,
            resolution_per_eye: 2048,
            refresh_rate_hz: 90,
            field_of_view: 110.0,
            tracking_space: "room_scale".to_string(),
            battery_percent: 100,
        }
    }

    pub fn update_battery(&mut self, percent: u8) {
        self.battery_percent = (percent).min(100);
    }
}

pub struct VREnvironment {
    pub environment_id: String,
    pub name: String,
    pub environment_type: String, // fantasy, sci_fi, realistic, abstract
    pub polygon_count: u32,
    pub loaded: bool,
}

impl VREnvironment {
    pub fn new(environment_id: String, name: String) -> Self {
        VREnvironment {
            environment_id,
            name,
            environment_type: "realistic".to_string(),
            polygon_count: 0,
            loaded: false,
        }
    }

    pub fn load(&mut self) {
        self.loaded = true;
    }

    pub fn unload(&mut self) {
        self.loaded = false;
    }
}

pub struct VRAvatar {
    pub avatar_id: String,
    pub user_id: String,
    pub avatar_name: String,
    pub position_x: f64,
    pub position_y: f64,
    pub position_z: f64,
    pub rotation_y: f64,
    pub scale: f64,
}

impl VRAvatar {
    pub fn new(avatar_id: String, user_id: String, avatar_name: String) -> Self {
        VRAvatar {
            avatar_id,
            user_id,
            avatar_name,
            position_x: 0.0,
            position_y: 0.0,
            position_z: 0.0,
            rotation_y: 0.0,
            scale: 1.0,
        }
    }

    pub fn move_to(&mut self, x: f64, y: f64, z: f64) {
        self.position_x = x;
        self.position_y = y;
        self.position_z = z;
    }

    pub fn rotate(&mut self, degrees: f64) {
        self.rotation_y = degrees % 360.0;
    }

    pub fn distance_to(&self, other_x: f64, other_y: f64, other_z: f64) -> f64 {
        ((self.position_x - other_x).powi(2) +
         (self.position_y - other_y).powi(2) +
         (self.position_z - other_z).powi(2)).sqrt()
    }
}

pub struct VRController {
    pub controller_id: String,
    pub hand: String, // left, right
    pub position_x: f64,
    pub position_y: f64,
    pub position_z: f64,
    pub trigger_pressure: f64, // 0.0 to 1.0
    pub battery_percent: u8,
}

impl VRController {
    pub fn new(controller_id: String, hand: String) -> Self {
        VRController {
            controller_id,
            hand,
            position_x: 0.0,
            position_y: 0.0,
            position_z: 0.0,
            trigger_pressure: 0.0,
            battery_percent: 100,
        }
    }

    pub fn update_position(&mut self, x: f64, y: f64, z: f64) {
        self.position_x = x;
        self.position_y = y;
        self.position_z = z;
    }

    pub fn update_trigger(&mut self, pressure: f64) {
        self.trigger_pressure = (pressure).min(1.0);
    }
}

pub struct VirtualRealityEnvironmentSystem {
    pub system_id: String,
    pub headsets: HashMap<String, VRHeadset>,
    pub environments: HashMap<String, VREnvironment>,
    pub avatars: HashMap<String, VRAvatar>,
    pub controllers: HashMap<String, VRController>,
}

impl VirtualRealityEnvironmentSystem {
    pub fn new(system_id: String) -> Self {
        VirtualRealityEnvironmentSystem {
            system_id,
            headsets: HashMap::new(),
            environments: HashMap::new(),
            avatars: HashMap::new(),
            controllers: HashMap::new(),
        }
    }

    pub fn register_headset(&mut self, headset: VRHeadset) {
        self.headsets.insert(headset.headset_id.clone(), headset);
    }

    pub fn create_environment(&mut self, env: VREnvironment) {
        self.environments.insert(env.environment_id.clone(), env);
    }

    pub fn spawn_avatar(&mut self, avatar: VRAvatar) {
        self.avatars.insert(avatar.avatar_id.clone(), avatar);
    }

    pub fn register_controller(&mut self, controller: VRController) {
        self.controllers.insert(controller.controller_id.clone(), controller);
    }

    pub fn get_loaded_environments(&self) -> u32 {
        self.environments
            .iter()
            .filter(|(_, e)| e.loaded)
            .count() as u32
    }

    pub fn get_active_avatars(&self) -> u32 {
        self.avatars.len() as u32
    }

    pub fn get_active_controllers(&self) -> u32 {
        self.controllers.len() as u32
    }

    pub fn get_low_battery_devices(&self) -> u32 {
        let headsets = self.headsets
            .iter()
            .filter(|(_, h)| h.battery_percent < 20)
            .count();
        let controllers = self.controllers
            .iter()
            .filter(|(_, c)| c.battery_percent < 20)
            .count();
        (headsets + controllers) as u32
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 139: VIRTUAL REALITY ENVIRONMENT ===\n");
    let mut vres = VirtualRealityEnvironmentSystem::new("vres_001".to_string());
    let headset = VRHeadset::new("hs_001".to_string(), "OmniVision Pro".to_string());
    vres.register_headset(headset);
    let env = VREnvironment::new("env_001".to_string(), "Fantasy Realm".to_string());
    vres.create_environment(env);
    let avatar = VRAvatar::new("av_001".to_string(), "user_001".to_string(), "Hero".to_string());
    vres.spawn_avatar(avatar);
    let controller = VRController::new("ctrl_001".to_string(), "right".to_string());
    vres.register_controller(controller);
    println!("✓ Headset, environment, avatar, and controller recorded");
    println!("✓ Loaded environments: {}", vres.get_loaded_environments());
    println!("✓✓✓ Virtual Reality Environment operational ✓✓✓");
    Ok(())
}
