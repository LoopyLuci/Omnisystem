// SecurityOperationsCenter.vera - Security operations center and threat management
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub enum ThreatSeverity {
    Low,
    Medium,
    High,
    Critical,
}

pub struct SecurityEvent {
    pub event_id: String,
    pub event_type: String,
    pub source: String,
    pub severity: ThreatSeverity,
    pub timestamp: u64,
    pub detected_at: u64,
    pub response_status: String, // pending, investigating, remediated
}

impl SecurityEvent {
    pub fn new(event_id: String, event_type: String, source: String, severity: ThreatSeverity) -> Self {
        let now = std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .unwrap()
            .as_secs();

        SecurityEvent {
            event_id,
            event_type,
            source,
            severity,
            timestamp: now,
            detected_at: now,
            response_status: "pending".to_string(),
        }
    }

    pub fn update_status(&mut self, status: String) {
        self.response_status = status;
    }
}

pub struct ThreatIntelligence {
    pub threat_id: String,
    pub threat_name: String,
    pub description: String,
    pub tactics: Vec<String>,
    pub indicators: Vec<String>,
}

impl ThreatIntelligence {
    pub fn new(threat_id: String, threat_name: String) -> Self {
        ThreatIntelligence {
            threat_id,
            threat_name,
            description: String::new(),
            tactics: Vec::new(),
            indicators: Vec::new(),
        }
    }

    pub fn add_tactic(&mut self, tactic: String) {
        if !self.tactics.contains(&tactic) {
            self.tactics.push(tactic);
        }
    }

    pub fn add_indicator(&mut self, indicator: String) {
        if !self.indicators.contains(&indicator) {
            self.indicators.push(indicator);
        }
    }
}

pub struct IncidentResponse {
    pub incident_id: String,
    pub security_event_id: String,
    pub response_team: String,
    pub actions_taken: Vec<String>,
    pub status: String,
}

impl IncidentResponse {
    pub fn new(incident_id: String, security_event_id: String) -> Self {
        IncidentResponse {
            incident_id,
            security_event_id,
            response_team: String::new(),
            actions_taken: Vec::new(),
            status: "initiated".to_string(),
        }
    }

    pub fn add_action(&mut self, action: String) {
        self.actions_taken.push(action);
    }

    pub fn close(&mut self) {
        self.status = "closed".to_string();
    }
}

pub struct SecurityOperationsCenter {
    pub soc_id: String,
    pub security_events: HashMap<String, SecurityEvent>,
    pub threat_intelligence: HashMap<String, ThreatIntelligence>,
    pub incident_responses: HashMap<String, IncidentResponse>,
    pub total_events: u32,
    pub critical_events: u32,
}

impl SecurityOperationsCenter {
    pub fn new(soc_id: String) -> Self {
        SecurityOperationsCenter {
            soc_id,
            security_events: HashMap::new(),
            threat_intelligence: HashMap::new(),
            incident_responses: HashMap::new(),
            total_events: 0,
            critical_events: 0,
        }
    }

    pub fn report_event(&mut self, event: SecurityEvent) -> Result<String, String> {
        let event_id = event.event_id.clone();
        if matches!(event.severity, ThreatSeverity::Critical) {
            self.critical_events += 1;
        }
        self.security_events.insert(event_id.clone(), event);
        self.total_events += 1;
        Ok(event_id)
    }

    pub fn add_threat_intel(&mut self, threat: ThreatIntelligence) {
        self.threat_intelligence.insert(threat.threat_id.clone(), threat);
    }

    pub fn initiate_incident_response(&mut self, event_id: &str) -> Result<String, String> {
        if self.security_events.contains_key(event_id) {
            let incident_id = format!("incident_{}", self.incident_responses.len());
            let response = IncidentResponse::new(incident_id.clone(), event_id.to_string());
            self.incident_responses.insert(incident_id.clone(), response);
            Ok(incident_id)
        } else {
            Err(format!("Event {} not found", event_id))
        }
    }

    pub fn get_mean_time_to_detect(&self) -> f64 {
        if self.total_events == 0 {
            0.0
        } else {
            let total_detection_time: u64 = self.security_events
                .iter()
                .map(|(_, e)| e.detected_at - e.timestamp)
                .sum();
            (total_detection_time as f64 / self.total_events as f64) / 60.0 // minutes
        }
    }

    pub fn get_critical_event_count(&self) -> u32 {
        self.critical_events
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 104: SECURITY OPERATIONS CENTER ===\n");
    let mut soc = SecurityOperationsCenter::new("soc_001".to_string());
    let event = SecurityEvent::new("evt_001".to_string(), "Unauthorized Access".to_string(), "192.168.1.100".to_string(), ThreatSeverity::High);
    soc.report_event(event)?;
    let incident_id = soc.initiate_incident_response("evt_001")?;
    println!("✓ Security event reported and incident initiated");
    println!("✓ Incident ID: {}", incident_id);
    println!("✓ Critical events: {}", soc.get_critical_event_count());
    println!("✓✓✓ Security Operations Center operational ✓✓✓");
    Ok(())
}
