// ServiceRequestFulfillment.titan - Service request management and fulfillment
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub enum RequestStatus {
    New,
    Assigned,
    InProgress,
    Pending,
    Fulfilled,
    Closed,
}

pub enum RequestPriority {
    Low,
    Normal,
    High,
    Urgent,
}

pub struct ServiceRequest {
    pub request_id: String,
    pub requestor: String,
    pub title: String,
    pub description: String,
    pub status: RequestStatus,
    pub priority: RequestPriority,
    pub assigned_to: Option<String>,
    pub created_at: u64,
    pub completion_target: u64, // Unix timestamp
}

impl ServiceRequest {
    pub fn new(request_id: String, requestor: String, title: String, priority: RequestPriority) -> Self {
        let now = std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .unwrap()
            .as_secs();

        ServiceRequest {
            request_id,
            requestor,
            title,
            description: String::new(),
            status: RequestStatus::New,
            priority,
            assigned_to: None,
            created_at: now,
            completion_target: now + (48 * 3600), // 48 hours default
        }
    }

    pub fn assign_to(&mut self, assignee: String) {
        self.assigned_to = Some(assignee);
        self.status = RequestStatus::Assigned;
    }

    pub fn start_work(&mut self) {
        self.status = RequestStatus::InProgress;
    }

    pub fn fulfill(&mut self) {
        self.status = RequestStatus::Fulfilled;
    }
}

pub struct RequestFulfillmentTask {
    pub task_id: String,
    pub request_id: String,
    pub task_name: String,
    pub completed: bool,
}

impl RequestFulfillmentTask {
    pub fn new(task_id: String, request_id: String, task_name: String) -> Self {
        RequestFulfillmentTask {
            task_id,
            request_id,
            task_name,
            completed: false,
        }
    }

    pub fn complete(&mut self) {
        self.completed = true;
    }
}

pub struct ServiceRequestFulfillmentSystem {
    pub system_id: String,
    pub requests: HashMap<String, ServiceRequest>,
    pub tasks: HashMap<String, RequestFulfillmentTask>,
    pub total_fulfilled: u32,
}

impl ServiceRequestFulfillmentSystem {
    pub fn new(system_id: String) -> Self {
        ServiceRequestFulfillmentSystem {
            system_id,
            requests: HashMap::new(),
            tasks: HashMap::new(),
            total_fulfilled: 0,
        }
    }

    pub fn submit_request(&mut self, request: ServiceRequest) -> Result<String, String> {
        let request_id = request.request_id.clone();
        self.requests.insert(request_id.clone(), request);
        Ok(request_id)
    }

    pub fn assign_request(&mut self, request_id: &str, assignee: String) -> Result<(), String> {
        if let Some(request) = self.requests.get_mut(request_id) {
            request.assign_to(assignee);
            Ok(())
        } else {
            Err(format!("Request {} not found", request_id))
        }
    }

    pub fn add_fulfillment_task(&mut self, task: RequestFulfillmentTask) -> Result<(), String> {
        self.tasks.insert(task.task_id.clone(), task);
        Ok(())
    }

    pub fn complete_request(&mut self, request_id: &str) -> Result<(), String> {
        if let Some(request) = self.requests.get_mut(request_id) {
            request.fulfill();
            self.total_fulfilled += 1;
            Ok(())
        } else {
            Err(format!("Request {} not found", request_id))
        }
    }

    pub fn get_pending_requests(&self) -> u32 {
        self.requests
            .iter()
            .filter(|(_, r)| matches!(r.status, RequestStatus::New | RequestStatus::Assigned | RequestStatus::InProgress))
            .count() as u32
    }

    pub fn get_sla_compliance(&self) -> f64 {
        let now = std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .unwrap()
            .as_secs();

        let on_time = self.requests
            .iter()
            .filter(|(_, r)| matches!(r.status, RequestStatus::Fulfilled) && r.completion_target >= now)
            .count();

        if self.total_fulfilled == 0 {
            0.0
        } else {
            (on_time as f64 / self.total_fulfilled as f64) * 100.0
        }
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 84: SERVICE REQUEST FULFILLMENT ===\n");
    let mut srfs = ServiceRequestFulfillmentSystem::new("srfs_001".to_string());
    let req = ServiceRequest::new("sr_001".to_string(), "user_001".to_string(), "New VPN access".to_string(), RequestPriority::Normal);
    srfs.submit_request(req)?;
    srfs.assign_request("sr_001", "admin_1".to_string())?;
    srfs.complete_request("sr_001")?;
    println!("✓ Service request fulfilled");
    println!("✓ Total fulfilled: {}", srfs.total_fulfilled);
    println!("✓ SLA compliance: {:.1}%", srfs.get_sla_compliance());
    println!("✓✓✓ Service Request Fulfillment operational ✓✓✓");
    Ok(())
}
