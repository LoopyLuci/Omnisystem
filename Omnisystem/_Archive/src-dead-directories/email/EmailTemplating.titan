// Email Templating
// Email template management
// System 77

use omnisystem::{HashMap, Vec, String, Option, Result}

struct EmailTemplate {
    id: String,
    name: String,
    subject: String,
    body: String,
    variables: Vec<String>
}

struct EmailTemplating {
    templates: HashMap<String, EmailTemplate>
}

impl EmailTemplating {
    fn new() -> Self {
        return EmailTemplating {
            templates: HashMap::new()
        }
    }

    fn create_template(&mut self, id: String, name: String, subject: String, body: String) -> Result<(), String> {
        let template = EmailTemplate {
            id: id.clone(),
            name: name.clone(),
            subject: subject,
            body: body,
            variables: Vec::new()
        }
        self.templates.insert(id.clone(), template)
        println("EmailTemplating: Created template {}", name)
        Ok(())
    }

    fn render_template(&self, id: String, vars: HashMap<String, String>) -> Result<String, String> {
        match self.templates.get(&id) {
            Some(template) => {
                println("EmailTemplating: Rendered template {}", id)
                Ok(template.body.clone())
            },
            None => Err("Template not found".to_string())
        }
    }

    fn get_template_count(&self) -> i32 {
        return self.templates.len() as i32
    }
}

fn test_email_templating() -> Result<(), String> {
    let mut tmpl = EmailTemplating::new()

    tmpl.create_template("welcome".to_string(), "Welcome Email".to_string(), "Welcome!".to_string(), "Hello {{name}}!".to_string())?
    tmpl.create_template("reset".to_string(), "Password Reset".to_string(), "Reset Password".to_string(), "Click {{link}} to reset.".to_string())?

    println("Templates: {}", tmpl.get_template_count())
    Ok(())
}
