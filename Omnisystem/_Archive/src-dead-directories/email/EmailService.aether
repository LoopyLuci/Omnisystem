// Email Service
// SMTP message delivery
// System 76

use omnisystem::{HashMap, Vec, String, Option, Result}

struct EmailMessage {
    id: String,
    from: String,
    to: String,
    subject: String,
    body: String,
    status: String
}

actor EmailService {
    messages: Vec<EmailMessage> = Vec::new(),
    sent_count: i32 = 0,
    failed_count: i32 = 0

    message SendEmail(from: String, to: String, subject: String, body: String) -> Result<String, String> {
        let msg = EmailMessage {
            id: "email_".to_string() + &(messages.len() as u32).to_string(),
            from: from.clone(),
            to: to.clone(),
            subject: subject.clone(),
            body: body,
            status: "sending".to_string()
        }

        let msg_id = msg.id.clone()
        messages.push(msg)

        println("EmailService: Sending email to {}", to)
        Ok(msg_id)
    }

    message MarkSent(msg_id: String) -> Result<(), String> {
        for msg in messages.iter_mut() {
            if msg.id == msg_id {
                msg.status = "sent".to_string()
                sent_count = sent_count + 1
                return Ok(())
            }
        }
        Err("Message not found".to_string())
    }

    message GetSentCount() -> i32 {
        sent_count
    }
}

async fn test_email_service() -> Result<(), String> {
    let svc: ActorRef<EmailService> = spawn(EmailService {
        messages: Vec::new(),
        sent_count: 0,
        failed_count: 0
    })

    let msg_id = await svc.call(EmailService::SendEmail(
        "noreply@omnisystem.io".to_string(),
        "user@example.com".to_string(),
        "Welcome".to_string(),
        "Hello!".to_string()
    ))?

    await svc.call(EmailService::MarkSent(msg_id))?
    let sent = await svc.call(EmailService::GetSentCount())?
    println("Sent: {} emails", sent)

    Ok(())
}
