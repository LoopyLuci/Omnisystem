// EmailSecurityGateway.titan - Email security and threat protection
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct EmailMessage {
    pub message_id: String,
    pub sender: String,
    pub recipient: String,
    pub subject: String,
    pub received_at: u64,
    pub has_attachments: bool,
    pub attachment_count: u32,
    pub scanned: bool,
}

impl EmailMessage {
    pub fn new(message_id: String, sender: String, recipient: String) -> Self {
        EmailMessage {
            message_id,
            sender,
            recipient,
            subject: String::new(),
            received_at: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
            has_attachments: false,
            attachment_count: 0,
            scanned: false,
        }
    }

    pub fn mark_scanned(&mut self) {
        self.scanned = true;
    }
}

pub struct EmailThreatDetection {
    pub detection_id: String,
    pub message_id: String,
    pub threat_type: String, // phishing, malware, spam, impersonation
    pub risk_score: f64, // 0.0 to 100.0
    pub indicators: Vec<String>,
    pub action: String, // quarantine, block, alert, allow
    pub detected_at: u64,
}

impl EmailThreatDetection {
    pub fn new(detection_id: String, message_id: String) -> Self {
        EmailThreatDetection {
            detection_id,
            message_id,
            threat_type: "unknown".to_string(),
            risk_score: 0.0,
            indicators: Vec::new(),
            action: "allow".to_string(),
            detected_at: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
        }
    }

    pub fn add_indicator(&mut self, indicator: String) {
        if !self.indicators.contains(&indicator) {
            self.indicators.push(indicator);
        }
    }

    pub fn quarantine(&mut self) {
        self.action = "quarantine".to_string();
    }

    pub fn block(&mut self) {
        self.action = "block".to_string();
    }
}

pub struct AttachmentAnalysis {
    pub analysis_id: String,
    pub message_id: String,
    pub filename: String,
    pub file_type: String,
    pub file_size_kb: u32,
    pub malware_detected: bool,
    pub detection_name: String,
}

impl AttachmentAnalysis {
    pub fn new(analysis_id: String, message_id: String, filename: String) -> Self {
        AttachmentAnalysis {
            analysis_id,
            message_id,
            filename,
            file_type: String::new(),
            file_size_kb: 0,
            malware_detected: false,
            detection_name: String::new(),
        }
    }

    pub fn detect_malware(&mut self, detection: String) {
        self.malware_detected = true;
        self.detection_name = detection;
    }
}

pub struct EmailPolicy {
    pub policy_id: String,
    pub policy_name: String,
    pub block_external_emails: bool,
    pub require_spf: bool,
    pub require_dkim: bool,
    pub require_dmarc: bool,
    pub max_attachment_size_mb: u32,
    pub blocked_file_types: Vec<String>,
    pub enabled: bool,
}

impl EmailPolicy {
    pub fn new(policy_id: String, policy_name: String) -> Self {
        EmailPolicy {
            policy_id,
            policy_name,
            block_external_emails: false,
            require_spf: true,
            require_dkim: true,
            require_dmarc: true,
            max_attachment_size_mb: 25,
            blocked_file_types: Vec::new(),
            enabled: true,
        }
    }

    pub fn block_file_type(&mut self, file_type: String) {
        if !self.blocked_file_types.contains(&file_type) {
            self.blocked_file_types.push(file_type);
        }
    }
}

pub struct QuarantinedEmail {
    pub quarantine_id: String,
    pub message_id: String,
    pub quarantine_reason: String,
    pub quarantined_at: u64,
    pub expires_at: u64,
    pub released: bool,
    pub release_time: Option<u64>,
}

impl QuarantinedEmail {
    pub fn new(quarantine_id: String, message_id: String, reason: String) -> Self {
        let now = std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .unwrap()
            .as_secs();

        QuarantinedEmail {
            quarantine_id,
            message_id,
            quarantine_reason: reason,
            quarantined_at: now,
            expires_at: now + (7 * 86400), // 7 days
            released: false,
            release_time: None,
        }
    }

    pub fn release(&mut self) {
        self.released = true;
        self.release_time = Some(std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .unwrap()
            .as_secs());
    }
}

pub struct EmailSecurityGatewaySystem {
    pub system_id: String,
    pub messages: HashMap<String, EmailMessage>,
    pub detections: HashMap<String, EmailThreatDetection>,
    pub attachments: HashMap<String, AttachmentAnalysis>,
    pub policies: HashMap<String, EmailPolicy>,
    pub quarantined: HashMap<String, QuarantinedEmail>,
}

impl EmailSecurityGatewaySystem {
    pub fn new(system_id: String) -> Self {
        EmailSecurityGatewaySystem {
            system_id,
            messages: HashMap::new(),
            detections: HashMap::new(),
            attachments: HashMap::new(),
            policies: HashMap::new(),
            quarantined: HashMap::new(),
        }
    }

    pub fn receive_email(&mut self, message: EmailMessage) {
        self.messages.insert(message.message_id.clone(), message);
    }

    pub fn detect_threat(&mut self, detection: EmailThreatDetection) {
        self.detections.insert(detection.detection_id.clone(), detection);
    }

    pub fn analyze_attachment(&mut self, analysis: AttachmentAnalysis) {
        self.attachments.insert(analysis.analysis_id.clone(), analysis);
    }

    pub fn create_policy(&mut self, policy: EmailPolicy) {
        self.policies.insert(policy.policy_id.clone(), policy);
    }

    pub fn quarantine_email(&mut self, email: QuarantinedEmail) {
        self.quarantined.insert(email.quarantine_id.clone(), email);
    }

    pub fn get_scanned_messages(&self) -> u32 {
        self.messages
            .iter()
            .filter(|(_, m)| m.scanned)
            .count() as u32
    }

    pub fn get_quarantined_count(&self) -> u32 {
        self.quarantined
            .iter()
            .filter(|(_, q)| !q.released)
            .count() as u32
    }

    pub fn get_malware_detections(&self) -> u32 {
        self.attachments
            .iter()
            .filter(|(_, a)| a.malware_detected)
            .count() as u32
    }

    pub fn get_high_risk_detections(&self) -> u32 {
        self.detections
            .iter()
            .filter(|(_, d)| d.risk_score > 80.0)
            .count() as u32
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 152: EMAIL SECURITY GATEWAY ===\n");
    let mut esgs = EmailSecurityGatewaySystem::new("esgs_001".to_string());
    let message = EmailMessage::new("msg_001".to_string(), "sender@external.com".to_string(), "recipient@company.com".to_string());
    esgs.receive_email(message);
    let detection = EmailThreatDetection::new("det_001".to_string(), "msg_001".to_string());
    esgs.detect_threat(detection);
    let attachment = AttachmentAnalysis::new("att_001".to_string(), "msg_001".to_string(), "document.pdf".to_string());
    esgs.analyze_attachment(attachment);
    let policy = EmailPolicy::new("pol_001".to_string(), "Corporate Email Policy".to_string());
    esgs.create_policy(policy);
    let quarantine = QuarantinedEmail::new("q_001".to_string(), "msg_001".to_string(), "phishing_detected".to_string());
    esgs.quarantine_email(quarantine);
    println!("✓ Message, detection, attachment, policy, and quarantine recorded");
    println!("✓ Quarantined emails: {}", esgs.get_quarantined_count());
    println!("✓✓✓ Email Security Gateway operational ✓✓✓");
    Ok(())
}
