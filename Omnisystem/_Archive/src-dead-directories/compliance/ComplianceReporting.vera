// ComplianceReporting.vera - Compliance reporting and audit trail
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct ComplianceFramework {
    pub framework_id: String,
    pub name: String,
    pub requirements: Vec<String>,
    pub version: String,
}

impl ComplianceFramework {
    pub fn new(framework_id: String, name: String) -> Self {
        ComplianceFramework {
            framework_id,
            name,
            requirements: Vec::new(),
            version: "1.0".to_string(),
        }
    }

    pub fn add_requirement(&mut self, requirement: String) {
        self.requirements.push(requirement);
    }
}

pub struct ComplianceControl {
    pub control_id: String,
    pub framework_id: String,
    pub description: String,
    pub is_implemented: bool,
    pub evidence: Vec<String>,
}

impl ComplianceControl {
    pub fn new(control_id: String, framework_id: String, description: String) -> Self {
        ComplianceControl {
            control_id,
            framework_id,
            description,
            is_implemented: false,
            evidence: Vec::new(),
        }
    }

    pub fn mark_implemented(&mut self) {
        self.is_implemented = true;
    }

    pub fn add_evidence(&mut self, evidence: String) {
        self.evidence.push(evidence);
    }
}

pub struct ComplianceReport {
    pub report_id: String,
    pub framework_id: String,
    pub total_controls: u32,
    pub implemented_controls: u32,
    pub compliance_percentage: f64,
    pub generated_at: u64,
}

impl ComplianceReport {
    pub fn new(report_id: String, framework_id: String) -> Self {
        ComplianceReport {
            report_id,
            framework_id,
            total_controls: 0,
            implemented_controls: 0,
            compliance_percentage: 0.0,
            generated_at: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
        }
    }

    pub fn calculate_compliance(&mut self) {
        if self.total_controls > 0 {
            self.compliance_percentage = (self.implemented_controls as f64 / self.total_controls as f64) * 100.0;
        }
    }
}

pub struct ComplianceReportingSystem {
    pub system_id: String,
    pub frameworks: HashMap<String, ComplianceFramework>,
    pub controls: HashMap<String, ComplianceControl>,
    pub reports: HashMap<String, ComplianceReport>,
}

impl ComplianceReportingSystem {
    pub fn new(system_id: String) -> Self {
        ComplianceReportingSystem {
            system_id,
            frameworks: HashMap::new(),
            controls: HashMap::new(),
            reports: HashMap::new(),
        }
    }

    pub fn register_framework(&mut self, framework: ComplianceFramework) {
        self.frameworks.insert(framework.framework_id.clone(), framework);
    }

    pub fn register_control(&mut self, control: ComplianceControl) {
        self.controls.insert(control.control_id.clone(), control);
    }

    pub fn generate_report(&mut self, report: ComplianceReport) -> Result<String, String> {
        let framework_controls: Vec<&ComplianceControl> = self.controls
            .iter()
            .filter(|(_, c)| c.framework_id == report.framework_id)
            .map(|(_, c)| c)
            .collect();

        let mut report = report;
        report.total_controls = framework_controls.len() as u32;
        report.implemented_controls = framework_controls.iter().filter(|c| c.is_implemented).count() as u32;
        report.calculate_compliance();

        let report_id = report.report_id.clone();
        self.reports.insert(report_id.clone(), report);
        Ok(report_id)
    }

    pub fn get_compliance_summary(&self) -> String {
        let total_frameworks = self.frameworks.len();
        let avg_compliance: f64 = if self.reports.is_empty() {
            0.0
        } else {
            self.reports.iter().map(|(_, r)| r.compliance_percentage).sum::<f64>() / self.reports.len() as f64
        };

        format!(
            "Compliance Summary: {} frameworks, {:.1}% average compliance",
            total_frameworks, avg_compliance
        )
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 80: COMPLIANCE REPORTING ===\n");
    let mut crs = ComplianceReportingSystem::new("crs_001".to_string());
    let framework = ComplianceFramework::new("gdpr".to_string(), "GDPR".to_string());
    crs.register_framework(framework);
    let control = ComplianceControl::new("ctrl_1".to_string(), "gdpr".to_string(), "Data encryption".to_string());
    crs.register_control(control);
    let report = ComplianceReport::new("rep_001".to_string(), "gdpr".to_string());
    crs.generate_report(report)?;
    println!("✓ Compliance report generated");
    println!("✓ {}", crs.get_compliance_summary());
    println!("✓✓✓ Compliance Reporting operational ✓✓✓");
    Ok(())
}
