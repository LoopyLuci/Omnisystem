// AlertManager.titan - Alert management and notification routing
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub enum AlertSeverity {
    Info,
    Warning,
    Critical,
    Emergency,
}

pub struct Alert {
    pub alert_id: String,
    pub title: String,
    pub description: String,
    pub severity: AlertSeverity,
    pub source: String,
    pub created_at: u64,
    pub acknowledged: bool,
}

impl Alert {
    pub fn new(alert_id: String, title: String, source: String, severity: AlertSeverity) -> Self {
        Alert {
            alert_id,
            title,
            description: String::new(),
            severity,
            source,
            created_at: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
            acknowledged: false,
        }
    }

    pub fn with_description(&mut self, desc: String) {
        self.description = desc;
    }

    pub fn acknowledge(&mut self) {
        self.acknowledged = true;
    }
}

pub struct AlertRule {
    pub rule_id: String,
    pub metric_name: String,
    pub threshold: f64,
    pub trigger_condition: String, // "gt", "lt", "eq"
}

impl AlertRule {
    pub fn new(rule_id: String, metric: String, threshold: f64) -> Self {
        AlertRule {
            rule_id,
            metric_name: metric,
            threshold,
            trigger_condition: "gt".to_string(),
        }
    }

    pub fn should_trigger(&self, value: f64) -> bool {
        match self.trigger_condition.as_str() {
            "gt" => value > self.threshold,
            "lt" => value < self.threshold,
            "eq" => (value - self.threshold).abs() < 0.001,
            _ => false,
        }
    }
}

pub struct AlertManager {
    pub manager_id: String,
    pub alerts: HashMap<String, Alert>,
    pub rules: HashMap<String, AlertRule>,
    pub total_triggered: u32,
}

impl AlertManager {
    pub fn new(manager_id: String) -> Self {
        AlertManager {
            manager_id,
            alerts: HashMap::new(),
            rules: HashMap::new(),
            total_triggered: 0,
        }
    }

    pub fn create_rule(&mut self, rule: AlertRule) {
        self.rules.insert(rule.rule_id.clone(), rule);
    }

    pub fn evaluate_metric(&mut self, metric_name: &str, value: f64) -> Result<(), String> {
        for (_, rule) in self.rules.iter() {
            if rule.metric_name == metric_name && rule.should_trigger(value) {
                let alert = Alert::new(
                    format!("alert_{}", self.total_triggered),
                    format!("Metric {} threshold exceeded", metric_name),
                    "metrics".to_string(),
                    AlertSeverity::Warning,
                );
                self.alerts.insert(alert.alert_id.clone(), alert);
                self.total_triggered += 1;
            }
        }
        Ok(())
    }

    pub fn acknowledge_alert(&mut self, alert_id: &str) -> Result<(), String> {
        if let Some(alert) = self.alerts.get_mut(alert_id) {
            alert.acknowledge();
            Ok(())
        } else {
            Err(format!("Alert {} not found", alert_id))
        }
    }

    pub fn get_active_alerts(&self) -> Vec<String> {
        self.alerts
            .iter()
            .filter(|(_, a)| !a.acknowledged)
            .map(|(id, _)| id.clone())
            .collect()
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 77: ALERT MANAGER ===\n");
    let mut am = AlertManager::new("am_001".to_string());
    let rule = AlertRule::new("cpu_rule".to_string(), "cpu_usage".to_string(), 80.0);
    am.create_rule(rule);
    am.evaluate_metric("cpu_usage", 85.0)?;
    println!("✓ Alert triggered for high CPU");
    println!("✓ Active alerts: {}", am.get_active_alerts().len());
    println!("✓✓✓ Alert Manager operational ✓✓✓");
    Ok(())
}
