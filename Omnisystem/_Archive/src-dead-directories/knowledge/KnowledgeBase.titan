// KnowledgeBase.titan - Knowledge base and documentation management
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct KnowledgeArticle {
    pub article_id: String,
    pub title: String,
    pub content: String,
    pub category: String,
    pub author: String,
    pub created_at: u64,
    pub updated_at: u64,
    pub views: u32,
}

impl KnowledgeArticle {
    pub fn new(article_id: String, title: String, category: String, author: String) -> Self {
        let now = std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .unwrap()
            .as_secs();

        KnowledgeArticle {
            article_id,
            title,
            content: String::new(),
            category,
            author,
            created_at: now,
            updated_at: now,
            views: 0,
        }
    }

    pub fn set_content(&mut self, content: String) {
        self.content = content;
        self.updated_at = std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .unwrap()
            .as_secs();
    }

    pub fn record_view(&mut self) {
        self.views += 1;
    }
}

pub struct FAQ {
    pub faq_id: String,
    pub question: String,
    pub answer: String,
    pub category: String,
    pub helpfulness_score: f64,
}

impl FAQ {
    pub fn new(faq_id: String, question: String, answer: String, category: String) -> Self {
        FAQ {
            faq_id,
            question,
            answer,
            category,
            helpfulness_score: 0.0,
        }
    }

    pub fn rate_helpful(&mut self, helpful: bool) {
        if helpful {
            self.helpfulness_score += 1.0;
        } else {
            self.helpfulness_score = (self.helpfulness_score - 1.0).max(0.0);
        }
    }
}

pub struct KnowledgeBaseSystem {
    pub system_id: String,
    pub articles: HashMap<String, KnowledgeArticle>,
    pub faqs: HashMap<String, FAQ>,
    pub categories: Vec<String>,
    pub total_views: u32,
}

impl KnowledgeBaseSystem {
    pub fn new(system_id: String) -> Self {
        KnowledgeBaseSystem {
            system_id,
            articles: HashMap::new(),
            faqs: HashMap::new(),
            categories: Vec::new(),
            total_views: 0,
        }
    }

    pub fn add_article(&mut self, article: KnowledgeArticle) -> Result<String, String> {
        let article_id = article.article_id.clone();
        if !self.categories.contains(&article.category) {
            self.categories.push(article.category.clone());
        }
        self.articles.insert(article_id.clone(), article);
        Ok(article_id)
    }

    pub fn add_faq(&mut self, faq: FAQ) {
        self.faqs.insert(faq.faq_id.clone(), faq);
    }

    pub fn search_articles(&self, keyword: &str) -> Vec<String> {
        self.articles
            .iter()
            .filter(|(_, a)| a.title.contains(keyword) || a.content.contains(keyword))
            .map(|(id, _)| id.clone())
            .collect()
    }

    pub fn view_article(&mut self, article_id: &str) -> Result<String, String> {
        if let Some(article) = self.articles.get_mut(article_id) {
            article.record_view();
            self.total_views += 1;
            Ok(article.content.clone())
        } else {
            Err(format!("Article {} not found", article_id))
        }
    }

    pub fn get_popular_articles(&self) -> Vec<String> {
        let mut articles: Vec<_> = self.articles.iter().collect();
        articles.sort_by(|a, b| b.1.views.cmp(&a.1.views));
        articles.iter().take(10).map(|(id, _)| id.clone()).collect()
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 86: KNOWLEDGE BASE ===\n");
    let mut kbs = KnowledgeBaseSystem::new("kbs_001".to_string());
    let mut article = KnowledgeArticle::new("art_001".to_string(), "How to Reset Password".to_string(), "security".to_string(), "admin".to_string());
    article.set_content("Click 'Forgot Password' on the login page...".to_string());
    kbs.add_article(article)?;
    kbs.view_article("art_001")?;
    println!("✓ Knowledge article added and viewed");
    println!("✓ Total views: {}", kbs.total_views);
    println!("✓✓✓ Knowledge Base operational ✓✓✓");
    Ok(())
}
