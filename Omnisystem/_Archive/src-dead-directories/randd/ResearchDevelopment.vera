// ResearchDevelopment.vera - Research and development management
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct ResearchProject {
    pub project_id: String,
    pub title: String,
    pub description: String,
    pub budget: f64,
    pub spent: f64,
    pub status: String, // planning, active, completed
    pub lead_researcher: String,
}

impl ResearchProject {
    pub fn new(project_id: String, title: String, budget: f64) -> Self {
        ResearchProject {
            project_id,
            title,
            description: String::new(),
            budget,
            spent: 0.0,
            status: "planning".to_string(),
            lead_researcher: String::new(),
        }
    }

    pub fn activate(&mut self) {
        self.status = "active".to_string();
    }

    pub fn record_expense(&mut self, amount: f64) {
        self.spent += amount;
    }

    pub fn budget_remaining(&self) -> f64 {
        (self.budget - self.spent).max(0.0)
    }
}

pub struct Experiment {
    pub experiment_id: String,
    pub project_id: String,
    pub title: String,
    pub hypothesis: String,
    pub status: String, // planned, running, completed
    pub results: String,
}

impl Experiment {
    pub fn new(experiment_id: String, project_id: String, title: String) -> Self {
        Experiment {
            experiment_id,
            project_id,
            title,
            hypothesis: String::new(),
            status: "planned".to_string(),
            results: String::new(),
        }
    }

    pub fn start(&mut self) {
        self.status = "running".to_string();
    }

    pub fn complete(&mut self, results: String) {
        self.status = "completed".to_string();
        self.results = results;
    }
}

pub struct Publication {
    pub publication_id: String,
    pub title: String,
    pub authors: Vec<String>,
    pub journal: String,
    pub published_at: u64,
}

impl Publication {
    pub fn new(publication_id: String, title: String, journal: String) -> Self {
        Publication {
            publication_id,
            title,
            authors: Vec::new(),
            journal,
            published_at: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
        }
    }

    pub fn add_author(&mut self, author: String) {
        if !self.authors.contains(&author) {
            self.authors.push(author);
        }
    }
}

pub struct ResearchDevelopmentSystem {
    pub system_id: String,
    pub projects: HashMap<String, ResearchProject>,
    pub experiments: HashMap<String, Experiment>,
    pub publications: HashMap<String, Publication>,
}

impl ResearchDevelopmentSystem {
    pub fn new(system_id: String) -> Self {
        ResearchDevelopmentSystem {
            system_id,
            projects: HashMap::new(),
            experiments: HashMap::new(),
            publications: HashMap::new(),
        }
    }

    pub fn create_project(&mut self, project: ResearchProject) {
        self.projects.insert(project.project_id.clone(), project);
    }

    pub fn create_experiment(&mut self, experiment: Experiment) {
        self.experiments.insert(experiment.experiment_id.clone(), experiment);
    }

    pub fn publish(&mut self, publication: Publication) {
        self.publications.insert(publication.publication_id.clone(), publication);
    }

    pub fn get_active_projects(&self) -> u32 {
        self.projects
            .iter()
            .filter(|(_, p)| p.status == "active")
            .count() as u32
    }

    pub fn get_completed_experiments(&self) -> u32 {
        self.experiments
            .iter()
            .filter(|(_, e)| e.status == "completed")
            .count() as u32
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 118: RESEARCH & DEVELOPMENT ===\n");
    let mut rds = ResearchDevelopmentSystem::new("rds_001".to_string());
    let project = ResearchProject::new("proj_001".to_string(), "AI Optimization".to_string(), 500000.0);
    rds.create_project(project);
    let experiment = Experiment::new("exp_001".to_string(), "proj_001".to_string(), "Algorithm Test".to_string());
    rds.create_experiment(experiment);
    let publication = Publication::new("pub_001".to_string(), "New Algorithm".to_string(), "Nature".to_string());
    rds.publish(publication);
    println!("✓ Project, experiment, and publication recorded");
    println!("✓ Active projects: {}", rds.get_active_projects());
    println!("✓✓✓ Research & Development operational ✓✓✓");
    Ok(())
}
