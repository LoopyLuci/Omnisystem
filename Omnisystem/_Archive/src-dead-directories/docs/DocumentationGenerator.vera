// DocumentationGenerator.vera - Documentation generation and API docs
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct APIEndpoint {
    pub endpoint_id: String,
    pub path: String,
    pub method: String,
    pub description: String,
    pub parameters: Vec<String>,
    pub response_type: String,
}

impl APIEndpoint {
    pub fn new(endpoint_id: String, path: String, method: String) -> Self {
        APIEndpoint {
            endpoint_id,
            path,
            method,
            description: String::new(),
            parameters: Vec::new(),
            response_type: "JSON".to_string(),
        }
    }

    pub fn with_description(&mut self, desc: String) {
        self.description = desc;
    }

    pub fn add_parameter(&mut self, param: String) {
        self.parameters.push(param);
    }
}

pub struct DocumentationPage {
    pub page_id: String,
    pub title: String,
    pub content: String,
    pub endpoints: Vec<APIEndpoint>,
    pub created_at: u64,
}

impl DocumentationPage {
    pub fn new(page_id: String, title: String) -> Self {
        DocumentationPage {
            page_id,
            title,
            content: String::new(),
            endpoints: Vec::new(),
            created_at: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
        }
    }

    pub fn add_endpoint(&mut self, endpoint: APIEndpoint) {
        self.endpoints.push(endpoint);
    }

    pub fn set_content(&mut self, content: String) {
        self.content = content;
    }
}

pub struct DocumentationGenerator {
    pub generator_id: String,
    pub pages: HashMap<String, DocumentationPage>,
    pub total_endpoints: u32,
    pub output_format: String,
}

impl DocumentationGenerator {
    pub fn new(generator_id: String) -> Self {
        DocumentationGenerator {
            generator_id,
            pages: HashMap::new(),
            total_endpoints: 0,
            output_format: "Markdown".to_string(),
        }
    }

    pub fn create_page(&mut self, page: DocumentationPage) {
        self.pages.insert(page.page_id.clone(), page);
    }

    pub fn add_endpoint_to_page(&mut self, page_id: &str, endpoint: APIEndpoint) -> Result<(), String> {
        if let Some(page) = self.pages.get_mut(page_id) {
            page.add_endpoint(endpoint);
            self.total_endpoints += 1;
            Ok(())
        } else {
            Err(format!("Page {} not found", page_id))
        }
    }

    pub fn generate_docs(&self) -> Result<String, String> {
        let mut output = String::new();
        output.push_str("# API Documentation\n\n");

        for (_, page) in &self.pages {
            output.push_str(&format!("## {}\n\n", page.title));

            for endpoint in &page.endpoints {
                output.push_str(&format!(
                    "### {} {}\n{}\n\n",
                    endpoint.method, endpoint.path, endpoint.description
                ));
            }
        }

        Ok(output)
    }

    pub fn export(&self, format: &str) -> Result<String, String> {
        match format {
            "markdown" => self.generate_docs(),
            "html" => Ok(format!("<html><body>{}</body></html>", self.generate_docs()?)),
            _ => Err(format!("Unsupported format: {}", format)),
        }
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 76: DOCUMENTATION GENERATOR ===\n");
    let mut dg = DocumentationGenerator::new("dg_001".to_string());
    let mut page = DocumentationPage::new("api_ref".to_string(), "API Reference".to_string());
    let mut endpoint = APIEndpoint::new("ep_1".to_string(), "/users".to_string(), "GET".to_string());
    endpoint.with_description("Retrieve all users".to_string());
    page.add_endpoint(endpoint);
    dg.create_page(page);
    let docs = dg.generate_docs()?;
    println!("✓ Documentation generated");
    println!("✓ Total endpoints: {}", dg.total_endpoints);
    println!("✓✓✓ Documentation Generator operational ✓✓✓");
    Ok(())
}
