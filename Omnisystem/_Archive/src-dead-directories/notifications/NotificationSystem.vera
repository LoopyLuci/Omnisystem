// NotificationSystem.vera - Multi-channel notification delivery
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub enum NotificationChannel {
    Email,
    SMS,
    Push,
    InApp,
}

pub enum NotificationPriority {
    Low,
    Normal,
    High,
    Urgent,
}

pub struct Notification {
    pub notification_id: String,
    pub recipient: String,
    pub channel: NotificationChannel,
    pub subject: String,
    pub message: String,
    pub priority: NotificationPriority,
    pub sent: bool,
    pub created_at: u64,
}

impl Notification {
    pub fn new(notification_id: String, recipient: String, channel: NotificationChannel) -> Self {
        Notification {
            notification_id,
            recipient,
            channel,
            subject: String::new(),
            message: String::new(),
            priority: NotificationPriority::Normal,
            sent: false,
            created_at: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
        }
    }

    pub fn mark_sent(&mut self) {
        self.sent = true;
    }
}

pub struct NotificationTemplate {
    pub template_id: String,
    pub name: String,
    pub subject_template: String,
    pub body_template: String,
    pub variables: Vec<String>,
}

impl NotificationTemplate {
    pub fn new(template_id: String, name: String) -> Self {
        NotificationTemplate {
            template_id,
            name,
            subject_template: String::new(),
            body_template: String::new(),
            variables: Vec::new(),
        }
    }
}

pub struct NotificationPreference {
    pub user_id: String,
    pub enabled_channels: Vec<NotificationChannel>,
    pub quiet_hours_start: Option<u32>, // hour in 24h format
    pub quiet_hours_end: Option<u32>,
}

impl NotificationPreference {
    pub fn new(user_id: String) -> Self {
        NotificationPreference {
            user_id,
            enabled_channels: vec![NotificationChannel::Email, NotificationChannel::Push],
            quiet_hours_start: None,
            quiet_hours_end: None,
        }
    }
}

pub struct NotificationSystem {
    pub system_id: String,
    pub notifications: HashMap<String, Notification>,
    pub templates: HashMap<String, NotificationTemplate>,
    pub preferences: HashMap<String, NotificationPreference>,
    pub total_sent: u32,
}

impl NotificationSystem {
    pub fn new(system_id: String) -> Self {
        NotificationSystem {
            system_id,
            notifications: HashMap::new(),
            templates: HashMap::new(),
            preferences: HashMap::new(),
            total_sent: 0,
        }
    }

    pub fn queue_notification(&mut self, notification: Notification) -> Result<String, String> {
        let notification_id = notification.notification_id.clone();
        self.notifications.insert(notification_id.clone(), notification);
        Ok(notification_id)
    }

    pub fn send_notification(&mut self, notification_id: &str) -> Result<(), String> {
        if let Some(notif) = self.notifications.get_mut(notification_id) {
            notif.mark_sent();
            self.total_sent += 1;
            Ok(())
        } else {
            Err(format!("Notification {} not found", notification_id))
        }
    }

    pub fn create_template(&mut self, template: NotificationTemplate) {
        self.templates.insert(template.template_id.clone(), template);
    }

    pub fn set_user_preference(&mut self, preference: NotificationPreference) {
        self.preferences.insert(preference.user_id.clone(), preference);
    }

    pub fn get_pending_notifications(&self) -> u32 {
        self.notifications
            .iter()
            .filter(|(_, n)| !n.sent)
            .count() as u32
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 94: NOTIFICATION SYSTEM ===\n");
    let mut ns = NotificationSystem::new("ns_001".to_string());
    let mut notif = Notification::new("notif_001".to_string(), "user@example.com".to_string(), NotificationChannel::Email);
    notif.subject = "Welcome!".to_string();
    notif.message = "Thanks for signing up.".to_string();
    ns.queue_notification(notif)?;
    ns.send_notification("notif_001")?;
    println!("✓ Notification sent");
    println!("✓ Total sent: {}", ns.total_sent);
    println!("✓✓✓ Notification System operational ✓✓✓");
    Ok(())
}
