// ContractManagement.vera - Contract management and lifecycle
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct Contract {
    pub contract_id: String,
    pub contract_number: String,
    pub title: String,
    pub vendor_id: String,
    pub value: f64,
    pub start_date: u64,
    pub end_date: u64,
    pub status: String, // draft, active, expired, terminated
}

impl Contract {
    pub fn new(contract_id: String, contract_number: String, title: String) -> Self {
        let now = std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .unwrap()
            .as_secs();

        Contract {
            contract_id,
            contract_number,
            title,
            vendor_id: String::new(),
            value: 0.0,
            start_date: now,
            end_date: now + (365 * 86400), // 1 year
            status: "draft".to_string(),
        }
    }

    pub fn activate(&mut self) {
        self.status = "active".to_string();
    }

    pub fn terminate(&mut self) {
        self.status = "terminated".to_string();
    }

    pub fn is_expired(&self) -> bool {
        let now = std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .unwrap()
            .as_secs();
        now > self.end_date
    }
}

pub struct ContractClause {
    pub clause_id: String,
    pub contract_id: String,
    pub title: String,
    pub description: String,
    pub conditions: Vec<String>,
}

impl ContractClause {
    pub fn new(clause_id: String, contract_id: String, title: String) -> Self {
        ContractClause {
            clause_id,
            contract_id,
            title,
            description: String::new(),
            conditions: Vec::new(),
        }
    }

    pub fn add_condition(&mut self, condition: String) {
        if !self.conditions.contains(&condition) {
            self.conditions.push(condition);
        }
    }
}

pub struct ContractAmendment {
    pub amendment_id: String,
    pub contract_id: String,
    pub description: String,
    pub effective_date: u64,
    pub approved: bool,
}

impl ContractAmendment {
    pub fn new(amendment_id: String, contract_id: String) -> Self {
        ContractAmendment {
            amendment_id,
            contract_id,
            description: String::new(),
            effective_date: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
            approved: false,
        }
    }

    pub fn approve(&mut self) {
        self.approved = true;
    }
}

pub struct ContractManagementSystem {
    pub system_id: String,
    pub contracts: HashMap<String, Contract>,
    pub clauses: HashMap<String, ContractClause>,
    pub amendments: HashMap<String, ContractAmendment>,
    pub total_contract_value: f64,
}

impl ContractManagementSystem {
    pub fn new(system_id: String) -> Self {
        ContractManagementSystem {
            system_id,
            contracts: HashMap::new(),
            clauses: HashMap::new(),
            amendments: HashMap::new(),
            total_contract_value: 0.0,
        }
    }

    pub fn create_contract(&mut self, contract: Contract) -> Result<String, String> {
        let contract_id = contract.contract_id.clone();
        self.total_contract_value += contract.value;
        self.contracts.insert(contract_id.clone(), contract);
        Ok(contract_id)
    }

    pub fn add_clause(&mut self, clause: ContractClause) {
        self.clauses.insert(clause.clause_id.clone(), clause);
    }

    pub fn create_amendment(&mut self, amendment: ContractAmendment) {
        self.amendments.insert(amendment.amendment_id.clone(), amendment);
    }

    pub fn get_active_contracts(&self) -> u32 {
        self.contracts
            .iter()
            .filter(|(_, c)| c.status == "active")
            .count() as u32
    }

    pub fn get_expiring_contracts(&self) -> Vec<String> {
        self.contracts
            .iter()
            .filter(|(_, c)| c.is_expired())
            .map(|(id, _)| id.clone())
            .collect()
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 110: CONTRACT MANAGEMENT ===\n");
    let mut cms = ContractManagementSystem::new("cms_001".to_string());
    let mut contract = Contract::new("con_001".to_string(), "C-2026-001".to_string(), "Service Agreement".to_string());
    contract.value = 500000.0;
    contract.vendor_id = "vendor_001".to_string();
    cms.create_contract(contract)?;
    let clause = ContractClause::new("cls_001".to_string(), "con_001".to_string(), "Payment Terms".to_string());
    cms.add_clause(clause);
    println!("✓ Contract created with clause");
    println!("✓ Total contract value: ${:.2}", cms.total_contract_value);
    println!("✓✓✓ Contract Management operational ✓✓✓");
    Ok(())
}
