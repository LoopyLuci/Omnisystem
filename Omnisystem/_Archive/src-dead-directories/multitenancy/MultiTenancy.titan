// Multi-Tenancy
// Tenant isolation, resource management, billing
// Replaces: phase 41 multitenancy systems

use omnisystem::{HashMap, Vec, String, Option, Result}

struct Tenant {
    id: String,
    name: String,
    created_at: i64,
    is_active: bool,
    storage_quota: i64,
    storage_used: i64
}

struct TenantManager {
    tenants: HashMap<String, Tenant>,
    tenant_data: HashMap<String, HashMap<String, Vec<u8>>>
}

impl TenantManager {
    fn new() -> Self {
        return TenantManager {
            tenants: HashMap::new(),
            tenant_data: HashMap::new()
        }
    }

    fn create_tenant(&mut self, name: String, storage_quota: i64) -> Result<String, String> {
        let tenant = Tenant {
            id: "tenant_".to_string() + &SystemTime::now().secs().to_string(),
            name: name.clone(),
            created_at: SystemTime::now().secs(),
            is_active: true,
            storage_quota: storage_quota,
            storage_used: 0
        }

        let tenant_id = tenant.id.clone()
        self.tenants.insert(tenant_id.clone(), tenant)
        self.tenant_data.insert(tenant_id.clone(), HashMap::new())

        println("TenantManager: Created tenant '{}' (quota: {} bytes)", name, storage_quota)
        Ok(tenant_id)
    }

    fn store_tenant_data(&mut self, tenant_id: String, key: String, value: Vec<u8>) -> Result<(), String> {
        match self.tenants.get_mut(&tenant_id) {
            Some(tenant) => {
                let data_size = value.len() as i64

                if tenant.storage_used + data_size > tenant.storage_quota {
                    return Err("Storage quota exceeded".to_string())
                }

                match self.tenant_data.get_mut(&tenant_id) {
                    Some(data) => {
                        data.insert(key.clone(), value)
                        tenant.storage_used = tenant.storage_used + data_size

                        println("TenantManager: Stored {} bytes for tenant {}", data_size, tenant_id)
                        Ok(())
                    },
                    None => Err("Tenant data not found".to_string())
                }
            },
            None => Err("Tenant not found".to_string())
        }
    }

    fn get_tenant_info(&self, tenant_id: String) -> Result<(String, i64, i64), String> {
        match self.tenants.get(&tenant_id) {
            Some(tenant) => {
                Ok((tenant.name.clone(), tenant.storage_used, tenant.storage_quota))
            },
            None => Err("Tenant not found".to_string())
        }
    }

    fn get_tenant_count(&self) -> i32 {
        return self.tenants.len() as i32
    }
}

fn test_multitenancy() -> Result<(), String> {
    let mut manager = TenantManager::new()

    let tenant1 = manager.create_tenant("Company A".to_string(), 1024 * 1024)?
    let tenant2 = manager.create_tenant("Company B".to_string(), 2048 * 1024)?

    manager.store_tenant_data(tenant1.clone(), "config".to_string(), vec![1, 2, 3])?
    manager.store_tenant_data(tenant2.clone(), "data".to_string(), vec![4, 5, 6, 7])?

    let (name, used, quota) = manager.get_tenant_info(tenant1)?
    println("Tenant {} using {} / {} bytes", name, used, quota)

    println("Total tenants: {}", manager.get_tenant_count())

    Ok(())
}
