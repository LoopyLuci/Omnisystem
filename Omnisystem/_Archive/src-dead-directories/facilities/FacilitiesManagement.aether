// FacilitiesManagement.aether - Facilities and real estate management
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct Building {
    pub building_id: String,
    pub name: String,
    pub location: String,
    pub square_meters: f64,
    pub floors: u32,
    pub capacity: u32,
    pub occupancy: u32,
}

impl Building {
    pub fn new(building_id: String, name: String, square_meters: f64) -> Self {
        Building {
            building_id,
            name,
            location: String::new(),
            square_meters,
            floors: 1,
            capacity: 100,
            occupancy: 0,
        }
    }

    pub fn occupancy_percentage(&self) -> f64 {
        if self.capacity == 0 {
            0.0
        } else {
            (self.occupancy as f64 / self.capacity as f64) * 100.0
        }
    }
}

pub struct MaintenanceRequest {
    pub request_id: String,
    pub building_id: String,
    pub category: String, // plumbing, electrical, HVAC, etc.
    pub description: String,
    pub priority: String, // low, medium, high
    pub status: String, // pending, in_progress, completed
    pub requested_at: u64,
}

impl MaintenanceRequest {
    pub fn new(request_id: String, building_id: String, category: String) -> Self {
        MaintenanceRequest {
            request_id,
            building_id,
            category,
            description: String::new(),
            priority: "medium".to_string(),
            status: "pending".to_string(),
            requested_at: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
        }
    }

    pub fn start(&mut self) {
        self.status = "in_progress".to_string();
    }

    pub fn complete(&mut self) {
        self.status = "completed".to_string();
    }
}

pub struct Space {
    pub space_id: String,
    pub building_id: String,
    pub floor: u32,
    pub space_type: String, // office, conference, storage
    pub area_sqm: f64,
    pub assigned_to: Option<String>,
}

impl Space {
    pub fn new(space_id: String, building_id: String, space_type: String, area: f64) -> Self {
        Space {
            space_id,
            building_id,
            floor: 1,
            space_type,
            area_sqm: area,
            assigned_to: None,
        }
    }

    pub fn assign(&mut self, employee_id: String) {
        self.assigned_to = Some(employee_id);
    }
}

pub struct FacilitiesManagementSystem {
    pub system_id: String,
    pub buildings: HashMap<String, Building>,
    pub maintenance_requests: HashMap<String, MaintenanceRequest>,
    pub spaces: HashMap<String, Space>,
    pub total_area_sqm: f64,
}

impl FacilitiesManagementSystem {
    pub fn new(system_id: String) -> Self {
        FacilitiesManagementSystem {
            system_id,
            buildings: HashMap::new(),
            maintenance_requests: HashMap::new(),
            spaces: HashMap::new(),
            total_area_sqm: 0.0,
        }
    }

    pub fn register_building(&mut self, building: Building) {
        self.total_area_sqm += building.square_meters;
        self.buildings.insert(building.building_id.clone(), building);
    }

    pub fn request_maintenance(&mut self, request: MaintenanceRequest) {
        self.maintenance_requests.insert(request.request_id.clone(), request);
    }

    pub fn register_space(&mut self, space: Space) {
        self.spaces.insert(space.space_id.clone(), space);
    }

    pub fn get_pending_maintenance(&self) -> u32 {
        self.maintenance_requests
            .iter()
            .filter(|(_, r)| r.status == "pending")
            .count() as u32
    }

    pub fn get_occupancy(&self) -> f64 {
        let total_occupancy: f64 = self.buildings.iter().map(|(_, b)| b.occupancy_percentage()).sum();
        if self.buildings.is_empty() {
            0.0
        } else {
            total_occupancy / self.buildings.len() as f64
        }
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 115: FACILITIES MANAGEMENT ===\n");
    let mut fms = FacilitiesManagementSystem::new("fms_001".to_string());
    let building = Building::new("bldg_001".to_string(), "Main Office".to_string(), 5000.0);
    fms.register_building(building);
    let maintenance = MaintenanceRequest::new("maint_001".to_string(), "bldg_001".to_string(), "HVAC".to_string());
    fms.request_maintenance(maintenance);
    let space = Space::new("space_001".to_string(), "bldg_001".to_string(), "office".to_string(), 25.0);
    fms.register_space(space);
    println!("✓ Building, maintenance, and space registered");
    println!("✓ Total facility area: {:.0} sqm", fms.total_area_sqm);
    println!("✓✓✓ Facilities Management operational ✓✓✓");
    Ok(())
}
