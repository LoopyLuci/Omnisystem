// CustomerExperienceManagement.vera - Customer experience and journey management
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct Customer {
    pub customer_id: String,
    pub name: String,
    pub email: String,
    pub phone: String,
    pub lifetime_value: f64,
    pub created_at: u64,
}

impl Customer {
    pub fn new(customer_id: String, name: String, email: String) -> Self {
        Customer {
            customer_id,
            name,
            email,
            phone: String::new(),
            lifetime_value: 0.0,
            created_at: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
        }
    }

    pub fn update_ltv(&mut self, amount: f64) {
        self.lifetime_value += amount;
    }
}

pub struct CustomerJourney {
    pub journey_id: String,
    pub customer_id: String,
    pub touchpoints: Vec<String>,
    pub current_stage: String, // awareness, consideration, decision, retention
    pub satisfaction_score: f64,
}

impl CustomerJourney {
    pub fn new(journey_id: String, customer_id: String) -> Self {
        CustomerJourney {
            journey_id,
            customer_id,
            touchpoints: Vec::new(),
            current_stage: "awareness".to_string(),
            satisfaction_score: 0.0,
        }
    }

    pub fn add_touchpoint(&mut self, touchpoint: String) {
        self.touchpoints.push(touchpoint);
    }

    pub fn advance_stage(&mut self, new_stage: String) {
        self.current_stage = new_stage;
    }

    pub fn set_satisfaction(&mut self, score: f64) {
        self.satisfaction_score = score.clamp(0.0, 5.0);
    }
}

pub struct CXMSegment {
    pub segment_id: String,
    pub name: String,
    pub criteria: Vec<String>,
    pub customer_count: u32,
}

impl CXMSegment {
    pub fn new(segment_id: String, name: String) -> Self {
        CXMSegment {
            segment_id,
            name,
            criteria: Vec::new(),
            customer_count: 0,
        }
    }

    pub fn add_criteria(&mut self, criterion: String) {
        if !self.criteria.contains(&criterion) {
            self.criteria.push(criterion);
        }
    }
}

pub struct CustomerExperienceManagementSystem {
    pub system_id: String,
    pub customers: HashMap<String, Customer>,
    pub journeys: HashMap<String, CustomerJourney>,
    pub segments: HashMap<String, CXMSegment>,
    pub total_customers: u32,
}

impl CustomerExperienceManagementSystem {
    pub fn new(system_id: String) -> Self {
        CustomerExperienceManagementSystem {
            system_id,
            customers: HashMap::new(),
            journeys: HashMap::new(),
            segments: HashMap::new(),
            total_customers: 0,
        }
    }

    pub fn register_customer(&mut self, customer: Customer) -> Result<String, String> {
        let customer_id = customer.customer_id.clone();
        self.customers.insert(customer_id.clone(), customer);
        self.total_customers += 1;
        Ok(customer_id)
    }

    pub fn create_journey(&mut self, journey: CustomerJourney) {
        self.journeys.insert(journey.journey_id.clone(), journey);
    }

    pub fn create_segment(&mut self, segment: CXMSegment) {
        self.segments.insert(segment.segment_id.clone(), segment);
    }

    pub fn get_average_satisfaction(&self) -> f64 {
        if self.journeys.is_empty() {
            0.0
        } else {
            let total: f64 = self.journeys.iter().map(|(_, j)| j.satisfaction_score).sum();
            total / self.journeys.len() as f64
        }
    }

    pub fn get_total_ltv(&self) -> f64 {
        self.customers
            .iter()
            .map(|(_, c)| c.lifetime_value)
            .sum()
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 106: CUSTOMER EXPERIENCE MANAGEMENT ===\n");
    let mut cxm = CustomerExperienceManagementSystem::new("cxm_001".to_string());
    let customer = Customer::new("cust_001".to_string(), "Alice Johnson".to_string(), "alice@example.com".to_string());
    cxm.register_customer(customer)?;
    let mut journey = CustomerJourney::new("journey_001".to_string(), "cust_001".to_string());
    journey.add_touchpoint("website_visit".to_string());
    journey.set_satisfaction(4.5);
    cxm.create_journey(journey);
    println!("✓ Customer registered with journey");
    println!("✓ Average satisfaction: {:.1}", cxm.get_average_satisfaction());
    println!("✓✓✓ Customer Experience Management operational ✓✓✓");
    Ok(())
}
