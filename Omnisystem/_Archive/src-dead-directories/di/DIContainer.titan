// DIContainer.titan - Dependency injection container
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct ServiceDescriptor {
    pub service_type: String,
    pub implementation: String,
    pub lifetime: String, // Singleton, Transient, Scoped
    pub factory_fn: Option<String>,
}

impl ServiceDescriptor {
    pub fn new(service_type: String, implementation: String, lifetime: String) -> Self {
        ServiceDescriptor {
            service_type,
            implementation,
            lifetime,
            factory_fn: None,
        }
    }

    pub fn with_factory(&mut self, factory: String) {
        self.factory_fn = Some(factory);
    }
}

pub struct ServiceInstance {
    pub instance_id: String,
    pub service_type: String,
    pub created_at: u64,
    pub is_disposed: bool,
}

impl ServiceInstance {
    pub fn new(instance_id: String, service_type: String) -> Self {
        ServiceInstance {
            instance_id,
            service_type,
            created_at: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
            is_disposed: false,
        }
    }
}

pub struct DIContainer {
    pub container_id: String,
    pub descriptors: HashMap<String, ServiceDescriptor>,
    pub singletons: HashMap<String, ServiceInstance>,
    pub total_resolutions: u32,
}

impl DIContainer {
    pub fn new(container_id: String) -> Self {
        DIContainer {
            container_id,
            descriptors: HashMap::new(),
            singletons: HashMap::new(),
            total_resolutions: 0,
        }
    }

    pub fn register_service(&mut self, descriptor: ServiceDescriptor) -> Result<(), String> {
        if self.descriptors.contains_key(&descriptor.service_type) {
            return Err(format!("Service {} already registered", descriptor.service_type));
        }
        self.descriptors.insert(descriptor.service_type.clone(), descriptor);
        Ok(())
    }

    pub fn resolve(&mut self, service_type: &str) -> Result<ServiceInstance, String> {
        if let Some(descriptor) = self.descriptors.get(service_type) {
            self.total_resolutions += 1;

            if descriptor.lifetime == "Singleton" {
                if let Some(instance) = self.singletons.get(service_type) {
                    return Ok(ServiceInstance::new(
                        instance.instance_id.clone(),
                        instance.service_type.clone(),
                    ));
                }
            }

            let instance = ServiceInstance::new(
                format!("instance_{}_{}", service_type, self.total_resolutions),
                service_type.to_string(),
            );

            if descriptor.lifetime == "Singleton" {
                self.singletons.insert(service_type.to_string(), instance.clone());
            }

            Ok(instance)
        } else {
            Err(format!("Service {} not registered", service_type))
        }
    }

    pub fn resolve_with_dependencies(&mut self, service_type: &str, _dependencies: Vec<String>) -> Result<ServiceInstance, String> {
        self.resolve(service_type)
    }
}

impl Clone for ServiceInstance {
    fn clone(&self) -> Self {
        ServiceInstance {
            instance_id: self.instance_id.clone(),
            service_type: self.service_type.clone(),
            created_at: self.created_at,
            is_disposed: self.is_disposed,
        }
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 74: DI CONTAINER ===\n");
    let mut container = DIContainer::new("dic_001".to_string());
    let desc = ServiceDescriptor::new(
        "IUserRepository".to_string(),
        "UserRepository".to_string(),
        "Singleton".to_string(),
    );
    container.register_service(desc)?;
    let instance = container.resolve("IUserRepository")?;
    println!("✓ Service resolved: {}", instance.instance_id);
    println!("✓ Total resolutions: {}", container.total_resolutions);
    println!("✓✓✓ DI Container operational ✓✓✓");
    Ok(())
}
