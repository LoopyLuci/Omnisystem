// LicenseManagement.vera - Software license management and compliance
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub enum LicenseType {
    Perpetual,
    Subscription,
    Floating,
    Metered,
}

pub struct License {
    pub license_id: String,
    pub software_name: String,
    pub license_type: LicenseType,
    pub purchase_date: u64,
    pub expiration_date: Option<u64>,
    pub seat_count: u32,
    pub used_seats: u32,
}

impl License {
    pub fn new(license_id: String, software_name: String, license_type: LicenseType) -> Self {
        License {
            license_id,
            software_name,
            license_type,
            purchase_date: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
            expiration_date: None,
            seat_count: 1,
            used_seats: 0,
        }
    }

    pub fn set_expiration(&mut self, days_from_now: u32) {
        self.expiration_date = Some(
            std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs() + (days_from_now as u64 * 86400)
        );
    }

    pub fn is_expired(&self) -> bool {
        if let Some(exp) = self.expiration_date {
            let now = std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs();
            now > exp
        } else {
            false
        }
    }

    pub fn can_allocate_seat(&self) -> bool {
        self.used_seats < self.seat_count
    }

    pub fn allocate_seat(&mut self) -> Result<(), String> {
        if self.can_allocate_seat() {
            self.used_seats += 1;
            Ok(())
        } else {
            Err("No seats available".to_string())
        }
    }
}

pub struct LicenseCompliance {
    pub compliance_id: String,
    pub total_licenses: u32,
    pub compliant_licenses: u32,
    pub non_compliant_licenses: u32,
    pub expiring_soon: u32, // licenses expiring within 30 days
}

impl LicenseCompliance {
    pub fn new(compliance_id: String) -> Self {
        LicenseCompliance {
            compliance_id,
            total_licenses: 0,
            compliant_licenses: 0,
            non_compliant_licenses: 0,
            expiring_soon: 0,
        }
    }

    pub fn get_compliance_percentage(&self) -> f64 {
        if self.total_licenses == 0 {
            100.0
        } else {
            (self.compliant_licenses as f64 / self.total_licenses as f64) * 100.0
        }
    }
}

pub struct LicenseManagementSystem {
    pub system_id: String,
    pub licenses: HashMap<String, License>,
    pub compliance: LicenseCompliance,
}

impl LicenseManagementSystem {
    pub fn new(system_id: String) -> Self {
        LicenseManagementSystem {
            system_id,
            licenses: HashMap::new(),
            compliance: LicenseCompliance::new("comp_001".to_string()),
        }
    }

    pub fn register_license(&mut self, license: License) -> Result<String, String> {
        let license_id = license.license_id.clone();
        self.licenses.insert(license_id.clone(), license);
        self.compliance.total_licenses += 1;
        Ok(license_id)
    }

    pub fn check_compliance(&mut self) {
        self.compliance.compliant_licenses = 0;
        self.compliance.non_compliant_licenses = 0;
        self.compliance.expiring_soon = 0;

        let now = std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .unwrap()
            .as_secs();

        for (_, license) in &self.licenses {
            if license.is_expired() {
                self.compliance.non_compliant_licenses += 1;
            } else {
                self.compliance.compliant_licenses += 1;

                if let Some(exp) = license.expiration_date {
                    if exp - now < (30 * 86400) {
                        self.compliance.expiring_soon += 1;
                    }
                }
            }
        }
    }

    pub fn allocate_seat(&mut self, license_id: &str) -> Result<(), String> {
        if let Some(license) = self.licenses.get_mut(license_id) {
            license.allocate_seat()
        } else {
            Err(format!("License {} not found", license_id))
        }
    }

    pub fn get_compliance_report(&mut self) -> String {
        self.check_compliance();
        format!(
            "License Compliance: {:.1}% compliant, {} expiring soon",
            self.compliance.get_compliance_percentage(),
            self.compliance.expiring_soon
        )
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 88: LICENSE MANAGEMENT ===\n");
    let mut lms = LicenseManagementSystem::new("lms_001".to_string());
    let license = License::new("lic_001".to_string(), "Microsoft Office".to_string(), LicenseType::Subscription);
    lms.register_license(license)?;
    println!("✓ License registered");
    println!("✓ {}", lms.get_compliance_report());
    println!("✓✓✓ License Management operational ✓✓✓");
    Ok(())
}
