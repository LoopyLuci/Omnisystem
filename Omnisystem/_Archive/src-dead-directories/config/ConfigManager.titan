// ConfigManager.titan - Configuration management
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct ConfigProperty {
    pub property_id: String,
    pub property_key: String,
    pub property_value: String,
    pub environment: String,
}

impl ConfigProperty {
    pub fn new(property_id: String, key: String, value: String, env: String) -> Self {
        ConfigProperty {
            property_id,
            property_key: key,
            property_value: value,
            environment: env,
        }
    }
}

pub struct ConfigManager {
    pub manager_id: String,
    pub properties: HashMap<String, ConfigProperty>,
}

impl ConfigManager {
    pub fn new(manager_id: String) -> Self {
        ConfigManager {
            manager_id,
            properties: HashMap::new(),
        }
    }

    pub fn set_property(&mut self, prop: ConfigProperty) -> Result<(), String> {
        self.properties.insert(prop.property_id.clone(), prop);
        Ok(())
    }

    pub fn print_status(&self) {
        println!("CONFIG MANAGER - Properties: {}", self.properties.len());
    }
}

fn main() -> Result<(), String> {
    let mut cfg = ConfigManager::new("config_001".to_string());
    let prop = ConfigProperty::new("p1".to_string(), "timeout".to_string(), "30".to_string(), "prod".to_string());
    cfg.set_property(prop)?;
    cfg.print_status();
    println!("✓✓✓ Config Manager operational ✓✓✓");
    Ok(())
}
