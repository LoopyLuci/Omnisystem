// Scheduler
// Task scheduling, cron jobs, recurring events
// Replaces: phase 36 scheduling systems

use omnisystem::{HashMap, Vec, String, Option, Result}
use omnisystem::time::SystemTime

struct ScheduledTask {
    id: String,
    name: String,
    cron_expression: String,
    handler: String,
    last_run: Option<i64>,
    next_run: i64,
    enabled: bool
}

actor Scheduler {
    tasks: Vec<ScheduledTask> = Vec::new(),
    execution_count: i64 = 0

    message ScheduleTask(
        name: String,
        cron: String,
        handler: String
    ) -> Result<String, String> {
        let task = ScheduledTask {
            id: "task_".to_string() + &SystemTime::now().secs().to_string(),
            name: name.clone(),
            cron_expression: cron,
            handler: handler,
            last_run: None,
            next_run: SystemTime::now().secs() + 60,
            enabled: true
        }

        let task_id = task.id.clone()
        tasks.push(task)
        println("Scheduler: Scheduled task '{}'", name)
        return Ok(task_id)
    }

    message ExecuteScheduledTasks() -> Result<i32, String> {
        let now = SystemTime::now().secs()
        let mut executed = 0

        for task in tasks.iter_mut() {
            if task.enabled && now >= task.next_run {
                println("Scheduler: Executing task '{}'", task.name)

                task.last_run = Some(now)
                task.next_run = now + 3600  // Next run in 1 hour
                execution_count = execution_count + 1
                executed = executed + 1
            }
        }

        return Ok(executed)
    }

    message GetExecutionCount() -> i64 {
        return execution_count
    }

    message DisableTask(task_id: String) -> Result<(), String> {
        for task in tasks.iter_mut() {
            if task.id == task_id {
                task.enabled = false
                return Ok(())
            }
        }
        return Err("Task not found".to_string())
    }
}

async fn test_scheduler() -> Result<(), String> {
    let scheduler: ActorRef<Scheduler> = spawn(Scheduler {
        tasks: Vec::new(),
        execution_count: 0
    })

    await scheduler.call(Scheduler::ScheduleTask(
        "daily_backup".to_string(),
        "0 2 * * *".to_string(),
        "backup_handler".to_string()
    ))?

    await scheduler.call(Scheduler::ScheduleTask(
        "hourly_sync".to_string(),
        "0 * * * *".to_string(),
        "sync_handler".to_string()
    ))?

    let executed = await scheduler.call(Scheduler::ExecuteScheduledTasks())?
    println("Executed {} tasks", executed)

    let count = await scheduler.call(Scheduler::GetExecutionCount())?
    println("Total executions: {}", count)

    Ok(())
}
