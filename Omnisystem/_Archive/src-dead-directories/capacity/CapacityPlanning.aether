// CapacityPlanning.aether - Capacity planning and resource forecasting
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct CapacityMetric {
    pub metric_id: String,
    pub resource_type: String,
    pub current_usage: f64,
    pub peak_usage: f64,
    pub capacity_limit: f64,
}

impl CapacityMetric {
    pub fn new(metric_id: String, resource_type: String, limit: f64) -> Self {
        CapacityMetric {
            metric_id,
            resource_type,
            current_usage: 0.0,
            peak_usage: 0.0,
            capacity_limit: limit,
        }
    }

    pub fn update_usage(&mut self, usage: f64) {
        self.current_usage = usage;
        if usage > self.peak_usage {
            self.peak_usage = usage;
        }
    }

    pub fn utilization_percentage(&self) -> f64 {
        (self.current_usage / self.capacity_limit) * 100.0
    }

    pub fn remaining_capacity(&self) -> f64 {
        self.capacity_limit - self.current_usage
    }
}

pub struct CapacityForecast {
    pub forecast_id: String,
    pub resource_type: String,
    pub projected_usage_30d: f64,
    pub projected_usage_90d: f64,
    pub recommended_capacity: f64,
}

impl CapacityForecast {
    pub fn new(forecast_id: String, resource_type: String) -> Self {
        CapacityForecast {
            forecast_id,
            resource_type,
            projected_usage_30d: 0.0,
            projected_usage_90d: 0.0,
            recommended_capacity: 0.0,
        }
    }

    pub fn calculate_forecast(&mut self, current_usage: f64, growth_rate: f64) {
        self.projected_usage_30d = current_usage * (1.0 + (growth_rate * 0.25));
        self.projected_usage_90d = current_usage * (1.0 + (growth_rate * 0.75));
        self.recommended_capacity = self.projected_usage_90d * 1.2; // 20% buffer
    }
}

pub struct CapacityPlanningSystem {
    pub system_id: String,
    pub metrics: HashMap<String, CapacityMetric>,
    pub forecasts: HashMap<String, CapacityForecast>,
}

impl CapacityPlanningSystem {
    pub fn new(system_id: String) -> Self {
        CapacityPlanningSystem {
            system_id,
            metrics: HashMap::new(),
            forecasts: HashMap::new(),
        }
    }

    pub fn register_metric(&mut self, metric: CapacityMetric) {
        self.metrics.insert(metric.metric_id.clone(), metric);
    }

    pub fn update_metric(&mut self, metric_id: &str, usage: f64) -> Result<(), String> {
        if let Some(metric) = self.metrics.get_mut(metric_id) {
            metric.update_usage(usage);
            Ok(())
        } else {
            Err(format!("Metric {} not found", metric_id))
        }
    }

    pub fn generate_forecast(&mut self, resource_type: &str, growth_rate: f64) -> Result<String, String> {
        let current_usage = self.metrics
            .iter()
            .filter(|(_, m)| m.resource_type == resource_type)
            .map(|(_, m)| m.current_usage)
            .sum::<f64>() / (self.metrics.len() as f64).max(1.0);

        let forecast_id = format!("forecast_{}", resource_type);
        let mut forecast = CapacityForecast::new(forecast_id.clone(), resource_type.to_string());
        forecast.calculate_forecast(current_usage, growth_rate);

        self.forecasts.insert(forecast_id.clone(), forecast);
        Ok(forecast_id)
    }

    pub fn get_capacity_alerts(&self) -> Vec<String> {
        let mut alerts = Vec::new();
        for (_, metric) in &self.metrics {
            if metric.utilization_percentage() > 80.0 {
                alerts.push(format!(
                    "Capacity warning: {} at {:.1}% utilization",
                    metric.resource_type, metric.utilization_percentage()
                ));
            }
        }
        alerts
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 82: CAPACITY PLANNING ===\n");
    let mut cps = CapacityPlanningSystem::new("cps_001".to_string());
    let metric = CapacityMetric::new("cpu_001".to_string(), "cpu".to_string(), 1000.0);
    cps.register_metric(metric);
    cps.update_metric("cpu_001", 850.0)?;
    cps.generate_forecast("cpu", 0.15)?;
    let alerts = cps.get_capacity_alerts();
    println!("✓ Capacity forecast generated");
    println!("✓ Capacity alerts: {}", alerts.len());
    println!("✓✓✓ Capacity Planning operational ✓✓✓");
    Ok(())
}
