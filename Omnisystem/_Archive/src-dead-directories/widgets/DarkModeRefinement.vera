// Dark Mode Refinement
// True dark mode, contrast ratios, material elevation, reduced blue light, OLED optimization
// Phase 167

use omnisystem::{Vec, HashMap, Option, Result, String, f64}

struct DarkModeConfig {
    enabled: bool,
    tone_curve: String,
    blue_light_reduction: f64,
    oled_optimization: bool,
    contrast_level: String
}

actor DarkModeEngine {
    config: DarkModeConfig = DarkModeConfig {
        enabled: false,
        tone_curve: "material".to_string(),
        blue_light_reduction: 0.0,
        oled_optimization: false,
        contrast_level: "standard".to_string()
    },
    elevation_map: HashMap<String, String> = HashMap::new(),
    color_overrides: HashMap<String, String> = HashMap::new()

    message EnableDarkMode(enabled: bool) -> Result<(), String> {
        config.enabled = enabled
        Ok(())
    }

    message SetToneCurve(curve: String) -> Result<(), String> {
        let valid = vec!["material", "ios", "custom"]
        if !valid.contains(&curve.as_str()) {
            return Err("Invalid tone curve".to_string())
        }
        config.tone_curve = curve
        Ok(())
    }

    message SetBlueLight(reduction: f64) -> Result<(), String> {
        if reduction < 0.0 || reduction > 1.0 {
            return Err("Reduction must be 0-1".to_string())
        }
        config.blue_light_reduction = reduction
        Ok(())
    }

    message SetOLEDOptimization(enabled: bool) -> Result<(), String> {
        config.oled_optimization = enabled
        Ok(())
    }

    message GetElevationColor(level: i32) -> Result<String, String> {
        let color = match level {
            0 => "#121212".to_string(),
            1 => "#1E1E1E".to_string(),
            2 => "#272727".to_string(),
            3 => "#2F2F2F".to_string(),
            4 => "#383838".to_string(),
            _ => Err("Invalid elevation level".to_string())?
        }
        Ok(color)
    }

    message ApplyDarkMode(light_color: String) -> Result<String, String> {
        if !config.enabled {
            return Ok(light_color)
        }

        let dark_color = match light_color.as_str() {
            "#FFFFFF" => "#121212".to_string(),
            "#F2F2F7" => "#1C1C1E".to_string(),
            "#E5E5EA" => "#3A3A3C".to_string(),
            _ => invert_color(&light_color)?
        }

        Ok(dark_color)
    }

    message SetContrastLevel(level: String) -> Result<(), String> {
        let valid = vec!["standard", "high", "maximum"]
        if !valid.contains(&level.as_str()) {
            return Err("Invalid contrast level".to_string())
        }
        config.contrast_level = level
        Ok(())
    }
}

fn invert_color(hex: &String) -> Result<String, String> {
    if hex.len() != 7 || !hex.starts_with("#") {
        return Err("Invalid hex color".to_string())
    }

    let r = u8::from_str_radix(&hex[1..3], 16).map_err(|_| "Invalid hex".to_string())?
    let g = u8::from_str_radix(&hex[3..5], 16).map_err(|_| "Invalid hex".to_string())?
    let b = u8::from_str_radix(&hex[5..7], 16).map_err(|_| "Invalid hex".to_string())?

    let r_inv = 255 - r
    let g_inv = 255 - g
    let b_inv = 255 - b

    Ok(format!("#{:02X}{:02X}{:02X}", r_inv, g_inv, b_inv))
}

component DarkModeToggle {
    state {
        is_dark: bool = false
    }

    props {
        on_change: fn(bool) = |_| {}
    }

    render {
        button {
            on_click: |_| {
                is_dark = !is_dark
                on_change(is_dark)
            },
            style: {
                "background": if is_dark { "#1C1C1E" } else { "#FFFFFF" },
                "color": if is_dark { "white" } else { "black" },
                "border": if is_dark { "1px solid #444" } else { "1px solid #ddd" }
            },
            content: if is_dark { "☀️" } else { "🌙" }
        }
    }
}
