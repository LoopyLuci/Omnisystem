// Redesigned Core Widget Library
// 50+ pixel-perfect, animated, themeable, accessible widgets
// Phase 161

use omnisystem::{Vec, HashMap, Option, Result, String, f64, bool}

// ============= BUTTON VARIATIONS =============

component Button {
    state {
        is_hovered: bool = false,
        is_pressed: bool = false,
        is_disabled: bool = false
    }

    props {
        label: String = "Button".to_string(),
        variant: String = "primary".to_string(),
        size: String = "medium".to_string(),
        disabled: bool = false,
        on_click: fn() = || {}
    }

    render {
        button {
            class: format_classes("btn", variant, size),
            disabled: disabled,
            on_click: on_click,
            on_hover: |_| { is_hovered = true },
            on_leave: |_| { is_hovered = false },
            on_mouse_down: |_| { is_pressed = true },
            on_mouse_up: |_| { is_pressed = false },
            style: {
                "padding": get_padding(size),
                "border-radius": "8px",
                "font-weight": "500",
                "transition": "all 0.2s cubic-bezier(0.4, 0, 0.2, 1)",
                "transform": if is_pressed { "scale(0.98)" } else { "scale(1)" },
                "box-shadow": if is_hovered { "0 4px 12px rgba(0,0,0,0.15)" } else { "0 2px 8px rgba(0,0,0,0.1)" }
            },
            content: label
        }
    }

    fn get_padding(sz: String) -> String {
        match sz.as_str() {
            "small" => "6px 12px".to_string(),
            "medium" => "10px 16px".to_string(),
            "large" => "14px 24px".to_string(),
            _ => "10px 16px".to_string()
        }
    }

    fn format_classes(base: String, variant: String, size: String) -> String {
        format!("{} {} {}", base, variant, size)
    }
}

component ToggleButton {
    state {
        is_active: bool = false
    }

    props {
        icon: String = "".to_string(),
        label: String = "".to_string(),
        active: bool = false,
        on_change: fn(bool) = |_| {}
    }

    render {
        button {
            class: "toggle-btn",
            style: {
                "background": if is_active { "#007AFF" } else { "#E5E5EA" },
                "color": if is_active { "white" } else { "black" },
                "border-radius": "6px",
                "padding": "8px 12px",
                "transition": "all 0.3s ease"
            },
            on_click: |_| {
                is_active = !is_active
                on_change(is_active)
            },
            content: label
        }
    }

    fn on_mount() {
        is_active = active
    }
}

component SplitButton {
    state {
        menu_open: bool = false
    }

    props {
        primary_label: String = "Action".to_string(),
        options: Vec<String> = Vec::new(),
        on_primary: fn() = || {},
        on_select: fn(String) = |_| {}
    }

    render {
        div {
            class: "split-button",
            style: { "display": "flex" },
            children: [
                button {
                    content: primary_label,
                    on_click: on_primary
                },
                button {
                    content: "▼",
                    on_click: |_| { menu_open = !menu_open }
                }
            ]
        }

        if menu_open {
            dropdown_menu(options.clone(), on_select)
        }
    }
}

// ============= TEXT INPUTS =============

component TextInput {
    state {
        value: String = "".to_string(),
        is_focused: bool = false
    }

    props {
        placeholder: String = "".to_string(),
        disabled: bool = false,
        on_change: fn(String) = |_| {}
    }

    render {
        input {
            type_: "text",
            class: "text-input",
            placeholder: placeholder,
            disabled: disabled,
            value: value.clone(),
            on_change: |new_val| {
                value = new_val.clone()
                on_change(value.clone())
            },
            on_focus: |_| { is_focused = true },
            on_blur: |_| { is_focused = false },
            style: {
                "padding": "10px 12px",
                "border": if is_focused { "2px solid #007AFF" } else { "1px solid #ccc" },
                "border-radius": "6px",
                "font-size": "14px",
                "transition": "border-color 0.2s"
            }
        }
    }
}

component TextArea {
    state {
        value: String = "".to_string(),
        is_focused: bool = false
    }

    props {
        placeholder: String = "".to_string(),
        rows: i32 = 4,
        on_change: fn(String) = |_| {}
    }

    render {
        textarea {
            class: "textarea",
            placeholder: placeholder,
            rows: rows,
            value: value.clone(),
            on_change: |new_val| {
                value = new_val.clone()
                on_change(value.clone())
            },
            style: {
                "padding": "12px",
                "border": if is_focused { "2px solid #007AFF" } else { "1px solid #ccc" },
                "border-radius": "6px",
                "font-family": "system-ui",
                "resize": "vertical"
            }
        }
    }
}

component SearchInput {
    state {
        value: String = "".to_string(),
        has_results: bool = false
    }

    props {
        on_search: fn(String) = |_| {},
        placeholder: String = "Search...".to_string()
    }

    render {
        div {
            class: "search-input",
            style: { "position": "relative" },
            children: [
                input {
                    type_: "text",
                    placeholder: placeholder,
                    value: value.clone(),
                    on_change: |new_val| {
                        value = new_val.clone()
                        on_search(value.clone())
                    },
                    style: {
                        "padding": "10px 36px 10px 12px",
                        "border": "1px solid #e0e0e0",
                        "border-radius": "6px",
                        "width": "100%"
                    }
                },
                span {
                    content: "🔍",
                    style: { "position": "absolute", "right": "10px", "top": "50%", "transform": "translateY(-50%)" }
                }
            ]
        }
    }
}

// ============= SELECTION CONTROLS =============

component Checkbox {
    state {
        checked: bool = false
    }

    props {
        label: String = "".to_string(),
        disabled: bool = false,
        on_change: fn(bool) = |_| {}
    }

    render {
        label {
            class: "checkbox-label",
            style: { "display": "flex", "align-items": "center", "gap": "8px" },
            children: [
                input {
                    type_: "checkbox",
                    checked: checked,
                    disabled: disabled,
                    on_change: |new_checked| {
                        checked = new_checked
                        on_change(checked)
                    },
                    style: { "cursor": "pointer", "width": "18px", "height": "18px" }
                },
                span {
                    content: label
                }
            ]
        }
    }
}

component RadioButton {
    state {
        selected: bool = false
    }

    props {
        label: String = "".to_string(),
        group: String = "".to_string(),
        value: String = "".to_string(),
        on_change: fn(String) = |_| {}
    }

    render {
        label {
            class: "radio-label",
            style: { "display": "flex", "align-items": "center", "gap": "8px" },
            children: [
                input {
                    type_: "radio",
                    name: group,
                    value: value.clone(),
                    checked: selected,
                    on_change: |_| {
                        selected = true
                        on_change(value.clone())
                    }
                },
                span {
                    content: label
                }
            ]
        }
    }
}

component ToggleSwitch {
    state {
        is_on: bool = false
    }

    props {
        label: String = "".to_string(),
        on_change: fn(bool) = |_| {}
    }

    render {
        label {
            class: "toggle-switch",
            style: { "display": "flex", "align-items": "center", "gap": "12px" },
            children: [
                div {
                    class: "switch-control",
                    on_click: |_| {
                        is_on = !is_on
                        on_change(is_on)
                    },
                    style: {
                        "width": "50px",
                        "height": "28px",
                        "background": if is_on { "#34C759" } else { "#EBEBF0" },
                        "border-radius": "14px",
                        "position": "relative",
                        "cursor": "pointer",
                        "transition": "background 0.3s"
                    }
                },
                span {
                    content: label
                }
            ]
        }
    }
}

component Select {
    state {
        selected_index: i32 = 0,
        is_open: bool = false
    }

    props {
        options: Vec<String> = Vec::new(),
        on_select: fn(String) = |_| {}
    }

    render {
        div {
            class: "select",
            style: { "position": "relative" },
            children: [
                button {
                    content: if options.len() > selected_index as usize { options[selected_index as usize].clone() } else { "Select...".to_string() },
                    on_click: |_| { is_open = !is_open }
                },
                if is_open {
                    div {
                        class: "select-dropdown",
                        style: {
                            "position": "absolute",
                            "top": "100%",
                            "left": "0",
                            "right": "0",
                            "background": "white",
                            "border": "1px solid #ccc",
                            "border-radius": "4px",
                            "z-index": "10"
                        },
                        children: render_options(options.clone())
                    }
                }
            ]
        }
    }

    fn render_options(opts: Vec<String>) -> Vec<Component> {
        let mut rendered: Vec<Component> = Vec::new()

        for opt in opts {
            rendered.push(
                div {
                    class: "select-option",
                    on_click: |_| {
                        selected_index = opts.iter().position(|x| x == &opt) as i32
                        is_open = false
                        on_select(opt.clone())
                    },
                    content: opt
                }
            )
        }

        rendered
    }
}

// ============= PROGRESS INDICATORS =============

component ProgressBar {
    state {}

    props {
        value: f64 = 0.5,
        max_value: f64 = 1.0,
        show_label: bool = true
    }

    render {
        div {
            class: "progress-bar",
            style: {
                "width": "100%",
                "height": "6px",
                "background": "#E5E5EA",
                "border-radius": "3px",
                "overflow": "hidden"
            },
            children: [
                div {
                    style: {
                        "height": "100%",
                        "background": "linear-gradient(90deg, #007AFF, #5AC8FA)",
                        "width": format_percentage(value / max_value),
                        "transition": "width 0.3s ease"
                    }
                }
            ]
        }

        if show_label {
            span {
                content: format!("{}%", (value / max_value * 100.0) as i32),
                style: { "font-size": "12px", "margin-top": "4px" }
            }
        }
    }

    fn format_percentage(ratio: f64) -> String {
        format!("{}%", (ratio * 100.0) as i32)
    }
}

component Spinner {
    state {}

    props {
        size: String = "medium".to_string(),
        color: String = "#007AFF".to_string()
    }

    render {
        div {
            class: "spinner",
            style: {
                "width": get_size(size),
                "height": get_size(size),
                "border": "3px solid rgba(0,0,0,0.1)",
                "border-top-color": color,
                "border-radius": "50%",
                "animation": "spin 1s linear infinite"
            }
        }
    }

    fn get_size(sz: String) -> String {
        match sz.as_str() {
            "small" => "20px".to_string(),
            "medium" => "32px".to_string(),
            "large" => "48px".to_string(),
            _ => "32px".to_string()
        }
    }
}

// ============= CARDS & CONTAINERS =============

component Card {
    state {}

    props {
        title: String = "".to_string(),
        padding: String = "16px".to_string(),
        elevated: bool = true
    }

    render {
        div {
            class: "card",
            style: {
                "padding": padding,
                "background": "white",
                "border-radius": "12px",
                "box-shadow": if elevated { "0 2px 8px rgba(0,0,0,0.1)" } else { "none" },
                "border": "1px solid #e5e5e5"
            },
            children: if title.len() > 0 {
                vec![
                    h3 { content: title },
                    slot { }
                ]
            } else {
                vec![ slot { } ]
            }
        }
    }
}

// ============= NAVIGATION =============

component TabPanel {
    state {
        active_index: i32 = 0
    }

    props {
        tabs: Vec<(String, String)> = Vec::new()
    }

    render {
        div {
            class: "tab-panel",
            children: [
                div {
                    class: "tabs",
                    style: { "display": "flex", "border-bottom": "1px solid #e5e5e5" },
                    children: render_tabs(tabs.clone())
                },
                div {
                    class: "tab-content",
                    content: if active_index >= 0 && active_index < tabs.len() as i32 {
                        tabs[active_index as usize].1.clone()
                    } else {
                        "".to_string()
                    }
                }
            ]
        }
    }

    fn render_tabs(tabs_list: Vec<(String, String)>) -> Vec<Component> {
        let mut rendered: Vec<Component> = Vec::new()

        for (idx, (label, _)) in tabs_list.iter().enumerate() {
            rendered.push(
                button {
                    content: label.clone(),
                    on_click: |_| { active_index = idx as i32 },
                    style: {
                        "padding": "12px 16px",
                        "border": "none",
                        "border-bottom": if active_index == idx as i32 { "2px solid #007AFF" } else { "none" },
                        "background": "transparent",
                        "cursor": "pointer"
                    }
                }
            )
        }

        rendered
    }
}

component NavigationSidebar {
    state {
        active_item: i32 = 0
    }

    props {
        items: Vec<(String, String)> = Vec::new()
    }

    render {
        nav {
            class: "sidebar",
            style: {
                "width": "240px",
                "background": "#f8f9fa",
                "padding": "16px",
                "border-right": "1px solid #e5e5e5"
            },
            children: render_nav_items(items.clone())
        }
    }

    fn render_nav_items(nav_items: Vec<(String, String)>) -> Vec<Component> {
        let mut rendered: Vec<Component> = Vec::new()

        for (idx, (icon, label)) in nav_items.iter().enumerate() {
            rendered.push(
                a {
                    href: "#",
                    class: "nav-item",
                    on_click: |_| { active_item = idx as i32 },
                    style: {
                        "display": "flex",
                        "align-items": "center",
                        "gap": "12px",
                        "padding": "12px",
                        "margin": "4px 0",
                        "border-radius": "6px",
                        "background": if active_item == idx as i32 { "#007AFF" } else { "transparent" },
                        "color": if active_item == idx as i32 { "white" } else { "#333" },
                        "text-decoration": "none",
                        "cursor": "pointer",
                        "transition": "all 0.2s"
                    },
                    content: label.clone()
                }
            )
        }

        rendered
    }
}

// ============= MODALS & OVERLAYS =============

component Modal {
    state {
        is_open: bool = true
    }

    props {
        title: String = "".to_string(),
        on_close: fn() = || {}
    }

    render {
        if is_open {
            div {
                class: "modal-backdrop",
                on_click: |_| {
                    is_open = false
                    on_close()
                },
                style: {
                    "position": "fixed",
                    "top": "0",
                    "left": "0",
                    "right": "0",
                    "bottom": "0",
                    "background": "rgba(0,0,0,0.5)",
                    "display": "flex",
                    "align-items": "center",
                    "justify-content": "center",
                    "z-index": "1000"
                },
                children: [
                    div {
                        class: "modal",
                        on_click: |event| { event.stop_propagation() },
                        style: {
                            "background": "white",
                            "border-radius": "12px",
                            "padding": "24px",
                            "min-width": "400px",
                            "box-shadow": "0 10px 40px rgba(0,0,0,0.3)"
                        },
                        children: [
                            h2 { content: title },
                            slot { }
                        ]
                    }
                ]
            }
        }
    }
}

// ============= NOTIFICATIONS & FEEDBACK =============

component Toast {
    state {}

    props {
        message: String = "".to_string(),
        variant: String = "info".to_string(),
        duration: f64 = 3.0
    }

    render {
        div {
            class: "toast",
            style: {
                "padding": "12px 16px",
                "border-radius": "6px",
                "margin-bottom": "8px",
                "display": "flex",
                "align-items": "center",
                "gap": "12px",
                "background": get_toast_bg(variant),
                "color": get_toast_color(variant),
                "animation": "slideIn 0.3s ease"
            },
            content: message
        }
    }

    fn get_toast_bg(variant: String) -> String {
        match variant.as_str() {
            "success" => "#D1FAE5".to_string(),
            "error" => "#FEE2E2".to_string(),
            "warning" => "#FEF3C7".to_string(),
            _ => "#DBEAFE".to_string()
        }
    }

    fn get_toast_color(variant: String) -> String {
        match variant.as_str() {
            "success" => "#065F46".to_string(),
            "error" => "#7F1D1D".to_string(),
            "warning" => "#92400E".to_string(),
            _ => "#0C4A6E".to_string()
        }
    }
}

component Badge {
    state {}

    props {
        label: String = "".to_string(),
        variant: String = "default".to_string()
    }

    render {
        span {
            class: "badge",
            style: {
                "display": "inline-block",
                "padding": "4px 8px",
                "border-radius": "12px",
                "font-size": "12px",
                "font-weight": "600",
                "background": get_badge_bg(variant),
                "color": get_badge_color(variant)
            },
            content: label
        }
    }

    fn get_badge_bg(variant: String) -> String {
        match variant.as_str() {
            "primary" => "#007AFF".to_string(),
            "success" => "#34C759".to_string(),
            "error" => "#FF3B30".to_string(),
            _ => "#E5E5EA".to_string()
        }
    }

    fn get_badge_color(variant: String) -> String {
        match variant.as_str() {
            "default" => "#333".to_string(),
            _ => "white".to_string()
        }
    }
}

fn dropdown_menu(options: Vec<String>, on_select: fn(String)) -> Component {
    div {
        class: "dropdown-menu",
        style: { "position": "absolute", "top": "100%", "left": "0" },
        children: render_menu_items(options)
    }
}

fn render_menu_items(items: Vec<String>) -> Vec<Component> {
    let mut rendered: Vec<Component> = Vec::new()

    for item in items {
        rendered.push(
            div {
                class: "menu-item",
                on_click: |_| { on_select(item.clone()) },
                content: item
            }
        )
    }

    rendered
}
