// Advanced Component State Management
// Hover, focus, active, disabled, loading, error, success states with transitions
// Phase 170

use omnisystem::{Vec, HashMap, Option, Result, String}

struct ComponentState {
    name: String,
    visual_style: HashMap<String, String>,
    transition_duration: f64,
    next_states: Vec<String>
}

struct StateTransition {
    from_state: String,
    to_state: String,
    trigger: String,
    animation: String
}

actor ComponentStateManager {
    states: HashMap<String, ComponentState> = HashMap::new(),
    transitions: Vec<StateTransition> = Vec::new(),
    current_states: HashMap<String, String> = HashMap::new(),
    state_history: Vec<(String, String)> = Vec::new(),
    max_history: i32 = 100

    message RegisterState(state_name: String, visual_style: HashMap<String, String>) -> Result<(), String> {
        let state = ComponentState {
            name: state_name.clone(),
            visual_style: visual_style,
            transition_duration: 0.2,
            next_states: Vec::new()
        }
        states.insert(state_name, state)
        Ok(())
    }

    message RegisterStateTransition(from: String, to: String, trigger: String) -> Result<(), String> {
        let transition = StateTransition {
            from_state: from,
            to_state: to,
            trigger: trigger,
            animation: "ease-in-out".to_string()
        }
        transitions.push(transition)
        Ok(())
    }

    message SetComponentState(component_id: String, state_name: String) -> Result<(), String> {
        if !states.contains_key(&state_name) {
            return Err("State not found".to_string())
        }

        let old_state = current_states.get(&component_id).cloned()

        current_states.insert(component_id.clone(), state_name.clone())

        if let Some(old) = old_state {
            state_history.push((component_id.clone(), format!("{} -> {}", old, state_name)))
            if state_history.len() > max_history as usize {
                state_history.remove(0)
            }
        }

        Ok(())
    }

    message GetComponentState(component_id: String) -> Option<String> {
        current_states.get(&component_id).cloned()
    }

    message CanTransition(from: String, to: String) -> bool {
        for transition in &transitions {
            if transition.from_state == from && transition.to_state == to {
                return true
            }
        }
        false
    }

    message GetStateStyle(state_name: String) -> Result<HashMap<String, String>, String> {
        match states.get(&state_name) {
            Some(state) => Ok(state.visual_style.clone()),
            None => Err("State not found".to_string())
        }
    }
}
