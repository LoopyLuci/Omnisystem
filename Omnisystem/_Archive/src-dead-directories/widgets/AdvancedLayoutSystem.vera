// Advanced Layout System
// CSS Grid, Flexbox, constraints, responsive breakpoints, safe areas
// Phase 162

use omnisystem::{Vec, HashMap, Option, Result, String, f64, bool}

struct LayoutConstraint {
    left: Option<f64>,
    right: Option<f64>,
    top: Option<f64>,
    bottom: Option<f64>,
    width: Option<f64>,
    height: Option<f64>,
    center_x: bool,
    center_y: bool
}

struct Breakpoint {
    name: String,
    min_width: f64,
    max_width: Option<f64>
}

struct SafeAreaInsets {
    top: f64,
    bottom: f64,
    left: f64,
    right: f64
}

struct ResponsiveValue {
    mobile: String,
    tablet: String,
    desktop: String,
    ultrawide: String
}

enum FlexDirection {
    Row,
    Column,
    RowReverse,
    ColumnReverse
}

enum FlexWrap {
    NoWrap,
    Wrap,
    WrapReverse
}

enum JustifyContent {
    FlexStart,
    Center,
    FlexEnd,
    SpaceBetween,
    SpaceAround,
    SpaceEvenly
}

enum AlignItems {
    FlexStart,
    Center,
    FlexEnd,
    Stretch,
    Baseline
}

component FlexContainer {
    state {}

    props {
        direction: String = "row".to_string(),
        wrap: String = "nowrap".to_string(),
        justify: String = "flex-start".to_string(),
        align: String = "stretch".to_string(),
        gap: String = "0".to_string(),
        padding: String = "0".to_string()
    }

    render {
        div {
            class: "flex-container",
            style: {
                "display": "flex",
                "flex-direction": direction,
                "flex-wrap": wrap,
                "justify-content": justify,
                "align-items": align,
                "gap": gap,
                "padding": padding
            },
            slot: {}
        }
    }
}

component GridContainer {
    state {}

    props {
        columns: i32 = 12,
        gap: String = "16px".to_string(),
        auto_flow: String = "row".to_string(),
        align_items: String = "start".to_string(),
        justify_items: String = "start".to_string()
    }

    render {
        div {
            class: "grid-container",
            style: {
                "display": "grid",
                "grid-template-columns": format!("repeat({}, 1fr)", columns),
                "gap": gap,
                "grid-auto-flow": auto_flow,
                "align-items": align_items,
                "justify-items": justify_items
            },
            slot: {}
        }
    }
}

component GridItem {
    state {}

    props {
        column: i32 = 1,
        row: i32 = 1,
        column_span: i32 = 1,
        row_span: i32 = 1
    }

    render {
        div {
            class: "grid-item",
            style: {
                "grid-column": format!("{} / span {}", column, column_span),
                "grid-row": format!("{} / span {}", row, row_span)
            },
            slot: {}
        }
    }
}

component ResponsiveLayout {
    state {
        current_breakpoint: String = "desktop".to_string(),
        window_width: f64 = 1024.0
    }

    props {
        breakpoints: Vec<(String, f64)> = vec![
            ("mobile".to_string(), 320.0),
            ("tablet".to_string(), 768.0),
            ("desktop".to_string(), 1024.0),
            ("ultrawide".to_string(), 1440.0)
        ]
    }

    render {
        div {
            class: "responsive-layout",
            on_resize: |width| {
                window_width = width
                update_breakpoint()
            },
            slot: {}
        }
    }

    fn update_breakpoint() {
        for i in breakpoints.iter().rev() {
            if window_width >= i.1 {
                current_breakpoint = i.0.clone()
                break
            }
        }
    }

    fn get_value(responsive: ResponsiveValue) -> String {
        match current_breakpoint.as_str() {
            "mobile" => responsive.mobile,
            "tablet" => responsive.tablet,
            "desktop" => responsive.desktop,
            "ultrawide" => responsive.ultrawide,
            _ => responsive.desktop
        }
    }
}

component ConstraintLayout {
    state {}

    props {
        constraint: LayoutConstraint = LayoutConstraint {
            left: None,
            right: None,
            top: None,
            bottom: None,
            width: None,
            height: None,
            center_x: false,
            center_y: false
        }
    }

    render {
        div {
            class: "constraint-layout",
            style: {
                "position": "absolute",
                "left": format_constraint(constraint.left),
                "right": format_constraint(constraint.right),
                "top": format_constraint(constraint.top),
                "bottom": format_constraint(constraint.bottom),
                "width": format_constraint(constraint.width),
                "height": format_constraint(constraint.height),
                "transform": if constraint.center_x && constraint.center_y {
                    "translate(-50%, -50%)".to_string()
                } else if constraint.center_x {
                    "translateX(-50%)".to_string()
                } else if constraint.center_y {
                    "translateY(-50%)".to_string()
                } else {
                    "none".to_string()
                }
            },
            slot: {}
        }
    }

    fn format_constraint(val: Option<f64>) -> String {
        match val {
            Some(v) => format!("{}px", v as i32),
            None => "auto".to_string()
        }
    }
}

component SafeAreaView {
    state {
        insets: SafeAreaInsets = SafeAreaInsets {
            top: 0.0,
            bottom: 0.0,
            left: 0.0,
            right: 0.0
        }
    }

    props {
        edges: Vec<String> = vec!["top".to_string(), "bottom".to_string(), "left".to_string(), "right".to_string()]
    }

    render {
        div {
            class: "safe-area-view",
            on_mount: |_| {
                detect_safe_areas()
            },
            style: {
                "padding-top": if edges.contains(&"top".to_string()) { format!("{}px", insets.top as i32) } else { "0".to_string() },
                "padding-bottom": if edges.contains(&"bottom".to_string()) { format!("{}px", insets.bottom as i32) } else { "0".to_string() },
                "padding-left": if edges.contains(&"left".to_string()) { format!("{}px", insets.left as i32) } else { "0".to_string() },
                "padding-right": if edges.contains(&"right".to_string()) { format!("{}px", insets.right as i32) } else { "0".to_string() }
            },
            slot: {}
        }
    }

    fn detect_safe_areas() {
        insets = SafeAreaInsets {
            top: 44.0,
            bottom: 34.0,
            left: 0.0,
            right: 0.0
        }
    }
}

component MasonryLayout {
    state {}

    props {
        columns: i32 = 3,
        gap: String = "16px".to_string()
    }

    render {
        div {
            class: "masonry-layout",
            style: {
                "display": "grid",
                "grid-template-columns": format!("repeat({}, 1fr)", columns),
                "gap": gap,
                "auto-rows": "max-content"
            },
            slot: {}
        }
    }
}

component AspectRatioBox {
    state {}

    props {
        ratio: f64 = 1.0,
        width: String = "100%".to_string()
    }

    render {
        div {
            class: "aspect-ratio-box",
            style: {
                "width": width,
                "aspect-ratio": format!("{}", ratio),
                "overflow": "hidden"
            },
            slot: {}
        }
    }
}

component SplitView {
    state {
        divider_position: f64 = 50.0,
        is_dragging: bool = false
    }

    props {
        orientation: String = "horizontal".to_string(),
        min_size: f64 = 200.0,
        max_size: Option<f64> = None
    }

    render {
        div {
            class: "split-view",
            style: {
                "display": "flex",
                "flex-direction": if orientation == "horizontal" { "row" } else { "column" },
                "width": "100%",
                "height": "100%"
            },
            children: [
                div {
                    class: "split-pane-left",
                    style: {
                        "flex": format!("0 0 {}%", divider_position),
                        "overflow": "auto"
                    },
                    slot: {}
                },
                div {
                    class: "divider",
                    on_mouse_down: |_| { is_dragging = true },
                    on_mouse_up: |_| { is_dragging = false },
                    on_mouse_move: |pos| {
                        if is_dragging {
                            divider_position = pos
                        }
                    },
                    style: {
                        "width": if orientation == "horizontal" { "4px" } else { "100%" },
                        "height": if orientation == "horizontal" { "100%" } else { "4px" },
                        "background": "#e5e5e5",
                        "cursor": if orientation == "horizontal" { "col-resize" } else { "row-resize" },
                        "flex-shrink": "0"
                    }
                },
                div {
                    class: "split-pane-right",
                    style: {
                        "flex": "1",
                        "overflow": "auto"
                    },
                    slot: {}
                }
            ]
        }
    }
}

actor LayoutEngine {
    breakpoints: Vec<Breakpoint> = Vec::new(),
    safe_areas: SafeAreaInsets = SafeAreaInsets { top: 0.0, bottom: 0.0, left: 0.0, right: 0.0 },
    viewport_width: f64 = 1024.0,
    viewport_height: f64 = 768.0,
    current_breakpoint: String = "desktop".to_string()

    message RegisterBreakpoint(name: String, min_width: f64, max_width: Option<f64>) -> Result<(), String> {
        let bp = Breakpoint {
            name: name,
            min_width: min_width,
            max_width: max_width
        }
        breakpoints.push(bp)
        Ok(())
    }

    message SetViewportSize(width: f64, height: f64) -> Result<(), String> {
        viewport_width = width
        viewport_height = height
        update_breakpoint()
        Ok(())
    }

    message GetCurrentBreakpoint() -> String {
        current_breakpoint.clone()
    }

    message SetSafeAreaInsets(top: f64, bottom: f64, left: f64, right: f64) -> Result<(), String> {
        safe_areas = SafeAreaInsets {
            top: top,
            bottom: bottom,
            left: left,
            right: right
        }
        Ok(())
    }

    message GetSafeAreaInsets() -> (f64, f64, f64, f64) {
        (safe_areas.top, safe_areas.bottom, safe_areas.left, safe_areas.right)
    }

    message CalculateConstraintPosition(constraint: LayoutConstraint, container_width: f64, container_height: f64) -> Result<(f64, f64, f64, f64), String> {
        let mut x = 0.0
        let mut y = 0.0
        let mut width = container_width
        let mut height = container_height

        if let Some(w) = constraint.width {
            width = w
        }
        if let Some(h) = constraint.height {
            height = h
        }

        if constraint.center_x {
            x = (container_width - width) / 2.0
        } else if let Some(l) = constraint.left {
            x = l
        } else if let Some(r) = constraint.right {
            x = container_width - r - width
        }

        if constraint.center_y {
            y = (container_height - height) / 2.0
        } else if let Some(t) = constraint.top {
            y = t
        } else if let Some(b) = constraint.bottom {
            y = container_height - b - height
        }

        Ok((x, y, width, height))
    }

    fn update_breakpoint() {
        for bp in breakpoints.iter().rev() {
            if viewport_width >= bp.min_width {
                if let Some(max) = bp.max_width {
                    if viewport_width <= max {
                        current_breakpoint = bp.name.clone()
                        break
                    }
                } else {
                    current_breakpoint = bp.name.clone()
                    break
                }
            }
        }
    }
}

async fn test_layout_system() -> Result<(), String> {
    let engine: ActorRef<LayoutEngine> = spawn(LayoutEngine {
        breakpoints: Vec::new(),
        safe_areas: SafeAreaInsets { top: 0.0, bottom: 0.0, left: 0.0, right: 0.0 },
        viewport_width: 1024.0,
        viewport_height: 768.0,
        current_breakpoint: "desktop".to_string()
    })

    await engine.call(LayoutEngine::RegisterBreakpoint("mobile".to_string(), 320.0, Some(767.0)))?
    await engine.call(LayoutEngine::RegisterBreakpoint("tablet".to_string(), 768.0, Some(1023.0)))?
    await engine.call(LayoutEngine::RegisterBreakpoint("desktop".to_string(), 1024.0, None))?

    await engine.call(LayoutEngine::SetViewportSize(1440.0, 900.0))?
    let current_bp = await engine.call(LayoutEngine::GetCurrentBreakpoint())?
    println("Current breakpoint: {}", current_bp)

    await engine.call(LayoutEngine::SetSafeAreaInsets(44.0, 34.0, 0.0, 0.0))?
    let (top, bottom, left, right) = await engine.call(LayoutEngine::GetSafeAreaInsets())?
    println("Safe areas: top={}, bottom={}, left={}, right={}", top, bottom, left, right)

    Ok(())
}
