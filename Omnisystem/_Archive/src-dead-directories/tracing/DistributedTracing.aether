// Distributed Tracing
// Request tracing, span collection, and observability
// Replaces: phase 28 tracing systems (100% rewrite in AETHER)

use omnisystem::{HashMap, Vec, String, Option, Result}
use omnisystem::time::SystemTime

struct Span {
    trace_id: String,
    span_id: String,
    parent_span_id: Option<String>,
    operation: String,
    start_time: i64,
    end_time: Option<i64>,
    duration_ms: Option<i64>,
    tags: HashMap<String, String>,
    logs: Vec<String>
}

actor TraceCollector {
    traces: HashMap<String, Vec<Span>> = HashMap::new(),
    span_count: i64 = 0

    message StartSpan(
        trace_id: String,
        span_id: String,
        parent_span_id: Option<String>,
        operation: String
    ) -> Result<(), String> {
        if !traces.contains_key(&trace_id) {
            traces.insert(trace_id.clone(), Vec::new())
        }

        let span = Span {
            trace_id: trace_id.clone(),
            span_id: span_id.clone(),
            parent_span_id: parent_span_id,
            operation: operation.clone(),
            start_time: SystemTime::now().secs(),
            end_time: None,
            duration_ms: None,
            tags: HashMap::new(),
            logs: Vec::new()
        }

        traces.get_mut(&trace_id).unwrap().push(span)
        span_count = span_count + 1

        println("TraceCollector: Started span {} in trace {}", span_id, trace_id)
        return Ok(())
    }

    message EndSpan(trace_id: String, span_id: String) -> Result<(), String> {
        match traces.get_mut(&trace_id) {
            Some(spans) => {
                for span in spans.iter_mut() {
                    if span.span_id == span_id {
                        let now = SystemTime::now().secs()
                        span.end_time = Some(now)
                        span.duration_ms = Some((now - span.start_time) * 1000)
                        println("TraceCollector: Ended span {} (duration: {}ms)",
                            span_id, span.duration_ms.unwrap_or(0))
                        return Ok(())
                    }
                }
                Err("Span not found".to_string())
            },
            None => Err("Trace not found".to_string())
        }
    }

    message AddTag(
        trace_id: String,
        span_id: String,
        key: String,
        value: String
    ) -> Result<(), String> {
        match traces.get_mut(&trace_id) {
            Some(spans) => {
                for span in spans.iter_mut() {
                    if span.span_id == span_id {
                        span.tags.insert(key, value)
                        return Ok(())
                    }
                }
                Err("Span not found".to_string())
            },
            None => Err("Trace not found".to_string())
        }
    }

    message AddLog(
        trace_id: String,
        span_id: String,
        message: String
    ) -> Result<(), String> {
        match traces.get_mut(&trace_id) {
            Some(spans) => {
                for span in spans.iter_mut() {
                    if span.span_id == span_id {
                        span.logs.push(message)
                        return Ok(())
                    }
                }
                Err("Span not found".to_string())
            },
            None => Err("Trace not found".to_string())
        }
    }

    message GetTrace(trace_id: String) -> Result<Vec<Span>, String> {
        match traces.get(&trace_id) {
            Some(spans) => Ok(spans.clone()),
            None => Err("Trace not found".to_string())
        }
    }

    message GetSpanCount() -> i64 {
        return span_count
    }
}

async fn test_distributed_tracing() -> Result<(), String> {
    let collector: ActorRef<TraceCollector> = spawn(TraceCollector {
        traces: HashMap::new(),
        span_count: 0
    })

    let trace_id = "trace-123".to_string()

    // Start root span
    await collector.call(TraceCollector::StartSpan(
        trace_id.clone(),
        "span-1".to_string(),
        None,
        "handle_request".to_string()
    ))?

    // Add child span
    await collector.call(TraceCollector::StartSpan(
        trace_id.clone(),
        "span-2".to_string(),
        Some("span-1".to_string()),
        "query_database".to_string()
    ))?

    // Add tags and logs
    await collector.call(TraceCollector::AddTag(
        trace_id.clone(),
        "span-1".to_string(),
        "service".to_string(),
        "api".to_string()
    ))?

    await collector.call(TraceCollector::AddLog(
        trace_id.clone(),
        "span-2".to_string(),
        "Query executed successfully".to_string()
    ))?

    // End spans
    await collector.call(TraceCollector::EndSpan(trace_id.clone(), "span-2".to_string()))?
    await collector.call(TraceCollector::EndSpan(trace_id.clone(), "span-1".to_string()))?

    let spans = await collector.call(TraceCollector::GetTrace(trace_id))?
    println("Trace contains {} spans", spans.len())

    let count = await collector.call(TraceCollector::GetSpanCount())?
    println("Total spans collected: {}", count)

    println("Distributed Tracing test complete")
    return Ok(())
}
