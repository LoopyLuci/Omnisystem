// AssetManagement.vera - IT asset management and tracking
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct Asset {
    pub asset_id: String,
    pub asset_type: String, // laptop, server, license, etc.
    pub serial_number: String,
    pub owner: String,
    pub purchase_date: u64,
    pub expiration_date: Option<u64>,
    pub status: String, // active, retired, maintenance
}

impl Asset {
    pub fn new(asset_id: String, asset_type: String, serial_number: String) -> Self {
        Asset {
            asset_id,
            asset_type,
            serial_number,
            owner: String::new(),
            purchase_date: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
            expiration_date: None,
            status: "active".to_string(),
        }
    }

    pub fn assign_to(&mut self, owner: String) {
        self.owner = owner;
    }

    pub fn retire(&mut self) {
        self.status = "retired".to_string();
    }
}

pub struct AssetDepreciation {
    pub depreciation_id: String,
    pub asset_id: String,
    pub original_value: f64,
    pub current_value: f64,
    pub depreciation_rate: f64, // annual percentage
}

impl AssetDepreciation {
    pub fn new(depreciation_id: String, asset_id: String, value: f64) -> Self {
        AssetDepreciation {
            depreciation_id,
            asset_id,
            original_value: value,
            current_value: value,
            depreciation_rate: 0.25, // 25% annually
        }
    }

    pub fn calculate_annual_depreciation(&mut self) {
        self.current_value = self.current_value * (1.0 - self.depreciation_rate);
    }
}

pub struct AssetManagementSystem {
    pub system_id: String,
    pub assets: HashMap<String, Asset>,
    pub depreciation: HashMap<String, AssetDepreciation>,
    pub total_asset_value: f64,
}

impl AssetManagementSystem {
    pub fn new(system_id: String) -> Self {
        AssetManagementSystem {
            system_id,
            assets: HashMap::new(),
            depreciation: HashMap::new(),
            total_asset_value: 0.0,
        }
    }

    pub fn register_asset(&mut self, asset: Asset) -> Result<String, String> {
        let asset_id = asset.asset_id.clone();
        self.assets.insert(asset_id.clone(), asset);
        Ok(asset_id)
    }

    pub fn track_depreciation(&mut self, dep: AssetDepreciation) {
        self.total_asset_value += dep.current_value;
        self.depreciation.insert(dep.depreciation_id.clone(), dep);
    }

    pub fn retire_asset(&mut self, asset_id: &str) -> Result<(), String> {
        if let Some(asset) = self.assets.get_mut(asset_id) {
            asset.retire();
            Ok(())
        } else {
            Err(format!("Asset {} not found", asset_id))
        }
    }

    pub fn get_asset_inventory(&self) -> HashMap<String, u32> {
        let mut inventory = HashMap::new();
        for (_, asset) in &self.assets {
            *inventory.entry(asset.asset_type.clone()).or_insert(0) += 1;
        }
        inventory
    }

    pub fn get_total_value(&self) -> f64 {
        self.depreciation.values().map(|d| d.current_value).sum()
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 85: ASSET MANAGEMENT ===\n");
    let mut ams = AssetManagementSystem::new("ams_001".to_string());
    let asset = Asset::new("asset_001".to_string(), "laptop".to_string(), "ABC123".to_string());
    ams.register_asset(asset)?;
    let dep = AssetDepreciation::new("dep_001".to_string(), "asset_001".to_string(), 1500.0);
    ams.track_depreciation(dep);
    println!("✓ Asset registered");
    println!("✓ Total asset value: ${:.2}", ams.get_total_value());
    println!("✓✓✓ Asset Management operational ✓✓✓");
    Ok(())
}
