// PluginArchitecture.titan - Plugin system and extensibility
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct Plugin {
    pub plugin_id: String,
    pub name: String,
    pub version: String,
    pub author: String,
    pub enabled: bool,
    pub dependencies: Vec<String>,
}

impl Plugin {
    pub fn new(plugin_id: String, name: String, version: String, author: String) -> Self {
        Plugin {
            plugin_id,
            name,
            version,
            author,
            enabled: false,
            dependencies: Vec::new(),
        }
    }

    pub fn enable(&mut self) {
        self.enabled = true;
    }

    pub fn disable(&mut self) {
        self.enabled = false;
    }

    pub fn add_dependency(&mut self, dep: String) {
        if !self.dependencies.contains(&dep) {
            self.dependencies.push(dep);
        }
    }
}

pub struct PluginHook {
    pub hook_name: String,
    pub handler: String,
    pub priority: u32, // 0-100
}

impl PluginHook {
    pub fn new(hook_name: String, handler: String, priority: u32) -> Self {
        PluginHook {
            hook_name,
            handler,
            priority,
        }
    }
}

pub struct PluginContext {
    pub context_id: String,
    pub plugin_id: String,
    pub api_version: String,
    pub config: HashMap<String, String>,
}

impl PluginContext {
    pub fn new(context_id: String, plugin_id: String) -> Self {
        PluginContext {
            context_id,
            plugin_id,
            api_version: "1.0".to_string(),
            config: HashMap::new(),
        }
    }

    pub fn set_config(&mut self, key: String, value: String) {
        self.config.insert(key, value);
    }
}

pub struct PluginArchitecture {
    pub system_id: String,
    pub plugins: HashMap<String, Plugin>,
    pub hooks: HashMap<String, Vec<PluginHook>>,
    pub active_plugins: u32,
}

impl PluginArchitecture {
    pub fn new(system_id: String) -> Self {
        PluginArchitecture {
            system_id,
            plugins: HashMap::new(),
            hooks: HashMap::new(),
            active_plugins: 0,
        }
    }

    pub fn register_plugin(&mut self, plugin: Plugin) -> Result<String, String> {
        let plugin_id = plugin.plugin_id.clone();
        self.plugins.insert(plugin_id.clone(), plugin);
        Ok(plugin_id)
    }

    pub fn enable_plugin(&mut self, plugin_id: &str) -> Result<(), String> {
        if let Some(plugin) = self.plugins.get_mut(plugin_id) {
            // Check dependencies
            for dep in &plugin.dependencies {
                if let Some(dep_plugin) = self.plugins.get(dep) {
                    if !dep_plugin.enabled {
                        return Err(format!("Dependency {} not enabled", dep));
                    }
                } else {
                    return Err(format!("Dependency {} not found", dep));
                }
            }

            plugin.enable();
            self.active_plugins += 1;
            Ok(())
        } else {
            Err(format!("Plugin {} not found", plugin_id))
        }
    }

    pub fn register_hook(&mut self, hook_name: String, hook: PluginHook) {
        self.hooks
            .entry(hook_name)
            .or_insert_with(Vec::new)
            .push(hook);
    }

    pub fn execute_hooks(&self, hook_name: &str) -> Vec<String> {
        if let Some(hooks) = self.hooks.get(hook_name) {
            let mut sorted_hooks = hooks.clone();
            sorted_hooks.sort_by(|a, b| b.priority.cmp(&a.priority));
            sorted_hooks.iter().map(|h| h.handler.clone()).collect()
        } else {
            Vec::new()
        }
    }

    pub fn get_active_plugins(&self) -> u32 {
        self.active_plugins
    }
}

impl Clone for PluginHook {
    fn clone(&self) -> Self {
        PluginHook {
            hook_name: self.hook_name.clone(),
            handler: self.handler.clone(),
            priority: self.priority,
        }
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 95: PLUGIN ARCHITECTURE ===\n");
    let mut pa = PluginArchitecture::new("pa_001".to_string());
    let plugin = Plugin::new("plugin_auth".to_string(), "Auth Plugin".to_string(), "1.0".to_string(), "OmniTeam".to_string());
    pa.register_plugin(plugin)?;
    pa.enable_plugin("plugin_auth")?;
    let hook = PluginHook::new("on_user_login".to_string(), "auth_handler".to_string(), 100);
    pa.register_hook("on_user_login".to_string(), hook);
    println!("✓ Plugin registered and enabled");
    println!("✓ Active plugins: {}", pa.get_active_plugins());
    println!("✓✓✓ Plugin Architecture operational ✓✓✓");
    Ok(())
}
