// IntellectualPropertyManagement.aether - Intellectual property management
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct Patent {
    pub patent_id: String,
    pub title: String,
    pub inventors: Vec<String>,
    pub filing_date: u64,
    pub grant_date: Option<u64>,
    pub status: String, // pending, granted, expired, abandoned
}

impl Patent {
    pub fn new(patent_id: String, title: String) -> Self {
        Patent {
            patent_id,
            title,
            inventors: Vec::new(),
            filing_date: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
            grant_date: None,
            status: "pending".to_string(),
        }
    }

    pub fn add_inventor(&mut self, inventor: String) {
        if !self.inventors.contains(&inventor) {
            self.inventors.push(inventor);
        }
    }

    pub fn grant(&mut self) {
        self.status = "granted".to_string();
        self.grant_date = Some(
            std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs()
        );
    }
}

pub struct Trademark {
    pub trademark_id: String,
    pub name: String,
    pub registration_number: String,
    pub registered_at: u64,
    pub expiration_date: u64,
    pub status: String, // active, expired, abandoned
}

impl Trademark {
    pub fn new(trademark_id: String, name: String, registration: String) -> Self {
        let now = std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .unwrap()
            .as_secs();

        Trademark {
            trademark_id,
            name,
            registration_number: registration,
            registered_at: now,
            expiration_date: now + (10 * 365 * 86400), // 10 years
            status: "active".to_string(),
        }
    }

    pub fn is_expired(&self) -> bool {
        let now = std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .unwrap()
            .as_secs();
        now > self.expiration_date
    }
}

pub struct Copyrighted Work {
    pub work_id: String,
    pub title: String,
    pub creator: String,
    pub work_type: String, // software, document, media
    pub created_at: u64,
    pub protected: bool,
}

impl Copyrighted Work {
    pub fn new(work_id: String, title: String, creator: String, work_type: String) -> Self {
        Copyrighted Work {
            work_id,
            title,
            creator,
            work_type,
            created_at: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
            protected: true,
        }
    }
}

pub struct LicenseAgreement {
    pub license_id: String,
    pub intellectual_property_id: String,
    pub licensee: String,
    pub license_type: String, // exclusive, non_exclusive
    pub royalty_rate: f64,
}

impl LicenseAgreement {
    pub fn new(license_id: String, ip_id: String, licensee: String, rate: f64) -> Self {
        LicenseAgreement {
            license_id,
            intellectual_property_id: ip_id,
            licensee,
            license_type: "non_exclusive".to_string(),
            royalty_rate: rate,
        }
    }
}

pub struct IntellectualPropertyManagementSystem {
    pub system_id: String,
    pub patents: HashMap<String, Patent>,
    pub trademarks: HashMap<String, Trademark>,
    pub copyrights: HashMap<String, Copyrighted Work>,
    pub licenses: HashMap<String, LicenseAgreement>,
}

impl IntellectualPropertyManagementSystem {
    pub fn new(system_id: String) -> Self {
        IntellectualPropertyManagementSystem {
            system_id,
            patents: HashMap::new(),
            trademarks: HashMap::new(),
            copyrights: HashMap::new(),
            licenses: HashMap::new(),
        }
    }

    pub fn file_patent(&mut self, patent: Patent) {
        self.patents.insert(patent.patent_id.clone(), patent);
    }

    pub fn register_trademark(&mut self, trademark: Trademark) {
        self.trademarks.insert(trademark.trademark_id.clone(), trademark);
    }

    pub fn register_copyright(&mut self, work: Copyrighted Work) {
        self.copyrights.insert(work.work_id.clone(), work);
    }

    pub fn create_license(&mut self, license: LicenseAgreement) {
        self.licenses.insert(license.license_id.clone(), license);
    }

    pub fn get_active_patents(&self) -> u32 {
        self.patents
            .iter()
            .filter(|(_, p)| p.status == "granted")
            .count() as u32
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 119: INTELLECTUAL PROPERTY MANAGEMENT ===\n");
    let mut ipms = IntellectualPropertyManagementSystem::new("ipms_001".to_string());
    let patent = Patent::new("pat_001".to_string(), "Novel Algorithm".to_string());
    ipms.file_patent(patent);
    let trademark = Trademark::new("tm_001".to_string(), "OmniVision".to_string(), "TM-2026-001".to_string());
    ipms.register_trademark(trademark);
    let work = Copyrighted Work::new("copy_001".to_string(), "Software Module".to_string(), "creator_1".to_string(), "software".to_string());
    ipms.register_copyright(work);
    println!("✓ Patent, trademark, and copyright recorded");
    println!("✓ Active patents: {}", ipms.get_active_patents());
    println!("✓✓✓ Intellectual Property Management operational ✓✓✓");
    Ok(())
}
