// Policy Engine
// Rule evaluation, policy enforcement, authorization
// Replaces: phase 34 policy systems

use omnisystem::{HashMap, Vec, String, Option, Result}

struct Policy {
    id: String,
    name: String,
    conditions: Vec<String>,
    actions: Vec<String>,
    priority: i32
}

struct PolicyEngine {
    policies: Vec<Policy>,
    context: HashMap<String, String>
}

impl PolicyEngine {
    fn new() -> Self {
        return PolicyEngine {
            policies: Vec::new(),
            context: HashMap::new()
        }
    }

    fn add_policy(&mut self, name: String, conditions: Vec<String>, actions: Vec<String>) -> void {
        let policy = Policy {
            id: "policy_".to_string() + &SystemTime::now().secs().to_string(),
            name: name.clone(),
            conditions: conditions,
            actions: actions,
            priority: 0
        }

        self.policies.push(policy)
        println("PolicyEngine: Added policy '{}'", name)
    }

    fn evaluate(&self, context: HashMap<String, String>) -> Vec<String> {
        let mut matched_actions: Vec<String> = Vec::new()

        for policy in &self.policies {
            let mut all_conditions_met = true

            for condition in &policy.conditions {
                if !context.contains_key(condition) {
                    all_conditions_met = false
                    break
                }
            }

            if all_conditions_met {
                for action in &policy.actions {
                    matched_actions.push(action.clone())
                }
                println("PolicyEngine: Policy '{}' matched", policy.name)
            }
        }

        return matched_actions
    }

    fn get_policy_count(&self) -> i32 {
        return self.policies.len() as i32
    }
}

fn test_policy_engine() -> Result<(), String> {
    let mut engine = PolicyEngine::new()

    engine.add_policy(
        "admin_access".to_string(),
        vec!["role".to_string()],
        vec!["read".to_string(), "write".to_string(), "delete".to_string()]
    )

    engine.add_policy(
        "user_access".to_string(),
        vec!["role".to_string()],
        vec!["read".to_string()]
    )

    let mut context = HashMap::new()
    context.insert("role".to_string(), "admin".to_string())

    let actions = engine.evaluate(context)
    println("Matched actions: {}", actions.len())

    Ok(())
}
