// SpaceExplorationCommandCenter.titan - Space exploration command and control
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct SpaceMission {
    pub mission_id: String,
    pub mission_name: String,
    pub mission_type: String, // lunar, mars, asteroid, deep_space
    pub launch_date: u64,
    pub status: String, // planned, active, completed, failed
    pub budget_billions: f64,
}

impl SpaceMission {
    pub fn new(mission_id: String, mission_name: String, mission_type: String) -> Self {
        SpaceMission {
            mission_id,
            mission_name,
            mission_type,
            launch_date: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
            status: "planned".to_string(),
            budget_billions: 0.0,
        }
    }

    pub fn launch(&mut self) {
        self.status = "active".to_string();
    }

    pub fn complete(&mut self) {
        self.status = "completed".to_string();
    }
}

pub struct Spacecraft {
    pub spacecraft_id: String,
    pub mission_id: String,
    pub name: String,
    pub mass_kg: u32,
    pub power_output_kw: f64,
    pub status: String, // in_construction, ready, in_space, landed, decommissioned
}

impl Spacecraft {
    pub fn new(spacecraft_id: String, mission_id: String, name: String) -> Self {
        Spacecraft {
            spacecraft_id,
            mission_id,
            name,
            mass_kg: 1000,
            power_output_kw: 50.0,
            status: "in_construction".to_string(),
        }
    }

    pub fn launch(&mut self) {
        self.status = "in_space".to_string();
    }

    pub fn land(&mut self) {
        self.status = "landed".to_string();
    }
}

pub struct SpaceCrewMember {
    pub crew_id: String,
    pub mission_id: String,
    pub name: String,
    pub role: String, // commander, pilot, scientist, engineer
    pub training_hours: u32,
    pub mission_ready: bool,
}

impl SpaceCrewMember {
    pub fn new(crew_id: String, mission_id: String, name: String, role: String) -> Self {
        SpaceCrewMember {
            crew_id,
            mission_id,
            name,
            role,
            training_hours: 0,
            mission_ready: false,
        }
    }

    pub fn add_training(&mut self, hours: u32) {
        self.training_hours += hours;
        if self.training_hours >= 1000 {
            self.mission_ready = true;
        }
    }
}

pub struct CelestialBody {
    pub body_id: String,
    pub name: String,
    pub body_type: String, // planet, moon, asteroid, comet
    pub diameter_km: f64,
    pub distance_from_sun_au: f64,
    pub surface_gravity: f64,
}

impl CelestialBody {
    pub fn new(body_id: String, name: String, body_type: String) -> Self {
        CelestialBody {
            body_id,
            name,
            body_type,
            diameter_km: 0.0,
            distance_from_sun_au: 0.0,
            surface_gravity: 0.0,
        }
    }
}

pub struct SpaceExplorationCommandCenterSystem {
    pub system_id: String,
    pub missions: HashMap<String, SpaceMission>,
    pub spacecraft: HashMap<String, Spacecraft>,
    pub crew: HashMap<String, SpaceCrewMember>,
    pub bodies: HashMap<String, CelestialBody>,
}

impl SpaceExplorationCommandCenterSystem {
    pub fn new(system_id: String) -> Self {
        SpaceExplorationCommandCenterSystem {
            system_id,
            missions: HashMap::new(),
            spacecraft: HashMap::new(),
            crew: HashMap::new(),
            bodies: HashMap::new(),
        }
    }

    pub fn plan_mission(&mut self, mission: SpaceMission) -> Result<String, String> {
        let mission_id = mission.mission_id.clone();
        self.missions.insert(mission_id.clone(), mission);
        Ok(mission_id)
    }

    pub fn build_spacecraft(&mut self, craft: Spacecraft) {
        self.spacecraft.insert(craft.spacecraft_id.clone(), craft);
    }

    pub fn assign_crew(&mut self, member: SpaceCrewMember) {
        self.crew.insert(member.crew_id.clone(), member);
    }

    pub fn catalog_body(&mut self, body: CelestialBody) {
        self.bodies.insert(body.body_id.clone(), body);
    }

    pub fn get_active_missions(&self) -> u32 {
        self.missions
            .iter()
            .filter(|(_, m)| m.status == "active")
            .count() as u32
    }

    pub fn get_space_ready_spacecraft(&self) -> u32 {
        self.spacecraft
            .iter()
            .filter(|(_, s)| s.status == "ready" || s.status == "in_space")
            .count() as u32
    }

    pub fn get_mission_ready_crew(&self) -> u32 {
        self.crew
            .iter()
            .filter(|(_, c)| c.mission_ready)
            .count() as u32
    }

    pub fn get_total_mission_budget(&self) -> f64 {
        self.missions
            .iter()
            .map(|(_, m)| m.budget_billions)
            .sum()
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 135: SPACE EXPLORATION COMMAND CENTER ===\n");
    let mut seccs = SpaceExplorationCommandCenterSystem::new("seccs_001".to_string());
    let mission = SpaceMission::new("miss_001".to_string(), "Mars 2030".to_string(), "mars".to_string());
    seccs.plan_mission(mission)?;
    let craft = Spacecraft::new("craft_001".to_string(), "miss_001".to_string(), "OmniExplorer 1".to_string());
    seccs.build_spacecraft(craft);
    let crew = SpaceCrewMember::new("crew_001".to_string(), "miss_001".to_string(), "Commander Smith".to_string(), "commander".to_string());
    seccs.assign_crew(crew);
    let body = CelestialBody::new("body_001".to_string(), "Mars".to_string(), "planet".to_string());
    seccs.catalog_body(body);
    println!("✓ Mission, spacecraft, crew, and celestial body recorded");
    println!("✓ Active missions: {}", seccs.get_active_missions());
    println!("✓✓✓ Space Exploration Command Center operational ✓✓✓");
    Ok(())
}
