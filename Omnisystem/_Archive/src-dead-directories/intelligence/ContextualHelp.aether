// Contextual Help & Onboarding System
// Smart tooltips, interactive tutorials, guided walkthroughs, progressive disclosure
// Phase 182

use omnisystem::{Vec, HashMap, Option, Result, String}

struct HelpTopic {
    name: String,
    content: String,
    related_topics: Vec<String>
}

struct Tutorial {
    name: String,
    steps: Vec<String>,
    estimated_time: f64
}

actor ContextualHelpEngine {
    help_topics: HashMap<String, HelpTopic> = HashMap::new(),
    tutorials: HashMap<String, Tutorial> = HashMap::new(),
    user_progress: HashMap<String, i32> = HashMap::new()

    message RegisterHelpTopic(name: String, content: String) -> Result<(), String> {
        let topic = HelpTopic {
            name: name.clone(),
            content: content,
            related_topics: Vec::new()
        }
        help_topics.insert(name, topic)
        Ok(())
    }

    message ShowContextualTip(context: String) -> Result<String, String> {
        Ok(format!("Contextual tip for {}", context))
    }

    message CreateTutorial(name: String, steps: Vec<String>) -> Result<(), String> {
        let tutorial = Tutorial {
            name: name.clone(),
            steps: steps,
            estimated_time: 5.0
        }
        tutorials.insert(name, tutorial)
        Ok(())
    }

    message StartTutorial(tutorial_name: String) -> Result<(), String> {
        user_progress.insert(tutorial_name, 0)
        Ok(())
    }

    message GetNextStep(tutorial_name: String) -> Result<String, String> {
        match tutorials.get(&tutorial_name) {
            Some(tutorial) => {
                let progress = user_progress.get(&tutorial_name).cloned().unwrap_or(0) as usize
                if progress < tutorial.steps.len() {
                    Ok(tutorial.steps[progress].clone())
                } else {
                    Err("Tutorial complete".to_string())
                }
            },
            None => Err("Tutorial not found".to_string())
        }
    }
}

async fn test_help_engine() -> Result<(), String> {
    let engine: ActorRef<ContextualHelpEngine> = spawn(ContextualHelpEngine {
        help_topics: HashMap::new(),
        tutorials: HashMap::new(),
        user_progress: HashMap::new()
    })

    await engine.call(ContextualHelpEngine::RegisterHelpTopic("basics".to_string(), "Basic tutorial content".to_string()))?
    await engine.call(ContextualHelpEngine::CreateTutorial("intro".to_string(), vec!["Step 1".to_string(), "Step 2".to_string()]))?

    Ok(())
}
