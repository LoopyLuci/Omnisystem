// SecureCloudGateway.helix - Secure cloud gateway and access control
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct CloudConnection {
    pub connection_id: String,
    pub user_id: String,
    pub cloud_provider: String, // aws, azure, gcp, hybrid
    pub connection_time: u64,
    pub status: String, // established, active, disconnected, suspended
    pub ip_address: String,
    pub encryption_protocol: String,
}

impl CloudConnection {
    pub fn new(connection_id: String, user_id: String, provider: String) -> Self {
        CloudConnection {
            connection_id,
            user_id,
            cloud_provider: provider,
            connection_time: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
            status: "established".to_string(),
            ip_address: String::new(),
            encryption_protocol: "TLS1.3".to_string(),
        }
    }

    pub fn activate(&mut self) {
        self.status = "active".to_string();
    }

    pub fn disconnect(&mut self) {
        self.status = "disconnected".to_string();
    }

    pub fn suspend(&mut self) {
        self.status = "suspended".to_string();
    }
}

pub struct TrafficInspection {
    pub inspection_id: String,
    pub connection_id: String,
    pub timestamp: u64,
    pub bytes_inspected: u64,
    pub threats_detected: u32,
    pub policy_violations: u32,
    pub allowed: bool,
}

impl TrafficInspection {
    pub fn new(inspection_id: String, connection_id: String) -> Self {
        TrafficInspection {
            inspection_id,
            connection_id,
            timestamp: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
            bytes_inspected: 0,
            threats_detected: 0,
            policy_violations: 0,
            allowed: true,
        }
    }

    pub fn block(&mut self) {
        self.allowed = false;
    }
}

pub struct GatewayPolicy {
    pub policy_id: String,
    pub policy_name: String,
    pub resource_type: String, // file, api, database, service
    pub allowed_actions: Vec<String>, // read, write, delete, execute
    pub geo_restrictions: Vec<String>,
    pub time_based_access: bool,
    pub active: bool,
}

impl GatewayPolicy {
    pub fn new(policy_id: String, policy_name: String) -> Self {
        GatewayPolicy {
            policy_id,
            policy_name,
            resource_type: "file".to_string(),
            allowed_actions: Vec::new(),
            geo_restrictions: Vec::new(),
            time_based_access: false,
            active: true,
        }
    }

    pub fn add_allowed_action(&mut self, action: String) {
        if !self.allowed_actions.contains(&action) {
            self.allowed_actions.push(action);
        }
    }

    pub fn add_geo_restriction(&mut self, country: String) {
        if !self.geo_restrictions.contains(&country) {
            self.geo_restrictions.push(country);
        }
    }
}

pub struct DataExfiltrationAttempt {
    pub attempt_id: String,
    pub connection_id: String,
    pub detected_at: u64,
    pub data_type: String, // credentials, pii, intellectual_property, financial
    pub volume_mb: f64,
    pub destination: String,
    pub action_taken: String, // blocked, quarantined, alerted
}

impl DataExfiltrationAttempt {
    pub fn new(attempt_id: String, connection_id: String) -> Self {
        DataExfiltrationAttempt {
            attempt_id,
            connection_id,
            detected_at: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
            data_type: "unknown".to_string(),
            volume_mb: 0.0,
            destination: String::new(),
            action_taken: "blocked".to_string(),
        }
    }
}

pub struct SecureCloudGatewaySystem {
    pub system_id: String,
    pub connections: HashMap<String, CloudConnection>,
    pub inspections: HashMap<String, TrafficInspection>,
    pub policies: HashMap<String, GatewayPolicy>,
    pub exfiltration_attempts: HashMap<String, DataExfiltrationAttempt>,
}

impl SecureCloudGatewaySystem {
    pub fn new(system_id: String) -> Self {
        SecureCloudGatewaySystem {
            system_id,
            connections: HashMap::new(),
            inspections: HashMap::new(),
            policies: HashMap::new(),
            exfiltration_attempts: HashMap::new(),
        }
    }

    pub fn establish_connection(&mut self, connection: CloudConnection) {
        self.connections.insert(connection.connection_id.clone(), connection);
    }

    pub fn inspect_traffic(&mut self, inspection: TrafficInspection) {
        self.inspections.insert(inspection.inspection_id.clone(), inspection);
    }

    pub fn create_policy(&mut self, policy: GatewayPolicy) {
        self.policies.insert(policy.policy_id.clone(), policy);
    }

    pub fn log_exfiltration_attempt(&mut self, attempt: DataExfiltrationAttempt) {
        self.exfiltration_attempts.insert(attempt.attempt_id.clone(), attempt);
    }

    pub fn get_active_connections(&self) -> u32 {
        self.connections
            .iter()
            .filter(|(_, c)| c.status == "active")
            .count() as u32
    }

    pub fn get_blocked_inspections(&self) -> u32 {
        self.inspections
            .iter()
            .filter(|(_, i)| !i.allowed)
            .count() as u32
    }

    pub fn get_active_policies(&self) -> u32 {
        self.policies
            .iter()
            .filter(|(_, p)| p.active)
            .count() as u32
    }

    pub fn get_exfiltration_attempts(&self) -> u32 {
        self.exfiltration_attempts.len() as u32
    }

    pub fn get_total_bytes_inspected(&self) -> u64 {
        self.inspections
            .iter()
            .map(|(_, i)| i.bytes_inspected)
            .sum()
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 150: SECURE CLOUD GATEWAY ===\n");
    let mut scgs = SecureCloudGatewaySystem::new("scgs_001".to_string());
    let connection = CloudConnection::new("conn_001".to_string(), "user_001".to_string(), "aws".to_string());
    scgs.establish_connection(connection);
    let inspection = TrafficInspection::new("insp_001".to_string(), "conn_001".to_string());
    scgs.inspect_traffic(inspection);
    let policy = GatewayPolicy::new("pol_001".to_string(), "Cloud Access Policy".to_string());
    scgs.create_policy(policy);
    let attempt = DataExfiltrationAttempt::new("exf_001".to_string(), "conn_001".to_string());
    scgs.log_exfiltration_attempt(attempt);
    println!("✓ Connection, inspection, policy, and exfiltration attempt recorded");
    println!("✓ Active connections: {}", scgs.get_active_connections());
    println!("✓✓✓ Secure Cloud Gateway operational ✓✓✓");
    Ok(())
}
