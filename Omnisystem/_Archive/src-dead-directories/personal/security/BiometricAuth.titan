// BiometricAuth.titan - Phase 24: Multi-factor biometric authentication
// Modules: Personal (simple biometric) + Enterprise (corporate policies + TOTP + security keys)

use crate::personal::ModuleFramework::*;

pub enum BiometricType {
    Fingerprint,
    FaceRecognition,
    IrisScanning,
    VoiceRecognition,
}

pub struct BiometricTemplate {
    pub id: String,
    pub biometric_type: BiometricType,
    pub template_data: Vec<u8>,
    pub enrolled_at: u64,
    pub success_count: u32,
    pub failure_count: u32,
    pub enabled: bool,
}

impl BiometricTemplate {
    pub fn new(biometric_type: BiometricType) -> Self {
        BiometricTemplate {
            id: format!("bio_{}", std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_secs()),
            biometric_type,
            template_data: vec![],
            enrolled_at: 0,
            success_count: 0,
            failure_count: 0,
            enabled: false,
        }
    }

    pub fn get_reliability(&self) -> u8 {
        if self.success_count + self.failure_count == 0 {
            return 0;
        }
        let success_rate = self.success_count as f32 / (self.success_count + self.failure_count) as f32;
        (success_rate * 100.0) as u8
    }
}

pub struct TOTPSecret {
    pub secret_key: String,
    pub current_code: String,
    pub expires_in_seconds: u32,
    pub backup_codes: Vec<String>,
}

impl TOTPSecret {
    pub fn new() -> Self {
        TOTPSecret {
            secret_key: "JBSWY3DPEBLW64TMMQ======".to_string(), // Example base32
            current_code: "000000".to_string(),
            expires_in_seconds: 30,
            backup_codes: vec![
                "12345678".to_string(),
                "87654321".to_string(),
                "11111111".to_string(),
            ],
        }
    }

    pub fn verify_code(&self, code: &str) -> bool {
        code == self.current_code
    }

    pub fn get_backup_codes(&self) -> Vec<String> {
        self.backup_codes.clone()
    }
}

pub struct SecurityKey {
    pub id: String,
    pub key_type: String, // "FIDO2", "U2F", "YubiKey"
    pub nickname: String,
    pub registered_at: u64,
    pub last_used: u64,
}

impl SecurityKey {
    pub fn new(key_type: String, nickname: String) -> Self {
        SecurityKey {
            id: format!("key_{}", std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_secs()),
            key_type,
            nickname,
            registered_at: 0,
            last_used: 0,
        }
    }
}

pub struct BiometricAuthCore {
    pub biometric_templates: Vec<BiometricTemplate>,
    pub totp_enabled: bool,
    pub totp_secret: Option<TOTPSecret>,
    pub security_keys: Vec<SecurityKey>,
    pub failed_attempts: u32,
    pub lockout_minutes: u32,
}

impl BiometricAuthCore {
    pub fn new() -> Self {
        BiometricAuthCore {
            biometric_templates: vec![],
            totp_enabled: false,
            totp_secret: None,
            security_keys: vec![],
            failed_attempts: 0,
            lockout_minutes: 15,
        }
    }

    pub fn enroll_biometric(&mut self, biometric_type: BiometricType) -> Result<String, String> {
        let mut template = BiometricTemplate::new(biometric_type);
        template.enabled = true;
        let id = template.id.clone();
        self.biometric_templates.push(template);
        Ok(id)
    }

    pub fn verify_biometric(&mut self, template_id: &str) -> Result<bool, String> {
        for template in &mut self.biometric_templates {
            if template.id == template_id {
                // Simulate biometric verification
                let success = true; // In production, use actual biometric matching
                if success {
                    template.success_count += 1;
                    self.failed_attempts = 0;
                    return Ok(true);
                } else {
                    template.failure_count += 1;
                    self.failed_attempts += 1;
                    return Ok(false);
                }
            }
        }
        Err("Template not found".to_string())
    }

    pub fn enable_totp(&mut self) -> Result<TOTPSecret, String> {
        let totp = TOTPSecret::new();
        self.totp_secret = Some(totp.clone());
        self.totp_enabled = true;
        Ok(totp)
    }

    pub fn verify_totp(&self, code: &str) -> Result<bool, String> {
        match &self.totp_secret {
            Some(totp) => Ok(totp.verify_code(code)),
            None => Err("TOTP not enabled".to_string()),
        }
    }

    pub fn register_security_key(&mut self, key_type: String, nickname: String) -> Result<String, String> {
        let key = SecurityKey::new(key_type, nickname);
        let id = key.id.clone();
        self.security_keys.push(key);
        Ok(id)
    }

    pub fn is_locked_out(&self) -> bool {
        self.failed_attempts >= 5
    }

    pub fn reset_lockout(&mut self) {
        self.failed_attempts = 0;
    }
}

// ============================================================================
// PERSONAL MODULE: Fingerprint + Optional TOTP
// ============================================================================

pub component BiometricAuthPersonal {
    state {
        core: BiometricAuthCore,
        config: ModuleConfig,
        enrolled_fingerprints: u32,
        backup_codes_saved: bool,
        totp_qr_code: String,
    }

    render {
        div.biometric-auth {
            h2 "Biometric Authentication"

            div.enrollment-section {
                h3 "Fingerprints"
                text: format!("Enrolled: {}", enrolled_fingerprints)
                button "Add Fingerprint" on_click={enroll_fingerprint}
            }

            div.totp-section {
                h3 "Two-Factor Authentication (Optional)"

                if !core.totp_enabled {
                    button "Enable TOTP" on_click={enable_totp}
                } else {
                    div.totp-enabled {
                        text "TOTP Enabled"
                        button "Show Recovery Codes" on_click={show_recovery_codes}
                    }

                    if backup_codes_saved {
                        div.backup-codes-saved {
                            text "✓ Backup codes saved in secure location"
                        }
                    }
                }
            }

            div.security-info {
                text "Biometric data stored locally, never transmitted"
                text "Biometric authentication is the fastest way to unlock"
            }
        }
    }

    on_mount {
        core = BiometricAuthCore::new();
        config = ModuleConfig::new(ModuleMode::Personal);
        config.set_flag("local_biometric".to_string(), true)?;
        config.set_flag("encryption_required".to_string(), true)?;
        enrolled_fingerprints = 0;
        Ok(())
    }

    fn enroll_fingerprint() -> Result<(), String> {
        let _id = core.enroll_biometric(BiometricType::Fingerprint)?;
        enrolled_fingerprints += 1;
        println!("Fingerprint enrolled: #{}", enrolled_fingerprints);
        Ok(())
    }

    fn enable_totp() -> Result<(), String> {
        let totp = core.enable_totp()?;
        totp_qr_code = format!("otpauth://totp/Omnisystem?secret={}", totp.secret_key);
        Ok(())
    }

    fn show_recovery_codes() {
        if let Some(totp) = &core.totp_secret {
            println!("Recovery codes: {:?}", totp.get_backup_codes());
        }
    }
}

// ============================================================================
// ENTERPRISE MODULE: Multiple Factors + Policy Enforcement
// ============================================================================

pub component BiometricAuthEnterprise {
    state {
        core: BiometricAuthCore,
        config: ModuleConfig,
        audit_log: AuditLog,
        policy_engine: PolicyEngine,
        mfa_required: bool,
        allowed_methods: Vec<String>,
        device_compliance: bool,
    }

    render {
        div.biometric-auth-enterprise {
            h2 "Enterprise Biometric Authentication"

            div.policy-section {
                h3 "Authentication Requirements"
                text: format!("MFA Required: {}", mfa_required)
                for method in &allowed_methods {
                    text: format!("✓ {}", method)
                }
            }

            div.methods-section {
                h3 "Available Methods"

                div.method {
                    text "Biometric (Primary)"
                    text: format!("{} enrolled", core.biometric_templates.len())
                }

                div.method {
                    text "TOTP (Backup)"
                    status: if core.totp_enabled { "Enabled" } else { "Disabled" }
                }

                for key in &core.security_keys {
                    div.method {
                        text: format!("Security Key: {}", key.nickname)
                        last_used: format!("Last used: {}", key.last_used)
                    }
                }
            }

            div.audit-section {
                text: format!("Audit log: {} entries", audit_log.get_entries().len())
            }
        }
    }

    on_mount {
        core = BiometricAuthCore::new();
        config = ModuleConfig::new(ModuleMode::Enterprise);
        audit_log.enable()?;
        policy_engine.enable()?;

        // Enterprise MFA policy
        let policy = PolicyConfig::new("mfa_policy".to_string());
        policy_engine.add_policy(policy)?;

        mfa_required = true;
        allowed_methods = vec![
            "Biometric".to_string(),
            "TOTP".to_string(),
            "Security Key".to_string(),
        ];

        device_compliance = true;

        Ok(())
    }

    fn log_auth_attempt(method: String, success: bool) -> Result<(), String> {
        let entry = AuditEntry::new(
            "user@corp.com".to_string(),
            "auth_attempt".to_string(),
            method,
        ).with_result(if success { "success" } else { "failed" }.to_string());
        audit_log.log(entry)?;
        Ok(())
    }
}

pub enum BiometricAuthModule {
    Personal(BiometricAuthPersonal),
    Enterprise(BiometricAuthEnterprise),
}

impl BiometricAuthModule {
    pub fn load(mode: ModuleMode) -> Result<Self, String> {
        match mode {
            ModuleMode::Personal => {
                Ok(BiometricAuthModule::Personal(BiometricAuthPersonal {
                    core: BiometricAuthCore::new(),
                    config: ModuleConfig::new(ModuleMode::Personal),
                    enrolled_fingerprints: 0,
                    backup_codes_saved: false,
                    totp_qr_code: String::new(),
                }))
            }
            ModuleMode::Enterprise => {
                Ok(BiometricAuthModule::Enterprise(BiometricAuthEnterprise {
                    core: BiometricAuthCore::new(),
                    config: ModuleConfig::new(ModuleMode::Enterprise),
                    audit_log: AuditLog::new(),
                    policy_engine: PolicyEngine::new(),
                    mfa_required: true,
                    allowed_methods: vec![],
                    device_compliance: true,
                }))
            }
        }
    }
}

fn main() -> Result<(), String> {
    println!("=== BiometricAuth (Phase 24) ===\n");

    let mut core = BiometricAuthCore::new();

    // Test fingerprint enrollment
    let fp_id = core.enroll_biometric(BiometricType::Fingerprint)?;
    println!("✓ Fingerprint enrolled: {}", fp_id);

    // Test biometric verification
    let verified = core.verify_biometric(&fp_id)?;
    println!("✓ Biometric verified: {}", verified);

    // Test TOTP
    let totp = core.enable_totp()?;
    println!("✓ TOTP enabled: secret={}", totp.secret_key);

    let totp_valid = core.verify_totp(&totp.current_code)?;
    println!("✓ TOTP verification: {}", totp_valid);

    // Test security key
    let key_id = core.register_security_key("FIDO2".to_string(), "Yubikey".to_string())?;
    println!("✓ Security key registered: {}", key_id);

    // Test Personal Module
    let personal = BiometricAuthModule::load(ModuleMode::Personal)?;
    println!("✓ Personal Module: Simple biometric + optional TOTP");

    // Test Enterprise Module
    let enterprise = BiometricAuthModule::load(ModuleMode::Enterprise)?;
    println!("✓ Enterprise Module: MFA enforcement + audit logging");

    println!("\n✓✓✓ BiometricAuth tests passed ✓✓✓");
    Ok(())
}
