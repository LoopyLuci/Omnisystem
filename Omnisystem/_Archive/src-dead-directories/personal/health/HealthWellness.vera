// HealthWellness.vera - Phase 26: Health tracking, fitness, nutrition, meditation, medicine
// Personal: Private health data | Enterprise: Optional corporate wellness integration

use crate::personal::ModuleFramework::*;

// ============================================================================
// HealthDashboard
// ============================================================================

pub struct HealthMetric {
    pub metric_type: String, // "steps", "heart_rate", "sleep", "calories"
    pub value: u32,
    pub timestamp: u64,
    pub unit: String,
}

pub struct HealthDashboardCore {
    pub metrics: Vec<HealthMetric>,
    pub daily_goals: Vec<(String, u32)>,
    pub health_alerts: Vec<String>,
}

impl HealthDashboardCore {
    pub fn new() -> Self {
        HealthDashboardCore {
            metrics: vec![],
            daily_goals: vec![
                ("steps".to_string(), 10000),
                ("sleep_hours".to_string(), 8),
                ("water_liters".to_string(), 8),
            ],
            health_alerts: vec![],
        }
    }

    pub fn log_metric(&mut self, metric: HealthMetric) -> Result<(), String> {
        self.metrics.push(metric);
        Ok(())
    }

    pub fn get_today_steps(&self) -> u32 {
        self.metrics.iter()
            .filter(|m| m.metric_type == "steps")
            .map(|m| m.value)
            .sum()
    }

    pub fn check_goal_progress(&self, goal: &str) -> u32 {
        if let Some((_, target)) = self.daily_goals.iter().find(|(g, _)| g == goal) {
            let current = self.get_today_steps();
            ((current as f32 / *target as f32) * 100.0) as u32
        } else {
            0
        }
    }
}

// ============================================================================
// WorkoutTracker
// ============================================================================

pub struct Workout {
    pub id: String,
    pub exercise_type: String,
    pub duration_minutes: u32,
    pub calories_burned: u32,
    pub intensity: String, // "light", "moderate", "high"
    pub date: u64,
}

impl Workout {
    pub fn new(exercise_type: String, duration_minutes: u32) -> Self {
        Workout {
            id: format!("workout_{}", std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_secs()),
            exercise_type,
            duration_minutes,
            calories_burned: 0,
            intensity: "moderate".to_string(),
            date: 0,
        }
    }
}

pub struct WorkoutTrackerCore {
    pub workouts: Vec<Workout>,
    pub weekly_goal_minutes: u32,
    pub personal_records: Vec<(String, u32)>, // exercise, max reps/weight
}

impl WorkoutTrackerCore {
    pub fn new() -> Self {
        WorkoutTrackerCore {
            workouts: vec![],
            weekly_goal_minutes: 150,
            personal_records: vec![],
        }
    }

    pub fn log_workout(&mut self, workout: Workout) -> Result<String, String> {
        let id = workout.id.clone();
        self.workouts.push(workout);
        Ok(id)
    }

    pub fn get_weekly_minutes(&self) -> u32 {
        self.workouts.iter().map(|w| w.duration_minutes).sum()
    }

    pub fn get_goal_progress(&self) -> u32 {
        ((self.get_weekly_minutes() as f32 / self.weekly_goal_minutes as f32) * 100.0) as u32
    }
}

// ============================================================================
// NutritionTracker
// ============================================================================

pub struct Meal {
    pub id: String,
    pub food_items: Vec<String>,
    pub calories: u32,
    pub protein_g: u32,
    pub carbs_g: u32,
    pub fat_g: u32,
    pub timestamp: u64,
}

impl Meal {
    pub fn new() -> Self {
        Meal {
            id: format!("meal_{}", std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_secs()),
            food_items: vec![],
            calories: 0,
            protein_g: 0,
            carbs_g: 0,
            fat_g: 0,
            timestamp: 0,
        }
    }
}

pub struct NutritionTrackerCore {
    pub meals: Vec<Meal>,
    pub daily_goal_calories: u32,
    pub daily_goal_protein_g: u32,
}

impl NutritionTrackerCore {
    pub fn new() -> Self {
        NutritionTrackerCore {
            meals: vec![],
            daily_goal_calories: 2000,
            daily_goal_protein_g: 150,
        }
    }

    pub fn log_meal(&mut self, meal: Meal) -> Result<String, String> {
        let id = meal.id.clone();
        self.meals.push(meal);
        Ok(id)
    }

    pub fn get_daily_calories(&self) -> u32 {
        self.meals.iter().map(|m| m.calories).sum()
    }

    pub fn get_daily_protein(&self) -> u32 {
        self.meals.iter().map(|m| m.protein_g).sum()
    }
}

// ============================================================================
// MeditationApp
// ============================================================================

pub struct MeditationSession {
    pub id: String,
    pub duration_minutes: u32,
    pub meditation_type: String, // "mindfulness", "breathing", "body_scan"
    pub completed: bool,
    pub date: u64,
}

impl MeditationSession {
    pub fn new(duration_minutes: u32, meditation_type: String) -> Self {
        MeditationSession {
            id: format!("meditation_{}", std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_secs()),
            duration_minutes,
            meditation_type,
            completed: false,
            date: 0,
        }
    }
}

pub struct MeditationAppCore {
    pub sessions: Vec<MeditationSession>,
    pub total_meditation_minutes: u32,
    pub current_streak: u32,
}

impl MeditationAppCore {
    pub fn new() -> Self {
        MeditationAppCore {
            sessions: vec![],
            total_meditation_minutes: 0,
            current_streak: 0,
        }
    }

    pub fn start_session(&mut self, duration: u32, meditation_type: String) -> Result<String, String> {
        let session = MeditationSession::new(duration, meditation_type);
        let id = session.id.clone();
        self.sessions.push(session);
        Ok(id)
    }

    pub fn complete_session(&mut self, session_id: &str) -> Result<(), String> {
        for session in &mut self.sessions {
            if session.id == session_id {
                session.completed = true;
                self.total_meditation_minutes += session.duration_minutes;
                self.current_streak += 1;
                return Ok(());
            }
        }
        Err("Session not found".to_string())
    }
}

// ============================================================================
// MedicineReminder
// ============================================================================

pub struct Medicine {
    pub id: String,
    pub name: String,
    pub dosage: String,
    pub frequency: String, // "daily", "twice_daily", "weekly"
    pub next_dose_time: u64,
    pub taken: bool,
}

impl Medicine {
    pub fn new(name: String, dosage: String, frequency: String) -> Self {
        Medicine {
            id: format!("med_{}", std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_secs()),
            name,
            dosage,
            frequency,
            next_dose_time: 0,
            taken: false,
        }
    }
}

pub struct MedicineReminderCore {
    pub medicines: Vec<Medicine>,
    pub reminders_enabled: bool,
    pub refill_alerts_enabled: bool,
}

impl MedicineReminderCore {
    pub fn new() -> Self {
        MedicineReminderCore {
            medicines: vec![],
            reminders_enabled: true,
            refill_alerts_enabled: true,
        }
    }

    pub fn add_medicine(&mut self, medicine: Medicine) -> Result<String, String> {
        let id = medicine.id.clone();
        self.medicines.push(medicine);
        Ok(id)
    }

    pub fn mark_dose_taken(&mut self, medicine_id: &str) -> Result<(), String> {
        for medicine in &mut self.medicines {
            if medicine.id == medicine_id {
                medicine.taken = true;
                return Ok(());
            }
        }
        Err("Medicine not found".to_string())
    }

    pub fn get_due_medicines(&self) -> Vec<&Medicine> {
        self.medicines.iter().collect()
    }
}

// ============================================================================
// PERSONAL MODULE: Private health data, local storage
// ============================================================================

pub component HealthWellnessPersonal {
    state {
        health_dashboard: HealthDashboardCore,
        workout_tracker: WorkoutTrackerCore,
        nutrition_tracker: NutritionTrackerCore,
        meditation_app: MeditationAppCore,
        medicine_reminder: MedicineReminderCore,
        config: ModuleConfig,
    }

    render {
        div.health-dashboard {
            h2 "Health & Wellness"

            div.daily-stats {
                div.stat {
                    label "Steps"
                    value: health_dashboard.get_today_steps().to_string()
                    progress: health_dashboard.check_goal_progress("steps")
                }

                div.stat {
                    label "Workouts"
                    value: format!("{} min", workout_tracker.get_weekly_minutes())
                    progress: workout_tracker.get_goal_progress()
                }

                div.stat {
                    label "Calories"
                    value: nutrition_tracker.get_daily_calories().to_string()
                }

                div.stat {
                    label "Meditation"
                    value: format!("{} min", meditation_app.total_meditation_minutes)
                    streak: meditation_app.current_streak
                }
            }

            div.medicines {
                h3 "Medications"
                text: format!("{} medicines", medicine_reminder.medicines.len())
            }
        }
    }

    on_mount {
        health_dashboard = HealthDashboardCore::new();
        workout_tracker = WorkoutTrackerCore::new();
        nutrition_tracker = NutritionTrackerCore::new();
        meditation_app = MeditationAppCore::new();
        medicine_reminder = MedicineReminderCore::new();
        config = ModuleConfig::new(ModuleMode::Personal);
        config.set_flag("encrypt_health_data".to_string(), true)?;
        Ok(())
    }
}

// ============================================================================
// ENTERPRISE MODULE: Optional corporate wellness programs
// ============================================================================

pub component HealthWellnessEnterprise {
    state {
        health_dashboard: HealthDashboardCore,
        workout_tracker: WorkoutTrackerCore,
        nutrition_tracker: NutritionTrackerCore,
        meditation_app: MeditationAppCore,
        medicine_reminder: MedicineReminderCore,
        config: ModuleConfig,
        audit_log: AuditLog,
        wellness_program_enabled: bool,
    }

    render {
        div.health-enterprise {
            h2 "Corporate Wellness Program"

            div.program-info {
                toggle "Wellness Program" enabled={wellness_program_enabled}
                text: "Optional participation"
            }

            div.team-metrics {
                text: format!("Participants: {}", 0)
                text: format!("Active: {}", 0)
            }

            div.audit {
                text: format!("Audit log: {} entries", audit_log.get_entries().len())
            }
        }
    }

    on_mount {
        health_dashboard = HealthDashboardCore::new();
        workout_tracker = WorkoutTrackerCore::new();
        nutrition_tracker = NutritionTrackerCore::new();
        meditation_app = MeditationAppCore::new();
        medicine_reminder = MedicineReminderCore::new();
        config = ModuleConfig::new(ModuleMode::Enterprise);
        audit_log.enable()?;
        wellness_program_enabled = true;
        Ok(())
    }
}

pub enum HealthWellnessModule {
    Personal(HealthWellnessPersonal),
    Enterprise(HealthWellnessEnterprise),
}

impl HealthWellnessModule {
    pub fn load(mode: ModuleMode) -> Result<Self, String> {
        match mode {
            ModuleMode::Personal => Ok(HealthWellnessModule::Personal(HealthWellnessPersonal {
                health_dashboard: HealthDashboardCore::new(),
                workout_tracker: WorkoutTrackerCore::new(),
                nutrition_tracker: NutritionTrackerCore::new(),
                meditation_app: MeditationAppCore::new(),
                medicine_reminder: MedicineReminderCore::new(),
                config: ModuleConfig::new(ModuleMode::Personal),
            })),
            ModuleMode::Enterprise => Ok(HealthWellnessModule::Enterprise(HealthWellnessEnterprise {
                health_dashboard: HealthDashboardCore::new(),
                workout_tracker: WorkoutTrackerCore::new(),
                nutrition_tracker: NutritionTrackerCore::new(),
                meditation_app: MeditationAppCore::new(),
                medicine_reminder: MedicineReminderCore::new(),
                config: ModuleConfig::new(ModuleMode::Enterprise),
                audit_log: AuditLog::new(),
                wellness_program_enabled: false,
            })),
        }
    }
}

fn main() -> Result<(), String> {
    println!("=== Health & Wellness (Phase 26) ===\n");

    let mut health = HealthDashboardCore::new();
    health.log_metric(HealthMetric {
        metric_type: "steps".to_string(),
        value: 8234,
        timestamp: 0,
        unit: "steps".to_string(),
    })?;
    println!("✓ Health: {} steps today", health.get_today_steps());

    let mut workout = WorkoutTrackerCore::new();
    let w = Workout::new("running".to_string(), 30);
    workout.log_workout(w)?;
    println!("✓ Workout: {} min ({}%)", workout.get_weekly_minutes(), workout.get_goal_progress());

    let mut nutrition = NutritionTrackerCore::new();
    let meal = Meal::new();
    nutrition.log_meal(meal)?;
    println!("✓ Nutrition: {} calories", nutrition.get_daily_calories());

    let mut meditation = MeditationAppCore::new();
    let session = meditation.start_session(10, "mindfulness".to_string())?;
    meditation.complete_session(&session)?;
    println!("✓ Meditation: {} min total, {} day streak", meditation.total_meditation_minutes, meditation.current_streak);

    let mut medicine = MedicineReminderCore::new();
    let med = Medicine::new("Aspirin".to_string(), "100mg".to_string(), "daily".to_string());
    medicine.add_medicine(med)?;
    println!("✓ Medicines: {}", medicine.medicines.len());

    println!("\n✓✓✓ Health & Wellness tests passed ✓✓✓");
    Ok(())
}
