// ResponsiveUI.vera - Phase 23: Responsive design system for mobile-first development
// Modules: Personal (gesture-optimized) + Enterprise (device management)

use crate::personal::ModuleFramework::*;

// ============================================================================
// CORE: RESPONSIVE LAYOUT ENGINE (Shared by Personal & Enterprise)
// ============================================================================

pub struct BreakPoint {
    pub name: String,
    pub min_width: u32,
    pub max_width: u32,
    pub columns: u32,
}

impl BreakPoint {
    pub fn new(name: String, min_width: u32, max_width: u32, columns: u32) -> Self {
        BreakPoint {
            name,
            min_width,
            max_width,
            columns,
        }
    }
}

pub struct ResponsiveLayout {
    pub breakpoints: Vec<BreakPoint>,
    pub current_width: u32,
    pub current_height: u32,
    pub current_breakpoint: String,
    pub orientation: String, // "portrait" or "landscape"
}

impl ResponsiveLayout {
    pub fn new() -> Self {
        let mut layout = ResponsiveLayout {
            breakpoints: vec![],
            current_width: 400,
            current_height: 800,
            current_breakpoint: "mobile".to_string(),
            orientation: "portrait".to_string(),
        };

        // Define standard breakpoints
        layout.breakpoints.push(BreakPoint::new(
            "mobile".to_string(),
            0,
            600,
            1,
        ));
        layout.breakpoints.push(BreakPoint::new(
            "tablet".to_string(),
            601,
            1024,
            2,
        ));
        layout.breakpoints.push(BreakPoint::new(
            "desktop".to_string(),
            1025,
            99999,
            3,
        ));

        layout
    }

    pub fn update_dimensions(&mut self, width: u32, height: u32) -> Result<(), String> {
        self.current_width = width;
        self.current_height = height;

        // Update orientation
        self.orientation = if width > height {
            "landscape".to_string()
        } else {
            "portrait".to_string()
        };

        // Update breakpoint
        for bp in &self.breakpoints {
            if width >= bp.min_width && width <= bp.max_width {
                self.current_breakpoint = bp.name.clone();
                break;
            }
        }

        Ok(())
    }

    pub fn get_current_columns(&self) -> u32 {
        for bp in &self.breakpoints {
            if bp.name == self.current_breakpoint {
                return bp.columns;
            }
        }
        1
    }

    pub fn get_current_breakpoint(&self) -> String {
        self.current_breakpoint.clone()
    }

    pub fn is_mobile(&self) -> bool {
        self.current_breakpoint == "mobile"
    }

    pub fn is_tablet(&self) -> bool {
        self.current_breakpoint == "tablet"
    }

    pub fn is_desktop(&self) -> bool {
        self.current_breakpoint == "desktop"
    }
}

pub struct TouchGestureDetector {
    pub touch_type: String, // "tap", "swipe", "pinch", "long_press"
    pub start_x: f32,
    pub start_y: f32,
    pub current_x: f32,
    pub current_y: f32,
    pub distance: f32,
    pub duration_ms: u64,
}

impl TouchGestureDetector {
    pub fn new() -> Self {
        TouchGestureDetector {
            touch_type: "none".to_string(),
            start_x: 0.0,
            start_y: 0.0,
            current_x: 0.0,
            current_y: 0.0,
            distance: 0.0,
            duration_ms: 0,
        }
    }

    pub fn on_touch_down(&mut self, x: f32, y: f32) -> Result<(), String> {
        self.start_x = x;
        self.start_y = y;
        self.current_x = x;
        self.current_y = y;
        self.touch_type = "touch_down".to_string();
        Ok(())
    }

    pub fn on_touch_move(&mut self, x: f32, y: f32) -> Result<(), String> {
        self.current_x = x;
        self.current_y = y;
        let dx = (x - self.start_x).abs();
        let dy = (y - self.start_y).abs();
        self.distance = (dx * dx + dy * dy).sqrt();

        if dx > dy && dx > 50.0 {
            self.touch_type = if x > self.start_x {
                "swipe_right".to_string()
            } else {
                "swipe_left".to_string()
            };
        } else if dy > dx && dy > 50.0 {
            self.touch_type = if y > self.start_y {
                "swipe_down".to_string()
            } else {
                "swipe_up".to_string()
            };
        }

        Ok(())
    }

    pub fn on_touch_up(&mut self) -> Result<String, String> {
        if self.distance < 5.0 {
            self.touch_type = "tap".to_string();
        }
        Ok(self.touch_type.clone())
    }

    pub fn get_gesture(&self) -> String {
        self.touch_type.clone()
    }
}

pub struct ResponsiveUICore {
    pub layout: ResponsiveLayout,
    pub gesture_detector: TouchGestureDetector,
    pub auto_scale_enabled: bool,
    pub safe_area_padding: u32,
}

impl ResponsiveUICore {
    pub fn new() -> Self {
        ResponsiveUICore {
            layout: ResponsiveLayout::new(),
            gesture_detector: TouchGestureDetector::new(),
            auto_scale_enabled: true,
            safe_area_padding: 16,
        }
    }

    pub fn handle_resize(&mut self, width: u32, height: u32) -> Result<(), String> {
        self.layout.update_dimensions(width, height)
    }

    pub fn handle_touch_event(
        &mut self,
        event_type: String,
        x: f32,
        y: f32,
    ) -> Result<String, String> {
        match event_type.as_str() {
            "down" => self.gesture_detector.on_touch_down(x, y)?,
            "move" => self.gesture_detector.on_touch_move(x, y)?,
            "up" => return self.gesture_detector.on_touch_up(),
            _ => return Err("Unknown event type".to_string()),
        }
        Ok("processing".to_string())
    }

    pub fn calculate_responsive_padding(&self) -> u32 {
        match self.layout.get_current_breakpoint().as_str() {
            "mobile" => 12,
            "tablet" => 16,
            "desktop" => 20,
            _ => 16,
        }
    }

    pub fn calculate_responsive_font_size(&self, base_size: u32) -> u32 {
        match self.layout.get_current_breakpoint().as_str() {
            "mobile" => (base_size as f32 * 0.9) as u32,
            "tablet" => (base_size as f32 * 1.0) as u32,
            "desktop" => (base_size as f32 * 1.2) as u32,
            _ => base_size,
        }
    }

    pub fn get_column_width(&self, total_width: u32) -> u32 {
        let columns = self.layout.get_current_columns();
        let padding = self.calculate_responsive_padding();
        ((total_width - padding * (columns + 1)) / columns).max(1)
    }
}

// ============================================================================
// PERSONAL MODULE: Gesture-Optimized, Single-User, Touch-Heavy
// ============================================================================

pub component ResponsiveUIPersonal {
    props {
        width: u32,
        height: u32,
    }

    state {
        core: ResponsiveUICore,
        config: ModuleConfig,
        gesture_history: Vec<String>,
        haptic_feedback_enabled: bool,
    }

    render {
        // Personal module focuses on:
        // 1. Touch gestures (swipe, tap, pinch)
        // 2. Single user interaction
        // 3. Beautiful, minimal interface
        // 4. Offline-first responsive design

        div.responsive-container {
            class: if core.layout.is_mobile() {
                "mobile-view"
            } else if core.layout.is_tablet() {
                "tablet-view"
            } else {
                "desktop-view"
            }

            // Dynamic padding based on breakpoint
            padding: core.calculate_responsive_padding()

            // Main content area with responsive grid
            div.content-grid {
                columns: core.layout.get_current_columns()
                gap: core.calculate_responsive_padding()

                // Children adapt to responsive layout
                {children}
            }

            // Gesture indicator (for debugging/feedback)
            if gesture_history.len() > 0 {
                div.gesture-indicator {
                    text: format!("Last: {}", gesture_history.last().unwrap_or(&"none".to_string()))
                    opacity: 0.5
                }
            }

            // Safe area padding for notches/home indicators
            padding-top: core.layout.safe_area_padding
            padding-bottom: if core.layout.orientation == "landscape" {
                0
            } else {
                core.layout.safe_area_padding
            }
        }
    }

    on_mount {
        core.layout.update_dimensions(props.width, props.height)?;
        config = ModuleConfig::new(ModuleMode::Personal);
        config.set_flag("touch_gestures".to_string(), true)?;
        config.set_flag("haptic_feedback".to_string(), true)?;
        haptic_feedback_enabled = true;
        Ok(())
    }

    on_touch_down(x: f32, y: f32) {
        core.handle_touch_event("down".to_string(), x, y)?;
        Ok(())
    }

    on_touch_move(x: f32, y: f32) {
        core.handle_touch_event("move".to_string(), x, y)?;
        Ok(())
    }

    on_touch_up(x: f32, y: f32) -> Result<String, String> {
        let gesture = core.handle_touch_event("up".to_string(), x, y)?;
        gesture_history.push(gesture.clone());
        if gesture_history.len() > 10 {
            gesture_history.remove(0);
        }

        if haptic_feedback_enabled {
            // Trigger haptic feedback on gesture
            println!("Haptic: {}", gesture);
        }

        Ok(gesture)
    }

    on_resize(width: u32, height: u32) {
        core.handle_resize(width, height)?;
        Ok(())
    }
}

// ============================================================================
// ENTERPRISE MODULE: Multi-Device Management, Policy Enforcement
// ============================================================================

pub component ResponsiveUIEnterprise {
    props {
        width: u32,
        height: u32,
    }

    state {
        core: ResponsiveUICore,
        config: ModuleConfig,
        audit_log: AuditLog,
        policy_engine: PolicyEngine,
        connected_devices: Vec<DeviceInfo>,
        current_device_id: String,
    }

    render {
        // Enterprise module focuses on:
        // 1. Multi-device management
        // 2. Policy enforcement
        // 3. Audit logging
        // 4. Device synchronization

        div.responsive-container {
            class: if core.layout.is_mobile() {
                "mobile-view"
            } else if core.layout.is_tablet() {
                "tablet-view"
            } else {
                "desktop-view"
            }

            // Header with device selector (Enterprise feature)
            div.device-selector {
                text: format!("Device: {}", current_device_id)
                dropdown: connected_devices.iter().map(|d| d.name.clone()).collect()
            }

            // Main content area
            div.content-grid {
                columns: core.layout.get_current_columns()
                gap: core.calculate_responsive_padding()

                {children}
            }

            // Enterprise policy indicator
            div.policy-info {
                text: format!("Policies: {}", policy_engine.get_policies().len())
                opacity: 0.7
            }

            // Audit log indicator (Enterprise feature)
            div.audit-info {
                text: format!("Audit entries: {}", audit_log.get_entries().len())
                opacity: 0.7
            }
        }
    }

    on_mount {
        core.layout.update_dimensions(props.width, props.height)?;
        config = ModuleConfig::new(ModuleMode::Enterprise);

        // Set up policy engine
        policy_engine.enable()?;
        let policy = PolicyConfig::new("device_management".to_string())
            .with_integration("device_sync".to_string());
        policy_engine.add_policy(policy)?;

        // Enable audit logging
        audit_log.enable()?;

        current_device_id = "device_001".to_string();

        Ok(())
    }

    on_device_connected(device: DeviceInfo) {
        connected_devices.push(device.clone());
        let entry = AuditEntry::new(
            "system".to_string(),
            "device_connected".to_string(),
            format!("device:{}", device.id)
        ).with_result("success".to_string());
        audit_log.log(entry)?;
        Ok(())
    }

    on_device_disconnected(device_id: String) {
        connected_devices.retain(|d| d.id != device_id);
        let entry = AuditEntry::new(
            "system".to_string(),
            "device_disconnected".to_string(),
            format!("device:{}", device_id)
        ).with_result("success".to_string());
        audit_log.log(entry)?;
        Ok(())
    }

    on_resize(width: u32, height: u32) {
        core.handle_resize(width, height)?;
        let entry = AuditEntry::new(
            "system".to_string(),
            "resize".to_string(),
            format!("{}x{}", width, height)
        ).with_result("success".to_string());
        audit_log.log(entry)?;
        Ok(())
    }
}

pub struct DeviceInfo {
    pub id: String,
    pub name: String,
    pub device_type: String, // "phone", "tablet", "laptop", "desktop"
    pub os: String,
    pub connected: bool,
}

impl DeviceInfo {
    pub fn new(id: String, name: String, device_type: String, os: String) -> Self {
        DeviceInfo {
            id,
            name,
            device_type,
            os,
            connected: true,
        }
    }
}

// ============================================================================
// RESPONSIVE UI LOADER
// ============================================================================

pub enum ResponsiveUIModule {
    Personal(ResponsiveUIPersonal),
    Enterprise(ResponsiveUIEnterprise),
}

impl ResponsiveUIModule {
    pub fn load(mode: ModuleMode, width: u32, height: u32) -> Result<Self, String> {
        match mode {
            ModuleMode::Personal => {
                let personal = ResponsiveUIPersonal {
                    width,
                    height,
                    // ... initialize
                };
                Ok(ResponsiveUIModule::Personal(personal))
            }
            ModuleMode::Enterprise => {
                let enterprise = ResponsiveUIEnterprise {
                    width,
                    height,
                    // ... initialize
                };
                Ok(ResponsiveUIModule::Enterprise(enterprise))
            }
        }
    }

    pub fn get_responsive_layout(&self) -> Result<ResponsiveLayout, String> {
        match self {
            ResponsiveUIModule::Personal(p) => Ok(p.state.core.layout.clone()),
            ResponsiveUIModule::Enterprise(e) => Ok(e.state.core.layout.clone()),
        }
    }

    pub fn handle_resize(&mut self, width: u32, height: u32) -> Result<(), String> {
        match self {
            ResponsiveUIModule::Personal(p) => p.on_resize(width, height),
            ResponsiveUIModule::Enterprise(e) => e.on_resize(width, height),
        }
    }
}

// ============================================================================
// MAIN TEST
// ============================================================================

fn main() -> Result<(), String> {
    println!("=== Omnisystem ResponsiveUI (Phase 23) ===\n");

    // Test Core responsive layout
    let mut layout = ResponsiveLayout::new();
    layout.update_dimensions(400, 800)?;
    println!(
        "✓ Mobile (400x800): breakpoint={}, orientation={}",
        layout.get_current_breakpoint(),
        layout.orientation
    );

    layout.update_dimensions(800, 600)?;
    println!(
        "✓ Tablet (800x600): breakpoint={}, columns={}",
        layout.get_current_breakpoint(),
        layout.get_current_columns()
    );

    layout.update_dimensions(1920, 1080)?;
    println!(
        "✓ Desktop (1920x1080): breakpoint={}, columns={}",
        layout.get_current_breakpoint(),
        layout.get_current_columns()
    );

    // Test gesture detection
    let mut gesture = TouchGestureDetector::new();
    gesture.on_touch_down(100.0, 100.0)?;
    gesture.on_touch_move(150.0, 100.0)?;
    let result = gesture.on_touch_up()?;
    println!("✓ Gesture Detection: {}", result);

    // Test responsive padding & font scaling
    let mut core = ResponsiveUICore::new();
    core.handle_resize(400, 800)?;
    println!(
        "✓ Mobile (400): padding={}, font_size={}",
        core.calculate_responsive_padding(),
        core.calculate_responsive_font_size(16)
    );

    core.handle_resize(1920, 1080)?;
    println!(
        "✓ Desktop (1920): padding={}, font_size={}",
        core.calculate_responsive_padding(),
        core.calculate_responsive_font_size(16)
    );

    // Test Personal Module
    let personal_module = ResponsiveUIModule::load(ModuleMode::Personal, 400, 800)?;
    let layout = personal_module.get_responsive_layout()?;
    println!("✓ Personal Module loaded: {}", layout.orientation);

    // Test Enterprise Module
    let enterprise_module = ResponsiveUIModule::load(ModuleMode::Enterprise, 1920, 1080)?;
    let layout = enterprise_module.get_responsive_layout()?;
    println!("✓ Enterprise Module loaded: {} mode", {
        match enterprise_module {
            ResponsiveUIModule::Enterprise(_) => "Enterprise",
            ResponsiveUIModule::Personal(_) => "Personal",
        }
    });

    println!("\n✓✓✓ ResponsiveUI tests passed ✓✓✓");
    Ok(())
}
