// TASK MANAGER - INTELLIGENT TASK MANAGEMENT
// Phase 21: Productivity | Language: VERA

pub struct Task {
    pub id: u64,
    pub title: String,
    pub description: String,
    pub priority: String, // "low", "medium", "high"
    pub due_date: Option<u64>,
    pub completed: bool,
    pub tags: Vec<String>,
}

pub struct TaskManager {
    pub tasks: Vec<Task>,
    pub next_id: u64,
    pub smart_scheduling_enabled: bool,
}

impl TaskManager {
    pub fn new() -> Self {
        TaskManager {
            tasks: Vec::new(),
            next_id: 1,
            smart_scheduling_enabled: true,
        }
    }

    pub fn add_task(&mut self, title: String, priority: String) -> u64 {
        let id = self.next_id;
        self.next_id += 1;
        self.tasks.push(Task {
            id,
            title,
            description: String::new(),
            priority,
            due_date: None,
            completed: false,
            tags: Vec::new(),
        });
        id
    }

    pub fn mark_complete(&mut self, id: u64) -> Result<(), String> {
        if let Some(task) = self.tasks.iter_mut().find(|t| t.id == id) {
            task.completed = true;
            Ok(())
        } else {
            Err("Task not found".to_string())
        }
    }

    pub fn get_pending(&self) -> Vec<u64> {
        self.tasks.iter()
            .filter(|t| !t.completed)
            .map(|t| t.id)
            .collect()
    }

    pub fn task_count(&self) -> usize { self.tasks.len() }
}

pub fn main() {
    println!("TASK MANAGER v1.0");
    let mut tm = TaskManager::new();
    tm.add_task("Finish project".to_string(), "high".to_string());
    println!("✓ Task Manager with {} tasks", tm.pending.len());
}