// CALENDAR APP - PERSONAL CALENDAR & SCHEDULING
// Phase 21: Productivity | Language: VERA

use std::collections::HashMap;

pub struct Event {
    pub id: u64,
    pub title: String,
    pub start_time: u64,
    pub end_time: u64,
    pub location: String,
    pub attendees: Vec<String>,
    pub reminder_enabled: bool,
}

pub struct Calendar {
    pub events: Vec<Event>,
    pub next_id: u64,
    pub reminders_enabled: bool,
    pub sync_enabled: bool,
}

impl Calendar {
    pub fn new() -> Self {
        Calendar {
            events: Vec::new(),
            next_id: 1,
            reminders_enabled: true,
            sync_enabled: true,
        }
    }

    pub fn create_event(&mut self, title: String, start: u64, end: u64) -> u64 {
        let id = self.next_id;
        self.next_id += 1;
        self.events.push(Event {
            id,
            title,
            start_time: start,
            end_time: end,
            location: String::new(),
            attendees: Vec::new(),
            reminder_enabled: true,
        });
        id
    }

    pub fn get_events_for_day(&self, day: u64) -> Vec<u64> {
        self.events.iter()
            .filter(|e| e.start_time >= day && e.start_time < day + 86400)
            .map(|e| e.id)
            .collect()
    }

    pub fn event_count(&self) -> usize { self.events.len() }
}

pub fn main() {
    println!("CALENDAR APP v1.0");
    let mut cal = Calendar::new();
    cal.create_event("Meeting".to_string(), 0, 3600);
    println!("✓ Calendar operational with {} events", cal.event_count());
}