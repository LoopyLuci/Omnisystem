// TASKBAR - APPLICATION LAUNCHER & SYSTEM MENU
// Phase 17: Personal Desktop | Language: VERA

use std::collections::HashMap;

pub struct AppIcon {
    pub name: String,
    pub icon_path: String,
    pub executable: String,
    pub pinned: bool,
}

pub struct Taskbar {
    pub apps: Vec<AppIcon>,
    pub pinned_apps: Vec<AppIcon>,
    pub show_clock: bool,
    pub show_system_tray: bool,
    pub position: String, // "bottom", "top", "left", "right"
    pub height: u32,
}

impl Taskbar {
    pub fn new() -> Self {
        Taskbar {
            apps: vec![
                AppIcon { name: "Terminal".to_string(), icon_path: "/usr/icons/terminal.svg".to_string(), executable: "terminal".to_string(), pinned: true },
                AppIcon { name: "Files".to_string(), icon_path: "/usr/icons/files.svg".to_string(), executable: "files".to_string(), pinned: true },
                AppIcon { name: "Editor".to_string(), icon_path: "/usr/icons/editor.svg".to_string(), executable: "editor".to_string(), pinned: true },
            ],
            pinned_apps: Vec::new(),
            show_clock: true,
            show_system_tray: true,
            position: "bottom".to_string(),
            height: 48,
        }
    }

    pub fn launch_app(&self, name: &str) -> Result<(), String> {
        if let Some(app) = self.apps.iter().find(|a| a.name == name) {
            Ok(())
        } else {
            Err(format!("App {} not found", name))
        }
    }

    pub fn pin_app(&mut self, name: String) {
        if let Some(app) = self.apps.iter().find(|a| a.name == name) {
            let pinned = app.clone();
            self.pinned_apps.push(pinned);
        }
    }
}

impl Clone for AppIcon {
    fn clone(&self) -> Self {
        AppIcon {
            name: self.name.clone(),
            icon_path: self.icon_path.clone(),
            executable: self.executable.clone(),
            pinned: self.pinned,
        }
    }
}

pub fn main() {
    println!("TASKBAR v1.0");
    let taskbar = Taskbar::new();
    println!("✓ Taskbar with {} apps", taskbar.apps.len());
}