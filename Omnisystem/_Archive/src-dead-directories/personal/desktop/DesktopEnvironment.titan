// OMNISYSTEM DESKTOP ENVIRONMENT - SESSION MANAGEMENT & LIFECYCLE
// Phase 17: Personal Desktop | Language: TITAN

use std::collections::HashMap;

pub struct DesktopSession {
    pub session_id: String,
    pub user: String,
    pub theme: String,
    pub wallpaper: String,
    pub autostart_apps: Vec<String>,
    pub running_services: HashMap<String, bool>,
}

impl DesktopSession {
    pub fn new(user: String) -> Self {
        DesktopSession {
            session_id: format!("session-{}", std::time::SystemTime::now().elapsed().unwrap().as_secs()),
            user,
            theme: "light".to_string(),
            wallpaper: "/usr/share/backgrounds/default.png".to_string(),
            autostart_apps: vec!["taskbar".to_string(), "notifier".to_string()],
            running_services: HashMap::new(),
        }
    }

    pub fn set_theme(&mut self, theme: String) { self.theme = theme; }
    pub fn set_wallpaper(&mut self, path: String) { self.wallpaper = path; }
    pub fn start_service(&mut self, name: String) { self.running_services.insert(name, true); }
    pub fn stop_service(&mut self, name: &str) { self.running_services.insert(name.to_string(), false); }
}

pub struct DesktopEnvironment {
    pub session: DesktopSession,
    pub window_manager_active: bool,
    pub file_manager_active: bool,
    pub taskbar_active: bool,
    pub notification_daemon_active: bool,
}

impl DesktopEnvironment {
    pub fn new(user: String) -> Self {
        DesktopEnvironment {
            session: DesktopSession::new(user),
            window_manager_active: true,
            file_manager_active: false,
            taskbar_active: true,
            notification_daemon_active: true,
        }
    }

    pub fn initialize(&mut self) -> Result<(), String> {
        for app in &self.session.autostart_apps {
            self.session.start_service(app.clone());
        }
        Ok(())
    }

    pub fn is_ready(&self) -> bool {
        self.window_manager_active && self.taskbar_active && self.notification_daemon_active
    }
}

pub fn main() {
    println!("DESKTOP ENVIRONMENT v1.0");
    let mut env = DesktopEnvironment::new("user".to_string());
    env.initialize().ok();
    println!("✓ Desktop ready: {}", env.is_ready());
}