// NOTIFICATION SYSTEM - DESKTOP NOTIFICATIONS & ALERTS
// Phase 17: Personal Desktop | Language: TITAN

use std::collections::VecDeque;

pub struct Notification {
    pub id: u64,
    pub title: String,
    pub body: String,
    pub app: String,
    pub icon: String,
    pub priority: String, // "low", "normal", "high", "critical"
    pub timeout_ms: u32,
    pub timestamp: u64,
}

impl Notification {
    pub fn new(title: String, body: String, app: String) -> Self {
        Notification {
            id: 0,
            title,
            body,
            app,
            icon: "/usr/icons/notification.svg".to_string(),
            priority: "normal".to_string(),
            timeout_ms: 5000,
            timestamp: 0,
        }
    }
}

pub struct NotificationCenter {
    pub notifications: VecDeque<Notification>,
    pub max_notifications: usize,
    pub do_not_disturb: bool,
    pub next_id: u64,
}

impl NotificationCenter {
    pub fn new() -> Self {
        NotificationCenter {
            notifications: VecDeque::new(),
            max_notifications: 10,
            do_not_disturb: false,
            next_id: 1,
        }
    }

    pub fn notify(&mut self, mut notif: Notification) -> Result<u64, String> {
        if self.do_not_disturb && notif.priority != "critical" {
            return Err("Do not disturb enabled".to_string());
        }

        notif.id = self.next_id;
        self.next_id += 1;

        self.notifications.push_back(notif.clone());
        if self.notifications.len() > self.max_notifications {
            self.notifications.pop_front();
        }

        Ok(notif.id)
    }

    pub fn toggle_do_not_disturb(&mut self) { self.do_not_disturb = !self.do_not_disturb; }
    pub fn clear_all(&mut self) { self.notifications.clear(); }
    pub fn notification_count(&self) -> usize { self.notifications.len() }
}

pub fn main() {
    println!("NOTIFICATION SYSTEM v1.0");
    let mut nc = NotificationCenter::new();
    let notif = Notification::new("Welcome".to_string(), "Omnisystem ready".to_string(), "system".to_string());
    nc.notify(notif).ok();
    println!("✓ Notification Center operational");
}