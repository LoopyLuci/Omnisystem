// PERSONAL CLOUD - SELF-HOSTED CLOUD INFRASTRUCTURE
// Phase 22: Cloud & Sync | Language: TITAN

use std::collections::HashMap;

pub struct CloudServer {
    pub host: String,
    pub port: u16,
    pub api_key: String,
    pub certificates: Vec<String>,
    pub storage_path: String,
    pub max_storage_gb: u64,
    pub current_usage_gb: u64,
}

impl CloudServer {
    pub fn new(host: String, storage_path: String) -> Self {
        CloudServer {
            host,
            port: 8443,
            api_key: String::new(),
            certificates: Vec::new(),
            storage_path,
            max_storage_gb: 1024,
            current_usage_gb: 0,
        }
    }

    pub fn initialize(&mut self) -> Result<(), String> {
        // Initialize self-hosted cloud server
        Ok(())
    }

    pub fn set_storage_limit(&mut self, limit_gb: u64) {
        self.max_storage_gb = limit_gb;
    }

    pub fn get_available_space(&self) -> u64 {
        self.max_storage_gb - self.current_usage_gb
    }

    pub fn can_store(&self, size_gb: u64) -> bool {
        self.current_usage_gb + size_gb <= self.max_storage_gb
    }

    pub fn add_certificate(&mut self, cert: String) {
        self.certificates.push(cert);
    }

    pub fn is_secure(&self) -> bool {
        !self.certificates.is_empty()
    }
}

pub struct PersonalCloudSystem {
    pub server: Option<CloudServer>,
    pub users: HashMap<String, String>,
    pub is_running: bool,
    pub uptime_seconds: u64,
}

impl PersonalCloudSystem {
    pub fn new() -> Self {
        PersonalCloudSystem {
            server: None,
            users: HashMap::new(),
            is_running: false,
            uptime_seconds: 0,
        }
    }

    pub fn deploy_cloud(&mut self, host: String, storage_path: String) -> Result<(), String> {
        let mut server = CloudServer::new(host, storage_path);
        server.initialize()?;
        self.server = Some(server);
        self.is_running = true;
        Ok(())
    }

    pub fn add_user(&mut self, username: String, password_hash: String) {
        self.users.insert(username, password_hash);
    }

    pub fn authenticate(&self, username: &str, password: &str) -> Result<(), String> {
        if self.users.contains_key(username) {
            Ok(())
        } else {
            Err("User not found".to_string())
        }
    }

    pub fn get_status(&self) -> String {
        if let Some(server) = &self.server {
            format!("Cloud: {}:{} | Storage: {}/{} GB | Secure: {}",
                    server.host, server.port, server.current_usage_gb, server.max_storage_gb, server.is_secure())
        } else {
            "Cloud: Not deployed".to_string()
        }
    }
}

pub fn main() {
    println!("PERSONAL CLOUD v1.0");
    let mut cloud = PersonalCloudSystem::new();
    cloud.deploy_cloud("localhost".to_string(), "/data/cloud".to_string()).ok();
    cloud.add_user("user".to_string(), "hash".to_string());
    println!("✓ {}", cloud.get_status());
}