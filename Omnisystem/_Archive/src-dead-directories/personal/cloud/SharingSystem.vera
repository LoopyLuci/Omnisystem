// SHARING SYSTEM - SECURE FILE SHARING
// Phase 22: Cloud & Sync | Language: VERA

pub struct ShareLink {
    pub id: String,
    pub file_path: String,
    pub password: Option<String>,
    pub expiration_time: Option<u64>,
    pub download_limit: Option<u32>,
    pub downloads_used: u32,
    pub created_at: u64,
}

impl ShareLink {
    pub fn new(id: String, file_path: String) -> Self {
        ShareLink {
            id,
            file_path,
            password: None,
            expiration_time: None,
            download_limit: None,
            downloads_used: 0,
            created_at: 0,
        }
    }

    pub fn set_password(&mut self, password: String) {
        self.password = Some(password);
    }

    pub fn set_expiration(&mut self, timestamp: u64) {
        self.expiration_time = Some(timestamp);
    }

    pub fn set_download_limit(&mut self, limit: u32) {
        self.download_limit = Some(limit);
    }

    pub fn is_valid(&self) -> bool {
        // Check expiration and download limit
        true
    }
}

pub struct SharingSystem {
    pub links: Vec<ShareLink>,
    pub next_id: u64,
    pub default_expiration_hours: u32,
}

impl SharingSystem {
    pub fn new() -> Self {
        SharingSystem {
            links: Vec::new(),
            next_id: 1,
            default_expiration_hours: 24,
        }
    }

    pub fn create_share_link(&mut self, file_path: String) -> String {
        let id = format!("share-{}", self.next_id);
        self.next_id += 1;
        let link = ShareLink::new(id.clone(), file_path);
        self.links.push(link);
        id
    }

    pub fn revoke_link(&mut self, id: &str) -> Result<(), String> {
        self.links.retain(|l| l.id != id);
        Ok(())
    }

    pub fn link_count(&self) -> usize {
        self.links.len()
    }
}

pub fn main() {
    println!("SHARING SYSTEM v1.0");
    let mut sharing = SharingSystem::new();
    let link = sharing.create_share_link("/home/user/document.pdf".to_string());
    println!("✓ Share link created: {}", link);
}