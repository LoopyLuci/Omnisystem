// NOTE MANAGER - MARKDOWN NOTES WITH REAL-TIME SYNC
// Phase 20: Knowledge Management | Language: VERA

use std::collections::HashMap;

pub struct Note {
    pub id: u64,
    pub title: String,
    pub content: String,
    pub tags: Vec<String>,
    pub created_at: u64,
    pub modified_at: u64,
    pub pinned: bool,
}

impl Note {
    pub fn new(title: String, content: String) -> Self {
        Note {
            id: 0,
            title,
            content,
            tags: Vec::new(),
            created_at: 0,
            modified_at: 0,
            pinned: false,
        }
    }

    pub fn add_tag(&mut self, tag: String) { self.tags.push(tag); }
    pub fn toggle_pin(&mut self) { self.pinned = !self.pinned; }
}

pub struct NoteManager {
    pub notes: HashMap<u64, Note>,
    pub next_id: u64,
    pub recent_notes: Vec<u64>,
    pub sync_enabled: bool,
}

impl NoteManager {
    pub fn new() -> Self {
        NoteManager {
            notes: HashMap::new(),
            next_id: 1,
            recent_notes: Vec::new(),
            sync_enabled: true,
        }
    }

    pub fn create_note(&mut self, title: String, content: String) -> u64 {
        let id = self.next_id;
        self.next_id += 1;
        let mut note = Note::new(title, content);
        note.id = id;
        self.notes.insert(id, note);
        self.recent_notes.insert(0, id);
        id
    }

    pub fn edit_note(&mut self, id: u64, content: String) -> Result<(), String> {
        if let Some(note) = self.notes.get_mut(&id) {
            note.content = content;
            note.modified_at = 0; // Would be current timestamp
            Ok(())
        } else {
            Err("Note not found".to_string())
        }
    }

    pub fn search(&self, query: &str) -> Vec<u64> {
        self.notes.iter()
            .filter(|(_, note)| note.title.contains(query) || note.content.contains(query))
            .map(|(id, _)| *id)
            .collect()
    }

    pub fn get_pinned(&self) -> Vec<u64> {
        self.notes.iter()
            .filter(|(_, note)| note.pinned)
            .map(|(id, _)| *id)
            .collect()
    }

    pub fn note_count(&self) -> usize { self.notes.len() }
}

pub fn main() {
    println!("NOTE MANAGER v1.0");
    let mut nm = NoteManager::new();
    nm.create_note("Welcome".to_string(), "# Welcome to Omnisystem Notes".to_string());
    println!("✓ {} notes", nm.note_count());
}