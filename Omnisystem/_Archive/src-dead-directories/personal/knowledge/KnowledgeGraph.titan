// KNOWLEDGE GRAPH - PERSONAL INFORMATION SYSTEM
// Phase 20: Knowledge Management | Language: TITAN

use std::collections::HashMap;

pub struct Entity {
    pub id: String,
    pub label: String,
    pub entity_type: String,
    pub properties: HashMap<String, String>,
}

pub struct Relationship {
    pub source: String,
    pub target: String,
    pub relation_type: String,
    pub weight: f32,
}

pub struct KnowledgeGraph {
    pub entities: HashMap<String, Entity>,
    pub relationships: Vec<Relationship>,
    pub topics: Vec<String>,
}

impl KnowledgeGraph {
    pub fn new() -> Self {
        KnowledgeGraph {
            entities: HashMap::new(),
            relationships: Vec::new(),
            topics: Vec::new(),
        }
    }

    pub fn add_entity(&mut self, id: String, label: String, entity_type: String) {
        self.entities.insert(id, Entity {
            id: id.clone(),
            label,
            entity_type,
            properties: HashMap::new(),
        });
    }

    pub fn link_entities(&mut self, source: String, target: String, relation: String) {
        self.relationships.push(Relationship {
            source,
            target,
            relation_type: relation,
            weight: 1.0,
        });
    }

    pub fn search_entity(&self, query: &str) -> Vec<String> {
        self.entities.iter()
            .filter(|(_, e)| e.label.contains(query))
            .map(|(id, _)| id.clone())
            .collect()
    }

    pub fn get_related(&self, entity_id: &str) -> Vec<String> {
        self.relationships.iter()
            .filter(|r| r.source == entity_id)
            .map(|r| r.target.clone())
            .collect()
    }

    pub fn entity_count(&self) -> usize { self.entities.len() }
}

pub fn main() {
    println!("KNOWLEDGE GRAPH v1.0");
    let mut kg = KnowledgeGraph::new();
    kg.add_entity("person-1".to_string(), "Alice".to_string(), "person".to_string());
    kg.add_entity("topic-1".to_string(), "Rust".to_string(), "technology".to_string());
    kg.link_entities("person-1".to_string(), "topic-1".to_string(), "knows".to_string());
    println!("✓ Knowledge Graph with {} entities", kg.entity_count());
}