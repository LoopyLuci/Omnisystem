// MaterialsScienceLaboratory.nexus - Materials science research and testing
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct Material {
    pub material_id: String,
    pub material_name: String,
    pub material_type: String, // metal, ceramic, polymer, composite
    pub density_g_cm3: f64,
    pub melting_point_celsius: f64,
    pub discovery_year: u32,
}

impl Material {
    pub fn new(material_id: String, material_name: String, material_type: String) -> Self {
        Material {
            material_id,
            material_name,
            material_type,
            density_g_cm3: 0.0,
            melting_point_celsius: 0.0,
            discovery_year: 2024,
        }
    }
}

pub struct MaterialProperties {
    pub property_id: String,
    pub material_id: String,
    pub tensile_strength_mpa: f64,
    pub hardness_hv: u32,
    pub electrical_conductivity_s_m: f64,
    pub thermal_conductivity_w_mk: f64,
    pub young_modulus_gpa: f64,
}

impl MaterialProperties {
    pub fn new(property_id: String, material_id: String) -> Self {
        MaterialProperties {
            property_id,
            material_id,
            tensile_strength_mpa: 0.0,
            hardness_hv: 0,
            electrical_conductivity_s_m: 0.0,
            thermal_conductivity_w_mk: 0.0,
            young_modulus_gpa: 0.0,
        }
    }
}

pub struct MaterialTest {
    pub test_id: String,
    pub material_id: String,
    pub test_type: String, // tensile, compression, hardness, thermal, corrosion
    pub test_date: u64,
    pub result_value: f64,
    pub passed: bool,
}

impl MaterialTest {
    pub fn new(test_id: String, material_id: String, test_type: String) -> Self {
        MaterialTest {
            test_id,
            material_id,
            test_type,
            test_date: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
            result_value: 0.0,
            passed: false,
        }
    }

    pub fn record_result(&mut self, value: f64, passed: bool) {
        self.result_value = value;
        self.passed = passed;
    }
}

pub struct Specimen {
    pub specimen_id: String,
    pub material_id: String,
    pub batch_id: String,
    pub creation_date: u64,
    pub dimensions_mm: String,
    pub weight_grams: f64,
    pub quality_grade: String, // A, B, C
}

impl Specimen {
    pub fn new(specimen_id: String, material_id: String, batch_id: String) -> Self {
        Specimen {
            specimen_id,
            material_id,
            batch_id,
            creation_date: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
            dimensions_mm: String::new(),
            weight_grams: 0.0,
            quality_grade: "B".to_string(),
        }
    }

    pub fn grade(&mut self, grade: String) {
        self.quality_grade = grade;
    }
}

pub struct ResearchProject {
    pub project_id: String,
    pub project_name: String,
    pub focus_material: String,
    pub start_date: u64,
    pub target_properties: Vec<String>,
    pub status: String, // planning, active, completed
    pub publications: u32,
}

impl ResearchProject {
    pub fn new(project_id: String, project_name: String, focus: String) -> Self {
        ResearchProject {
            project_id,
            project_name,
            focus_material: focus,
            start_date: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
            target_properties: Vec::new(),
            status: "planning".to_string(),
            publications: 0,
        }
    }

    pub fn activate(&mut self) {
        self.status = "active".to_string();
    }

    pub fn publish(&mut self) {
        self.publications += 1;
    }
}

pub struct MaterialsScienceLaboratorySystem {
    pub system_id: String,
    pub materials: HashMap<String, Material>,
    pub properties: HashMap<String, MaterialProperties>,
    pub tests: HashMap<String, MaterialTest>,
    pub specimens: HashMap<String, Specimen>,
    pub projects: HashMap<String, ResearchProject>,
}

impl MaterialsScienceLaboratorySystem {
    pub fn new(system_id: String) -> Self {
        MaterialsScienceLaboratorySystem {
            system_id,
            materials: HashMap::new(),
            properties: HashMap::new(),
            tests: HashMap::new(),
            specimens: HashMap::new(),
            projects: HashMap::new(),
        }
    }

    pub fn catalog_material(&mut self, material: Material) {
        self.materials.insert(material.material_id.clone(), material);
    }

    pub fn record_properties(&mut self, props: MaterialProperties) {
        self.properties.insert(props.property_id.clone(), props);
    }

    pub fn conduct_test(&mut self, test: MaterialTest) {
        self.tests.insert(test.test_id.clone(), test);
    }

    pub fn create_specimen(&mut self, specimen: Specimen) {
        self.specimens.insert(specimen.specimen_id.clone(), specimen);
    }

    pub fn start_project(&mut self, project: ResearchProject) {
        self.projects.insert(project.project_id.clone(), project);
    }

    pub fn get_high_strength_materials(&self) -> u32 {
        self.properties
            .iter()
            .filter(|(_, p)| p.tensile_strength_mpa > 500.0)
            .count() as u32
    }

    pub fn get_passed_tests(&self) -> u32 {
        self.tests
            .iter()
            .filter(|(_, t)| t.passed)
            .count() as u32
    }

    pub fn get_grade_a_specimens(&self) -> u32 {
        self.specimens
            .iter()
            .filter(|(_, s)| s.quality_grade == "A")
            .count() as u32
    }

    pub fn get_active_projects(&self) -> u32 {
        self.projects
            .iter()
            .filter(|(_, p)| p.status == "active")
            .count() as u32
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 136: MATERIALS SCIENCE LABORATORY ===\n");
    let mut msls = MaterialsScienceLaboratorySystem::new("msls_001".to_string());
    let material = Material::new("mat_001".to_string(), "Graphene".to_string(), "composite".to_string());
    msls.catalog_material(material);
    let props = MaterialProperties::new("prop_001".to_string(), "mat_001".to_string());
    msls.record_properties(props);
    let test = MaterialTest::new("test_001".to_string(), "mat_001".to_string(), "tensile".to_string());
    msls.conduct_test(test);
    let specimen = Specimen::new("spec_001".to_string(), "mat_001".to_string(), "batch_001".to_string());
    msls.create_specimen(specimen);
    let project = ResearchProject::new("proj_001".to_string(), "Advanced Composites".to_string(), "Graphene".to_string());
    msls.start_project(project);
    println!("✓ Material, properties, test, specimen, and project recorded");
    println!("✓ Passed tests: {}", msls.get_passed_tests());
    println!("✓✓✓ Materials Science Laboratory operational ✓✓✓");
    Ok(())
}
