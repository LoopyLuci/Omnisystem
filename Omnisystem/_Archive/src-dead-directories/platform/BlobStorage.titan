// Blob Storage - System 98
use omnisystem::{HashMap, Vec, String, Option, Result}
struct Blob { id: String, name: String, data: Vec<u8>, size: i64 }
struct BlobStorage { blobs: HashMap<String, Blob> }
impl BlobStorage {
    fn new() -> Self { BlobStorage { blobs: HashMap::new() } }
    fn put_blob(&mut self, name: String, data: Vec<u8>) -> Result<String, String> {
        let id = "blob_".to_string() + &(self.blobs.len() as u32).to_string()
        let size = data.len() as i64
        self.blobs.insert(id.clone(), Blob { id: id.clone(), name: name, data: data, size: size })
        Ok(id)
    }
    fn get_blob(&self, id: String) -> Result<Vec<u8>, String> {
        match self.blobs.get(&id) { Some(b) => Ok(b.data.clone()), None => Err("Not found".to_string()) }
    }
}
fn test_blob() -> Result<(), String> { Ok(()) }
