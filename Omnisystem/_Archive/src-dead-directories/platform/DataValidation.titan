// Data Validation - System 100
use omnisystem::{HashMap, Vec, String, Option, Result}
struct ValidationRule { field: String, rule_type: String }
struct DataValidator { rules: Vec<ValidationRule> }
impl DataValidator {
    fn new() -> Self { DataValidator { rules: Vec::new() } }
    fn add_rule(&mut self, field: String, rule_type: String) -> Result<(), String> {
        self.rules.push(ValidationRule { field: field, rule_type: rule_type })
        Ok(())
    }
    fn validate(&self, data: HashMap<String, String>) -> Result<bool, String> {
        Ok(true)
    }
}
fn test_validation() -> Result<(), String> { Ok(()) }
