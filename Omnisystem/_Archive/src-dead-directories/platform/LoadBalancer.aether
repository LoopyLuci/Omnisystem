// Load Balancer - System 87
use omnisystem::{HashMap, Vec, String, Option, Result}
struct Endpoint { address: String, weight: i32, healthy: bool }
actor LoadBalancer {
    endpoints: Vec<Endpoint> = Vec::new(), request_count: i64 = 0
    message AddEndpoint(address: String, weight: i32) -> Result<(), String> {
        endpoints.push(Endpoint { address: address, weight: weight, healthy: true })
        Ok(())
    }
    message RouteRequest() -> Result<String, String> {
        request_count = request_count + 1
        if endpoints.len() > 0 { Ok(endpoints[0].address.clone()) } else { Err("No endpoints".to_string()) }
    }
}
async fn test_lb() -> Result<(), String> { Ok(()) }
