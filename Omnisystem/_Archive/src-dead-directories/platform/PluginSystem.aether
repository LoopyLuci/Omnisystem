// Plugin System - System 90
use omnisystem::{HashMap, Vec, String, Option, Result}
struct Plugin { id: String, name: String, version: String, active: bool }
actor PluginSystem {
    plugins: HashMap<String, Plugin> = HashMap::new()
    message RegisterPlugin(id: String, name: String, version: String) -> Result<(), String> {
        plugins.insert(id.clone(), Plugin { id: id, name: name, version: version, active: false })
        Ok(())
    }
    message EnablePlugin(id: String) -> Result<(), String> {
        match plugins.get_mut(&id) { Some(p) => { p.active = true; Ok(()) }, None => Err("Not found".to_string()) }
    }
}
async fn test_plugins() -> Result<(), String> { Ok(()) }
