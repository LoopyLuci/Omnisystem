// Content Delivery - System 91
use omnisystem::{HashMap, Vec, String, Option, Result}
struct Cache { key: String, data: Vec<u8>, expires_at: i64 }
actor ContentDelivery {
    cache: HashMap<String, Cache> = HashMap::new(), hits: i64 = 0, misses: i64 = 0
    message CacheContent(key: String, data: Vec<u8>, ttl: i64) -> Result<(), String> {
        cache.insert(key, Cache { key: key.clone(), data: data, expires_at: SystemTime::now().secs() + ttl })
        Ok(())
    }
    message GetContent(key: String) -> Result<Vec<u8>, String> {
        match cache.get(&key) {
            Some(c) => { hits = hits + 1; Ok(c.data.clone()) },
            None => { misses = misses + 1; Err("Not found".to_string()) }
        }
    }
}
async fn test_cdn() -> Result<(), String> { Ok(()) }
