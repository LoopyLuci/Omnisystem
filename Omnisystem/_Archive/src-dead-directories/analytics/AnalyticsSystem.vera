// AnalyticsSystem.vera - Phase 38: Advanced analytics and reporting

use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct DataPoint {
    pub value: f64,
    pub category: String,
}

impl DataPoint {
    pub fn new(value: f64, category: String) -> Self {
        DataPoint { value, category }
    }
}

pub struct Metric {
    pub metric_id: String,
    pub metric_name: String,
    pub data_points: Vec<DataPoint>,
}

impl Metric {
    pub fn new(metric_id: String, metric_name: String) -> Self {
        Metric {
            metric_id,
            metric_name,
            data_points: vec![],
        }
    }

    pub fn add_data_point(&mut self, data_point: DataPoint) {
        self.data_points.push(data_point);
    }

    pub fn aggregate_sum(&self) -> f64 {
        self.data_points.iter().map(|p| p.value).sum()
    }

    pub fn aggregate_avg(&self) -> f64 {
        if self.data_points.is_empty() {
            0.0
        } else {
            let sum: f64 = self.data_points.iter().map(|p| p.value).sum();
            sum / self.data_points.len() as f64
        }
    }
}

pub struct Report {
    pub report_id: String,
    pub report_name: String,
    pub report_type: String,
    pub metrics: Vec<String>,
}

impl Report {
    pub fn new(report_id: String, report_name: String) -> Self {
        Report {
            report_id,
            report_name,
            report_type: "business".to_string(),
            metrics: vec![],
        }
    }

    pub fn add_metric(&mut self, metric_id: String) {
        self.metrics.push(metric_id);
    }
}

pub struct AnalyticsSystem {
    pub system_id: String,
    pub metrics: HashMap<String, Metric>,
    pub reports: HashMap<String, Report>,
    pub total_data_points: u32,
}

impl AnalyticsSystem {
    pub fn new(system_id: String) -> Self {
        AnalyticsSystem {
            system_id,
            metrics: HashMap::new(),
            reports: HashMap::new(),
            total_data_points: 0,
        }
    }

    pub fn create_metric(&mut self, metric: Metric) -> Result<(), String> {
        self.metrics.insert(metric.metric_id.clone(), metric);
        Ok(())
    }

    pub fn add_data(&mut self, metric_id: &str, data_point: DataPoint) -> Result<(), String> {
        if let Some(metric) = self.metrics.get_mut(metric_id) {
            metric.add_data_point(data_point);
            self.total_data_points += 1;
            Ok(())
        } else {
            Err("Metric not found".to_string())
        }
    }

    pub fn generate_report(&mut self, report: Report) -> Result<(), String> {
        self.reports.insert(report.report_id.clone(), report);
        Ok(())
    }

    pub fn print_status(&self) {
        println!("\n╔════════════════════════════════════════════════════╗");
        println!("║        ANALYTICS SYSTEM (Phase 38)                 ║");
        println!("╚════════════════════════════════════════════════════╝\n");

        println!("📊 METRICS:");
        println!("   Defined: {}", self.metrics.len());
        println!("   Data points: {}", self.total_data_points);

        println!("\n📄 REPORTS:");
        println!("   Generated: {}", self.reports.len());

        println!("\n");
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 38: ANALYTICS SYSTEM ===\n");

    let mut system = AnalyticsSystem::new("analytics_001".to_string());

    println!("--- Creating Metrics ---");
    let metric = Metric::new("metric_revenue".to_string(), "Revenue".to_string());
    system.create_metric(metric)?;
    println!("✓ Metrics created\n");

    println!("--- Adding Data ---");
    for i in 0..10 {
        let dp = DataPoint::new(1000.0 + (i as f64 * 100.0), "US".to_string());
        system.add_data("metric_revenue", dp)?;
    }
    println!("✓ Data collected\n");

    println!("--- Generating Report ---");
    let report = Report::new(
        "report_001".to_string(),
        "Monthly Revenue".to_string(),
    );
    system.generate_report(report)?;
    println!("✓ Report generated\n");

    system.print_status();

    println!("✓✓✓ Analytics System operational ✓✓✓");
    Ok(())
}
