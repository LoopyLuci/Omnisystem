// CDNManager.vera - Content delivery network management
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct EdgeNode {
    pub node_id: String,
    pub location: String,
    pub latitude: f64,
    pub longitude: f64,
    pub available_bandwidth: u32, // Mbps
    pub cache_size_gb: u32,
}

impl EdgeNode {
    pub fn new(node_id: String, location: String) -> Self {
        EdgeNode {
            node_id,
            location,
            latitude: 0.0,
            longitude: 0.0,
            available_bandwidth: 1000,
            cache_size_gb: 500,
        }
    }

    pub fn calculate_distance(&self, lat: f64, lon: f64) -> f64 {
        ((self.latitude - lat).powi(2) + (self.longitude - lon).powi(2)).sqrt()
    }
}

pub struct CachedContent {
    pub content_id: String,
    pub url: String,
    pub size_mb: u32,
    pub cached_at: u64,
    pub last_accessed: u64,
    pub hit_count: u32,
}

impl CachedContent {
    pub fn new(content_id: String, url: String, size_mb: u32) -> Self {
        let now = std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .unwrap()
            .as_secs();

        CachedContent {
            content_id,
            url,
            size_mb,
            cached_at: now,
            last_accessed: now,
            hit_count: 0,
        }
    }

    pub fn record_access(&mut self) {
        self.hit_count += 1;
        self.last_accessed = std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .unwrap()
            .as_secs();
    }
}

pub struct CDNManager {
    pub manager_id: String,
    pub edge_nodes: HashMap<String, EdgeNode>,
    pub cached_content: HashMap<String, Vec<CachedContent>>,
    pub total_requests: u32,
    pub cache_hits: u32,
}

impl CDNManager {
    pub fn new(manager_id: String) -> Self {
        CDNManager {
            manager_id,
            edge_nodes: HashMap::new(),
            cached_content: HashMap::new(),
            total_requests: 0,
            cache_hits: 0,
        }
    }

    pub fn register_node(&mut self, node: EdgeNode) {
        self.edge_nodes.insert(node.node_id.clone(), node);
    }

    pub fn find_nearest_node(&self, latitude: f64, longitude: f64) -> Option<String> {
        let mut nearest: Option<(String, f64)> = None;

        for (id, node) in &self.edge_nodes {
            let distance = node.calculate_distance(latitude, longitude);
            if nearest.is_none() || distance < nearest.as_ref().unwrap().1 {
                nearest = Some((id.clone(), distance));
            }
        }

        nearest.map(|(id, _)| id)
    }

    pub fn cache_content(&mut self, node_id: &str, content: CachedContent) -> Result<(), String> {
        if self.edge_nodes.contains_key(node_id) {
            self.cached_content
                .entry(node_id.to_string())
                .or_insert_with(Vec::new)
                .push(content);
            Ok(())
        } else {
            Err(format!("Node {} not found", node_id))
        }
    }

    pub fn request_content(&mut self, node_id: &str, content_id: &str) -> Result<(), String> {
        self.total_requests += 1;

        if let Some(contents) = self.cached_content.get_mut(node_id) {
            if let Some(content) = contents.iter_mut().find(|c| c.content_id == content_id) {
                content.record_access();
                self.cache_hits += 1;
                return Ok(());
            }
        }

        Err("Content not found in cache".to_string())
    }

    pub fn get_cache_hit_ratio(&self) -> f64 {
        if self.total_requests == 0 {
            0.0
        } else {
            (self.cache_hits as f64 / self.total_requests as f64) * 100.0
        }
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 97: CDN MANAGER ===\n");
    let mut cdn = CDNManager::new("cdn_001".to_string());
    let node = EdgeNode::new("node_us_west".to_string(), "Los Angeles".to_string());
    cdn.register_node(node);
    let content = CachedContent::new("content_001".to_string(), "https://example.com/video.mp4".to_string(), 500);
    cdn.cache_content("node_us_west", content)?;
    cdn.request_content("node_us_west", "content_001")?;
    println!("✓ CDN content cached and served");
    println!("✓ Cache hit ratio: {:.1}%", cdn.get_cache_hit_ratio());
    println!("✓✓✓ CDN Manager operational ✓✓✓");
    Ok(())
}
