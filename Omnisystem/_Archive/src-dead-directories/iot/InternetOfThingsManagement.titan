// InternetOfThingsManagement.titan - Internet of Things device management
use crate::personal::ModuleFramework::*;
use std::collections::HashMap;

pub struct IoTDevice {
    pub device_id: String,
    pub device_name: String,
    pub device_type: String, // sensor, actuator, gateway, controller
    pub location: String,
    pub status: String, // online, offline, error, maintenance
    pub last_heartbeat: u64,
}

impl IoTDevice {
    pub fn new(device_id: String, device_name: String, device_type: String) -> Self {
        IoTDevice {
            device_id,
            device_name,
            device_type,
            location: String::new(),
            status: "online".to_string(),
            last_heartbeat: std::time::SystemTime::now()
                .duration_since(std::time::UNIX_EPOCH)
                .unwrap()
                .as_secs(),
        }
    }

    pub fn send_heartbeat(&mut self) {
        self.last_heartbeat = std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .unwrap()
            .as_secs();
        self.status = "online".to_string();
    }

    pub fn mark_offline(&mut self) {
        self.status = "offline".to_string();
    }
}

pub struct Sensor {
    pub sensor_id: String,
    pub device_id: String,
    pub sensor_type: String, // temperature, humidity, pressure, light, motion
    pub current_reading: f64,
    pub unit: String,
    pub min_value: f64,
    pub max_value: f64,
}

impl Sensor {
    pub fn new(sensor_id: String, device_id: String, sensor_type: String) -> Self {
        Sensor {
            sensor_id,
            device_id,
            sensor_type,
            current_reading: 0.0,
            unit: String::new(),
            min_value: 0.0,
            max_value: 100.0,
        }
    }

    pub fn update_reading(&mut self, value: f64) {
        self.current_reading = value;
    }

    pub fn is_in_range(&self) -> bool {
        self.current_reading >= self.min_value && self.current_reading <= self.max_value
    }
}

pub struct Actuator {
    pub actuator_id: String,
    pub device_id: String,
    pub actuator_type: String, // relay, motor, pump, valve, heater
    pub state: String, // on, off, varying
    pub power_consumption_w: f64,
}

impl Actuator {
    pub fn new(actuator_id: String, device_id: String, actuator_type: String) -> Self {
        Actuator {
            actuator_id,
            device_id,
            actuator_type,
            state: "off".to_string(),
            power_consumption_w: 0.0,
        }
    }

    pub fn turn_on(&mut self) {
        self.state = "on".to_string();
    }

    pub fn turn_off(&mut self) {
        self.state = "off".to_string();
    }
}

pub struct IoTRule {
    pub rule_id: String,
    pub name: String,
    pub trigger_condition: String,
    pub action: String,
    pub enabled: bool,
    pub execution_count: u32,
}

impl IoTRule {
    pub fn new(rule_id: String, name: String, condition: String, action: String) -> Self {
        IoTRule {
            rule_id,
            name,
            trigger_condition: condition,
            action,
            enabled: true,
            execution_count: 0,
        }
    }

    pub fn execute(&mut self) {
        if self.enabled {
            self.execution_count += 1;
        }
    }

    pub fn disable(&mut self) {
        self.enabled = false;
    }
}

pub struct InternetOfThingsManagementSystem {
    pub system_id: String,
    pub devices: HashMap<String, IoTDevice>,
    pub sensors: HashMap<String, Sensor>,
    pub actuators: HashMap<String, Actuator>,
    pub rules: HashMap<String, IoTRule>,
}

impl InternetOfThingsManagementSystem {
    pub fn new(system_id: String) -> Self {
        InternetOfThingsManagementSystem {
            system_id,
            devices: HashMap::new(),
            sensors: HashMap::new(),
            actuators: HashMap::new(),
            rules: HashMap::new(),
        }
    }

    pub fn register_device(&mut self, device: IoTDevice) {
        self.devices.insert(device.device_id.clone(), device);
    }

    pub fn attach_sensor(&mut self, sensor: Sensor) {
        self.sensors.insert(sensor.sensor_id.clone(), sensor);
    }

    pub fn attach_actuator(&mut self, actuator: Actuator) {
        self.actuators.insert(actuator.actuator_id.clone(), actuator);
    }

    pub fn create_rule(&mut self, rule: IoTRule) {
        self.rules.insert(rule.rule_id.clone(), rule);
    }

    pub fn get_online_devices(&self) -> u32 {
        self.devices
            .iter()
            .filter(|(_, d)| d.status == "online")
            .count() as u32
    }

    pub fn get_out_of_range_sensors(&self) -> u32 {
        self.sensors
            .iter()
            .filter(|(_, s)| !s.is_in_range())
            .count() as u32
    }

    pub fn get_active_actuators(&self) -> u32 {
        self.actuators
            .iter()
            .filter(|(_, a)| a.state == "on")
            .count() as u32
    }

    pub fn get_enabled_rules(&self) -> u32 {
        self.rules
            .iter()
            .filter(|(_, r)| r.enabled)
            .count() as u32
    }

    pub fn get_total_power_consumption(&self) -> f64 {
        self.actuators
            .iter()
            .filter(|(_, a)| a.state == "on")
            .map(|(_, a)| a.power_consumption_w)
            .sum()
    }
}

fn main() -> Result<(), String> {
    println!("=== PHASE 140: INTERNET OF THINGS MANAGEMENT ===\n");
    let mut iotms = InternetOfThingsManagementSystem::new("iotms_001".to_string());
    let device = IoTDevice::new("dev_001".to_string(), "Smart Sensor Hub".to_string(), "gateway".to_string());
    iotms.register_device(device);
    let sensor = Sensor::new("sensor_001".to_string(), "dev_001".to_string(), "temperature".to_string());
    iotms.attach_sensor(sensor);
    let actuator = Actuator::new("act_001".to_string(), "dev_001".to_string(), "heater".to_string());
    iotms.attach_actuator(actuator);
    let rule = IoTRule::new("rule_001".to_string(), "Auto Heat".to_string(), "temperature < 18".to_string(), "turn_on heater".to_string());
    iotms.create_rule(rule);
    println!("✓ Device, sensor, actuator, and rule recorded");
    println!("✓ Online devices: {}", iotms.get_online_devices());
    println!("✓✓✓ Internet of Things Management operational ✓✓✓");
    Ok(())
}
